/** app.wxss — 适老化设计系统 (Senior-Friendly Design System) */
/* 基于 UI/UX Pro Max 设计系统：Accessible & Ethical 风格 */
/* 配色：Calm blue + Reassuring green, 高对比度 */

/* ═══════════════════════════════════════════
   Design Tokens
   ═══════════════════════════════════════════ */
:root {
  /* ── 配色 (高对比度, 适老) ── */
  --primary: #0369A1;
  --primary-dark: #075985;
  --primary-light: #E0F2FE;
  --secondary: #38BDF8;
  --cta-green: #16A34A;
  --cta-green-light: #DCFCE7;
  --cta-green-dark: #15803D;
  --accent-gold: #D97706;
  --accent-gold-light: #FEF3C7;
  --accent-red: #DC2626;
  --accent-red-light: #FEE2E2;

  /* ── 背景 ── */
  --page-bg: #F0F9FF;        /* 浅蓝天空色 */
  --card-bg: #FFFFFF;
  --card-bg-soft: #F0F7FF;

  /* ── 文字 (高对比度) ── */
  --ink-main: #0C4A6E;       /* 主文字: 深蓝 */
  --ink-sub: #1E293B;        /* 辅助文字: 深灰蓝 (非浅灰!) */
  --ink-white: #FFFFFF;
  --ink-link: #0369A1;

  /* ── 圆角 ── */
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-pill: 999rpx;

  /* ── 阴影 ── */
  --shadow-sm: 0 2rpx 8rpx rgba(3, 105, 161, 0.08);
  --shadow-md: 0 6rpx 24rpx rgba(3, 105, 161, 0.10);
  --shadow-lg: 0 12rpx 40rpx rgba(3, 105, 161, 0.12);
  --shadow-green: 0 8rpx 24rpx rgba(22, 163, 74, 0.20);

  /* ── 边框 ── */
  --border-light: 2rpx solid rgba(3, 105, 161, 0.10);
  --border-medium: 2rpx solid rgba(3, 105, 161, 0.20);
}

/* ═══════════════════════════════════════════
   基础样式
   ═══════════════════════════════════════════ */
page {
  color: var(--ink-main);
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  background: var(--page-bg) !important;
  font-size: 34rpx;           /* 17px body text — 适老最小字号 */
  line-height: 1.6;
}

page,
.page {
  min-height: 100vh;
  background: var(--page-bg) !important;
}

.page-body {
  box-sizing: border-box;
  padding: 24rpx 28rpx;
}

.safe-bottom {
  height: calc(16rpx + env(safe-area-inset-bottom));
}

/* ═══════════════════════════════════════════
   排版 (全部放大)
   ═══════════════════════════════════════════ */
.page-title {
  font-size: 52rpx;           /* 26px — 大标题 */
  font-weight: 900;
  color: var(--ink-main);
  line-height: 1.3;
}

.section-title {
  font-size: 44rpx;           /* 22px */
  font-weight: 800;
  color: var(--ink-main);
  line-height: 1.4;
}

.body-text {
  font-size: 34rpx;           /* 17px — 正文 */
  line-height: 1.7;
  color: var(--ink-main);
  font-weight: 600;
}

.meta-text {
  font-size: 30rpx;           /* 15px — 辅助文字 (最小字号) */
  color: var(--ink-sub);
  line-height: 1.6;
  font-weight: 600;
}

.money-number {
  font-size: 56rpx;
  line-height: 1.1;
  color: var(--ink-main);
  font-weight: 900;
}

.money-number.blue { color: var(--primary); }
.money-number.gold { color: var(--accent-gold); }
.money-number.green { color: var(--cta-green-dark); }
.money-number.red { color: var(--accent-red); }

/* ═══════════════════════════════════════════
   卡片 (大圆角大白卡片)
   ═══════════════════════════════════════════ */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-md);
  border: var(--border-light);
}

.card-sm {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-sm);
  border: var(--border-light);
}

.card-soft {
  background: var(--card-bg-soft);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  border: var(--border-light);
}

/* ═══════════════════════════════════════════
   按钮 — 适老化超大按钮
   ═══════════════════════════════════════════ */
.btn {
  border: none;
  border-radius: 28rpx;
  min-height: 110rpx;         /* 55px — 适老触控目标 */
  height: 110rpx;
  line-height: 110rpx;
  font-size: 36rpx;           /* 18px */
  font-weight: 800;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn:active {
  opacity: 0.85;
}

.btn-primary {
  color: var(--ink-white);
  background: var(--cta-green);
  box-shadow: var(--shadow-green);
}

.btn-primary[disabled] {
  background: #94A3B8;
  box-shadow: none;
  color: var(--ink-white);
}

.btn-secondary {
  color: var(--ink-main);
  background: var(--card-bg);
  border: 3rpx solid var(--primary);
  font-weight: 800;
}

.btn-ghost {
  color: var(--primary);
  background: var(--primary-light);
  border: 3rpx solid rgba(3, 105, 161, 0.25);
  font-weight: 800;
}

.btn-danger {
  color: var(--ink-white);
  background: var(--accent-red);
  box-shadow: 0 4rpx 16rpx rgba(220, 38, 38, 0.20);
}

.btn-sm {
  min-height: 88rpx;          /* 44px — 仍然满足 WCAG */
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 22rpx;
}

.btn-lg {
  min-height: 120rpx;         /* 60px */
  height: 120rpx;
  line-height: 120rpx;
  font-size: 40rpx;
  border-radius: 32rpx;
}

.btn-block {
  width: 100%;
}

.btn::after { border: none; }

/* ═══════════════════════════════════════════
   标签 (高对比度)
   ═══════════════════════════════════════════ */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 22rpx;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.tag-blue { background: var(--primary-light); color: var(--primary); border: 2rpx solid rgba(3, 105, 161, 0.20); }
.tag-green { background: var(--cta-green-light); color: var(--cta-green-dark); border: 2rpx solid rgba(22, 163, 74, 0.20); }
.tag-red { background: var(--accent-red-light); color: var(--accent-red); border: 2rpx solid rgba(220, 38, 38, 0.20); }
.tag-gold { background: var(--accent-gold-light); color: var(--accent-gold); border: 2rpx solid rgba(217, 119, 6, 0.20); }

/* ═══════════════════════════════════════════
   表单 (大号输入框)
   ═══════════════════════════════════════════ */
.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-sub);
}

.input-wrapper {
  display: flex;
  align-items: center;
  height: 100rpx;             /* 50px 输入框 */
  padding: 0 24rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg);
  border: 3rpx solid rgba(3, 105, 161, 0.15);
  box-sizing: border-box;
  transition: all 0.25s;
}

.input-wrapper.focus {
  border-color: var(--primary);
  background: var(--card-bg);
  box-shadow: 0 0 0 6rpx rgba(3, 105, 161, 0.10);
}

.input-field {
  flex: 1;
  height: 100%;
  font-size: 34rpx;           /* 17px */
  color: var(--ink-main);
  background: transparent;
  min-height: 50rpx;
}

.placeholder {
  color: #64748B;             /* 中灰 (非浅灰) */
  font-size: 30rpx;
}

/* ═══════════════════════════════════════════
   布局工具
   ═══════════════════════════════════════════ */
.flex-row { display: flex; align-items: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-col { display: flex; flex-direction: column; }

.gap-sm { gap: 16rpx; }
.gap-md { gap: 24rpx; }
.gap-lg { gap: 32rpx; }

.mt-sm { margin-top: 16rpx; }
.mt-md { margin-top: 28rpx; }
.mt-lg { margin-top: 40rpx; }

.mb-sm { margin-bottom: 16rpx; }
.mb-md { margin-bottom: 28rpx; }
.mb-lg { margin-bottom: 40rpx; }

.p-sm { padding: 16rpx; }
.p-md { padding: 28rpx; }
.p-lg { padding: 40rpx; }

.text-center { text-align: center; }
.text-right { text-align: right; }
.text-primary { color: var(--primary); }
.text-sub { color: var(--ink-sub); }
.text-green { color: var(--cta-green-dark); }
.text-red { color: var(--accent-red); }
.text-white { color: var(--ink-white); }
.fw-700 { font-weight: 700; }
.fw-800 { font-weight: 800; }
.fw-900 { font-weight: 900; }

/* ═══════════════════════════════════════════
   分隔线
   ═══════════════════════════════════════════ */
.divider {
  height: 2rpx;
  background: rgba(3, 105, 161, 0.08);
  margin: 24rpx 0;
}

/* ═══════════════════════════════════════════
   动画
   ═══════════════════════════════════════════ */
.page-enter {
  animation: pageFadeIn 0.35s ease both;
}

@keyframes pageFadeIn {
  from { opacity: 0; transform: translate3d(0, 16rpx, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}

/* ═══════════════════════════════════════════
   模块头部
   ═══════════════════════════════════════════ */
.section + .section { margin-top: 28rpx; }

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-header-accent {
  width: 10rpx;
  height: 40rpx;
  border-radius: 5rpx;
  background: var(--primary);
  flex-shrink: 0;
}

.section-header-title {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ink-main);
  flex: 1;
}

.section-header-more {
  font-size: 30rpx;
  color: var(--primary);
  font-weight: 700;
}

/* ── 模块卡片块 ── */
.section-block {
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  background: var(--card-bg);
  box-shadow: var(--shadow-md);
  border: var(--border-light);
}

.section-block-soft {
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  background: var(--card-bg-soft);
  border: var(--border-light);
}

/* ═══════════════════════════════════════════
   装饰点缀
   ═══════════════════════════════════════════ */
.accent-dot {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
}

.accent-dot.gold { background: var(--accent-gold); }
.accent-dot.green { background: var(--cta-green); }
.accent-dot.red { background: var(--accent-red); }

.pressable { transition: transform 0.2s ease, opacity 0.2s ease; }
.pressable:active { opacity: 0.8; }

.error-text {
  color: var(--accent-red);
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ═══════════════════════════════════════════
   卡片淡入动画
   ═══════════════════════════════════════════ */
.card-in {
  animation: fadeUp 0.4s ease both;
}

.delay-1 { animation-delay: 80ms; }
.delay-2 { animation-delay: 140ms; }
.delay-3 { animation-delay: 200ms; }
.delay-4 { animation-delay: 260ms; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ═══════════════════════════════════════════
   向后兼容映射 — 旧变量 → 新配色
   让未重构的页面自动使用新配色
   ═══════════════════════════════════════════ */
:root {
  --brand-purple: var(--primary);
  --ink-muted: #64748B;
  --ink-sub: #1E293B;
  --accent-green: var(--cta-green-dark);
  --accent-red: var(--accent-red);
  --accent-gold: var(--accent-gold);
  --card-bg-soft: #F0F7FF;
  --shadow-sm: 0 2rpx 8rpx rgba(3, 105, 161, 0.08);
  --shadow-md: 0 6rpx 24rpx rgba(3, 105, 161, 0.10);
  --shadow-lg: 0 12rpx 40rpx rgba(3, 105, 161, 0.12);
  --border-soft: 2rpx solid rgba(3, 105, 161, 0.08);
  --border-medium: 2rpx solid rgba(3, 105, 161, 0.15);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-pill: 999rpx;
}
