.tab-shell {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 16rpx;
  z-index: 999;
}

.compact-shell {
  left: 16rpx;
  right: 16rpx;
  bottom: 12rpx;
}

.tab-bar {
  height: 132rpx;
  padding: 10rpx 16rpx calc(env(safe-area-inset-bottom) + 12rpx);
  border-radius: 36rpx;
  border: 2rpx solid rgba(44, 93, 201, 0.08);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 16rpx 40rpx rgba(31, 66, 148, 0.14);
  display: flex;
  align-items: flex-end;
  backdrop-filter: blur(16rpx);
}

.compact-bar {
  height: 102rpx;
  padding: 6rpx 12rpx calc(env(safe-area-inset-bottom) + 8rpx);
  border-radius: 30rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 8rpx;
}

.icon-wrap {
  width: 70rpx;
  height: 52rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
  position: relative;
}

.icon-text {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  color: #8fa1c2;
}

.tab-text {
  font-size: 22rpx;
  line-height: 1.25;
  color: #7c8dad;
  font-weight: 700;
}

.compact-bar .icon-wrap {
  width: 54rpx;
  height: 38rpx;
  margin-bottom: 4rpx;
}

.compact-bar .icon-text {
  font-size: 24rpx;
}

.compact-bar .tab-text {
  font-size: 18rpx;
}

.tab-item.active .icon-wrap {
  background: rgba(45, 99, 219, 0.08);
}

.tab-item.active .icon-text,
.tab-item.active .tab-text {
  color: #2d63db;
}

.tab-item.is-center {
  padding-bottom: 0;
}

.tab-item.is-center .tab-text {
  margin-top: -24rpx;
  color: #234caa;
  font-weight: 800;
}

.center-wrap {
  width: 126rpx;
  height: 126rpx;
  border-radius: 999rpx;
  border: 10rpx solid #f5f8ff;
  background: linear-gradient(160deg, #2f67f6 0%, #4f8cff 100%);
  transform: translateY(-38rpx);
  box-shadow: 0 16rpx 32rpx rgba(47, 103, 246, 0.34);
  margin-bottom: 8rpx;
}

.center-glow {
  position: absolute;
  inset: -12rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(111, 160, 255, 0.32) 0%, rgba(111, 160, 255, 0) 70%);
}

.tab-item.is-center .icon-text {
  font-size: 40rpx;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.tab-item.is-center.active .center-wrap {
  box-shadow: 0 18rpx 36rpx rgba(47, 103, 246, 0.42);
}
