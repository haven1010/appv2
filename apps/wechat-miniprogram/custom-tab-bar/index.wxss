.tab-shell {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 18rpx;
  z-index: 999;
}

.compact-shell {
  left: 16rpx;
  right: 16rpx;
  bottom: 12rpx;
}

.tab-bar {
  height: 132rpx;
  padding: 10rpx 16rpx calc(env(safe-area-inset-bottom) + 12rpx);
  border-radius: 36rpx;
  border: 1rpx solid rgba(105, 126, 181, 0.08);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(249, 251, 255, 0.98) 100%);
  box-shadow: 0 12rpx 30rpx rgba(80, 101, 150, 0.12);
  display: flex;
  align-items: flex-end;
  backdrop-filter: blur(16rpx);
}

.compact-bar {
  height: 102rpx;
  padding: 6rpx 12rpx calc(env(safe-area-inset-bottom) + 8rpx);
  border-radius: 30rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 8rpx;
}

.icon-wrap {
  width: 70rpx;
  height: 52rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
  position: relative;
}

.icon-text {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  color: #9ba8c0;
}

.tab-text {
  font-size: 22rpx;
  line-height: 1.25;
  color: #8593ad;
  font-weight: 700;
}

.compact-bar .icon-wrap {
  width: 54rpx;
  height: 38rpx;
  margin-bottom: 4rpx;
}

.compact-bar .icon-text {
  font-size: 24rpx;
}

.compact-bar .tab-text {
  font-size: 18rpx;
}

.tab-item.active .icon-wrap {
  background: rgba(58, 105, 226, 0.09);
}

.tab-item.active .icon-text,
.tab-item.active .tab-text {
  color: #2f67f6;
}

.tab-item.is-center {
  padding-bottom: 0;
}

.tab-item.is-center .tab-text {
  margin-top: -24rpx;
  color: #2f67f6;
  font-weight: 800;
}

.center-wrap {
  width: 126rpx;
  height: 126rpx;
  border-radius: 999rpx;
  border: 10rpx solid #f7faff;
  background: linear-gradient(160deg, #ffd24b 0%, #ffb32c 100%);
  transform: translateY(-38rpx);
  box-shadow: 0 14rpx 28rpx rgba(255, 178, 31, 0.28);
  margin-bottom: 8rpx;
}

.center-glow {
  position: absolute;
  inset: -12rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 210, 74, 0.36) 0%, rgba(255, 210, 74, 0) 70%);
}

.tab-item.is-center .icon-text {
  font-size: 40rpx;
  color: #8d5700;
  letter-spacing: 2rpx;
}

.tab-item.is-center.active .center-wrap {
  box-shadow: 0 16rpx 30rpx rgba(255, 178, 31, 0.34);
}
