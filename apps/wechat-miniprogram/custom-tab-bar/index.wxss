/* custom-tab-bar/index.wxss — monochrome worker tab bar */

.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(251, 251, 250, 0.96);
  border-top: 2rpx solid rgba(17, 17, 17, 0.08);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-bar {
  height: 148rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 10rpx 34rpx 18rpx;
}

.tab-item {
  flex: 1;
  min-width: 0;
  min-height: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  border-radius: 28rpx;
  transition: opacity 0.18s, transform 0.18s;
}

.tab-item:active {
  opacity: 0.72;
  transform: scale(0.96);
}

.tab-icon-wrap {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.tab-text {
  margin-top: 8rpx;
  color: #b5b5b5;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0;
}

.tab-desc {
  display: none;
}

.tab-item.active .tab-text {
  color: #111111;
  font-weight: 900;
}

.worker-tab-item.center-tab {
  justify-content: flex-start;
  padding-top: 0;
}

.worker-tab-item.center-tab .tab-icon-wrap {
  width: 104rpx;
  height: 104rpx;
  margin-top: -18rpx;
  border-radius: 50%;
  background: #111111;
  box-shadow: 0 14rpx 30rpx rgba(17, 17, 17, 0.18);
}

.worker-tab-item.center-tab .tab-icon {
  width: 52rpx;
  height: 52rpx;
}

.worker-tab-item.center-tab .tab-text {
  margin-top: 10rpx;
  color: #b5b5b5;
}

.worker-tab-item.center-tab.active .tab-text {
  color: #111111;
}

/* Keep non-worker role tabs usable if this component is shown there. */
.tab-item:not(.worker-tab-item).active .tab-text {
  color: #111111;
}

/* Login state */
.tab-login-bar {
  flex: 1;
  height: 96rpx;
  margin: 8rpx 0 4rpx;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.tab-login-bar:active {
  opacity: 0.82;
}

.tab-login-icon {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.tab-login-text {
  color: #ffffff;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 900;
}

.tab-login-arrow {
  color: #ffffff;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 800;
}
