<view wx:if="{{!hiddenForSplash}}" class="tab-shell">
  <view class="tab-bar">
    <block wx:if="{{!loggedIn}}">
      <view class="tab-login-bar" bindtap="goToLogin">
        <image class="tab-login-icon" src="{{lockIcon}}" mode="aspectFit" />
        <text class="tab-login-text">请先登录</text>
        <text class="tab-login-arrow">›</text>
      </view>
    </block>

    <block wx:elif="{{role === 'field_manager'}}">
      <view
        wx:for="{{fieldList}}"
        wx:key="pagePath"
        class="tab-item {{selected === index ? 'active' : ''}}"
        data-path="{{item.pagePath}}"
        bindtap="switchTab"
      >
        <image class="tab-icon" src="{{selected === index ? item.iconActive : item.icon}}" mode="aspectFit" />
        <text class="tab-text">{{item.text}}</text>
      </view>
    </block>

    <block wx:elif="{{role === 'boss'}}">
      <view
        wx:for="{{bossList}}"
        wx:key="pagePath"
        class="tab-item {{selected === index ? 'active' : ''}}"
        data-path="{{item.pagePath}}"
        bindtap="switchTab"
      >
        <image class="tab-icon" src="{{selected === index ? item.iconActive : item.icon}}" mode="aspectFit" />
        <text class="tab-text">{{item.text}}</text>
      </view>
    </block>

    <block wx:else>
      <view
        wx:for="{{workerList}}"
        wx:key="pagePath"
        class="tab-item worker-tab-item {{item.isCenter ? 'center-tab' : ''}} {{selected === index ? 'active' : ''}}"
        data-path="{{item.pagePath}}"
        bindtap="switchTab"
      >
        <view class="tab-icon-wrap">
          <image class="tab-icon" src="{{item.isCenter || selected === index ? item.iconActive : item.icon}}" mode="aspectFit" />
        </view>
        <text class="tab-text">{{item.text}}</text>
        <text wx:if="{{item.desc}}" class="tab-desc">{{item.desc}}</text>
      </view>
    </block>
  </view>
</view>
