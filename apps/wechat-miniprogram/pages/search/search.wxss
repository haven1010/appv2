.search-page {
  min-height: 100vh;
  background: #f5f5f7;
}

.search-header {
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f0f2f7;
  border-radius: 36rpx;
}

.search-input-icon {
  font-size: 28rpx;
  line-height: 1;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1a1a2e;
  line-height: 1.4;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #c0c4cc;
  color: #1a1a2e;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-body {
  padding: 16rpx 0;
}

/* Hint */
.search-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.search-hint-icon {
  font-size: 64rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.search-hint-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.search-hint-desc {
  font-size: 26rpx;
  color: #8a94a6;
}

/* Results */
.search-results {
  padding: 0 24rpx;
}

.search-result-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-result-item:active {
  opacity: 0.7;
}

.result-type-tag {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.result-tag-job {
  background: rgba(90, 108, 214, 0.1);
  color: #5A6CD6;
}

.result-tag-base {
  background: rgba(49, 164, 124, 0.1);
  color: #31a47c;
}

.result-tag-policy {
  background: rgba(242, 184, 75, 0.15);
  color: #b8860b;
}

.result-body {
  flex: 1;
  min-width: 0;
}

.result-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a94a6;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-arrow {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #c0c4cc;
  font-weight: 700;
}
