/* === Policy Apply === */

.page {
  background: linear-gradient(180deg, #f0f7ff 0%, #e6f0ff 100%) !important;
}

.page-body {
  padding: 24rpx 28rpx;
}

/* ── Header Banner ── */
.header-card {
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #4DA6FF 0%, #2563EB 100%);
  border-radius: var(--radius-lg);
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(37, 99, 235, 0.25);
  position: relative;
  overflow: hidden;
}

.header-card::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -10%;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.03);
}

.header-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 14rpx;
  position: relative;
  z-index: 1;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #1a1a2e;
  margin-bottom: 10rpx;
  position: relative;
  z-index: 1;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: #d8e8ff;
  line-height: 1.6;
  position: relative;
  z-index: 1;
}

/* ── Form Cards ── */
.form-card,
.tips-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: var(--border-soft);
  box-shadow: var(--shadow-md);
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink-main);
  margin-bottom: 14rpx;
}

.form-label.required::after {
  content: ' *';
  color: var(--accent-red);
}

/* ── Inputs ── */
.form-input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 20rpx;
  background: var(--card-bg-soft);
  border: 2rpx solid #e8e4f0;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--ink-main);
  transition: all 0.25s;
}

.form-input:focus {
  border-color: #2563EB;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(37, 99, 235, 0.1);
}

.form-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  padding: 18rpx;
  background: var(--card-bg-soft);
  border: 2rpx solid #e8e4f0;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--ink-main);
  line-height: 1.8;
  transition: all 0.25s;
}

.form-textarea:focus {
  border-color: #2563EB;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(37, 99, 235, 0.1);
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--ink-muted);
  margin-top: 10rpx;
}

/* ── Tips ── */
.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink-main);
  margin-bottom: 14rpx;
}

.tips-item {
  display: block;
  font-size: 24rpx;
  color: var(--ink-sub);
  line-height: 1.8;
  margin-bottom: 6rpx;
}

.tips-item:last-child {
  margin-bottom: 0;
}

/* ── Action ── */
.action-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #2563EB;
  color: #ffffff;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 900;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.35);
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.btn-primary[disabled] {
  background: #b8b4c8;
  box-shadow: none;
  color: #1a1a2e;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--card-bg);
  color: #2563EB;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 800;
  border: 2rpx solid rgba(37, 99, 235, 0.15);
}

.btn-ghost:active {
  opacity: 0.6;
}

.btn-ghost::after {
  border: none;
}

/* ── Bottom ── */
.page-bottom-gap {
  height: 56rpx;
}
