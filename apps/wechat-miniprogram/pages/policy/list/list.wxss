/* === Policy List — Claude Purple === */

.page-body {
  padding: 24rpx 28rpx;
}

/* ── Search Bar ── */
.search-bar {
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  background: var(--card-bg);
  border-radius: var(--radius-pill);
  border: var(--border-soft);
  box-shadow: var(--shadow-sm);
  transition: all 0.25s;
}

.search-box:focus-within {
  border-color: var(--brand-purple);
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1), var(--shadow-md);
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink-main);
  height: 60rpx;
}

.search-input::placeholder {
  color: var(--ink-muted);
}

/* ── Category Tabs ── */
.category-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding: 4rpx 0;
}

.tab-item {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  background: var(--card-bg);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  color: var(--ink-sub);
  font-weight: 700;
  border: var(--border-soft);
  transition: all 0.25s;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-active {
  background: var(--brand-gradient);
  color: #1a1a2e;
  border-color: transparent;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.25);
}

/* ── Loading / Empty ── */
.loading-state {
  text-align: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: var(--ink-muted);
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: var(--ink-muted);
}

/* ── Policy List ── */
.policy-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.policy-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  border: var(--border-soft);
  box-shadow: var(--shadow-md);
  animation: pageFadeIn 0.35s ease both;
  transition: transform 0.2s, box-shadow 0.2s;
}

.policy-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.policy-header {
  margin-bottom: 14rpx;
}

.policy-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink-main);
  line-height: 1.5;
}

.policy-summary {
  display: block;
  font-size: 26rpx;
  color: var(--ink-sub);
  line-height: 1.75;
  margin-bottom: 18rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.policy-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.policy-category {
  padding: 6rpx 18rpx;
  background: rgba(102, 126, 234, 0.1);
  color: var(--brand-purple);
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 700;
}

.policy-date {
  font-size: 22rpx;
  color: var(--ink-muted);
}

/* ── Bottom ── */
.page-bottom-gap {
  height: 56rpx;
}

@keyframes pageFadeIn {
  from { opacity: 0; transform: translate3d(0, 16rpx, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}
