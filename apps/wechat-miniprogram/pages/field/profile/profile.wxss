/* pages/field/profile/profile.wxss */
.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 84% -8%, rgba(46, 143, 77, 0.14) 0%, rgba(46, 143, 77, 0) 34%),
    radial-gradient(circle at 8% 8%, rgba(45, 115, 199, 0.12) 0%, rgba(45, 115, 199, 0) 30%),
    linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 0 26rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(45, 115, 199, 0.12);
  border: 4rpx solid rgba(45, 115, 199, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #1d5fae;
  margin-bottom: 16rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #17354f;
  margin-bottom: 12rpx;
}

.user-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.role-tag {
  background: rgba(46, 143, 77, 0.14);
  color: #1f7e42;
}

.uid-tag {
  background: rgba(45, 115, 199, 0.12);
  color: #1d5fae;
}

.loading-box {
  text-align: center;
  color: #67859d;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.info-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.16);
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(45, 115, 199, 0.1);
}

.card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #17354f;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(45, 115, 199, 0.14);
}

.card-content.empty {
  padding: 24rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #67859d;
}

.base-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
}

.base-icon {
  font-size: 40rpx;
}

.base-info {
  display: flex;
  flex-direction: column;
}

.base-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #17354f;
}

.base-id {
  font-size: 22rpx;
  color: #67859d;
  margin-top: 4rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(45, 115, 199, 0.12);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #67859d;
}

.info-value {
  font-size: 26rpx;
  color: #17354f;
}

.menu-list {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.16);
  margin-bottom: 40rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(45, 115, 199, 0.12);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 36rpx;
}

.menu-label {
  font-size: 28rpx;
  color: #17354f;
}

.menu-arrow {
  font-size: 32rpx;
  color: #6a88a1;
}

.btn-logout {
  background: rgba(217, 94, 73, 0.12);
  color: #b33f2a;
  border: 1rpx solid rgba(217, 94, 73, 0.24);
  border-radius: 20rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}