/* === Field Profile — Claude Purple === */

.page {
  padding: 24rpx 28rpx;
  padding-bottom: 140rpx;
}

/* ── Profile Header ── */
.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 28rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  border: var(--border-soft);
  box-shadow: var(--shadow-md);
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(102, 126, 234, 0.1);
  border: 4rpx solid rgba(102, 126, 234, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--brand-purple);
  margin-bottom: 16rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink-main);
  margin-bottom: 14rpx;
}

.user-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  font-weight: 700;
}

.role-tag {
  background: rgba(49, 164, 124, 0.1);
  color: var(--accent-green);
}

.uid-tag {
  background: rgba(102, 126, 234, 0.1);
  color: var(--brand-purple);
}

/* ── Loading ── */
.loading-box {
  text-align: center;
  color: var(--ink-sub);
  padding: 80rpx 0;
  font-size: 28rpx;
}

/* ── Info Card ── */
.info-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  border: var(--border-soft);
  box-shadow: var(--shadow-md);
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink-main);
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: var(--border-soft);
}

.card-content.empty {
  padding: 10rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: var(--ink-sub);
}

.base-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
}

.base-icon {
  font-size: 40rpx;
}

.base-info {
  display: flex;
  flex-direction: column;
}

.base-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-main);
}

.base-id {
  font-size: 22rpx;
  color: var(--ink-sub);
  margin-top: 4rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(102, 126, 234, 0.06);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--ink-sub);
}

.info-value {
  font-size: 26rpx;
  color: var(--ink-main);
  font-weight: 700;
}

/* ── Menu List ── */
.menu-list {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  border: var(--border-soft);
  box-shadow: var(--shadow-md);
  margin-bottom: 40rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid rgba(102, 126, 234, 0.06);
  transition: all 0.2s;
}

.menu-item:active {
  opacity: 0.7;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 36rpx;
}

.menu-label {
  font-size: 28rpx;
  color: var(--ink-main);
  font-weight: 700;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--ink-muted);
}

/* ── Logout ── */
.btn-logout {
  background: rgba(228, 92, 109, 0.08);
  color: var(--accent-red);
  border: 2rpx solid rgba(228, 92, 109, 0.2);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
  height: auto;
  line-height: 1.4;
  transition: all 0.2s;
}

.btn-logout:active {
  opacity: 0.8;
}

.btn-logout::after {
  border: none;
}
