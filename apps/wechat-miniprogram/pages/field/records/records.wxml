<view class="page page-enter">
  <view class="records-header">
    <text class="records-title">签到表</text>
    <text class="records-base">查看各日期的报名与签到记录，支持导出Excel</text>
    <picker mode="selector" value="{{baseIndex}}" range="{{managedBases}}" range-key="baseName" bindchange="onBaseChange" wx:if="{{managedBases.length}}">
      <view class="records-picker">{{baseName || '请选择基地'}}</view>
    </picker>
  </view>

  <view class="date-switcher">
    <view class="date-btn" bindtap="prevDay">‹</view>
    <picker mode="date" value="{{selectedDate}}" end="{{selectedDate}}" bindchange="onDateChange">
      <view class="date-display">
        <text class="date-label">{{dateLabel}}</text>
        <text class="date-value">{{selectedDate}}</text>
      </view>
    </picker>
    <view class="date-btn" bindtap="nextDay">›</view>
  </view>

  <view class="count-bar">
    <text class="count-text">共 <text class="count-num">{{totalCount}}</text> 条记录</text>
    <button class="export-btn" bindtap="exportRecords" loading="{{exporting}}" disabled="{{exporting}}">导出签到表</button>
  </view>

  <view class="loading-box" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="record-list" wx:elif="{{records.length > 0}}">
    <view class="record-item" wx:for="{{records}}" wx:key="id">
      <view class="record-left">
        <view class="record-avatar">{{item.displayAvatar}}</view>
        <view class="record-idx">{{index + 1}}</view>
      </view>
      <view class="record-center">
        <text class="record-name">{{item.displayName}}</text>
        <text class="record-detail">UID：{{item.displayUid}} ｜ 岗位：{{item.displayJob}}</text>
        <text class="record-detail">工作日期：{{item.displayWorkDate}}</text>
      </view>
      <view class="record-right">
        <text class="record-time">{{item.displayTime}}</text>
        <view class="record-status {{item.statusClass}}">{{item.statusText}}</view>
        <button class="checkout-btn" wx:if="{{item.canCheckout}}" data-id="{{item.id}}" bindtap="checkoutRecord" loading="{{checkoutingId === item.id}}" disabled="{{checkoutingId > 0}}">结束务工</button>
      </view>
    </view>
  </view>

  <view class="empty-box" wx:elif="{{!loading}}">
    <text class="empty-icon">签</text>
    <text class="empty-text">{{dateLabel}}暂无签到记录</text>
    <text class="empty-hint">工人报名后需现场管理员扫码完成签到</text>
  </view>
</view>
