/* === Field Records — Claude Purple === */

.page {
  padding: 24rpx 28rpx;
  padding-bottom: 140rpx;
}

/* ── Records Header ── */
.records-header {
  margin-bottom: 24rpx;
}

.records-title {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ink-main);
  display: block;
  margin-bottom: 8rpx;
}

.records-base {
  font-size: 24rpx;
  color: var(--ink-sub);
  margin-bottom: 10rpx;
  display: block;
}

.records-picker {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--brand-purple);
  background: rgba(102, 126, 234, 0.1);
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  font-weight: 700;
}

/* ── Date Switcher ── */
.date-switcher {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 20rpx 32rpx;
  border: var(--border-soft);
  box-shadow: var(--shadow-sm);
  margin-bottom: 22rpx;
}

.date-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--brand-purple);
  background: rgba(102, 126, 234, 0.1);
  border-radius: var(--radius-md);
  font-weight: 700;
}

.date-btn:active {
  opacity: 0.6;
}

.date-display {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.date-label {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
}

.date-value {
  font-size: 22rpx;
  color: var(--ink-sub);
  margin-top: 4rpx;
}

/* ── Count Bar ── */
.count-bar {
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.count-text {
  font-size: 24rpx;
  color: var(--ink-sub);
}

.count-num {
  color: var(--brand-purple);
  font-weight: 700;
}

.export-btn {
  margin: 0;
  border: none;
  min-width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-purple);
  color: #1a1a2e;
  font-size: 24rpx;
  font-weight: 800;
  padding: 0 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(102, 126, 234, 0.25);
  transition: all 0.2s;
}

.export-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.export-btn[disabled] {
  opacity: 0.55;
  box-shadow: none;
}

.export-btn::after {
  border: none;
}

/* ── Loading ── */
.loading-box {
  text-align: center;
  color: var(--ink-sub);
  padding: 80rpx 0;
  font-size: 28rpx;
}

/* ── Record List ── */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: var(--border-soft);
  box-shadow: var(--shadow-sm);
}

.record-left {
  position: relative;
  flex-shrink: 0;
}

.record-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(102, 126, 234, 0.1);
  border: 2rpx solid rgba(102, 126, 234, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brand-purple);
}

.record-idx {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  background: var(--brand-gradient);
  color: #1a1a2e;
  border-radius: 50%;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.record-center {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-main);
}

.record-detail {
  font-size: 22rpx;
  color: var(--ink-sub);
  margin-top: 4rpx;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.record-time {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink-main);
  margin-bottom: 8rpx;
}

.record-status {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
}

.record-status.checked {
  background: rgba(49, 164, 124, 0.12);
  color: var(--accent-green);
}

.record-status.pending {
  background: rgba(242, 184, 75, 0.15);
  color: #b8860b;
}

.record-status.absent {
  background: rgba(228, 92, 109, 0.1);
  color: var(--accent-red);
}

.record-status.cancelled {
  background: rgba(153, 153, 153, 0.12);
  color: #888888;
}

/* ── Empty ── */
.empty-box {
  text-align: center;
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--ink-sub);
}

.empty-hint {
  font-size: 22rpx;
  color: var(--ink-sub);
  margin-top: 12rpx;
  opacity: 0.6;
}
