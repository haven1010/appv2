/* === Field Home — Claude Purple === */

.page {
  padding: 24rpx 28rpx;
  padding-bottom: 156rpx;
}

/* ── Hero Header ── */
.hero-card {
  background: var(--brand-gradient);
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(102, 126, 234, 0.2);
  position: relative;
  overflow: hidden;
}

.hero-card::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -10%;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #ffffff;
  margin-bottom: 10rpx;
  position: relative;
  z-index: 1;
}

.hero-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.6;
  position: relative;
  z-index: 1;
}

/* ── Base Card ── */
.base-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 22rpx;
  border: var(--border-soft);
  box-shadow: var(--shadow-md);
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
  margin-bottom: 14rpx;
}

.base-switch {
  display: inline-block;
  background: rgba(102, 126, 234, 0.1);
  color: var(--brand-purple);
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  margin-bottom: 12rpx;
  font-weight: 700;
}

.base-desc {
  display: block;
  font-size: 24rpx;
  color: var(--ink-sub);
  line-height: 1.5;
}

/* ── Loading / Error ── */
.loading-box {
  text-align: center;
  color: var(--ink-sub);
  padding: 110rpx 0;
  font-size: 26rpx;
}

.error-card {
  background: rgba(228, 92, 109, 0.06);
  border: 1rpx solid rgba(228, 92, 109, 0.2);
  border-radius: var(--radius-md);
  padding: 42rpx 30rpx;
  text-align: center;
}

.error-msg {
  font-size: 26rpx;
  color: var(--accent-red);
  display: block;
  margin-bottom: 20rpx;
}

.btn-retry {
  display: inline-block;
  background: var(--brand-purple);
  color: #ffffff;
  padding: 14rpx 36rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 700;
}

/* ── Stats Card ── */
.stats-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 22rpx;
  border: var(--border-soft);
  box-shadow: var(--shadow-md);
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
}

.section-link {
  font-size: 22rpx;
  color: var(--brand-purple);
  font-weight: 700;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.stat-item {
  flex: 1;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink-main);
}

.stat-value.blue {
  color: var(--brand-purple);
}

.stat-value.orange {
  color: #8f5d11;
}

.stat-value.red {
  color: var(--accent-red);
}

.stat-label {
  font-size: 20rpx;
  color: var(--ink-sub);
  margin-top: 6rpx;
}

/* ── Action Buttons ── */
.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.action-btn {
  flex: 1;
  border-radius: var(--radius-lg);
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: var(--card-bg);
  border: var(--border-soft);
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s, box-shadow 0.2s;
}

.action-btn:active {
  transform: scale(0.97);
  box-shadow: var(--shadow-sm);
}

/* Keep scan/records buttons clean - no green background tint */
.action-text {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink-main);
  margin-bottom: 8rpx;
}

.action-desc {
  font-size: 21rpx;
  color: var(--ink-sub);
  line-height: 1.5;
}

.recent-section {
  margin-bottom: 30rpx;
}

/* ── Record List ── */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  border: var(--border-soft);
  box-shadow: var(--shadow-sm);
}

.record-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(102, 126, 234, 0.1);
  border: 2rpx solid rgba(102, 126, 234, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand-purple);
  flex-shrink: 0;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-main);
}

.record-time {
  font-size: 21rpx;
  color: var(--ink-sub);
  margin-top: 4rpx;
}

.record-status {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  flex-shrink: 0;
  font-weight: 700;
}

/* Keep green for check-in status indicators */
.record-status.success {
  background: rgba(49, 164, 124, 0.12);
  color: var(--accent-green);
}

.record-status.pending {
  background: rgba(242, 184, 75, 0.15);
  color: #b8860b;
}

.empty-box {
  text-align: center;
  color: var(--ink-sub);
  padding: 70rpx 0;
  font-size: 26rpx;
}
