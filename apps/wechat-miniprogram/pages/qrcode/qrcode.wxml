<view class="page scanner-page page-enter">
  <view class="scanner-hero">
    <view class="hero-orb hero-orb-one"></view>
    <view class="hero-orb hero-orb-two"></view>

    <text class="hero-title">今日上工码</text>
    <text class="hero-subtitle">出示给现场负责人扫码签到</text>
  </view>

  <view class="scanner-content">
    <view class="qrcode-card {{refreshing ? 'card-refreshing' : ''}}">
      <view class="qrcode-area {{refreshing ? 'refreshing' : ''}}">
        <image
          wx:if="{{qrCodeUrl}}"
          class="qrcode-image {{refreshing ? 'qr-refresh' : ''}}"
          src="{{qrCodeUrl}}"
          mode="aspectFit"
          binderror="onQrError"
        ></image>
        <view wx:else class="qrcode-placeholder">
          <view class="placeholder-code">
            <view></view>
            <view></view>
            <view></view>
            <view></view>
          </view>
          <text class="placeholder-text">加载二维码...</text>
        </view>

        <view wx:if="{{showStamp}}" class="stamp-overlay">
          <view class="stamp-icon stamp-anim {{stampAnim}}">
            <text class="stamp-char">签</text>
          </view>
        </view>
      </view>

      <text class="worker-name">{{name}}</text>
      <text class="worker-role">{{job}}</text>
      <text class="refresh-time">更新于 {{lastRefreshTime}}</text>

      <button class="refresh-btn" bindtap="refreshQR" disabled="{{refreshing}}">
        <block wx:if="{{refreshing}}">刷新中...</block>
        <block wx:else>刷新签到码</block>
      </button>
    </view>

    <view class="metric-card">
      <view class="metric-item status-item">
        <text class="metric-title">签到状态</text>
        <text class="metric-value status-value">{{checkinStatusText}}</text>
        <view class="progress-track">
          <view class="progress-fill {{checkedIn ? 'checked' : ''}}"></view>
        </view>
      </view>
    </view>
  </view>
</view>
