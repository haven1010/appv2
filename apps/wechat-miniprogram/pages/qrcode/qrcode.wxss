/* pages/qrcode/qrcode.wxss - iOS scanner dashboard */

page {
  background: #f5f5f7 !important;
  color: #111111;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.scanner-page {
  min-height: 100vh;
  background: #f5f5f7;
  overflow: hidden;
}

.scanner-hero {
  position: relative;
  min-height: 326rpx;
  box-sizing: border-box;
  padding: calc(48rpx + env(safe-area-inset-top)) 40rpx 34rpx;
  background: #f5f5f7;
  color: #111111;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.scanner-hero::after {
  display: none;
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  background: rgba(17, 17, 17, 0.035);
  pointer-events: none;
}

.hero-orb-one {
  width: 520rpx;
  height: 520rpx;
  right: -160rpx;
  top: -230rpx;
}

.hero-orb-two {
  width: 320rpx;
  height: 320rpx;
  right: 70rpx;
  bottom: -150rpx;
  background: rgba(17, 17, 17, 0.025);
}

.hero-title {
  position: relative;
  z-index: 2;
  display: block;
  margin-top: 0;
  color: #111111;
  font-size: 62rpx;
  line-height: 1.12;
  font-weight: 900;
  letter-spacing: 0;
}

.hero-subtitle {
  position: relative;
  z-index: 2;
  display: block;
  margin-top: 18rpx;
  color: #8e8e93;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
}

.scanner-content {
  position: relative;
  z-index: 3;
  margin-top: 0;
  padding: 20rpx 40rpx calc(176rpx + env(safe-area-inset-bottom));
}

.qrcode-card,
.metric-card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 34rpx;
  box-shadow: 0 18rpx 44rpx rgba(15, 23, 42, 0.06);
  border: 2rpx solid rgba(17, 17, 17, 0.06);
}

.qrcode-card {
  margin-top: 0;
  padding: 64rpx 36rpx 44rpx;
  text-align: center;
  border-radius: 34rpx;
}

.card-refreshing {
  transform: scale(0.99);
}

.qrcode-area {
  position: relative;
  width: 430rpx;
  height: 430rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #f8f8f9;
  border: 2rpx solid rgba(17, 17, 17, 0.04);
  overflow: hidden;
}

.qrcode-area.refreshing {
  opacity: 0.72;
}

.qrcode-image {
  width: 410rpx;
  height: 410rpx;
  display: block;
}

.qr-refresh {
  opacity: 0.55;
}

.qrcode-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.placeholder-code {
  width: 210rpx;
  height: 210rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 34rpx;
}

.placeholder-code view {
  width: 88rpx;
  height: 88rpx;
  border: 18rpx solid #111111;
  box-sizing: border-box;
}

.placeholder-text {
  color: #8e8e93;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
}

.worker-name {
  display: block;
  margin-top: 44rpx;
  color: #111111;
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 900;
  letter-spacing: 0;
}

.worker-role,
.refresh-time {
  display: block;
  color: #8e8e93;
  font-weight: 800;
  letter-spacing: 0;
}

.worker-role {
  margin-top: 18rpx;
  font-size: 30rpx;
  line-height: 1.36;
}

.refresh-time {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.3;
}

.refresh-btn {
  width: 320rpx;
  height: 82rpx;
  margin: 34rpx auto 0;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 82rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 28rpx rgba(17, 17, 17, 0.14);
}

.refresh-btn::after {
  border: none;
}

.refresh-btn[disabled] {
  opacity: 0.72;
}

.stamp-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  background: rgba(255, 255, 255, 0.58);
}

.stamp-icon {
  width: 178rpx;
  height: 178rpx;
  border-radius: 50%;
  border: 8rpx solid #111111;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 34rpx rgba(17, 17, 17, 0.14);
}

.stamp-char {
  color: #111111;
  font-size: 82rpx;
  line-height: 1;
  font-weight: 900;
}

.stamp-anim {
  animation: stampDrop 0.5s ease both;
}

@keyframes stampDrop {
  0% { transform: scale(0.2) rotate(-18deg); opacity: 0; }
  60% { transform: scale(1.14) rotate(5deg); opacity: 1; }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

.metric-card {
  margin-top: 32rpx;
  min-height: 176rpx;
  padding: 36rpx 38rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.metric-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.status-item {
  align-items: stretch;
}

.metric-title {
  color: #111111;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 900;
}

.metric-value {
  margin-top: 24rpx;
  color: #111111;
  font-size: 44rpx;
  line-height: 1.08;
  font-weight: 900;
}

.status-value {
  color: #8e8e93;
  font-size: 32rpx;
}

.progress-track {
  width: 100%;
  height: 14rpx;
  margin-top: 26rpx;
  border-radius: 999rpx;
  background: #e5e5ea;
  overflow: hidden;
}

.progress-fill {
  width: 0;
  height: 100%;
  border-radius: 999rpx;
  background: #111111;
  transition: width 0.25s ease;
}

.progress-fill.checked {
  width: 100%;
}
