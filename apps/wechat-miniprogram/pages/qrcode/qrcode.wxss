/* ═══════════════════════════════════════════
   QR Code Page — Claude Purple Theme
   ═══════════════════════════════════════════ */

.page {
  min-height: 100vh;
}

/* ── Container ── */
.container {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 24rpx calc(188rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

/* ── User Card ── */
.user-card {
  display: flex;
  align-items: center;
  padding: 22rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  border: var(--border-soft);
}

.avatar {
  width: 102rpx;
  height: 102rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(102, 126, 234, 0.12);
  background: var(--card-bg-soft);
  flex-shrink: 0;
}

.user-meta {
  margin-left: 18rpx;
}

.name {
  display: block;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 900;
  color: var(--ink-main);
}

.job {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 27rpx;
  color: var(--brand-purple);
  border-radius: var(--radius-pill);
  background: rgba(102, 126, 234, 0.08);
  padding: 6rpx 16rpx;
}

/* ── Work Info Card ── */
.work-info-card {
  padding: 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  border: var(--border-soft);
}

.work-info-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.work-info-row + .work-info-row {
  margin-top: 12rpx;
}

.work-info-label {
  min-width: 164rpx;
  font-size: 26rpx;
  color: var(--ink-sub);
  line-height: 1.5;
}

.work-info-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ink-main);
  line-height: 1.55;
  font-weight: 700;
}

/* ── Ticket Card (QR Code) ── */
.ticket-card {
  padding: 24rpx 22rpx 26rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  border: var(--border-soft);
  transition: transform 0.2s ease;
}

.ticket-refreshing {
  transform: scale(0.98);
}

.ticket-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
}

.ticket-title {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--ink-main);
}

.ticket-status {
  font-size: 24rpx;
  color: var(--brand-purple);
  background: rgba(102, 126, 234, 0.08);
  border-radius: var(--radius-pill);
  padding: 6rpx 14rpx;
  font-weight: 700;
}

.ticket-time {
  display: block;
  margin-top: 10rpx;
  color: var(--ink-sub);
  font-size: 24rpx;
}

.qr-card {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  height: 620rpx;
  margin: 18rpx auto 0;
  border-radius: 34rpx;
  border: 2rpx solid rgba(102, 126, 234, 0.08);
  background: var(--card-bg-soft);
  padding: 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-image {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  border: 4rpx solid rgba(102, 126, 234, 0.1);
  background: #fff;
}

.qr-image-refresh {
  animation: qrRefresh 0.36s ease;
}

.qr-placeholder {
  font-size: 32rpx;
  color: var(--ink-sub);
  font-weight: 700;
}

/* ── Stamp Overlay ── */
.stamp-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.stamp-image {
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  border: 10rpx solid var(--brand-purple);
  background: rgba(241, 246, 255, 0.95);
  box-shadow: 0 12rpx 18rpx rgba(102, 126, 234, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translate3d(0, -200px, 0) scale(0.5);
  opacity: 0;
}

.stamp-char {
  font-size: 112rpx;
  line-height: 1;
  font-weight: 900;
  color: var(--brand-purple);
}

.stamp-anim-drop {
  animation:
    stamp-drop 0.45s cubic-bezier(0.2, 0.88, 0.3, 1.22) forwards,
    stamp-fade 0.2s ease-out 1.2s forwards;
}

/* ── Growth Card ── */
.growth-card {
  display: flex;
  gap: 14rpx;
  padding: 16rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  border: var(--border-soft);
}

.growth-item {
  flex: 1;
  border-radius: var(--radius-md);
  background: var(--card-bg-soft);
  padding: 16rpx 14rpx;
  text-align: center;
}

.growth-label {
  display: block;
  font-size: 24rpx;
  color: var(--ink-sub);
}

.growth-value {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  color: var(--ink-main);
  font-weight: 900;
}

/* ── Tip ── */
.tip {
  text-align: center;
  color: var(--ink-sub);
  font-size: 28rpx;
  line-height: 1.55;
  font-weight: 700;
}

/* ── Refresh Button ── */
.refresh-btn {
  height: 100rpx;
  border-radius: 28rpx;
  border: none;
  background: var(--brand-purple);
  color: #1a1a2e;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.refresh-btn:active {
  transform: scale(0.97);
}

.refresh-btn::after {
  border: none;
}

.refresh-btn[disabled] {
  opacity: 0.72;
}

/* ── Animations ── */
@keyframes qrRefresh {
  0% {
    opacity: 0.75;
    transform: scale(0.96) rotate(-2deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
}

@keyframes stamp-drop {
  0% {
    transform: translate3d(0, -200px, 0) scale(0.5);
    opacity: 0;
  }
  15% {
    opacity: 1;
  }
  65% {
    transform: translate3d(0, 10px, 0) scale(1.1);
    opacity: 1;
  }
  80% {
    transform: translate3d(0, -4px, 0) scale(0.95);
  }
  100% {
    transform: translate3d(0, 0, 0) scale(1);
    opacity: 1;
  }
}

@keyframes stamp-fade {
  from { opacity: 1; }
  to { opacity: 0; }
}
