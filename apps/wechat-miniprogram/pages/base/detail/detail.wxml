<view class="page base-detail-page">
  <view wx:if="{{loading}}" class="state-panel">
    <view class="state-visual"></view>
    <text class="state-title">正在加载基地</text>
    <text class="state-desc">请稍候</text>
  </view>

  <view wx:elif="{{loadError}}" class="state-panel">
    <view class="state-visual empty"></view>
    <text class="state-title">{{loadError}}</text>
    <text class="state-desc">下拉可重试</text>
  </view>

  <block wx:elif="{{baseInfo}}">
    <view class="base-hero">
      <image class="base-hero-img" src="{{envImages[0] || '/images/home-action-bg-3.png'}}" mode="aspectFill"></image>
      <view class="base-hero-mask"></view>
      <view class="base-hero-copy">
        <text class="status-tag {{baseInfo.auditStatus === 1 ? 'approved' : baseInfo.auditStatus === 2 ? 'rejected' : 'pending'}}">{{auditText}}</text>
        <text class="hero-title">{{baseInfo.baseName || '基地详情'}}</text>
        <text class="hero-desc">{{categoryText}}</text>
      </view>
    </view>

    <view class="info-card">
      <view class="info-row">
        <text class="info-label">详细地址</text>
        <text class="info-value">{{addressText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">岗位要求</text>
        <text class="info-value">{{jobRequirementText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">环境情况</text>
        <text class="info-value">{{envSummaryText}}</text>
      </view>
    </view>

    <view class="section-block">
      <view class="section-head">
        <text class="section-title">基地环境</text>
        <text class="section-desc">真实场景图会优先展示在顶部</text>
      </view>

      <scroll-view wx:if="{{envImages.length}}" class="env-scroll" scroll-x enable-flex>
        <view class="env-img-row">
          <image
            wx:for="{{envImages}}"
            wx:key="index"
            class="env-image"
            src="{{item}}"
            mode="aspectFill"
            bindtap="previewImage"
            binderror="onEnvImageError"
            data-index="{{index}}"
            data-src="{{item}}"
          />
        </view>
      </scroll-view>

      <view wx:else class="empty-card">
        <view class="empty-visual"></view>
        <text class="empty-title">暂无环境图片</text>
        <text class="empty-desc">后续可补充基地实拍图，提升可信度</text>
      </view>

      <text wx:if="{{hasExpiredTempImage}}" class="warn-tip">部分图片地址已失效，请在企业端重新上传。</text>
    </view>

    <view wx:if="{{isBossView && !showBossPanels}}" class="state-panel compact">
      <text class="state-title">基地入驻未审核通过</text>
      <text class="state-desc">报名进度和工资结算将在审核通过后开放。</text>
    </view>

    <view wx:if="{{showBossPanels}}" class="management-card">
      <view class="section-head">
        <text class="section-title">报名进度</text>
      </view>

      <view class="summary-grid">
        <view class="summary-item">
          <text class="summary-value">{{progressSummary.totalJobs}}</text>
          <text class="summary-label">岗位</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">{{progressSummary.openJobs}}</text>
          <text class="summary-label">招聘中</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">{{progressSummary.totalApplicants}}</text>
          <text class="summary-label">总报名</text>
        </view>
      </view>

      <view wx:if="{{progressLoading}}" class="inner-state">报名进度加载中...</view>
      <view wx:elif="{{progressError}}" class="inner-state">{{progressError}}</view>
      <view wx:elif="{{progressRows.length === 0}}" class="inner-state">暂无报名进度数据</view>

      <view wx:else class="progress-list">
        <view wx:for="{{progressRows}}" wx:key="id" class="progress-card">
          <view class="progress-head">
            <text class="progress-title">{{item.jobTitle}}</text>
            <text class="progress-status {{item.statusClass}}">{{item.statusText}}</text>
          </view>
          <view class="progress-meta">
            <text>招聘 {{item.recruitCount}} 人</text>
            <text>已报名 {{item.applicantCount}} 人</text>
          </view>
          <text class="progress-date">{{item.workDateRange}}</text>
          <view wx:if="{{item.applicantNames.length}}" class="name-list">
            <text wx:for="{{item.applicantNames}}" wx:key="index" class="name-chip">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{showBossPanels}}" class="management-card">
      <view class="section-head">
        <text class="section-title">工资结算</text>
      </view>

      <view class="summary-grid payroll">
        <view class="summary-item">
          <text class="summary-value">{{payrollSummary.workerCount}}</text>
          <text class="summary-label">上岗人数</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">¥{{payrollSummary.totalAmountText}}</text>
          <text class="summary-label">累计工资</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">¥{{payrollSummary.pendingAmountText}}</text>
          <text class="summary-label">待发放</text>
        </view>
      </view>

      <view wx:if="{{payrollLoading}}" class="inner-state">工资数据加载中...</view>
      <view wx:elif="{{payrollError}}" class="inner-state">{{payrollError}}</view>
      <view wx:elif="{{payrollRows.length === 0}}" class="inner-state">暂无工资记录</view>

      <view wx:else class="payroll-list">
        <view wx:for="{{payrollRows}}" wx:key="key" class="payroll-card">
          <view class="payroll-head">
            <text class="payroll-name">{{item.workerName}}</text>
            <text class="payroll-status {{item.statusClass}}">{{item.statusText}}</text>
          </view>
          <view class="payroll-main">
            <text class="payroll-total-label">累计工资</text>
            <text class="payroll-total-value">¥{{item.totalAmountText}}</text>
          </view>
          <view class="payroll-meta">
            <text>已发放 ¥{{item.paidAmountText}}</text>
            <text>待发放 ¥{{item.pendingAmountText}}</text>
            <text>上岗 {{item.recordCount}} 次</text>
          </view>
          <text class="payroll-date">最近上岗：{{item.lastWorkDateText}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
