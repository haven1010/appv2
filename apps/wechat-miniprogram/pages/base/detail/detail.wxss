page {
  background: #f5f5f7;
}

.base-detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #f5f5f7;
  color: #111111;
}

.base-hero {
  position: relative;
  height: 410rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #111111;
  box-shadow: 0 22rpx 52rpx rgba(0, 0, 0, 0.14);
}

.base-hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.base-hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08) 0%, rgba(0, 0, 0, 0.78) 100%);
}

.base-hero-copy {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 30rpx;
}

.status-tag {
  display: flex;
  align-items: center;
  width: 120rpx;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #8d929c;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 900;
}

.status-tag.approved {
  color: #168252;
}

.status-tag.rejected {
  color: #c23b32;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 52rpx;
  line-height: 1.12;
  font-weight: 900;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 800;
}

.info-card,
.management-card {
  margin-top: 24rpx;
  border-radius: 34rpx;
  background: #ffffff;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.055);
}

.info-card {
  padding: 8rpx 30rpx;
}

.info-row {
  padding: 24rpx 0;
}

.info-row + .info-row {
  border-top: 1rpx solid #eef0f2;
}

.info-label {
  display: block;
  color: #8d929c;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 800;
}

.info-value {
  display: block;
  margin-top: 10rpx;
  color: #111111;
  font-size: 30rpx;
  line-height: 1.58;
  font-weight: 900;
  word-break: break-all;
}

.section-block {
  margin-top: 30rpx;
}

.section-head {
  padding: 0 4rpx 18rpx;
}

.section-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 900;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  color: #9ca0aa;
  font-size: 25rpx;
  line-height: 1.4;
  font-weight: 700;
}

.env-scroll {
  white-space: nowrap;
}

.env-img-row {
  display: flex;
  gap: 16rpx;
}

.env-image {
  width: 330rpx;
  height: 220rpx;
  border-radius: 26rpx;
  background: #e8e9ed;
  flex-shrink: 0;
}

.empty-card,
.state-panel,
.inner-state {
  border-radius: 34rpx;
  background: #ffffff;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.055);
}

.empty-card {
  padding: 44rpx 30rpx;
  text-align: center;
}

.empty-visual,
.state-visual {
  width: 150rpx;
  height: 150rpx;
  margin: 0 auto;
  border-radius: 42rpx;
  background:
    radial-gradient(circle at 32% 28%, rgba(22, 130, 82, 0.22), transparent 34%),
    linear-gradient(145deg, #ffffff, #e9ece8);
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.08);
}

.empty-title,
.state-title {
  display: block;
  margin-top: 28rpx;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 900;
}

.empty-desc,
.state-desc {
  display: block;
  margin-top: 10rpx;
  color: #8d929c;
  font-size: 27rpx;
  line-height: 1.45;
  font-weight: 700;
}

.warn-tip {
  display: block;
  margin-top: 16rpx;
  color: #c23b32;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 800;
}

.state-panel {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 52rpx 32rpx;
}

.state-panel.compact {
  min-height: 220rpx;
  margin-top: 24rpx;
}

.management-card {
  padding: 30rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.summary-item {
  min-height: 118rpx;
  border-radius: 26rpx;
  background: #f6f7f8;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
  text-align: center;
}

.summary-value {
  display: block;
  color: #111111;
  font-size: 31rpx;
  line-height: 1.18;
  font-weight: 900;
}

.summary-label {
  display: block;
  margin-top: 10rpx;
  color: #8d929c;
  font-size: 23rpx;
  line-height: 1.25;
  font-weight: 800;
}

.inner-state {
  margin-top: 22rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  color: #8d929c;
  font-size: 27rpx;
  font-weight: 800;
}

.progress-list,
.payroll-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.progress-card,
.payroll-card {
  border-radius: 28rpx;
  background: #f6f7f8;
  padding: 24rpx;
}

.progress-head,
.payroll-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-title,
.payroll-name {
  flex: 1;
  color: #111111;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 900;
}

.progress-status,
.payroll-status {
  flex: none;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  color: #8d929c;
  background: #ffffff;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 900;
}

.progress-status.open,
.payroll-status.confirm,
.payroll-status.paid {
  color: #168252;
  background: #edf8f2;
}

.progress-status.closed,
.payroll-status.pending {
  color: #b8860b;
  background: #fff7df;
}

.progress-meta,
.payroll-meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  color: #707680;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
}

.progress-date,
.payroll-date {
  display: block;
  margin-top: 12rpx;
  color: #9ca0aa;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 700;
}

.name-list {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.name-chip {
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  color: #168252;
  background: #edf8f2;
  font-size: 22rpx;
  font-weight: 900;
}

.payroll-main {
  margin-top: 18rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.payroll-total-label {
  color: #8d929c;
  font-size: 25rpx;
  font-weight: 800;
}

.payroll-total-value {
  color: #111111;
  font-size: 36rpx;
  font-weight: 900;
}
