<view class="page base-list-page">
  <view class="base-hero">
    <image class="base-hero-img" src="/images/home-action-bg-3.png" mode="aspectFill"></image>
    <view class="base-hero-mask"></view>
    <view class="base-hero-copy">
      <text class="hero-kicker">{{isBossView ? '老板视角' : '基地广场'}}</text>
      <text class="hero-title">{{isBossView ? '我的基地' : '附近基地'}}</text>
      <text class="hero-desc">{{isBossView ? '查看基地、报名和工资进度' : '选择可信基地，查看可报名岗位'}}</text>
    </view>
  </view>

  <view class="stat-strip">
    <view class="stat-item">
      <text class="stat-value">{{bases.length}}</text>
      <text class="stat-label">{{isBossView ? '我的基地' : '当前结果'}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{isBossView ? '全部' : (category === 0 ? '全部' : category === 1 ? '水果' : category === 2 ? '蔬菜' : '其他')}}</text>
      <text class="stat-label">{{isBossView ? '数据范围' : '筛选分类'}}</text>
    </view>
  </view>

  <view wx:if="{{!isBossView}}" class="segment-card">
    <view class="segment-item {{category === 0 ? 'active' : ''}}" data-category="0" bindtap="filterByCategory">全部</view>
    <view class="segment-item {{category === 1 ? 'active' : ''}}" data-category="1" bindtap="filterByCategory">水果</view>
    <view class="segment-item {{category === 2 ? 'active' : ''}}" data-category="2" bindtap="filterByCategory">蔬菜</view>
    <view class="segment-item {{category === 3 ? 'active' : ''}}" data-category="3" bindtap="filterByCategory">其他</view>
  </view>

  <view wx:if="{{loading}}" class="state-panel">
    <view class="state-visual"></view>
    <text class="state-title">正在加载基地</text>
    <text class="state-desc">请稍候</text>
  </view>

  <view wx:elif="{{bases.length === 0}}" class="state-panel">
    <view class="state-visual empty"></view>
    <text class="state-title">暂无基地信息</text>
    <text class="state-desc">可下拉刷新后重试</text>
  </view>

  <view wx:else class="base-list">
    <view
      wx:for="{{bases}}"
      wx:key="id"
      class="base-card"
      data-id="{{item.id}}"
      bindtap="goToDetail"
    >
      <image class="base-cover" src="/images/home-action-bg-3.png" mode="aspectFill"></image>
      <view class="base-content">
        <view class="base-head">
          <text class="base-name">{{item.baseName || '未命名基地'}}</text>
          <text class="status-tag {{item.auditStatus === 1 ? 'ok' : 'wait'}}">{{item.auditStatus === 1 ? '已认证' : '待审核'}}</text>
        </view>

        <view class="base-tags">
          <text class="category-tag">{{item.category === 1 ? '水果' : item.category === 2 ? '蔬菜' : '其他'}}</text>
          <text class="job-tag">{{isBossView ? '管理基地' : '查看岗位'}}</text>
        </view>

        <text class="base-address">{{item.address || '地址待补充'}}</text>
        <text wx:if="{{isBossView}}" class="base-tip">点击查看报名进度、基地信息和工资结算</text>
      </view>
    </view>
  </view>

  <view wx:if="{{isBossView}}" class="boss-bottom-nav">
    <view class="boss-bottom-item" bindtap="goToBossDashboard">工作台</view>
    <view class="boss-bottom-item active">我的基地</view>
    <view class="boss-bottom-item" bindtap="goToBossJobList">岗位发布</view>
    <view class="boss-bottom-item" bindtap="goToBossProfile">我的</view>
  </view>
</view>
