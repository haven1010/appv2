page {
  background: #f5f5f7;
}

.base-list-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  background: #f5f5f7;
  color: #111111;
}

.base-hero {
  position: relative;
  height: 360rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #111111;
  box-shadow: 0 22rpx 52rpx rgba(0, 0, 0, 0.14);
}

.base-hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.base-hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08) 0%, rgba(0, 0, 0, 0.74) 100%);
}

.base-hero-copy {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 30rpx;
}

.hero-kicker {
  display: flex;
  align-items: center;
  width: 150rpx;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #168252;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 900;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 52rpx;
  line-height: 1.12;
  font-weight: 900;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 800;
}

.stat-strip {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.stat-item {
  min-height: 116rpx;
  border-radius: 28rpx;
  background: #ffffff;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 12rpx 34rpx rgba(0, 0, 0, 0.045);
}

.stat-value {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 900;
}

.stat-label {
  display: block;
  margin-top: 10rpx;
  color: #9ca0aa;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 800;
}

.segment-card {
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  padding: 8rpx;
  display: flex;
  gap: 6rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.04);
}

.segment-item {
  flex: 1;
  height: 70rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8d929c;
  font-size: 27rpx;
  font-weight: 900;
}

.segment-item.active {
  color: #ffffff;
  background: #111111;
}

.state-panel {
  min-height: 420rpx;
  margin-top: 24rpx;
  border-radius: 34rpx;
  background: #ffffff;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.055);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40rpx;
}

.state-visual {
  width: 150rpx;
  height: 150rpx;
  border-radius: 42rpx;
  background:
    radial-gradient(circle at 32% 28%, rgba(22, 130, 82, 0.22), transparent 34%),
    linear-gradient(145deg, #ffffff, #e9ece8);
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.08);
}

.state-title {
  margin-top: 28rpx;
  color: #111111;
  font-size: 34rpx;
  font-weight: 900;
}

.state-desc {
  margin-top: 10rpx;
  color: #8d929c;
  font-size: 27rpx;
  font-weight: 700;
}

.base-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.base-card {
  overflow: hidden;
  border-radius: 34rpx;
  background: #ffffff;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.055);
}

.base-card:active {
  opacity: 0.78;
}

.base-cover {
  width: 100%;
  height: 220rpx;
  display: block;
  background: #e8e9ed;
}

.base-content {
  padding: 26rpx 28rpx 28rpx;
}

.base-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.base-name {
  flex: 1;
  color: #111111;
  font-size: 35rpx;
  line-height: 1.3;
  font-weight: 900;
}

.status-tag {
  flex: none;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  color: #8d929c;
  background: #f1f2f4;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 900;
}

.status-tag.ok {
  color: #168252;
  background: #edf8f2;
}

.base-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.category-tag,
.job-tag {
  height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 900;
}

.category-tag {
  color: #111111;
  background: #f2f3f5;
}

.job-tag {
  color: #168252;
  background: #edf8f2;
}

.base-address,
.base-tip {
  display: block;
  margin-top: 18rpx;
  color: #707680;
  font-size: 27rpx;
  line-height: 1.5;
  font-weight: 800;
}

.boss-bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(251, 251, 250, 0.94);
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.boss-bottom-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 14rpx 8rpx 10rpx;
  color: #9ca0aa;
  font-size: 24rpx;
  font-weight: 900;
}

.boss-bottom-item.active {
  color: #111111;
}
