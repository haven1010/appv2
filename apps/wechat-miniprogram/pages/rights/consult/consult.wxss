.page {
  min-height: 100vh;
  background: #f5efe3;
}

.page-body {
  padding: 16px;
}

.header-card {
  padding: 32px 24px;
  margin-bottom: 16px;
  text-align: center;
  background: linear-gradient(135deg, #22C55E, #16A34A);
  border-radius: 16px;
}

.header-icon {
  font-size: 48px;
  display: block;
  margin-bottom: 12px;
}

.header-title {
  display: block;
  font-size: 24px;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8px;
}

.header-subtitle {
  display: block;
  font-size: 14px;
  color: rgba(255, 255, 255, 0.9);
}

.form-card {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.form-label {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #0F172A;
  margin-bottom: 12px;
}

.form-label.required::after {
  content: ' *';
  color: #EF4444;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 48px;
  padding: 0 16px;
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
}

.picker-text {
  font-size: 14px;
  color: #0F172A;
}

.picker-text.placeholder {
  color: #94A3B8;
}

.picker-arrow {
  font-size: 12px;
  color: #94A3B8;
}

.form-textarea {
  width: 100%;
  min-height: 120px;
  padding: 12px;
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  font-size: 14px;
  color: #0F172A;
  line-height: 1.6;
  box-sizing: border-box;
}

.form-input {
  width: 100%;
  height: 48px;
  padding: 0 16px;
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  font-size: 14px;
  color: #0F172A;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 12px;
  color: #94A3B8;
  margin-top: 8px;
}

.upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.image-item {
  position: relative;
  width: 100px;
  height: 100px;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 8px;
  object-fit: cover;
}

.remove-btn {
  position: absolute;
  top: -8px;
  right: -8px;
  width: 24px;
  height: 24px;
  background: #EF4444;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: 700;
  line-height: 1;
}

.upload-btn {
  width: 100px;
  height: 100px;
  background: #F8FAFC;
  border: 2px dashed #CBD5E1;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.upload-icon {
  font-size: 32px;
  color: #94A3B8;
}

.upload-text {
  font-size: 12px;
  color: #64748B;
}

.form-hint {
  display: block;
  font-size: 12px;
  color: #64748B;
  margin-top: 12px;
  line-height: 1.5;
}

.tips-card {
  background: #EFF6FF;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 16px;
}

.tips-title {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #1E40AF;
  margin-bottom: 12px;
}

.tips-item {
  display: block;
  font-size: 14px;
  color: #1E3A8A;
  line-height: 1.8;
  margin-bottom: 4px;
}

.tips-item:last-child {
  margin-bottom: 0;
}

.action-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 16px;
}

.btn-primary,
.btn-ghost {
  width: 100%;
  height: 48px;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 600;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #22C55E, #16A34A);
  color: #FFFFFF;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: #FFFFFF;
  color: #64748B;
  border: 1px solid #E2E8F0;
}

.btn-ghost::after {
  border: none;
}

.page-bottom-gap {
  height: 40px;
}
