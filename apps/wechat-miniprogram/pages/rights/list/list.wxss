/* === Rights List — Claude Purple === */

.page-body {
  padding: 24rpx 28rpx;
}

/* ── Header ── */
.header-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ink-main);
}

.btn-new {
  border: none;
  border-radius: var(--radius-pill);
  padding: 0 28rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
  font-weight: 800;
  background: var(--brand-purple);
  color: #139d7f;
  box-shadow: 0 6rpx 18rpx rgba(102, 126, 234, 0.25);
  transition: all 0.2s;
}

.btn-new:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.btn-new::after {
  border: none;
}

/* ── Loading / Empty ── */
.loading-state {
  text-align: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: var(--ink-muted);
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 18rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--ink-muted);
  margin-bottom: 24rpx;
}

.btn-consult {
  border: none;
  border-radius: var(--radius-pill);
  width: 280rpx;
  height: 82rpx;
  line-height: 82rpx;
  font-size: 28rpx;
  font-weight: 800;
  background: var(--brand-purple);
  color: #1a1a2e;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.25);
}

.btn-consult:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-consult::after {
  border: none;
}

/* ── Consultation List ── */
.consultation-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.consultation-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  border: var(--border-soft);
  box-shadow: var(--shadow-md);
  animation: pageFadeIn 0.35s ease both;
  transition: transform 0.2s, box-shadow 0.2s;
}

.consultation-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.issue-type {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
}

.status-badge {
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 700;
}

.status-pending {
  background: rgba(102, 126, 234, 0.1);
  color: var(--brand-purple);
}

.status-processing {
  background: rgba(102, 126, 234, 0.08);
  color: var(--brand-purple);
}

.status-completed {
  background: rgba(49, 164, 124, 0.1);
  color: var(--accent-green);
}

.description {
  display: block;
  font-size: 26rpx;
  color: var(--ink-sub);
  line-height: 1.8;
  margin-bottom: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.created-time {
  display: block;
  font-size: 22rpx;
  color: var(--ink-muted);
}

/* ── Bottom ── */
.page-bottom-gap {
  height: 56rpx;
}

@keyframes pageFadeIn {
  from { opacity: 0; transform: translate3d(0, 16rpx, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}
