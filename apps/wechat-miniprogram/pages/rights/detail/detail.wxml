<view class="page page-enter">
  <view class="page-body">
    <view wx:if="{{loading}}" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:elif="{{consultation}}" class="content">
      <view class="header-card">
        <view class="header-row">
          <text class="issue-type">{{consultation.issueType}}</text>
          <text class="status-badge {{consultation.statusClass}}">{{consultation.statusText}}</text>
        </view>
        <text class="created-time">提交时间：{{consultation.createdAt}}</text>
      </view>

      <view class="info-card">
        <text class="section-title">问题描述</text>
        <text class="info-text">{{consultation.description}}</text>
      </view>

      <view class="info-card">
        <text class="section-title">联系方式</text>
        <text class="info-text">{{consultation.contactPhone}}</text>
      </view>

      <view wx:if="{{consultation.reply}}" class="reply-card">
        <text class="section-title">处理回复</text>
        <text class="reply-text">{{consultation.reply}}</text>
        <text class="reply-time">回复时间：{{consultation.repliedAt}}</text>
      </view>

      <view wx:else class="tips-card">
        <text class="tips-text">工作人员会在1-3个工作日内处理您的咨询，请保持电话畅通</text>
      </view>
    </view>

    <view class="page-bottom-gap"></view>
  </view>
</view>
