/* === Training Detail — Claude Purple === */

.page {
  background: linear-gradient(180deg, #f0f7ff 0%, #e6f0ff 100%) !important;
}

.page-body {
  padding: 24rpx 28rpx;
}

/* ── Loading ── */
.loading-state {
  text-align: center;
  padding: 140rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: var(--ink-muted);
}

/* ── Header Card ── */
.header-card {
  background: linear-gradient(135deg, #4DA6FF 0%, #2563EB 100%);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 40rpx rgba(37, 99, 235, 0.25);
  position: relative;
  overflow: hidden;
}

.header-card::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -15%;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.course-title {
  display: block;
  font-size: 38rpx;
  font-weight: 900;
  color: #ffffff;
  margin-bottom: 18rpx;
  line-height: 1.4;
  position: relative;
  z-index: 1;
}

.course-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  position: relative;
  z-index: 1;
}

.tag {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 700;
}

/* ── Info / Desc Cards ── */
.info-card,
.desc-card {
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
  margin-bottom: 18rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: var(--ink-sub);
}

.info-value {
  font-size: 26rpx;
  color: var(--ink-main);
  font-weight: 700;
  text-align: right;
}

.desc-text {
  display: block;
  font-size: 26rpx;
  color: var(--ink-sub);
  line-height: 1.9;
}

/* ── Action ── */
.action-card {
  margin-bottom: 20rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #2563EB;
  color: #ffffff;
  border-radius: 28rpx;
  font-size: 34rpx;
  font-weight: 900;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.btn-primary[disabled] {
  background: #b8b4c8;
  box-shadow: none;
  color: #ffffff;
}

.btn-primary::after {
  border: none;
}

.enrolled-badge {
  text-align: center;
  padding: 24rpx;
  background: rgba(49, 164, 124, 0.1);
  border-radius: var(--radius-md);
}

.enrolled-text {
  font-size: 28rpx;
  color: var(--accent-green);
  font-weight: 800;
}

/* ── Bottom ── */
.page-bottom-gap {
  height: 56rpx;
}
