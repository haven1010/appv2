<view class="page page-enter">
  <view class="page-body">
    <view class="header-card">
      <text class="header-title">技能培训</text>
      <text class="header-subtitle">提升技能，拓展就业机会</text>
    </view>

    <view class="category-tabs">
      <view
        class="tab-item {{activeCategory === item.id ? 'tab-active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >{{item.name}}</view>
    </view>

    <view wx:if="{{loading}}" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:elif="{{courses.length}}" class="course-list">
      <view
        class="course-card"
        wx:for="{{courses}}"
        wx:key="id"
        style="animation-delay: {{item.delay}};"
        bindtap="goToCourseDetail"
        data-id="{{item.id}}"
      >
        <view class="course-header">
          <text class="course-title">{{item.title}}</text>
          <text class="course-status">{{item.statusText}}</text>
        </view>
        <view class="course-meta">
          <text class="course-category">{{item.category}}</text>
          <text class="course-duration">⏱ {{item.duration}}</text>
        </view>
        <view class="course-footer">
          <button
            wx:if="{{!item.enrolled}}"
            class="btn-enroll"
            data-id="{{item.id}}"
            catchtap="enrollCourse"
          >立即报名</button>
          <text wx:else class="enrolled-text">已报名</text>
        </view>
      </view>
    </view>

    <view wx:else class="empty-state">
      <text class="empty-text">暂无培训课程</text>
    </view>

    <view class="page-bottom-gap"></view>
  </view>
</view>
