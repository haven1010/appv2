/* === Training List — Claude Purple === */

.page-body {
  padding: 24rpx 28rpx;
}

/* ── Header Banner ── */
.header-card {
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  background: var(--brand-gradient);
  border-radius: var(--radius-lg);
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(102, 126, 234, 0.2);
  position: relative;
  overflow: hidden;
}

.header-card::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.header-card::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 900;
  color: #ffffff;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  position: relative;
  z-index: 1;
}

/* ── Category Tabs ── */
.category-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding: 4rpx 0;
}

.tab-item {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  background: var(--card-bg);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  color: var(--ink-sub);
  font-weight: 700;
  border: var(--border-soft);
  transition: all 0.25s;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-active {
  background: var(--brand-gradient);
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.25);
}

/* ── Loading / Empty ── */
.loading-state {
  text-align: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: var(--ink-muted);
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: var(--ink-muted);
}

/* ── Course List ── */
.course-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.course-card {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--shadow-md);
  animation: pageFadeIn 0.35s ease both;
  transition: transform 0.2s, box-shadow 0.2s;
}

.course-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.course-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.course-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink-main);
  line-height: 1.5;
}

.course-status {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  background: rgba(102, 126, 234, 0.1);
  color: var(--brand-purple);
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 700;
}

.course-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.course-category,
.course-duration {
  font-size: 24rpx;
  color: var(--ink-sub);
}

.course-footer {
  display: flex;
  justify-content: flex-end;
}

.btn-enroll {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--brand-purple);
  color: #ffffff;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 800;
  border: none;
  box-shadow: 0 6rpx 18rpx rgba(102, 126, 234, 0.3);
  transition: all 0.2s;
}

.btn-enroll:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.btn-enroll::after {
  border: none;
}

.enrolled-text {
  font-size: 26rpx;
  color: var(--accent-green);
  font-weight: 700;
  padding: 10rpx 20rpx;
  background: rgba(49, 164, 124, 0.1);
  border-radius: var(--radius-pill);
}

/* ── Bottom Gap ── */
.page-bottom-gap {
  height: 56rpx;
}

/* ── Keyframes ── */
@keyframes pageFadeIn {
  from { opacity: 0; transform: translate3d(0, 16rpx, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}
