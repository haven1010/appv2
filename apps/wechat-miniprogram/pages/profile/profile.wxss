.page {
  background-color: #f5efe3;
}

.page-body {
  padding: 24rpx;
  padding-bottom: calc(186rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.profile-card {
  background: linear-gradient(150deg, #fff8e8 0%, #eef8e6 52%, #fcefd9 100%);
}

.profile-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.profile-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #eadfc7;
  border: 4rpx solid #6a994e;
  flex-shrink: 0;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #355528;
}

.identity {
  flex: 1;
  min-width: 0;
}

.name {
  display: block;
  font-size: 40rpx;
  line-height: 1.3;
  color: #333333;
  font-weight: 800;
}

.uid {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: #999999;
}

.role {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #e3f0d0;
  color: #466e34;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 700;
}

.verify-badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #dcecc8;
  color: #466e34;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 700;
  flex-shrink: 0;
}

.profile-tip {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #999999;
}

.stats-card {
  margin-top: 24rpx;
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.stat-item {
  flex: 1;
  min-width: 0;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.75);
  padding: 14rpx 8rpx;
  text-align: center;
}

.stat-icon {
  display: block;
  font-size: 32rpx;
  line-height: 1;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: #999999;
}

.stat-value {
  display: block;
  margin-top: 8rpx;
  font-size: 50rpx;
  line-height: 1.1;
  color: #333333;
  font-weight: 900;
}

.stat-value.income {
  color: #f4a261;
}

.growth-card {
  margin-top: 24rpx;
}

.growth-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.growth-title {
  font-size: 34rpx;
  line-height: 1.35;
  color: #333333;
  font-weight: 800;
}

.growth-hint {
  font-size: 28rpx;
  line-height: 1.5;
  color: #999999;
}

.badge-list {
  margin-top: 14rpx;
  display: flex;
  gap: 10rpx;
}

.badge-item {
  flex: 1;
  min-width: 0;
  border-radius: 18rpx;
  background: #f6f0de;
  padding: 14rpx 10rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.badge-item.active {
  background: #e3f0d0;
}

.badge-icon {
  display: block;
  font-size: 34rpx;
  line-height: 1;
}

.badge-name {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: #666666;
  font-weight: 700;
}

.badge-item.active .badge-name {
  color: #355528;
}

.menu-card {
  margin-top: 24rpx;
  padding: 14rpx;
}

.menu-item {
  border-radius: 18rpx;
  padding: 18rpx 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  transition: transform 220ms ease;
}

.menu-item + .menu-item {
  margin-top: 12rpx;
}

.menu-item-press {
  transform: scale(0.95);
}

.menu-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #e3f0d0;
  color: #466e34;
  font-size: 30rpx;
  line-height: 54rpx;
  text-align: center;
  flex-shrink: 0;
}

.menu-content {
  flex: 1;
  min-width: 0;
}

.menu-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.4;
  color: #333333;
  font-weight: 700;
}

.menu-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: #999999;
}

.menu-arrow {
  font-size: 30rpx;
  color: #a18f78;
}

.logout-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 40rpx;
  background: linear-gradient(90deg, #f4a261 0%, #dd7f42 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  transform: scale(1);
  transition: transform 120ms ease;
}

.logout-btn::after {
  border: none;
}

.logout-btn-press {
  transform: scale(0.95);
}

.delay-1 {
  animation-delay: 80ms;
}

.delay-2 {
  animation-delay: 140ms;
}

.delay-3 {
  animation-delay: 200ms;
}

.page-bottom-gap {
  height: 24rpx;
}
