/* pages/profile/profile.wxss - iOS profile dashboard */

page {
  background: #f5f5f7 !important;
  color: #111111;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.profile-page {
  min-height: 100vh;
  background: #f5f5f7;
}

.profile-hero {
  position: relative;
  min-height: 560rpx;
  padding: calc(30rpx + env(safe-area-inset-top)) 44rpx 48rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 0 0 44rpx 44rpx;
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.06);
  text-align: center;
}

.profile-nav {
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  color: #111111;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 900;
}

.avatar-wrap {
  width: 176rpx;
  height: 176rpx;
  margin: 34rpx auto 0;
  border-radius: 50%;
  background: #f2f2f4;
  border: 2rpx solid rgba(17, 17, 17, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.profile-avatar {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  display: block;
}

.profile-avatar-fallback {
  color: #111111;
  font-size: 68rpx;
  line-height: 176rpx;
  text-align: center;
  font-weight: 900;
}

.profile-mark {
  width: 64rpx;
  height: 6rpx;
  margin: 28rpx auto 0;
  border-radius: 999rpx;
  background: #111111;
}

.profile-name {
  display: block;
  margin-top: 34rpx;
  color: #111111;
  font-size: 42rpx;
  line-height: 1.14;
  font-weight: 900;
  letter-spacing: 0;
}

.profile-role {
  display: block;
  margin-top: 10rpx;
  color: #8e8e93;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 900;
}

.profile-mood {
  display: block;
  max-width: 540rpx;
  margin: 16rpx auto 0;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 700;
}

.profile-body {
  padding: 54rpx 44rpx calc(174rpx + env(safe-area-inset-bottom));
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.section-title {
  color: #111111;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0;
}

.section-arrow {
  color: #111111;
  font-size: 64rpx;
  line-height: 1;
  font-weight: 800;
}

.section-glyph {
  flex-shrink: 0;
}

.stats-glyph {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
}

.stats-glyph view {
  width: 10rpx;
  border-radius: 999rpx;
  background: #111111;
}

.stats-glyph view:nth-child(1) { height: 24rpx; background: #8e8e93; }
.stats-glyph view:nth-child(2) { height: 44rpx; background: #111111; }
.stats-glyph view:nth-child(3) { height: 32rpx; background: #c7c7cc; }

.stats-grid {
  margin-top: 34rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 34rpx;
}

.stat-card {
  width: 314rpx;
  min-height: 264rpx;
  padding: 30rpx 28rpx 28rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(17, 17, 17, 0.06);
  box-shadow: 0 16rpx 30rpx rgba(15, 23, 42, 0.055);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  position: relative;
  overflow: hidden;
}

.stat-card::after {
  content: '';
  position: absolute;
  right: -42rpx;
  top: -42rpx;
  width: 146rpx;
  height: 146rpx;
  border-radius: 50%;
  opacity: 0.045;
}

.stat-card-pending {
  background: rgba(255, 255, 255, 0.96);
  border-color: rgba(17, 17, 17, 0.06);
}

.stat-card-income {
  background: rgba(255, 255, 255, 0.96);
  border-color: rgba(17, 17, 17, 0.06);
}

.stat-card-days {
  background: rgba(255, 255, 255, 0.96);
  border-color: rgba(17, 17, 17, 0.06);
}

.stat-card-hours {
  background: rgba(255, 255, 255, 0.96);
  border-color: rgba(17, 17, 17, 0.06);
}

.stat-card-pending::after,
.stat-card-income::after,
.stat-card-days::after,
.stat-card-hours::after { background: #111111; }

.card-press {
  opacity: 0.78;
  transform: scale(0.985);
}

.stat-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 900;
  position: relative;
  z-index: 1;
  box-shadow: 0 10rpx 22rpx rgba(17, 17, 17, 0.12);
}

.income-icon {
  background: #111111;
}

.days-icon {
  background: #111111;
  font-size: 32rpx;
}

.hours-icon {
  background: #111111;
  color: #ffffff;
  font-size: 34rpx;
}

.pending-icon {
  background: #111111;
  font-size: 32rpx;
}

.stat-rule {
  width: 64rpx;
  height: 6rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #e5e5ea;
}

.stat-card-pending .stat-rule,
.stat-card-income .stat-rule,
.stat-card-days .stat-rule,
.stat-card-hours .stat-rule { background: #e5e5ea; }

.stat-card-pending .stat-value,
.stat-card-income .stat-value,
.stat-card-days .stat-value,
.stat-card-hours .stat-value { color: #111111; }

.stat-card-pending .stat-label,
.stat-card-income .stat-label,
.stat-card-days .stat-label,
.stat-card-hours .stat-label { color: #8e8e93; }

.stat-value {
  display: block;
  max-width: 100%;
  margin-top: 22rpx;
  color: #111111;
  font-size: 38rpx;
  line-height: 1.08;
  font-weight: 900;
  overflow-wrap: anywhere;
  letter-spacing: 0;
}

.stat-label {
  display: block;
  margin-top: 12rpx;
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 1.28;
  font-weight: 800;
}

.calendar-head {
  margin-top: 76rpx;
}

.calendar-glyph {
  position: relative;
  width: 48rpx;
  height: 42rpx;
  border-radius: 12rpx;
  border: 6rpx solid #111111;
  box-sizing: border-box;
}

.calendar-glyph::before,
.calendar-glyph::after {
  content: '';
  position: absolute;
  top: -14rpx;
  width: 7rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #111111;
}

.calendar-glyph::before { left: 9rpx; }
.calendar-glyph::after { right: 9rpx; }

.calendar-card {
  margin-top: 30rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(17, 17, 17, 0.06);
  box-shadow: 0 18rpx 34rpx rgba(15, 23, 42, 0.055);
  overflow: hidden;
}

.calendar-days {
  min-height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-bottom: 2rpx solid #edf0f4;
}

.calendar-day {
  flex: 1;
  min-width: 0;
  min-height: 150rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.calendar-day.active::before {
  content: '';
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 0;
  height: 10rpx;
  background: #111111;
}

.calendar-num {
  color: #111111;
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 900;
}

.calendar-week {
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 800;
}

.calendar-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  background: transparent;
}

.calendar-dot.active {
  background: #111111;
}

.calendar-footer {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.calendar-footer text {
  color: #8e8e93;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 900;
}

.calendar-footer-icon {
  width: 38rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.calendar-footer-icon view {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #111111;
}

.settings-card {
  margin-top: 34rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(17, 17, 17, 0.06);
  box-shadow: 0 18rpx 34rpx rgba(15, 23, 42, 0.055);
  overflow: hidden;
}

.settings-row {
  min-height: 118rpx;
  padding: 28rpx 34rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.settings-divider {
  height: 2rpx;
  margin: 0 34rpx;
  background: #edf0f4;
}

.settings-copy {
  display: flex;
  flex-direction: column;
}

.settings-title {
  color: #111111;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 900;
}

.settings-desc {
  margin-top: 10rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 800;
}

.settings-arrow {
  color: #c7c7cc;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 800;
}

.page-bottom-gap {
  height: 14rpx;
}
