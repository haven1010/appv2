/* pages/profile/profile.wxss — Claude Purple Theme */
.worker-profile-page {
  background: var(--page-bg);
}

.worker-profile-body {
  padding: 28rpx 24rpx calc(176rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.profile-stats,
.profile-menu {
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.profile-hero {
  padding: 30rpx 26rpx;
  position: relative;
  overflow: hidden;
}

.profile-hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: var(--brand-gradient);
}

.profile-hero::after {
  content: '';
  position: absolute;
  right: -30rpx;
  top: -30rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.06) 0%, transparent 70%);
  pointer-events: none;
}

.profile-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.profile-avatar {
  width: 118rpx;
  height: 118rpx;
  border-radius: 50%;
  background: var(--card-bg-soft);
  border: 6rpx solid rgba(102, 126, 234, 0.14);
  flex-shrink: 0;
}

.profile-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
  color: var(--brand-purple);
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 42rpx;
  line-height: 1.3;
  color: var(--ink-main);
  font-weight: 900;
}

.profile-uid {
  display: block;
  margin-top: 8rpx;
  font-size: 27rpx;
  color: var(--ink-sub);
}

.profile-role {
  display: inline-flex;
  margin-top: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  background: rgba(102, 126, 234, 0.1);
  color: var(--brand-purple);
  font-size: 26rpx;
  font-weight: 700;
}

.profile-note {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink-sub);
}

.profile-stats {
  margin-top: 22rpx;
  padding: 24rpx 20rpx;
  display: flex;
  gap: 12rpx;
  position: relative;
  overflow: hidden;
}

.profile-stats::after {
  content: '';
  position: absolute;
  left: -20rpx;
  bottom: -20rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.04) 0%, transparent 70%);
  pointer-events: none;
}

.profile-stat-item {
  flex: 1;
  min-width: 0;
  border-radius: 22rpx;
  background: var(--card-bg-soft);
  padding: 18rpx 10rpx;
  text-align: center;
}

.profile-stat-label {
  display: block;
  font-size: 26rpx;
  color: var(--ink-sub);
}

.profile-stat-value {
  display: block;
  margin-top: 10rpx;
  font-size: 46rpx;
  line-height: 1.15;
  color: var(--ink-main);
  font-weight: 900;
}

.profile-stat-value.accent {
  color: var(--brand-purple);
}

.profile-menu {
  margin-top: 22rpx;
  padding: 18rpx;
}

.profile-menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 16rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg-soft);
  border: var(--border-soft);
  transition: transform 0.2s, opacity 0.2s;
}

.profile-menu-item + .profile-menu-item {
  margin-top: 14rpx;
}

.profile-menu-item.strong {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.06), rgba(118, 75, 162, 0.04));
  position: relative;
  overflow: hidden;
}

.profile-menu-item.strong::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  height: 60%;
  width: 4rpx;
  border-radius: 2rpx;
  background: var(--brand-gradient);
  opacity: 0.4;
}

.profile-menu-press {
  transform: scale(0.97);
  opacity: 0.96;
}

.profile-menu-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.icon-blue { background: var(--brand-gradient); }
.icon-green { background: linear-gradient(145deg, #2f9e78 0%, #4dbf97 100%); }
.icon-cyan { background: linear-gradient(145deg, #1795ff 0%, #4db8ff 100%); }
.icon-indigo { background: linear-gradient(145deg, #5f6fff 0%, #8592ff 100%); }
.icon-orange { background: linear-gradient(145deg, #f49a39 0%, #ffb35c 100%); }

.profile-menu-copy {
  flex: 1;
  min-width: 0;
}

.profile-menu-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.4;
  color: var(--ink-main);
  font-weight: 800;
}

.profile-menu-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: var(--ink-sub);
}

.profile-menu-arrow {
  color: var(--brand-purple);
  font-size: 26rpx;
  font-weight: 700;
}

.senior-logout-btn {
  margin-top: 32rpx;
  height: auto;
  line-height: 1.5;
  padding: 24rpx 0;
  border-radius: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-main);
  background: transparent !important;
  box-shadow: none !important;
  border-top: 2rpx solid rgba(0, 0, 0, 0.06);
}

.logout-btn-press {
  transform: scale(0.97);
}

.card-in {
  animation: fadeUp 0.4s ease both;
}

.delay-1 { animation-delay: 80ms; }
.delay-2 { animation-delay: 140ms; }
.delay-3 { animation-delay: 200ms; }
