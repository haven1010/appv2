<view class="page profile-page">
  <view class="profile-hero">
    <view class="profile-nav">
      <text class="nav-title">个人中心</text>
    </view>

    <view class="avatar-wrap">
      <image wx:if="{{avatarUrl}}" class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
      <view wx:else class="profile-avatar profile-avatar-fallback">{{displayInitial}}</view>
    </view>

    <view class="profile-mark"></view>
    <text class="profile-name">{{displayName}}</text>
    <text class="profile-role">{{roleText}}</text>
    <text class="profile-mood">{{profileMoodText}}</text>
  </view>

  <view class="profile-body">
    <view class="section-head">
      <view class="section-title-wrap">
        <view class="section-glyph stats-glyph" aria-hidden="true">
          <view></view>
          <view></view>
          <view></view>
        </view>
        <text class="section-title">数据统计</text>
      </view>
      <text class="section-arrow" bindtap="goSalary">›</text>
    </view>

    <view class="stats-grid">
      <view class="stat-card stat-card-pending" bindtap="goSalary" hover-class="card-press">
        <view class="stat-icon pending-icon">待</view>
        <view class="stat-rule"></view>
        <text class="stat-value">¥{{pendingAmountText}}</text>
        <text class="stat-label">待确认工资</text>
      </view>

      <view class="stat-card stat-card-income" bindtap="goSalary" hover-class="card-press">
        <view class="stat-icon income-icon">¥</view>
        <view class="stat-rule"></view>
        <text class="stat-value">¥{{totalIncomeText}}</text>
        <text class="stat-label">累计收入</text>
      </view>

      <view class="stat-card stat-card-days" bindtap="showWorkHistory" hover-class="card-press">
        <view class="stat-icon days-icon">天</view>
        <view class="stat-rule"></view>
        <text class="stat-value">{{totalWorkDaysText}}</text>
        <text class="stat-label">累计工作天数</text>
      </view>

      <view class="stat-card stat-card-hours" bindtap="showWorkHistory" hover-class="card-press">
        <view class="stat-icon hours-icon">h</view>
        <view class="stat-rule"></view>
        <text class="stat-value">{{totalWorkHoursText}}</text>
        <text class="stat-label">累计工作小时</text>
      </view>
    </view>

    <view class="section-head calendar-head">
      <view class="section-title-wrap">
        <view class="section-glyph calendar-glyph" aria-hidden="true"></view>
        <text class="section-title">工作日历</text>
      </view>
      <text class="section-arrow" bindtap="showWorkHistory">›</text>
    </view>

    <view class="calendar-card" bindtap="showWorkHistory" hover-class="card-press">
      <view class="calendar-days">
        <view wx:for="{{calendarDays}}" wx:key="key" class="calendar-day {{item.active ? 'active' : ''}}">
          <text class="calendar-num">{{item.day}}</text>
          <text class="calendar-week">{{item.week}}</text>
          <view class="calendar-dot {{item.active ? 'active' : ''}}"></view>
        </view>
      </view>
      <view class="calendar-footer">
        <view class="calendar-footer-icon">
          <view></view>
          <view></view>
          <view></view>
          <view></view>
          <view></view>
          <view></view>
        </view>
        <text>查看工作历史</text>
      </view>
    </view>

    <view class="settings-card">
      <view class="settings-row" bindtap="goSalaryCard" hover-class="card-press">
        <view class="settings-copy">
          <text class="settings-title">银行卡</text>
          <text class="settings-desc">工资收款账户管理</text>
        </view>
        <text class="settings-arrow">›</text>
      </view>
      <view class="settings-divider"></view>
      <view class="settings-row" bindtap="goSettings" hover-class="card-press">
        <view class="settings-copy">
          <text class="settings-title">账号设置</text>
          <text class="settings-desc">个人信息、账号与退出</text>
        </view>
        <text class="settings-arrow">›</text>
      </view>
    </view>

    <view class="page-bottom-gap"></view>
  </view>
</view>
