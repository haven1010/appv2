<view class="page worker-profile-page">
  <view class="page-body worker-profile-body {{pageReady ? 'page-enter' : ''}}">
    <view class="profile-hero card-in">
      <view class="profile-main">
        <image wx:if="{{avatarUrl}}" class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
        <view wx:else class="profile-avatar profile-avatar-fallback">{{displayInitial}}</view>
        <view class="profile-copy">
          <text class="profile-name">{{displayName}}</text>
          <text class="profile-uid">UID：{{displayUid}}</text>
          <text class="profile-role">{{roleText}}</text>
        </view>
      </view>
      <text class="profile-note">{{profileMoodText}}</text>
    </view>

    <view class="profile-stats card-in delay-1">
      <view class="profile-stat-item">
        <text class="profile-stat-label">工作天数</text>
        <text class="profile-stat-value">{{workDaysText}}</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-label">累计收入</text>
        <text class="profile-stat-value accent">¥{{totalIncomeText}}</text>
      </view>
      <view class="profile-stat-item">
        <text class="profile-stat-label">我的报名</text>
        <text class="profile-stat-value">{{signupCountText}}</text>
      </view>
    </view>

    <view class="profile-menu card-in delay-2">
      <view class="profile-menu-item strong" hover-class="profile-menu-press" hover-stay-time="100" bindtap="goSalary">
        <view class="profile-menu-icon icon-blue">薪</view>
        <view class="profile-menu-copy">
          <text class="profile-menu-title">收入与工资</text>
          <text class="profile-menu-desc">查看工资、确认金额、发起申诉</text>
        </view>
        <text class="profile-menu-arrow">></text>
      </view>

      <view class="profile-menu-item strong" hover-class="profile-menu-press" hover-stay-time="100" bindtap="goMySignups">
        <view class="profile-menu-icon icon-green">报</view>
        <view class="profile-menu-copy">
          <text class="profile-menu-title">我的报名</text>
          <text class="profile-menu-desc">查看岗位报名、进度和状态</text>
        </view>
        <text class="profile-menu-arrow">></text>
      </view>

      <view class="profile-menu-item" hover-class="profile-menu-press" hover-stay-time="100" bindtap="goSalaryCard">
        <view class="profile-menu-icon icon-cyan">卡</view>
        <view class="profile-menu-copy">
          <text class="profile-menu-title">银行卡</text>
          <text class="profile-menu-desc">工资收款账户管理</text>
        </view>
        <text class="profile-menu-arrow">></text>
      </view>

      <view class="profile-menu-item" hover-class="profile-menu-press" hover-stay-time="100" bindtap="goBasicInfo">
        <view class="profile-menu-icon icon-indigo">档</view>
        <view class="profile-menu-copy">
          <text class="profile-menu-title">基本信息</text>
          <text class="profile-menu-desc">姓名、电话、地址和实名资料</text>
        </view>
        <text class="profile-menu-arrow">></text>
      </view>

      <view class="profile-menu-item" hover-class="profile-menu-press" hover-stay-time="100" bindtap="showWorkHistory">
        <view class="profile-menu-icon icon-orange">史</view>
        <view class="profile-menu-copy">
          <text class="profile-menu-title">工作历史</text>
          <text class="profile-menu-desc">查看签到记录和工作时间线</text>
        </view>
        <text class="profile-menu-arrow">></text>
      </view>
    </view>

    <button class="btn-danger senior-logout-btn card-in delay-3" hover-class="logout-btn-press" hover-stay-time="100" bindtap="logout">退出登录</button>

    <view class="page-bottom-gap"></view>
  </view>
</view>
