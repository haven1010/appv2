<view class="page page-enter">
  <view class="settings-hero">
    <text class="hero-title">账号设置</text>
    <text class="hero-subtitle">管理提醒、隐私和本地缓存</text>
  </view>

  <view class="group-title">通知偏好</view>
  <view class="setting-list">
    <view class="setting-item">
      <view>
        <view class="item-title">岗位进度提醒</view>
        <view class="item-desc">报名状态变化时推送提醒</view>
      </view>
      <switch color="#111111" checked="{{notifyJob}}" bindchange="onSwitchJob" />
    </view>
    <view class="setting-item">
      <view>
        <view class="item-title">工资到账提醒</view>
        <view class="item-desc">待确认或到账时发送通知</view>
      </view>
      <switch color="#111111" checked="{{notifySalary}}" bindchange="onSwitchSalary" />
    </view>
  </view>

  <view class="group-title">隐私与性能</view>
  <view class="setting-list">
    <view class="setting-item">
      <view>
        <view class="item-title">敏感信息默认脱敏</view>
        <view class="item-desc">手机号、银行卡号默认隐藏</view>
      </view>
      <switch color="#111111" checked="{{privacyMask}}" bindchange="onSwitchPrivacy" />
    </view>
    <view class="setting-item">
      <view>
        <view class="item-title">低流量模式</view>
        <view class="item-desc">减少图片与动画加载</view>
      </view>
      <switch color="#111111" checked="{{lowDataMode}}" bindchange="onSwitchLowData" />
    </view>
  </view>

  <view class="group-title">存储与帮助</view>
  <view class="setting-list">
    <view class="setting-item plain">
      <view>
        <view class="item-title">当前缓存</view>
        <view class="item-desc">{{cacheSize}}</view>
      </view>
      <button class="mini-btn" bindtap="clearCache">清理</button>
    </view>
    <view class="setting-item plain" bindtap="contactSupport">
      <view>
        <view class="item-title">技术支持</view>
        <view class="item-desc">反馈问题与建议</view>
      </view>
      <text class="arrow">></text>
    </view>
  </view>

  <view class="group-title">账号</view>
  <view class="setting-list danger-list">
    <view class="setting-item plain" bindtap="logout">
      <view>
        <view class="item-title danger-title">退出当前账号</view>
        <view class="item-desc">退出后需要重新登录</view>
      </view>
      <text class="arrow danger-arrow">></text>
    </view>
  </view>
</view>
