/* pages/profile/settings/settings.wxss — Claude Purple Theme */
.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: var(--page-bg);
}

.card {
  background: var(--card-bg);
  border: var(--border-soft);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.brand-head {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-logo {
  width: 62rpx;
  height: 62rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.2);
}

.brand-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink-main);
}

.brand-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-sub);
}

.group-title {
  margin: 18rpx 0 12rpx;
  font-size: 28rpx;
  color: var(--ink-main);
  font-weight: 800;
}

.setting-list,
.action-list {
  overflow: hidden;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx;
  border-bottom: 1rpx solid rgba(102, 126, 234, 0.06);
}

.setting-item:last-child {
  border-bottom: none;
}

.item-title {
  font-size: 28rpx;
  color: var(--ink-main);
  font-weight: 700;
}

.item-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-sub);
}

.setting-item.plain {
  background: transparent;
}

.mini-btn {
  min-width: 104rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: var(--brand-purple);
  border: none;
  padding: 0 20rpx;
}

.mini-btn::after {
  border: none;
}

.arrow {
  font-size: 28rpx;
  color: var(--ink-muted);
}

switch {
  --switch-color: var(--brand-purple);
}
