/* pages/profile/settings/settings.wxss — iOS-style settings */
page {
  background: #f5f5f7 !important;
  color: #111111;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(188rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f5f5f7;
}

.settings-hero {
  padding: 30rpx 4rpx 18rpx;
}

.hero-title {
  display: block;
  color: #111111;
  font-size: 46rpx;
  line-height: 1.1;
  font-weight: 900;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #8e8e93;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
}

.group-title {
  margin: 30rpx 10rpx 14rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 900;
}

.setting-list {
  overflow: hidden;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.05);
}

.setting-item {
  min-height: 116rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background: #f7f7f8;
}

.item-title {
  color: #111111;
  font-size: 31rpx;
  line-height: 1.22;
  font-weight: 900;
}

.item-desc {
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 700;
}

.mini-btn {
  min-width: 108rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border: none;
  border-radius: 999rpx;
  background: #f2f2f4;
  color: #111111;
  font-size: 25rpx;
  line-height: 60rpx;
  font-weight: 900;
}

.mini-btn::after {
  border: none;
}

.arrow {
  color: #c7c7cc;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 700;
}

.danger-title,
.danger-arrow {
  color: #ff3b30;
}

switch {
  transform: scale(0.82);
}
