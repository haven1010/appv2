/* pages/profile/settings/settings.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 84% -8%, rgba(46, 143, 77, 0.16) 0%, rgba(46, 143, 77, 0) 34%),
    radial-gradient(circle at 8% 8%, rgba(231, 168, 58, 0.14) 0%, rgba(231, 168, 58, 0) 30%),
    linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
}

.card {
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(45, 115, 199, 0.16);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(45, 115, 199, 0.1);
}

.brand-head {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-logo {
  width: 62rpx;
  height: 62rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.2);
}

.brand-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #153457;
}

.brand-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6a87a0;
}

.group-title {
  margin: 18rpx 0 12rpx;
  font-size: 28rpx;
  color: #1f4569;
  font-weight: 800;
}

.setting-list,
.action-list {
  overflow: hidden;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx;
  border-bottom: 1rpx solid rgba(45, 115, 199, 0.14);
}

.setting-item:last-child {
  border-bottom: none;
}

.item-title {
  font-size: 28rpx;
  color: #153457;
  font-weight: 700;
}

.item-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6f8aa2;
}

.setting-item.plain {
  background: transparent;
}

.mini-btn {
  min-width: 104rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 62%, #1f5ca9 100%);
  border: none;
  padding: 0 20rpx;
}

.mini-btn::after {
  border: none;
}

.arrow {
  font-size: 28rpx;
  color: #90a7bb;
}
