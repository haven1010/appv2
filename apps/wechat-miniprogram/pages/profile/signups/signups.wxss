/* pages/profile/signups/signups.wxss — iOS-style signup records */
page {
  background: #f5f5f7 !important;
  color: #111111;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.page {
  min-height: 100vh;
  background: #f5f5f7;
}

.page-body {
  padding: 28rpx 28rpx calc(188rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ds-card,
.hero-card,
.filter-card,
.state-card,
.ds-empty,
.record-card {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 18rpx 44rpx rgba(15, 23, 42, 0.06);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.card-in {
  animation: fadeUp 0.36s ease both;
}

.delay-1 { animation-delay: 70ms; }
.delay-2 { animation-delay: 120ms; }

.hero-card {
  position: relative;
  overflow: hidden;
  border-radius: 38rpx;
  padding: 34rpx 32rpx 30rpx;
}

.hero-card::before {
  content: '';
  position: absolute;
  right: -110rpx;
  top: -140rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 122, 255, 0.16) 0%, rgba(0, 122, 255, 0) 68%);
  pointer-events: none;
}

.hero-title {
  position: relative;
  z-index: 1;
  display: block;
  color: #111111;
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 900;
  letter-spacing: 0;
}

.hero-subtitle {
  position: relative;
  z-index: 1;
  display: block;
  max-width: 520rpx;
  margin-top: 12rpx;
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 1.42;
  font-weight: 700;
}

.hero-stats {
  position: relative;
  z-index: 1;
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.hero-stat {
  min-width: 0;
  min-height: 142rpx;
  padding: 20rpx 16rpx;
  border-radius: 26rpx;
  background: #f7f7f8;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hero-value {
  display: block;
  color: #111111;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 900;
  overflow-wrap: anywhere;
}

.hero-label {
  display: block;
  color: #8e8e93;
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 800;
}

.filter-card {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 34rpx;
}

.search-input {
  width: 100%;
  min-height: 82rpx;
  box-sizing: border-box;
  border: none;
  border-radius: 24rpx;
  background: #f2f2f4;
  color: #111111;
  font-size: 28rpx;
  line-height: 82rpx;
  font-weight: 800;
  padding: 0 26rpx;
}

.filter-row {
  margin-top: 18rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #f2f2f4;
  display: flex;
  gap: 6rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-chip {
  flex-shrink: 0;
  min-height: 58rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #6f7278;
  font-size: 25rpx;
  line-height: 58rpx;
  font-weight: 900;
  transition: all 0.2s;
}

.filter-chip.active {
  background: #ffffff;
  color: #111111;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.08);
}

.state-card,
.ds-empty {
  margin-top: 22rpx;
  border-radius: 34rpx;
  padding: 56rpx 34rpx;
  text-align: center;
}

.state-card::before {
  content: '';
  display: block;
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #111111;
  box-shadow: 0 0 0 18rpx rgba(17, 17, 17, 0.06);
  animation: signupPulse 1.2s ease-in-out infinite;
}

.state-title,
.ds-empty-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 900;
}

.state-desc,
.ds-empty-desc {
  display: block;
  max-width: 520rpx;
  margin: 12rpx auto 0;
  color: #8e8e93;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 700;
}

.ds-empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 26rpx;
  border-radius: 28rpx;
  background: #f2f2f4;
  color: #111111;
  font-size: 0;
  line-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ds-empty-icon::before {
  content: '';
  width: 42rpx;
  height: 50rpx;
  border-radius: 10rpx;
  border: 6rpx solid #111111;
  box-sizing: border-box;
}

.record-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.record-card {
  border-radius: 34rpx;
  padding: 30rpx;
}

.record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.record-base {
  flex: 1;
  min-width: 0;
  color: #111111;
  font-size: 33rpx;
  line-height: 1.25;
  font-weight: 900;
}

.status-badge {
  flex-shrink: 0;
  min-width: 100rpx;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 900;
  text-align: center;
}

.status-pending {
  background: #fff4cc;
  color: #9a6700;
}

.status-ok {
  background: #ddf8e7;
  color: #16853f;
}

.status-warn {
  background: #ffe4e4;
  color: #c22a2a;
}

.status-muted {
  background: #ededee;
  color: #6f7278;
}

.status-completed {
  background: #e6f0ff;
  color: #0066cc;
}

.record-job {
  display: block;
  margin-top: 14rpx;
  color: #5f6368;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 800;
}

.record-meta {
  margin-top: 12rpx;
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 1.4;
  font-weight: 700;
}

.record-actions {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  justify-content: flex-end;
}

.record-cancel-btn,
.record-qr-btn,
.record-detail-btn {
  min-width: 168rpx;
  height: 76rpx;
  margin: 0;
  padding: 0 24rpx;
  border: none;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 900;
}

.record-cancel-btn {
  background: #ffe4e4;
  color: #c22a2a;
}

.record-qr-btn {
  background: #111111;
  color: #ffffff;
}

.record-detail-btn {
  background: #f2f2f4;
  color: #111111;
}

.record-cancel-btn::after,
.record-qr-btn::after,
.record-detail-btn::after {
  border: none;
}

.record-cancel-btn:active,
.record-qr-btn:active,
.record-detail-btn:active {
  opacity: 0.74;
}

.action-row {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.mini-btn {
  min-width: 0;
  height: 88rpx;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  line-height: 1;
  font-weight: 900;
}

.mini-btn::after {
  border: none;
}

.btn-ghost {
  background: #ffffff;
  color: #111111;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.04);
}

.btn-primary {
  background: #111111;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.12);
}

.safe-bottom-space {
  height: 24rpx;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes signupPulse {
  0%, 100% { transform: scale(0.92); opacity: 0.72; }
  50% { transform: scale(1); opacity: 1; }
}
