/* pages/profile/signups/signups.wxss — Claude Purple Theme */
.page {
  background: var(--page-bg);
}

.page-body {
  padding: 24rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* Shared card classes */
.ds-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  border: var(--border-soft);
}

.card-in {
  animation: fadeUp 0.4s ease both;
}

.delay-1 { animation-delay: 80ms; }
.delay-2 { animation-delay: 140ms; }

.hero-card {
  background: linear-gradient(150deg, var(--card-bg) 0%, rgba(244, 248, 255, 0.96) 52%, rgba(238, 244, 255, 0.98) 100%);
}

.hero-title {
  display: block;
  font-size: 38rpx;
  line-height: 1.3;
  color: var(--ink-main);
  font-weight: 900;
}

.hero-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink-sub);
}

.hero-stats {
  margin-top: 14rpx;
  display: flex;
  gap: 10rpx;
}

.hero-stat {
  flex: 1;
  min-width: 0;
  text-align: center;
  background: var(--card-bg-soft);
  border-radius: var(--radius-sm);
  padding: 12rpx 8rpx;
}

.hero-value {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: var(--brand-purple);
}

.hero-label {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-sub);
}

.filter-card {
  margin-top: 20rpx;
}

.search-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  border-radius: var(--radius-md);
  background: #f5f2ff;
  border: var(--border-soft);
  padding: 0 22rpx;
  font-size: 28rpx;
  color: var(--ink-main);
  transition: all 0.25s;
}

.search-input:focus {
  border-color: var(--brand-purple);
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.filter-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.filter-chip {
  padding: 10rpx 18rpx;
  border-radius: var(--radius-pill);
  background: rgba(102, 126, 234, 0.1);
  color: var(--ink-sub);
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  transition: all 0.2s;
}

.filter-chip.active {
  background: var(--brand-purple);
  color: #ffffff;
}

.state-card {
  margin-top: 20rpx;
  text-align: center;
}

.state-title {
  display: block;
  font-size: 32rpx;
  color: var(--ink-main);
  font-weight: 800;
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ink-sub);
}

.ds-empty {
  padding: 60rpx 32rpx;
  text-align: center;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  border: var(--border-soft);
}

.ds-empty-icon {
  display: block;
  font-size: 64rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.ds-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
}

.ds-empty-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ink-sub);
}

.record-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.record-card {
  padding: 24rpx;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.record-base {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 900;
  color: var(--ink-main);
}

.status-badge {
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 700;
}

.status-pending {
  background: rgba(102, 126, 234, 0.1);
  color: var(--brand-purple);
}

.status-ok {
  background: rgba(49, 164, 124, 0.1);
  color: var(--accent-green);
}

.status-warn {
  background: rgba(228, 92, 109, 0.1);
  color: var(--accent-red);
}

.status-muted {
  background: rgba(142, 150, 168, 0.1);
  color: var(--ink-sub);
}

.record-job {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #4a4d5e;
}

.record-meta {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--ink-sub);
  line-height: 1.5;
}

.record-actions {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: flex-end;
}

.record-cancel-btn,
.record-qr-btn,
.record-detail-btn {
  margin: 0;
  min-width: 180rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 800;
  border: none;
  transition: all 0.2s;
}

.record-cancel-btn {
  background: rgba(228, 92, 109, 0.1);
  color: var(--accent-red);
}

.record-qr-btn,
.record-detail-btn {
  background: rgba(102, 126, 234, 0.1);
  color: var(--brand-purple);
}

.record-cancel-btn::after,
.record-qr-btn::after,
.record-detail-btn::after {
  border: none;
}

.action-row {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
}

.mini-btn {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
