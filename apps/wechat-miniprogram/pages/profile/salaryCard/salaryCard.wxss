/* pages/profile/salaryCard/salaryCard.wxss — Claude Purple Theme */
.page {
  min-height: 100vh;
  position: relative;
  background: var(--page-bg);
  opacity: 0;
  transform: translateY(18rpx);
  transition: opacity 260ms ease, transform 260ms ease;
}

.page.page-enter {
  opacity: 1;
  transform: translateY(0);
}

.paper-bg {
  display: none;
}

.container {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 24rpx calc(42rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card-zone,
.salary-card,
.empty-card,
.edit-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: var(--border-soft);
  box-shadow: var(--shadow-md);
}

.card-swiper {
  height: 336rpx;
}

swiper-item {
  box-sizing: border-box;
  padding: 4rpx;
}

.bank-card {
  height: 320rpx;
  border-radius: var(--radius-lg);
  box-sizing: border-box;
  padding: 30rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  color: #1a1a2e;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.bank-card.theme-abc,
.bank-card.theme-ccb,
.bank-card.theme-default {
  background: var(--brand-gradient);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bank-name {
  font-size: 34rpx;
  font-weight: 700;
}

.card-tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  background: rgba(0, 0, 0, 0.06);
}

.card-no {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.2;
  word-break: break-all;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.bottom-col.right {
  text-align: right;
}

.bottom-label {
  display: block;
  font-size: 22rpx;
  color: #8a94a6;
}

.bottom-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.dot-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(102, 126, 234, 0.18);
}

.dot.active {
  background: var(--brand-purple);
  transform: scale(1.08);
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.action-btn,
.save-btn {
  border: none;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 800;
}

.action-btn {
  flex: 1;
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after,
.save-btn::after {
  border: none;
}

.action-ghost {
  color: var(--brand-purple);
  background: rgba(102, 126, 234, 0.08);
}

.action-primary,
.save-btn {
  color: #1a1a2e;
  background: var(--brand-purple);
}

.salary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.salary-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink-main);
}

.salary-link {
  font-size: 24rpx;
  color: var(--brand-purple);
}

.salary-body {
  margin-top: 18rpx;
  background: rgba(102, 126, 234, 0.08);
  border-radius: var(--radius-md);
  padding: 20rpx;
}

.amount {
  display: block;
  font-size: 56rpx;
  line-height: 1.15;
  font-weight: 900;
  color: var(--brand-purple);
}

.amount-pop {
  animation: pop 0.4s ease;
}

.salary-meta {
  margin-top: 12rpx;
  display: block;
  font-size: 26rpx;
  color: var(--ink-sub);
}

.salary-empty {
  margin-top: 18rpx;
  border-radius: var(--radius-md);
  padding: 30rpx 20rpx;
  text-align: center;
  background: var(--card-bg-soft);
}

.salary-empty-icon,
.empty-icon {
  display: block;
  font-size: 56rpx;
}

.salary-empty-title,
.empty-title {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
}

.salary-empty-desc,
.empty-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-sub);
}

.edit-title {
  font-size: 30rpx;
  color: var(--ink-main);
  font-weight: 800;
  margin-bottom: 18rpx;
}

.edit-item {
  margin-top: 14rpx;
}

.edit-label {
  display: block;
  font-size: 26rpx;
  color: #4a4d5e;
  margin-bottom: 8rpx;
  font-weight: 700;
}

.edit-input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: #f5f2ff;
  border: var(--border-soft);
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--ink-main);
  transition: all 0.25s;
}

.edit-input:focus {
  border-color: var(--brand-purple);
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.save-btn {
  margin-top: 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes pop {
  0% {
    transform: scale(0.8);
    opacity: 0;
  }
  60% {
    transform: scale(1.1);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}
