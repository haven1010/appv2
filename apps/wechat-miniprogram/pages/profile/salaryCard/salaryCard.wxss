/* pages/profile/salaryCard/salaryCard.wxss — iOS-style bank card */
page {
  background: #f5f5f7 !important;
  color: #111111;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.page {
  min-height: 100vh;
  position: relative;
  background: #f5f5f7;
  opacity: 0;
  transform: translateY(18rpx);
  transition: opacity 260ms ease, transform 260ms ease;
}

.page.page-enter {
  opacity: 1;
  transform: translateY(0);
}

.paper-bg {
  display: none;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 28rpx calc(188rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.card-zone,
.salary-card,
.empty-card,
.edit-card {
  border-radius: 34rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 18rpx 44rpx rgba(15, 23, 42, 0.06);
}

.card-swiper {
  height: 338rpx;
}

swiper-item {
  box-sizing: border-box;
  padding: 4rpx;
}

.bank-card {
  height: 320rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  padding: 30rpx;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  position: relative;
  box-shadow: 0 20rpx 44rpx rgba(15, 23, 42, 0.16);
}

.bank-card::before {
  content: '';
  position: absolute;
  right: -110rpx;
  top: -110rpx;
  width: 310rpx;
  height: 310rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.13);
}

.bank-card.theme-abc {
  background: linear-gradient(135deg, #111111 0%, #1f6f43 100%);
}

.bank-card.theme-ccb {
  background: linear-gradient(135deg, #111111 0%, #1d5fd1 100%);
}

.bank-card.theme-default {
  background: linear-gradient(135deg, #111111 0%, #4a4a4f 100%);
}

.card-top,
.card-bottom,
.card-no {
  position: relative;
  z-index: 1;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.bank-name {
  color: #ffffff;
  font-size: 33rpx;
  line-height: 1.2;
  font-weight: 900;
}

.card-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 800;
}

.card-no {
  color: #ffffff;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 2rpx;
  word-break: break-all;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.bottom-col.right {
  text-align: right;
}

.bottom-label {
  display: block;
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 800;
}

.bottom-value {
  display: block;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 900;
}

.dot-row {
  margin-top: 18rpx;
  display: flex;
  justify-content: center;
  gap: 10rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d1d1d6;
}

.dot.active {
  width: 28rpx;
  border-radius: 999rpx;
  background: #111111;
}

.action-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.action-btn,
.save-btn {
  border: none;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 900;
}

.action-btn {
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after,
.save-btn::after,
.scan-card-btn::after {
  border: none;
}

.action-ghost {
  color: #111111;
  background: #ffffff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.04);
}

.action-primary,
.save-btn {
  color: #ffffff;
  background: #111111;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.12);
}

.salary-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  flex-wrap: wrap;
}

.salary-title,
.edit-title,
.empty-title,
.salary-empty-title {
  color: #111111;
  font-size: 32rpx;
  line-height: 1.22;
  font-weight: 900;
}

.salary-link {
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 800;
}

.salary-body {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: #f7f7f8;
}

.amount {
  display: block;
  color: #16853f;
  font-size: 54rpx;
  line-height: 1.1;
  font-weight: 900;
}

.amount-pop {
  animation: pop 0.4s ease;
}

.salary-meta {
  display: block;
  margin-top: 12rpx;
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 1.4;
  font-weight: 700;
}

.salary-empty,
.empty-card {
  text-align: center;
}

.salary-empty {
  margin-top: 20rpx;
  padding: 34rpx 20rpx;
  border-radius: 26rpx;
  background: #f7f7f8;
}

.salary-empty-icon,
.empty-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 22rpx;
  border-radius: 28rpx;
  background: #f2f2f4;
  position: relative;
}

.salary-empty-icon::before,
.empty-icon::before {
  content: '';
  position: absolute;
  left: 26rpx;
  top: 24rpx;
  width: 36rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 6rpx solid #111111;
  box-sizing: border-box;
}

.salary-empty-desc,
.empty-desc {
  display: block;
  max-width: 480rpx;
  margin: 10rpx auto 0;
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 700;
}

.edit-title {
  margin-bottom: 22rpx;
}

.scan-card-btn {
  width: 100%;
  height: 82rpx;
  margin: 0 0 22rpx;
  padding: 0;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 22rpx;
  background: #f7f7f8;
  color: #111111;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 900;
}

.scan-card-icon {
  width: 34rpx;
  height: 34rpx;
}

.edit-item {
  margin-top: 18rpx;
}

.edit-label {
  display: block;
  margin-bottom: 10rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 900;
}

.edit-input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  border: none;
  border-radius: 24rpx;
  background: #f2f2f4;
  color: #111111;
  padding: 0 22rpx;
  font-size: 29rpx;
  line-height: 88rpx;
  font-weight: 800;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes pop {
  0% { transform: scale(0.84); opacity: 0; }
  60% { transform: scale(1.08); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
