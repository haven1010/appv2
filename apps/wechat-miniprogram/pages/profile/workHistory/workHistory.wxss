/* pages/profile/workHistory/workHistory.wxss — iOS-style work history cards */
page {
  background: #f5f5f7 !important;
  color: #111111;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.page {
  min-height: 100vh;
  background: #f5f5f7;
}

.history-body {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 28rpx calc(188rpx + env(safe-area-inset-bottom));
}

.history-hero,
.state-card,
.history-card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 18rpx 44rpx rgba(15, 23, 42, 0.06);
}

.history-hero {
  position: relative;
  overflow: hidden;
  border-radius: 38rpx;
  padding: 36rpx 32rpx 30rpx;
}

.history-hero::before {
  content: '';
  position: absolute;
  right: -120rpx;
  top: -150rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 122, 255, 0.15) 0%, rgba(0, 122, 255, 0) 68%);
  pointer-events: none;
}

.history-title {
  position: relative;
  z-index: 1;
  display: block;
  color: #111111;
  font-size: 46rpx;
  line-height: 1.08;
  font-weight: 900;
}

.history-subtitle {
  position: relative;
  z-index: 1;
  display: block;
  max-width: 560rpx;
  margin-top: 12rpx;
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 1.42;
  font-weight: 700;
}

.history-stats {
  position: relative;
  z-index: 1;
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.history-stat {
  min-width: 0;
  min-height: 142rpx;
  padding: 20rpx 16rpx;
  border-radius: 26rpx;
  background: #f7f7f8;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.history-stat-value {
  color: #111111;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 900;
}

.history-stat-label {
  color: #8e8e93;
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 800;
}

.state-card {
  margin-top: 24rpx;
  border-radius: 34rpx;
  padding: 56rpx 34rpx;
  text-align: center;
}

.state-pulse {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #111111;
  box-shadow: 0 0 0 18rpx rgba(17, 17, 17, 0.06);
  animation: historyPulse 1.2s ease-in-out infinite;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  background: #f2f2f4;
  position: relative;
}

.empty-icon::before {
  content: '';
  position: absolute;
  left: 25rpx;
  top: 25rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 6rpx solid #111111;
  box-sizing: border-box;
}

.state-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 900;
}

.state-desc {
  display: block;
  max-width: 520rpx;
  margin: 12rpx auto 0;
  color: #8e8e93;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 700;
}

.history-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.history-card {
  border-radius: 34rpx;
  padding: 30rpx;
  animation: cardEnter 420ms ease both;
}

.history-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.history-card-main {
  flex: 1;
  min-width: 0;
}

.history-date {
  display: block;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 800;
}

.history-base {
  display: block;
  margin-top: 12rpx;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 900;
}

.history-job {
  display: block;
  margin-top: 10rpx;
  color: #5f6368;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 800;
}

.history-status {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  line-height: 1.25;
  font-weight: 900;
}

.history-money-row {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: #f7f7f8;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.history-money-label {
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 800;
}

.history-money {
  color: #111111;
  font-size: 38rpx;
  line-height: 1.05;
  font-weight: 900;
  text-align: right;
  overflow-wrap: anywhere;
}

.history-detail {
  margin-top: 0;
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height 320ms ease, opacity 240ms ease, margin-top 240ms ease;
}

.history-card.open .history-detail {
  margin-top: 18rpx;
  max-height: 280rpx;
  opacity: 1;
}

.detail-text {
  display: block;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f7f7f8;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  color: #6f7278;
  font-size: 25rpx;
  line-height: 1.55;
  font-weight: 700;
}

.history-card-foot {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #111111;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 900;
}

.foot-arrow {
  color: #8e8e93;
  font-size: 34rpx;
  line-height: 1;
}

.status-ok {
  color: #16853f;
  background: #ddf8e7;
}

.status-paid {
  color: #0066cc;
  background: #e6f0ff;
}

.status-pending {
  color: #9a6700;
  background: #fff4cc;
}

.status-error {
  color: #c22a2a;
  background: #ffe4e4;
}

.pressing {
  opacity: 0.78;
  transform: scale(0.985);
}

@keyframes cardEnter {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes historyPulse {
  0%, 100% { transform: scale(0.92); opacity: 0.72; }
  50% { transform: scale(1); opacity: 1; }
}
