.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: transparent;
}

.hero-card,
.filter-card,
.form-card,
.job-section-card,
.state-panel,
.base-card {
  border-radius: 28rpx;
  border: 3rpx solid rgba(140, 112, 72, 0.2);
  background: var(--warm-card);
  box-shadow: var(--shadow-card);
}

.hero-card {
  padding: 24rpx;
}

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.hero-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: #473421;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-badge {
  font-size: 20rpx;
  color: #4a6b34;
  background: rgba(240, 246, 226, 0.9);
  border: 2rpx solid rgba(78, 115, 58, 0.25);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.hero-subtitle {
  margin-top: 10rpx;
  display: block;
  font-size: 24rpx;
  color: var(--ink-sub);
  line-height: 1.45;
}

.hero-actions {
  margin-top: 12rpx;
}

.hero-back {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(78, 115, 58, 0.25);
  background: rgba(240, 246, 226, 0.9);
  color: #4a6b34;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-stats {
  margin-top: 16rpx;
  display: flex;
  gap: 10rpx;
}

.hero-stat {
  flex: 1;
  border-radius: 16rpx;
  border: 2rpx solid rgba(140, 112, 72, 0.2);
  background: rgba(255, 255, 255, 0.66);
  text-align: center;
  padding: 14rpx 8rpx;
}

.hero-stat-value {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #3f3222;
}

.hero-stat-label {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #7a664e;
}

.filter-card {
  margin-top: 14rpx;
  padding: 16rpx;
}

.search-input {
  width: 100%;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 2rpx solid rgba(140, 112, 72, 0.2);
  background: rgba(255, 255, 255, 0.72);
  padding: 16rpx 18rpx;
  font-size: 24rpx;
  color: #3f3222;
}

.segment-row {
  margin-top: 12rpx;
  display: flex;
  gap: 8rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  border: 2rpx solid rgba(140, 112, 72, 0.18);
  background: rgba(255, 255, 255, 0.66);
  color: #7a664e;
  font-size: 22rpx;
  font-weight: 700;
}

.segment-item.active {
  color: #ffffff;
  background: linear-gradient(90deg, var(--warm-green) 0%, var(--warm-blue) 100%);
  box-shadow: 0 8rpx 16rpx rgba(86, 126, 67, 0.24);
}

.mode-row {
  margin-top: 10rpx;
}

.state-panel {
  margin-top: 16rpx;
  padding: 50rpx 28rpx;
  text-align: center;
}

.state-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #4a3823;
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a664e;
}

.inner-state {
  margin-top: 12rpx;
  padding: 36rpx 24rpx;
}

.error-panel {
  border-color: rgba(178, 95, 65, 0.26);
  background: #f8eee6;
}

.lock-panel {
  border-color: rgba(155, 87, 61, 0.25);
  background: #f8efe9;
}

.lock-btn {
  margin-top: 20rpx;
  width: 340rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--warm-green) 0%, var(--warm-blue) 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.base-list,
.job-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.base-card {
  padding: 18rpx;
}

.base-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
}

.base-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 800;
  color: #473421;
}

.base-audit {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.base-audit.ok {
  color: #4a6b34;
  background: rgba(240, 246, 226, 0.9);
}

.base-audit.warn {
  color: #8e4a2e;
  background: rgba(248, 225, 214, 0.88);
}

.base-address {
  margin-top: 10rpx;
  display: block;
  font-size: 23rpx;
  color: #6f5e49;
}

.base-stats {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.base-chip {
  font-size: 20rpx;
  color: #6f5e49;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(140, 112, 72, 0.18);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.base-chip.success {
  color: #4a6b34;
}

.base-foot {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed rgba(140, 112, 72, 0.22);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.base-foot-text {
  font-size: 22rpx;
  color: #7a664e;
}

.cell-arrow {
  font-size: 30rpx;
  color: #9a876e;
  line-height: 1;
}

.form-card {
  margin-top: 14rpx;
  padding: 20rpx;
}

.form-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #473421;
}

.form-subtitle {
  font-size: 22rpx;
  color: #7a664e;
}

.field {
  margin-top: 14rpx;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #5a4733;
  font-weight: 700;
}

.input,
.textarea,
.picker {
  width: 100%;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 2rpx solid rgba(140, 112, 72, 0.2);
  background: rgba(255, 255, 255, 0.72);
  color: #3f3222;
  font-size: 24rpx;
  padding: 16rpx 18rpx;
}

.textarea {
  min-height: 140rpx;
}

.picker {
  min-height: 84rpx;
  display: flex;
  align-items: center;
}

.two-col {
  display: flex;
  gap: 10rpx;
}

.col {
  flex: 1;
}

.stepper {
  display: flex;
  align-items: center;
  width: 260rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(140, 112, 72, 0.2);
  background: rgba(255, 255, 255, 0.72);
  overflow: hidden;
}

.step-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 34rpx;
  color: #4a6b34;
  font-weight: 700;
}

.step-value {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #3f3222;
  font-weight: 700;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.image-item,
.image-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  border: 2rpx dashed rgba(140, 112, 72, 0.35);
  background: rgba(255, 255, 255, 0.72);
  position: relative;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.remove-image {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.48);
  color: #fff;
  font-size: 24rpx;
}

.image-add {
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-add-text {
  color: #7a664e;
  font-size: 24rpx;
  font-weight: 700;
}

.submit-btn {
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--warm-green) 0%, var(--warm-blue) 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.job-section-card {
  margin-top: 14rpx;
  padding: 18rpx;
}

.job-section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #473421;
}

.job-card {
  border-radius: 22rpx;
  border: 2rpx solid rgba(140, 112, 72, 0.18);
  background: rgba(255, 255, 255, 0.72);
  padding: 16rpx;
}

.job-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}

.job-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 800;
  color: #473421;
}

.job-salary {
  font-size: 24rpx;
  font-weight: 800;
  color: #4a6b34;
  text-align: right;
}

.job-meta {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.meta-tag {
  font-size: 20rpx;
  color: #4a6b34;
  background: rgba(240, 246, 226, 0.9);
  border: 2rpx solid rgba(78, 115, 58, 0.25);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.meta-item {
  font-size: 21rpx;
  color: #6f5e49;
}

.job-bottom {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed rgba(140, 112, 72, 0.24);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status {
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.status-open {
  color: #4a6b34;
  background: rgba(240, 246, 226, 0.9);
}

.status-closed {
  color: #8e4a2e;
  background: rgba(248, 225, 214, 0.88);
}

.apply-btn {
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(90deg, var(--warm-green) 0%, var(--warm-blue) 100%);
}

.boss-tip {
  font-size: 22rpx;
  color: #7a664e;
}
