/* ═══════════════════════════════════════════
   jobs/list - Claude Purple Theme
   ═══════════════════════════════════════════ */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: transparent;
}

/* ───── State Panels ───── */
.state-panel {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  text-align: center;
  padding: 50rpx 28rpx;
  box-shadow: var(--shadow-md);
  border: var(--border-soft);
}

.state-panel.inner-state {
  margin-top: 20rpx;
  padding: 40rpx 24rpx;
}

.state-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-sub);
}

/* ───── Hero Card ───── */
.hero-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-md);
  border: var(--border-soft);
}

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.hero-title {
  flex: 1;
  font-size: 44rpx;
  font-weight: 900;
  color: var(--ink-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-badge {
  font-size: 22rpx;
  color: var(--brand-purple);
  background: rgba(102, 126, 234, 0.1);
  border: 1rpx solid rgba(102, 126, 234, 0.15);
  border-radius: var(--radius-pill);
  padding: 6rpx 16rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.hero-subtitle {
  margin-top: 10rpx;
  display: block;
  font-size: 26rpx;
  color: var(--ink-sub);
  line-height: 1.5;
}

/* ───── Job Section ───── */
.job-section-card {
  margin-top: 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-md);
  border: var(--border-soft);
}

.job-section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink-main);
  margin-bottom: 4rpx;
}

/* ───── Job List ───── */
.job-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.job-card {
  background: var(--card-bg-soft);
  border-radius: var(--radius-md);
  padding: 20rpx;
  border: var(--border-soft);
  transition: all 0.2s;
}

.job-card:active {
  transform: scale(0.98);
}

.job-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.job-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
}

.job-salary {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--brand-purple);
  text-align: right;
  flex-shrink: 0;
}

.job-meta {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.meta-tag {
  font-size: 22rpx;
  color: var(--brand-purple);
  background: rgba(102, 126, 234, 0.1);
  border-radius: var(--radius-pill);
  padding: 4rpx 14rpx;
  font-weight: 700;
}

.meta-item {
  font-size: 24rpx;
  color: var(--ink-sub);
}

.job-bottom {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(102, 126, 234, 0.12);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status {
  font-size: 22rpx;
  font-weight: 700;
  border-radius: var(--radius-pill);
  padding: 4rpx 14rpx;
}

.status-open {
  background: rgba(49, 164, 124, 0.1);
  color: var(--accent-green);
}

.status-closed {
  background: rgba(228, 92, 109, 0.1);
  color: var(--accent-red);
}

.apply-btn {
  border-radius: var(--radius-pill);
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #1a1a2e;
  background: var(--brand-purple);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  transition: all 0.2s;
}

.apply-btn:active {
  transform: scale(0.96);
  opacity: 0.92;
}

.boss-tip {
  font-size: 24rpx;
  color: var(--ink-muted);
}

/* ───── Job Thumbnails ───── */
.job-thumbs {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
}

.job-thumb {
  width: 120rpx;
  height: 90rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: rgba(102, 126, 234, 0.06);
}

/* ───── Boss Bottom Nav ───── */
.boss-bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: var(--border-soft);
  box-shadow: 0 -6rpx 24rpx rgba(102, 126, 234, 0.06);
  backdrop-filter: blur(20rpx);
}

.boss-bottom-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 14rpx 8rpx 10rpx;
  color: var(--ink-sub);
  font-size: 24rpx;
  font-weight: 800;
  background: transparent;
}

.boss-bottom-item.active {
  color: var(--brand-purple);
}

/* ───── Boss Back Row ───── */
.back-row {
  margin-bottom: 20rpx;
  display: inline-flex;
  align-items: center;
}

.back-row:active {
  opacity: 0.6;
}

.back-link {
  font-size: 26rpx;
  color: var(--brand-purple);
  font-weight: 700;
}

/* ───── Section Card ───── */
.section-card {
  margin-top: 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-md);
  border: var(--border-soft);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
}

.section-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-sub);
}

/* ───── Section Head ───── */
.section-head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* ───── Filter Row ───── */
.filter-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.filter-chip {
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 700;
  color: var(--brand-purple);
  background: rgba(102, 126, 234, 0.08);
  transition: all 0.2s;
}

.filter-chip.active {
  background: var(--brand-purple);
  color: #1a1a2e;
}

/* ───── Lock Notice ───── */
.lock-notice {
  margin-top: 20rpx;
  background: rgba(228, 92, 109, 0.06);
  border: 1rpx solid rgba(228, 92, 109, 0.14);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  text-align: center;
}

.lock-text {
  display: block;
  font-size: 26rpx;
  color: var(--accent-red);
  line-height: 1.6;
}

.lock-btn {
  margin-top: 16rpx;
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-purple);
  color: #1a1a2e;
  font-size: 26rpx;
  font-weight: 700;
}

/* ───── Form Fields ───── */
.field {
  margin-top: 18rpx;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.field-half {
  flex: 1;
  min-width: 0;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #4a4d5e;
  font-weight: 700;
}

.input,
.textarea,
.picker-box {
  width: 100%;
  box-sizing: border-box;
  border-radius: 18rpx;
  border: var(--border-soft);
  background: var(--card-bg-soft);
  color: var(--ink-main);
  font-size: 28rpx;
  padding: 18rpx;
  min-height: 84rpx;
  line-height: 1.5;
  transition: all 0.25s;
}

.input:focus,
.textarea:focus {
  border-color: var(--brand-purple);
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.textarea {
  min-height: 132rpx;
}

/* ───── Salary Mode Chips ───── */
.chip-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.mode-chip {
  padding: 12rpx 24rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand-purple);
  background: rgba(102, 126, 234, 0.08);
  transition: all 0.2s;
}

.mode-chip.active {
  background: var(--brand-purple);
  color: #1a1a2e;
}

/* ───── Stepper ───── */
.stepper {
  display: inline-flex;
  align-items: center;
  gap: 0;
  border-radius: var(--radius-pill);
  border: var(--border-soft);
  background: var(--card-bg-soft);
  overflow: hidden;
}

.stepper-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--brand-purple);
  background: rgba(102, 126, 234, 0.06);
}

.stepper-btn:active {
  background: rgba(102, 126, 234, 0.15);
}

.stepper-value {
  min-width: 80rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
  padding: 0 16rpx;
}

/* ───── Env Images ───── */
.env-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.env-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.env-img {
  width: 100%;
  height: 100%;
}

.env-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.env-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  border: 2rpx dashed rgba(102, 126, 234, 0.24);
  background: var(--card-bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.env-add-text {
  font-size: 52rpx;
  color: var(--brand-purple);
  font-weight: 300;
  line-height: 1;
}

/* ───── Submit Button ───── */
.submit-btn {
  margin-top: 22rpx;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-purple);
  color: #1a1a2e;
  font-size: 30rpx;
  font-weight: 800;
  border: none;
  box-shadow: 0 10rpx 18rpx rgba(102, 126, 234, 0.16);
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.submit-btn[disabled] {
  background: #b8b4c8;
  box-shadow: none;
}

/* ───── Base List ───── */
.base-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.base-card {
  background: var(--card-bg-soft);
  border: var(--border-soft);
  border-radius: var(--radius-md);
  padding: 20rpx;
  position: relative;
  transition: all 0.2s;
}

.base-card:active {
  transform: scale(0.98);
}

.base-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.base-card-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
  flex: 1;
  min-width: 0;
}

.base-card-audit {
  font-size: 22rpx;
  font-weight: 700;
  border-radius: var(--radius-pill);
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}

.audit-ok {
  background: rgba(49, 164, 124, 0.1);
  color: var(--accent-green);
}

.audit-pending {
  background: rgba(102, 126, 234, 0.1);
  color: var(--brand-purple);
}

.audit-reject {
  background: rgba(228, 92, 109, 0.1);
  color: var(--accent-red);
}

.audit-badge {
  font-size: 22rpx;
  font-weight: 700;
  border-radius: var(--radius-pill);
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}

.base-card-meta {
  margin-top: 12rpx;
  display: flex;
  gap: 24rpx;
}

.base-card-stat {
  font-size: 24rpx;
  color: var(--ink-sub);
}

.base-card-action {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(102, 126, 234, 0.12);
  display: flex;
  justify-content: flex-end;
}

.publish-btn {
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-purple);
  color: #1a1a2e;
  font-size: 26rpx;
  font-weight: 700;
}

.publish-btn:active {
  transform: scale(0.96);
  opacity: 0.92;
}
