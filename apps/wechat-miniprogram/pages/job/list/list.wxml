<view class="page">
  <block wx:if="{{loading}}">
    <view class="state-panel">
      <text class="state-title">正在加载页面...</text>
      <text class="state-desc">请稍候</text>
    </view>
  </block>

  <block wx:else>
    <block wx:if="{{loadError}}">
      <view class="state-panel">
        <text class="state-title">页面加载失败</text>
        <text class="state-desc">{{loadError}}</text>
      </view>
    </block>

    <block wx:else>
      <!-- ═══════════ Hero ═══════════ -->
      <view class="hero-card">
        <view class="hero-head">
          <view>
            <text class="hero-title">{{isBossView ? '岗位发布' : '岗位广场'}}</text>
            <text class="hero-subtitle">{{isBossView ? '查看并发布岗位，统一管理招聘信息' : '浏览基地岗位，快速选择适合的工作'}}</text>
          </view>
          <text class="hero-badge">{{isBossView ? '老板视角' : '工人视角'}}</text>
        </view>
      </view>

      <!-- ═══════════ Worker: Job List ═══════════ -->
      <block wx:if="{{!isBossView}}">
        <view class="job-section-card">
          <text class="job-section-title">可报名岗位</text>
          <view wx:if="{{viewJobs.length === 0}}" class="state-panel inner-state">
            <text class="state-title">暂无可报名岗位</text>
            <text class="state-desc">可调整筛选条件后重试</text>
          </view>
          <view wx:else class="job-list">
            <view wx:for="{{viewJobs}}" wx:key="id" class="job-card pressable" bindtap="goToDetail" data-id="{{item.id}}" data-baseid="{{item.baseId}}" hover-class="pressing" hover-stay-time="100">
              <view class="job-top">
                <text class="job-title">{{item.jobTitle}}</text>
                <text class="job-salary">{{item.salaryText}}</text>
              </view>
              <view class="job-meta">
                <text class="meta-tag">{{item.baseName}}</text>
                <text class="meta-item">{{item.payModeText}}</text>
                <text class="meta-item">招聘 {{item.recruitCount}} 人</text>
                <text class="meta-item">已报名 {{item.applicantCount}} 人</text>
              </view>
              <view class="job-meta">
                <text class="meta-item">{{item.workDateRange}}</text>
              </view>
              <view class="job-bottom">
                <text class="status {{item.statusClass}}">{{item.statusText}}</text>
                <view class="apply-btn pressable" catchtap="applyJob" data-id="{{item.id}}" data-baseid="{{item.baseId}}" data-basename="{{item.baseName}}" data-jobtitle="{{item.jobTitle}}">立即报名</view>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- ═══════════ Boss: Base Selector ═══════════ -->
      <block wx:if="{{isBossView && !baseId}}">
        <view class="section-card">
          <text class="section-title">我的基地（{{approvedBaseCount}} 个已通过）</text>
          <text class="section-sub">选择一个基地进入岗位管理</text>
          <view wx:if="{{viewBossBases.length === 0}}" class="state-panel inner-state">
            <text class="state-title">暂无基地</text>
            <text class="state-desc">请先在「工作台」完成企业入驻，审核通过后即可发布岗位</text>
          </view>
          <view wx:else class="base-list">
            <view wx:for="{{viewBossBases}}" wx:key="id" class="base-card">
              <view class="base-card-top">
                <text class="base-card-name">{{item.baseName}}</text>
                <text class="base-card-audit {{item.auditStatus === 1 ? 'audit-ok' : 'audit-pending'}}">{{item.auditText}}</text>
              </view>
              <view class="base-card-meta">
                <text class="base-card-stat">总岗位 {{item.totalJobs}}</text>
                <text class="base-card-stat">开放中 {{item.openJobs}}</text>
                <text class="base-card-stat">已关闭 {{item.closedJobs}}</text>
              </view>
              <view class="base-card-action">
                <view class="publish-btn" data-id="{{item.id}}" catchtap="goToBasePublish">发布岗位</view>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- ═══════════ Boss: Job Management for Selected Base ═══════════ -->
      <block wx:if="{{isBossView && baseId > 0}}">
        <view class="back-row" bindtap="backToBaseSelector">
          <text class="back-link">← 返回基地列表</text>
        </view>
        <!-- Locked Notice -->
        <view wx:if="{{lockUI}}" class="lock-notice">
          <text class="lock-text">{{lockReason}}</text>
          <view class="lock-btn" bindtap="goToAuditPage">去完成入驻审核</view>
        </view>

        <!-- Job Creation Form -->
        <view class="section-card" wx:if="{{!lockUI}}">
          <text class="section-title">发布新岗位</text>
          <text class="section-sub">当前基地：{{baseName}}</text>

          <view class="field">
            <text class="label">岗位名称</text>
            <input class="input" placeholder="如：苹果采摘工" value="{{form.jobTitle}}" data-field="jobTitle" bindinput="onFormInput" />
          </view>

          <view class="field">
            <text class="label">工作地址</text>
            <input class="input" placeholder="具体工作地点" value="{{form.workAddress}}" data-field="workAddress" bindinput="onFormInput" />
          </view>

          <view class="field">
            <text class="label">薪资模式</text>
            <view class="chip-row">
              <view class="mode-chip {{form.salaryMode === 'daily' ? 'active' : ''}}" data-mode="daily" bindtap="onSalaryModeChange">日结</view>
              <view class="mode-chip {{form.salaryMode === 'piece' ? 'active' : ''}}" data-mode="piece" bindtap="onSalaryModeChange">计件</view>
              <view class="mode-chip {{form.salaryMode === 'monthly' ? 'active' : ''}}" data-mode="monthly" bindtap="onSalaryModeChange">月薪</view>
            </view>
          </view>

          <view class="field">
            <text class="label">{{amountLabel}}</text>
            <input class="input" type="digit" placeholder="请输入金额" value="{{form.amount}}" data-field="amount" bindinput="onFormInput" />
          </view>

          <view class="field">
            <text class="label">招聘人数</text>
            <view class="stepper">
              <view class="stepper-btn" data-delta="-1" bindtap="onRecruitCountStep">−</view>
              <text class="stepper-value">{{form.recruitCount}}</text>
              <view class="stepper-btn" data-delta="1" bindtap="onRecruitCountStep">+</view>
            </view>
          </view>

          <view class="field">
            <text class="label">工作时间</text>
            <input class="input" placeholder="如：08:00-17:00" value="{{form.workHours}}" data-field="workHours" bindinput="onFormInput" />
          </view>

          <view class="field-row">
            <view class="field field-half">
              <text class="label">开始日期</text>
              <picker mode="date" value="{{form.workStartDate}}" bindchange="onFormDateChange" data-field="workStartDate">
                <view class="picker-box">{{form.workStartDate || '请选择'}}</view>
              </picker>
            </view>
            <view class="field field-half">
              <text class="label">结束日期</text>
              <picker mode="date" value="{{form.workEndDate}}" bindchange="onFormDateChange" data-field="workEndDate">
                <view class="picker-box">{{form.workEndDate || '请选择'}}</view>
              </picker>
            </view>
          </view>

          <view class="field">
            <text class="label">岗位要求</text>
            <input class="input" placeholder="如：年龄18-55岁，身体健康" value="{{form.requirements}}" data-field="requirements" bindinput="onFormInput" />
          </view>

          <view class="field">
            <text class="label">岗位描述</text>
            <textarea class="textarea" placeholder="详细描述工作内容、福利待遇等" value="{{form.workContent}}" data-field="workContent" bindinput="onFormInput" auto-height />
          </view>

          <view class="field">
            <text class="label">工作环境图片（最多3张）</text>
            <view class="env-row">
              <view wx:for="{{form.workEnvImages}}" wx:key="index" class="env-thumb">
                <image class="env-img" src="{{item}}" mode="aspectFill" />
                <view class="env-remove" data-index="{{index}}" catchtap="removeEnvImage">×</view>
              </view>
              <view wx:if="{{form.workEnvImages.length < 3}}" class="env-add" bindtap="chooseEnvImages">
                <text class="env-add-text">+</text>
              </view>
            </view>
          </view>

          <button class="submit-btn" loading="{{submitting}}" disabled="{{submitting || uploadingImages}}" bindtap="submitPublishJob">
            {{submitting ? '发布中...' : '发布岗位'}}
          </button>
        </view>

        <!-- Existing Jobs -->
        <view class="section-card">
          <view class="section-head">
            <text class="section-title">已发布岗位（{{jobs.length}}）</text>
            <view class="filter-row">
              <view class="filter-chip {{statusFilter === 'all' ? 'active' : ''}}" data-status="all" bindtap="onStatusChange">全部</view>
              <view class="filter-chip {{statusFilter === 'open' ? 'active' : ''}}" data-status="open" bindtap="onStatusChange">开放中（{{openCount}}）</view>
              <view class="filter-chip {{statusFilter === 'closed' ? 'active' : ''}}" data-status="closed" bindtap="onStatusChange">已关闭（{{closedCount}}）</view>
            </view>
          </view>

          <view wx:if="{{viewJobs.length === 0}}" class="state-panel inner-state">
            <text class="state-title">暂无岗位</text>
            <text class="state-desc">上方填写表单发布第一个岗位</text>
          </view>

          <view wx:else class="job-list">
            <view wx:for="{{viewJobs}}" wx:key="id" class="job-card pressable" bindtap="goToDetail" data-id="{{item.id}}" data-baseid="{{item.baseId}}" hover-class="pressing" hover-stay-time="100">
              <view class="job-top">
                <text class="job-title">{{item.jobTitle}}</text>
                <text class="job-salary">{{item.salaryText}}</text>
              </view>
              <view class="job-meta">
                <text class="meta-tag">{{item.baseName}}</text>
                <text class="meta-item">{{item.payModeText}}</text>
                <text class="meta-item">招聘 {{item.recruitCount}} 人</text>
                <text class="meta-item">已报名 {{item.applicantCount}} 人</text>
              </view>
              <view class="job-meta">
                <text class="meta-item">{{item.workDateRange}}</text>
              </view>
              <view class="job-bottom">
                <text class="status {{item.statusClass}}">{{item.statusText}}</text>
                <text class="boss-tip">点击查看详情</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </block>
  </block>

  <!-- ═══════════ Boss Bottom Nav ═══════════ -->
  <view wx:if="{{isBossView}}" class="boss-bottom-nav">
    <view class="boss-bottom-item" bindtap="goToBossDashboard">工作台</view>
    <view class="boss-bottom-item" bindtap="goToBossBaseList">我的基地</view>
    <view class="boss-bottom-item active">岗位发布</view>
    <view class="boss-bottom-item" bindtap="goToBossProfile">我的</view>
  </view>
</view>
