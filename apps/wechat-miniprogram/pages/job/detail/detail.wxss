page {
  background: #f5f5f7;
}

.job-detail-page {
  min-height: 100vh;
  background: #f5f5f7;
  color: #111111;
}

.page-body {
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
}

.job-hero {
  position: relative;
  height: 420rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #111111;
  box-shadow: 0 22rpx 52rpx rgba(0, 0, 0, 0.16);
}

.job-hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.job-hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08) 0%, rgba(0, 0, 0, 0.78) 100%);
}

.job-hero-copy {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 30rpx;
}

.status-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.9);
  color: #111111;
}

.status-badge.open {
  color: #0f7a4f;
}

.status-badge.closed {
  color: #c23b32;
}

.job-title {
  display: block;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 54rpx;
  line-height: 1.12;
  font-weight: 900;
}

.job-subtitle {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 800;
}

.salary-panel {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.salary-main {
  min-width: 0;
}

.salary-label {
  display: block;
  color: #8d929c;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 800;
}

.salary-value {
  display: block;
  margin-top: 12rpx;
  color: #111111;
  font-size: 58rpx;
  line-height: 1.05;
  font-weight: 900;
}

.salary-meta {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  color: #168252;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 900;
}

.metric-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.metric-card {
  min-height: 134rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #ffffff;
  padding: 24rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 12rpx 34rpx rgba(0, 0, 0, 0.045);
}

.metric-card.is-clickable:active,
.address-card.is-clickable:active,
.apply-btn-press {
  opacity: 0.72;
}

.metric-value {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 900;
}

.metric-label {
  display: block;
  margin-top: 12rpx;
  color: #9ca0aa;
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 800;
}

.section-block {
  margin-top: 30rpx;
}

.section-head {
  padding: 0 4rpx 16rpx;
}

.section-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 900;
}

.address-card,
.text-panel {
  border-radius: 30rpx;
  background: #ffffff;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 14rpx 38rpx rgba(0, 0, 0, 0.045);
}

.address-card {
  padding: 28rpx;
}

.address-text {
  display: block;
  color: #111111;
  font-size: 30rpx;
  line-height: 1.55;
  font-weight: 800;
}

.address-action {
  display: flex;
  margin-top: 18rpx;
  color: #168252;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 900;
}

.text-panel {
  padding: 28rpx;
}

.panel-text {
  display: block;
  color: #4f545d;
  font-size: 29rpx;
  line-height: 1.78;
  font-weight: 700;
}

.env-scroll {
  white-space: nowrap;
}

.env-img-row {
  display: flex;
  gap: 16rpx;
}

.env-img {
  width: 330rpx;
  height: 220rpx;
  border-radius: 26rpx;
  flex-shrink: 0;
  background: #e8e9ed;
}

.state-card {
  min-height: 64vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 56rpx 34rpx;
}

.state-visual {
  width: 180rpx;
  height: 180rpx;
  border-radius: 48rpx;
  background:
    radial-gradient(circle at 32% 28%, rgba(22, 130, 82, 0.22), transparent 34%),
    linear-gradient(145deg, #ffffff, #e8ebe8);
  box-shadow: 0 22rpx 54rpx rgba(0, 0, 0, 0.08);
}

.state-visual.empty {
  background:
    radial-gradient(circle at 70% 28%, rgba(22, 130, 82, 0.18), transparent 32%),
    linear-gradient(145deg, #ffffff, #eceef1);
}

.state-title {
  display: block;
  margin-top: 32rpx;
  color: #111111;
  font-size: 36rpx;
  line-height: 1.35;
  font-weight: 900;
}

.state-desc {
  display: block;
  margin-top: 12rpx;
  color: #8d929c;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 700;
}

.action-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  box-sizing: border-box;
  padding: 18rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(245, 245, 247, 0.86);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.apply-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  background: #111111;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.apply-btn::after {
  border: none;
}

.apply-btn[disabled] {
  background: #d9dbe0 !important;
  box-shadow: none;
  color: #9ca0aa;
}

.page-bottom-gap {
  height: 8rpx;
}
