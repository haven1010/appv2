/* ═══════════════════════════════════════════
   jobs/detail - Claude Purple Theme
   ═══════════════════════════════════════════ */
.page {
  background: transparent;
}

.page-body {
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  padding-bottom: calc(194rpx + env(safe-area-inset-bottom));
}

/* ───── Shared Card Base (ds-card compat) ───── */
.ds-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-md);
  border: var(--border-soft);
}

.card-in {
  animation: cardFadeIn 0.35s ease both;
}

@keyframes cardFadeIn {
  from { opacity: 0; transform: translate3d(0, 20rpx, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}

/* ───── Overview Card ───── */
.overview-card {
  background: linear-gradient(145deg, rgba(255,255,255,0.98) 0%, rgba(245,242,255,0.96) 52%, rgba(240,236,255,0.98) 100%);
}

.overview-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.overview-main {
  flex: 1;
  min-width: 0;
}

.job-title {
  display: block;
  font-size: 46rpx;
  line-height: 1.24;
  color: var(--ink-main);
  font-weight: 900;
}

.job-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--ink-sub);
}

.status-badge {
  flex-shrink: 0;
  border-radius: var(--radius-pill);
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
}

.status-badge.open {
  background: rgba(49, 164, 124, 0.1);
  color: var(--accent-green);
}

.status-badge.closed {
  background: rgba(228, 92, 109, 0.1);
  color: var(--accent-red);
}

/* ───── Salary Focus ───── */
.salary-focus {
  margin-top: 24rpx;
  border-radius: var(--radius-md);
  background: rgba(102, 126, 234, 0.08);
  padding: 20rpx 24rpx;
}

.salary-label {
  display: block;
  font-size: 28rpx;
  line-height: 1.35;
  color: var(--ink-sub);
}

.salary-value {
  display: block;
  margin-top: 8rpx;
  font-size: 66rpx;
  line-height: 1.08;
  color: var(--brand-purple);
  font-weight: 900;
}

/* ───── Key Row ───── */
.key-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.key-item {
  flex: 1;
  min-width: 0;
  border-radius: var(--radius-md);
  background: var(--card-bg);
  padding: 16rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: var(--border-soft);
}

.key-icon {
  font-size: 28rpx;
  line-height: 1;
}

.key-text {
  font-size: 26rpx;
  line-height: 1.3;
  color: var(--ink-main);
  font-weight: 700;
}

/* ───── Section Card ───── */
.section-card {
  margin-top: 24rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.35;
  color: var(--ink-main);
  font-weight: 900;
}

/* ───── Info List ───── */
.info-list {
  margin-top: 12rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed rgba(102, 126, 234, 0.1);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--ink-sub);
  flex-shrink: 0;
}

.info-value {
  font-size: 30rpx;
  line-height: 1.45;
  color: var(--ink-main);
  font-weight: 700;
  text-align: right;
}

.info-value.salary {
  color: var(--brand-purple);
}

.info-row-address {
  align-items: flex-start;
}

.address-value {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  gap: 6rpx;
}

.address-icon {
  margin-top: 2rpx;
  font-size: 28rpx;
  line-height: 1.2;
}

.address-text {
  max-width: 72%;
  text-align: right;
  word-break: break-all;
  white-space: pre-wrap;
}

.info-row-address.is-clickable .address-text {
  color: var(--brand-purple);
}

.info-row-address.is-disabled .address-text {
  color: var(--ink-muted);
}

/* ───── Note Card ───── */
.note-card {
  margin-top: 16rpx;
  border-radius: var(--radius-md);
  background: rgba(102, 126, 234, 0.06);
  padding: 20rpx 24rpx;
}

.note-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--ink-main);
}

/* ───── State Card ───── */
.state-card {
  text-align: center;
}

.state-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.45;
  color: var(--ink-main);
  font-weight: 800;
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--ink-sub);
}

/* ───── Action Shell ───── */
.action-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  box-sizing: border-box;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.apply-btn {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 28rpx;
  color: var(--ink-main);
  font-size: 34rpx;
  font-weight: 800;
  background: transparent;
  box-shadow: none;
  transition: all 0.2s;
}

.apply-btn::after {
  border: none;
}

.apply-btn:active {
  opacity: 0.5;
}

.apply-btn-press {
  opacity: 0.5;
}

.apply-btn[disabled] {
  background: transparent !important;
  box-shadow: none;
  color: var(--ink-muted);
}

/* ───── Animation Delays ───── */
.delay-1 { animation-delay: 80ms; }
.delay-2 { animation-delay: 140ms; }
.delay-3 { animation-delay: 200ms; }

/* ───── Work Environment Images ───── */
.env-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.env-img-row {
  display: inline-flex;
  gap: 14rpx;
}

.env-img {
  width: 280rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: rgba(102, 126, 234, 0.06);
}

.page-bottom-gap {
  height: 8rpx;
}
