.page {
  background-color: #f5efe3;
}

.page-body {
  padding-bottom: calc(194rpx + env(safe-area-inset-bottom));
}

.overview-card {
  background: linear-gradient(145deg, #fff8e8 0%, #eef7e5 52%, #eef5ff 100%);
}

.overview-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.overview-main {
  flex: 1;
  min-width: 0;
}

.job-title {
  display: block;
  font-size: 46rpx;
  line-height: 1.24;
  color: #333333;
  font-weight: 800;
}

.job-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: #999999;
}

.status-badge {
  flex-shrink: 0;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 700;
}

.status-badge.open {
  background: #dcecc8;
  color: #466e34;
}

.status-badge.closed {
  background: #f4dfbf;
  color: #8d6132;
}

.salary-focus {
  margin-top: 20rpx;
  border-radius: 22rpx;
  background: #fff3dc;
  padding: 18rpx 20rpx;
}

.salary-label {
  display: block;
  font-size: 28rpx;
  line-height: 1.35;
  color: #999999;
}

.salary-value {
  display: block;
  margin-top: 8rpx;
  font-size: 66rpx;
  line-height: 1.08;
  color: #6a994e;
  font-weight: 900;
}

.key-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.key-item {
  flex: 1;
  min-width: 0;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.75);
  padding: 14rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.key-icon {
  font-size: 28rpx;
  line-height: 1;
}

.key-text {
  font-size: 28rpx;
  line-height: 1.3;
  color: #333333;
  font-weight: 700;
}

.section-card {
  margin-top: 24rpx;
}

.section-title {
  display: block;
  font-size: 36rpx;
  line-height: 1.35;
  color: #333333;
  font-weight: 800;
}

.info-list {
  margin-top: 12rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
}

.info-label {
  font-size: 28rpx;
  line-height: 1.45;
  color: #999999;
}

.info-value {
  font-size: 32rpx;
  line-height: 1.45;
  color: #333333;
  font-weight: 700;
  text-align: right;
}

.info-value.salary {
  color: #f4a261;
}

.info-row-address {
  align-items: flex-start;
}

.address-value {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  gap: 6rpx;
}

.address-icon {
  margin-top: 2rpx;
  font-size: 28rpx;
  line-height: 1.2;
}

.address-text {
  max-width: 72%;
  text-align: right;
  word-break: break-all;
  white-space: pre-wrap;
}

.info-row-address.is-clickable .address-text {
  color: #6a994e;
}

.info-row-address.is-disabled .address-text {
  color: #999999;
}

.note-card {
  margin-top: 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  padding: 18rpx 20rpx;
}

.note-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #5e5345;
}

.state-card {
  text-align: center;
  margin-top: 12rpx;
}

.state-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.45;
  color: #333333;
  font-weight: 700;
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #999999;
}

.action-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  box-sizing: border-box;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 239, 227, 0) 0%, rgba(245, 239, 227, 0.96) 40%);
}

.apply-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 40rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  background: linear-gradient(90deg, #6a994e 0%, #4f98d8 100%);
  box-shadow: 0 8rpx 20rpx rgba(79, 139, 95, 0.2);
  transform: scale(1);
  transition: transform 120ms ease, opacity 120ms ease;
}

.apply-btn::after {
  border: none;
}

.apply-btn-press {
  transform: scale(0.95);
}

.apply-btn[disabled] {
  background: #b9c7b1 !important;
  box-shadow: none;
}

.page-bottom-gap {
  height: 8rpx;
}

.delay-1 {
  animation-delay: 80ms;
}

.delay-2 {
  animation-delay: 140ms;
}

.delay-3 {
  animation-delay: 200ms;
}
