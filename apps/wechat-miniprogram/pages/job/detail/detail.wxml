<view class="page job-detail-page">
  <view class="page-body">
    <view wx:if="{{loading}}" class="state-card">
      <view class="state-visual"></view>
      <text class="state-title">正在加载岗位</text>
      <text class="state-desc">请稍候</text>
    </view>

    <block wx:elif="{{jobInfo}}">
      <view class="job-hero">
        <image class="job-hero-img" src="/images/home-action-bg-1.png" mode="aspectFill"></image>
        <view class="job-hero-mask"></view>
        <view class="job-hero-copy">
          <view class="status-badge {{jobInfo.statusClass}}">{{jobInfo.statusText}}</view>
          <text class="job-title">{{jobInfo.jobTitle || '岗位详情'}}</text>
          <text class="job-subtitle">{{jobInfo.baseName || '岗位信息'}}</text>
        </view>
      </view>

      <view class="salary-panel">
        <view class="salary-main">
          <text class="salary-label">预计工资</text>
          <text class="salary-value">{{jobInfo.salaryText}}</text>
        </view>
        <view class="salary-meta">
          <text>{{jobInfo.payTypeText}}</text>
          <text>{{jobInfo.workCycleText}}</text>
        </view>
      </view>

      <view class="metric-grid">
        <view class="metric-card">
          <text class="metric-value">{{jobInfo.recruitText}}</text>
          <text class="metric-label">招聘人数</text>
        </view>
        <view class="metric-card">
          <text class="metric-value">{{jobInfo.payTypeText}}</text>
          <text class="metric-label">工资类型</text>
        </view>
        <view class="metric-card">
          <text class="metric-value">{{jobInfo.workCycleText}}</text>
          <text class="metric-label">结算周期</text>
        </view>
        <view class="metric-card {{jobInfo.hasMapLocation ? 'is-clickable' : ''}}" bindtap="openWorkAddress">
          <text class="metric-value">{{jobInfo.hasMapLocation ? '可导航' : '待补充'}}</text>
          <text class="metric-label">工作位置</text>
        </view>
      </view>

      <view class="section-block">
        <view class="section-head">
          <text class="section-title">工作地点</text>
        </view>
        <view class="address-card {{jobInfo.hasMapLocation ? 'is-clickable' : ''}}" bindtap="openWorkAddress">
          <text class="address-text">{{jobInfo.workAddress || '地址待补充'}}</text>
          <text class="address-action">{{jobInfo.hasMapLocation ? '打开地图' : '暂无坐标'}}</text>
        </view>
      </view>

      <view class="section-block" wx:if="{{jobInfo.workplaceImages && jobInfo.workplaceImages.length}}">
        <view class="section-head">
          <text class="section-title">工作环境</text>
        </view>
        <scroll-view class="env-scroll" scroll-x enable-flex>
          <view class="env-img-row">
            <image
              wx:for="{{jobInfo.workplaceImages}}"
              wx:key="index"
              class="env-img"
              src="{{item}}"
              mode="aspectFill"
              data-index="{{index}}"
              data-urls="{{jobInfo.workplaceImages}}"
              bindtap="previewEnvImage"
            />
          </view>
        </scroll-view>
      </view>

      <view class="section-block">
        <view class="section-head">
          <text class="section-title">工作内容</text>
        </view>
        <view class="text-panel">
          <text class="panel-text">{{jobInfo.jobDescription}}</text>
        </view>
      </view>

      <view class="section-block">
        <view class="section-head">
          <text class="section-title">报名要求</text>
        </view>
        <view class="text-panel">
          <text class="panel-text">{{jobInfo.requirements}}</text>
        </view>
      </view>
    </block>

    <view wx:else class="state-card">
      <view class="state-visual empty"></view>
      <text class="state-title">岗位信息不存在</text>
      <text class="state-desc">请返回岗位列表重新选择</text>
    </view>

    <view class="page-bottom-gap"></view>
  </view>

  <view class="action-shell">
    <button
      class="apply-btn"
      hover-class="apply-btn-press"
      hover-stay-time="100"
      bindtap="handleApply"
      disabled="{{!canApply || applying}}"
    >{{applying ? '报名提交中...' : (canApply ? '立即报名' : '岗位已关闭')}}</button>
  </view>
</view>
