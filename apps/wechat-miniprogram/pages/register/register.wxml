<view class="register-page">
  <view class="steps-container">
    <view class="step {{stepClasses[0]}}">
      <view class="step-body">
        <view class="brand-mark">
          <image class="brand-logo" src="/images/zhihui-logo.webp" mode="aspectFit" />
        </view>
        <text class="brand-name">智绘就业</text>
        <text class="step-title">注册账号</text>
        <text class="step-desc">输入手机号，接收短信验证码</text>

        <view class="step-input-area">
          <view class="phone-row">
            <text class="phone-prefix">+86</text>
            <view class="input-wrapper {{phone ? 'has-value' : ''}}">
              <input
                class="input-field"
                type="number"
                maxlength="11"
                placeholder="请输入手机号"
                placeholder-class="placeholder"
                value="{{phone}}"
                bindinput="onInputPhone"
                focus="{{currentStep === 0}}"
              />
            </view>
          </view>
        </view>

        <view class="step-error" wx:if="{{error}}">
          <text class="step-error-text">{{error}}</text>
        </view>

        <button
          class="primary-btn {{phone.length === 11 && hasAgreed ? 'btn-active' : 'btn-disabled'}}"
          disabled="{{phone.length !== 11 || loading}}"
          bindtap="handleSendCode"
        >
          <text wx:if="{{!loading}}">获取验证码</text>
          <text wx:else>发送中...</text>
        </button>

        <view class="agreement-row" bindtap="toggleAgreement">
          <view class="agreement-check {{hasAgreed ? 'checked' : ''}}">
            <text wx:if="{{hasAgreed}}">✓</text>
          </view>
          <view class="agreement-copy">
            <text class="agreement-text">我已阅读并同意</text>
            <text class="agreement-link" catchtap="openUserAgreement">《用户协议》</text>
            <text class="agreement-text">和</text>
            <text class="agreement-link" catchtap="openPrivacyPolicy">《隐私政策》</text>
          </view>
        </view>

        <view class="login-link-row">
          <text class="login-link-text">已有账号？</text>
          <text class="login-link-btn" bindtap="goToLogin">去登录</text>
        </view>
      </view>
    </view>

    <view class="step {{stepClasses[1]}}">
      <view class="step-body">
        <view class="code-back" bindtap="goBackToPhone">修改手机号</view>
        <text class="step-title">输入验证码</text>
        <text class="step-desc">验证码已发送至 {{phone}}</text>

        <view class="code-input-area">
          <view class="code-row">
            <view class="code-input-wrapper">
              <input
                class="code-field"
                type="number"
                maxlength="6"
                placeholder="请输入验证码"
                placeholder-class="placeholder"
                value="{{code}}"
                bindinput="onInputCode"
                focus="{{currentStep === 1}}"
              />
            </view>
          </view>
          <view class="code-hint-row">
            <text class="code-hint" wx:if="{{countdown > 0}}">{{countdown}}秒后可重新发送</text>
            <text class="code-resend" wx:else bindtap="handleResendCode">重新发送验证码</text>
          </view>
        </view>

        <view class="step-error" wx:if="{{error}}">
          <text class="step-error-text">{{error}}</text>
        </view>

        <button
          class="primary-btn {{code.length === 6 && hasAgreed ? 'btn-active' : 'btn-disabled'}}"
          disabled="{{code.length !== 6 || loading}}"
          bindtap="handleRegister"
        >
          <text wx:if="{{!loading}}">注册并登录</text>
          <text wx:else>注册中...</text>
        </button>
      </view>
    </view>
  </view>
</view>
