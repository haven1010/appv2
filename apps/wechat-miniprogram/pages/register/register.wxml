<view class="container register-container page-enter">
  <view class="brand-hero">
    <view class="brand-row">
      <image class="brand-logo" src="/images/zhihui-logo.jpg" mode="aspectFit" />
      <view>
        <view class="brand-title">智汇就业</view>
        <view class="brand-subtitle">实名注册 · 劳务协作信息完善</view>
      </view>
    </view>
  </view>

  <view class="card register-card">
    <view class="card-title">{{registerRole === 'boss' ? '创建老板账号' : (registerMode === 'proxy' ? '家人代注册采摘工账号' : '创建采摘工账号')}}</view>
    <view class="card-subtitle">{{registerRole === 'boss' ? '请填写真实信息，用于企业入驻与资料审核' : (registerMode === 'proxy' ? '请填写工人信息与代办授权信息，提交后进入审核流程' : '请填写真实信息，用于报名、工资结算与发放')}}</view>

    <view class="mode-switch" wx:if="{{registerRole === 'worker'}}">
      <view class="mode-pill {{registerMode === 'self' ? 'active' : ''}}" data-mode="self" bindtap="onSwitchRegisterMode">本人注册</view>
      <view class="mode-pill {{registerMode === 'proxy' ? 'active' : ''}}" data-mode="proxy" bindtap="onSwitchRegisterMode">家人代注册</view>
    </view>

    <view class="mode-tip" wx:if="{{registerRole === 'worker' && registerMode === 'proxy'}}">
      代注册提交后需管理员审核，审核通过后工人本人登录接管账号。
    </view>

    <view class="steps">
      <view class="step active">
        <view class="step-dot">1</view>
        <text class="step-label">基本信息</text>
      </view>
      <view class="step-line"></view>
      <view class="step {{registerMode === 'proxy' ? (proxyName || proxyPhone || relationToWorker ? 'active' : '') : (emergencyContact || emergencyPhone ? 'active' : '')}}">
        <view class="step-dot">2</view>
        <text class="step-label">{{registerMode === 'proxy' ? '代办信息' : '紧急联系人'}}</text>
      </view>
    </view>

    <view class="form-section">
      <view class="section-label">
        <text>基本信息</text>
      </view>

      <view class="form-item">
        <view class="input-wrapper {{nameFocus ? 'focus' : ''}}">
          <text class="input-icon">姓名</text>
          <input
            class="input-field"
            type="text"
            placeholder="真实姓名"
            placeholder-class="placeholder"
            value="{{name}}"
            bindinput="onInputName"
            bindfocus="onNameFocus"
            bindblur="onNameBlur"
          />
          <text class="required-star">*</text>
        </view>
      </view>

      <view class="form-item">
        <view class="input-wrapper {{idCardFocus ? 'focus' : ''}}">
          <text class="input-icon">证件</text>
          <input
            class="input-field"
            type="idcard"
            placeholder="18位身份证号码"
            placeholder-class="placeholder"
            value="{{idCard}}"
            bindinput="onInputIdCard"
            bindfocus="onIdCardFocus"
            bindblur="onIdCardBlur"
            maxlength="18"
          />
          <text class="required-star">*</text>
        </view>
      </view>

      <view class="form-item">
        <view class="input-wrapper {{phoneFocus ? 'focus' : ''}}">
          <text class="input-icon">手机</text>
          <input
            class="input-field"
            type="number"
            placeholder="11位手机号"
            placeholder-class="placeholder"
            value="{{phone}}"
            bindinput="onInputPhone"
            bindfocus="onPhoneFocus"
            bindblur="onPhoneBlur"
            maxlength="11"
          />
          <text class="required-star">*</text>
        </view>
      </view>

      <block wx:if="{{registerRole === 'worker'}}">
        <view class="form-item">
          <view class="input-wrapper">
            <text class="input-icon">性别</text>
            <picker mode="selector" range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="onGenderChange">
              <view class="input-field picker-field {{genderIndex === 0 ? 'picker-placeholder' : ''}}">
                {{genderOptions[genderIndex].label}}
              </view>
            </picker>
            <text class="required-star">*</text>
          </view>
        </view>

        <view class="form-item">
          <view class="input-wrapper">
            <text class="input-icon">贫困</text>
            <picker mode="selector" range="{{povertyOptions}}" range-key="label" value="{{povertyIndex}}" bindchange="onPovertyChange">
              <view class="input-field picker-field {{povertyIndex === 0 ? 'picker-placeholder' : ''}}">
                {{povertyOptions[povertyIndex].label}}
              </view>
            </picker>
            <text class="required-star">*</text>
          </view>
        </view>
      </block>

      <view class="form-item">
        <view class="input-wrapper input-wrapper-multiline">
          <text class="input-icon">住址</text>
          <textarea
            class="input-field input-area"
            placeholder="身份证地址（与证件一致，至少5个字）"
            placeholder-class="placeholder"
            value="{{homeAddress}}"
            bindinput="onInputHomeAddress"
            maxlength="120"
            auto-height
          />
          <text class="required-star">*</text>
        </view>
      </view>

      <block wx:if="{{registerRole === 'worker'}}">
        <view class="form-item">
          <view class="input-wrapper">
            <text class="input-icon">银行</text>
            <input
              class="input-field"
              type="text"
              placeholder="如：中国农业银行"
              placeholder-class="placeholder"
              value="{{bankName}}"
              bindinput="onInputBankName"
            />
            <text class="required-star">*</text>
          </view>
        </view>

        <view class="form-item">
          <view class="input-wrapper">
            <text class="input-icon">卡号</text>
            <input
              class="input-field"
              type="number"
              placeholder="银行卡号"
              placeholder-class="placeholder"
              value="{{bankCardNo}}"
              bindinput="onInputBankCardNo"
              maxlength="30"
            />
            <text class="required-star">*</text>
          </view>
        </view>
      </block>

      <block wx:if="{{registerRole === 'boss'}}">
        <view class="form-item">
          <view class="input-wrapper">
            <text class="input-icon">银行</text>
            <picker mode="selector" range="{{bossBankOptions}}" range-key="label" value="{{bossBankIndex}}" bindchange="onBossBankChange">
              <view class="input-field picker-field {{bossBankIndex === 0 ? 'picker-placeholder' : ''}}">
                {{bossBankOptions[bossBankIndex].label}}
              </view>
            </picker>
            <text class="required-star">*</text>
          </view>
        </view>

        <view class="form-item">
          <view class="input-wrapper">
            <text class="input-icon">卡号</text>
            <input
              class="input-field"
              type="number"
              placeholder="16-19位银行卡号"
              placeholder-class="placeholder"
              value="{{bankCardNo}}"
              bindinput="onInputBankCardNo"
              maxlength="19"
            />
            <text class="required-star">*</text>
          </view>
          <view class="input-hint">
            <text class="hint-text">老板账号银行卡号需填写16-19位数字</text>
          </view>
        </view>
      </block>
    </view>

    <view class="form-section" wx:if="{{registerRole === 'worker' && registerMode === 'proxy'}}">
      <view class="section-label">
        <text>代办人信息</text>
      </view>

      <view class="form-item">
        <view class="input-wrapper">
          <text class="input-icon">代办</text>
          <input
            class="input-field"
            type="text"
            placeholder="代办人姓名"
            placeholder-class="placeholder"
            value="{{proxyName}}"
            bindinput="onInputProxyName"
          />
          <text class="required-star">*</text>
        </view>
      </view>

      <view class="form-item">
        <view class="input-wrapper">
          <text class="input-icon">电话</text>
          <input
            class="input-field"
            type="number"
            placeholder="代办人11位手机号"
            placeholder-class="placeholder"
            value="{{proxyPhone}}"
            bindinput="onInputProxyPhone"
            maxlength="11"
          />
          <text class="required-star">*</text>
        </view>
      </view>

      <view class="form-item">
        <view class="input-wrapper">
          <text class="input-icon">关系</text>
          <input
            class="input-field"
            type="text"
            placeholder="与工人关系，如：子女/配偶/父母"
            placeholder-class="placeholder"
            value="{{relationToWorker}}"
            bindinput="onInputRelationToWorker"
          />
          <text class="required-star">*</text>
        </view>
      </view>

      <view class="form-item">
        <view class="input-wrapper input-wrapper-multiline">
          <text class="input-icon">声明</text>
          <textarea
            class="input-field input-area"
            placeholder="授权声明（选填），如：已获本人授权办理入职"
            placeholder-class="placeholder"
            value="{{consentStatement}}"
            bindinput="onInputConsentStatement"
            maxlength="120"
            auto-height
          />
        </view>
      </view>
    </view>

    <view class="form-section">
      <view class="section-label">
        <text>紧急联系人</text>
        <text class="section-optional">选填</text>
      </view>

      <view class="form-item">
        <view class="input-wrapper">
          <text class="input-icon">联系人</text>
          <input
            class="input-field"
            type="text"
            placeholder="姓名及关系，如：李四-配偶"
            placeholder-class="placeholder"
            value="{{emergencyContact}}"
            bindinput="onInputEmergencyContact"
          />
        </view>
      </view>

      <view class="form-item">
        <view class="input-wrapper">
          <text class="input-icon">电话</text>
          <input
            class="input-field"
            type="number"
            placeholder="紧急联系人电话"
            placeholder-class="placeholder"
            value="{{emergencyPhone}}"
            bindinput="onInputEmergencyPhone"
            maxlength="11"
          />
        </view>
      </view>
    </view>

    <view class="error-msg" wx:if="{{error}}">
      <text>{{error}}</text>
    </view>

    <button
      class="register-btn"
      hover-class="register-btn-hover"
      bindtap="handleRegister"
      loading="{{loading}}"
      disabled="{{loading}}"
    >{{loading ? '提交中...' : (registerRole === 'boss' ? '创建老板账号' : (registerMode === 'proxy' ? '提交代注册' : '立即注册'))}}</button>

    <view class="footer-links">
      <text class="login-text">已有账号？</text>
      <text class="login-link" bindtap="goToLogin">返回登录</text>
    </view>

    <view class="network-panel">
      <view class="network-header" bindtap="toggleApiConfig">
        <text class="network-title">网络设置</text>
        <text class="network-summary">当前接口：{{currentBaseUrlDisplay}}</text>
      </view>

      <view wx:if="{{showApiConfig}}" class="network-body">
        <text class="network-tip">手机真机调试请填写电脑可访问的内网地址，例如 `http://192.168.1.10:3001/api`。</text>
        <input
          class="network-input"
          type="text"
          value="{{apiBaseUrlInput}}"
          placeholder="http://你的电脑内网IP:3001/api"
          placeholder-class="placeholder"
          bindinput="onInputApiBaseUrl"
        />
        <view class="preset-row">
          <view class="preset-chip" data-url="{{devtoolsBaseUrl}}" bindtap="useApiPreset" wx:if="{{devtoolsBaseUrl}}">开发者工具</view>
          <view class="preset-chip" data-url="{{lanBaseUrl}}" bindtap="useApiPreset" wx:if="{{lanBaseUrl}}">当前局域网预设</view>
        </view>
        <button class="network-save-btn" bindtap="saveApiBaseUrl">保存接口地址</button>
      </view>
    </view>
  </view>
</view>
