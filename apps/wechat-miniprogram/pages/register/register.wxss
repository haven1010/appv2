page {
  background: #f5f5f7;
}

.register-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 36rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #f5f5f7;
  color: #111111;
}

.steps-container {
  position: relative;
  min-height: calc(100vh - 144rpx);
  overflow: hidden;
}

.step {
  position: absolute;
  width: 100%;
  left: 0;
  top: 0;
  box-sizing: border-box;
  transition: transform 0.34s ease, opacity 0.34s ease;
}

.step.current {
  position: relative;
  transform: translateX(0);
  opacity: 1;
  z-index: 2;
}

.step.past {
  transform: translateX(-28%);
  opacity: 0;
  pointer-events: none;
}

.step.future {
  transform: translateX(28%);
  opacity: 0;
  pointer-events: none;
}

.step-body {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.brand-mark {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 26rpx;
}

.brand-logo {
  width: 82rpx;
  height: 82rpx;
}

.brand-name {
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #767676;
  margin-bottom: 22rpx;
}

.step-title {
  font-size: 64rpx;
  line-height: 1.08;
  font-weight: 900;
  color: #111111;
  letter-spacing: 0;
}

.step-desc {
  margin-top: 22rpx;
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #8b8f99;
}

.step-input-area,
.code-input-area {
  margin-top: 74rpx;
}

.phone-row,
.code-input-wrapper {
  height: 128rpx;
  box-sizing: border-box;
  border-radius: 34rpx;
  background: #ffffff;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.06);
}

.phone-row {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  gap: 24rpx;
}

.phone-prefix {
  flex: none;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 900;
  color: #111111;
  padding-right: 24rpx;
  border-right: 2rpx solid #e8e8ed;
}

.input-wrapper {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
}

.input-field,
.code-field {
  width: 100%;
  height: 100%;
  color: #111111;
  background: transparent;
  border: none;
  font-weight: 900;
  box-sizing: border-box;
}

.input-field {
  font-size: 42rpx;
}

.code-field {
  text-align: center;
  font-size: 56rpx;
  letter-spacing: 14rpx;
  padding-left: 14rpx;
}

.placeholder {
  color: #b8bbc3;
  font-weight: 700;
}

.code-back {
  align-self: flex-start;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #111111;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 68rpx;
}

.code-hint-row {
  margin-top: 24rpx;
  text-align: center;
}

.code-hint,
.code-resend {
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 800;
}

.code-hint {
  color: #a2a5ad;
}

.code-resend {
  color: #111111;
}

.primary-btn {
  width: 100%;
  height: 112rpx;
  border-radius: 999rpx;
  margin-top: 42rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 900;
}

.btn-active {
  background: #111111;
  color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.18);
}

.btn-active:active,
.code-back:active,
.login-link-btn:active,
.agreement-link:active {
  opacity: 0.72;
}

.btn-disabled {
  background: #dfdfe4;
  color: #9fa2aa;
  box-shadow: none;
}

.agreement-row {
  margin-top: 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.agreement-check {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 3rpx solid #cfd1d7;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 900;
  margin-top: 3rpx;
}

.agreement-check.checked {
  border-color: #111111;
  background: #111111;
}

.agreement-copy {
  flex: 1;
  line-height: 1.5;
}

.agreement-text,
.agreement-link {
  font-size: 25rpx;
  line-height: 1.5;
}

.agreement-text {
  color: #8b8f99;
}

.agreement-link {
  color: #111111;
  font-weight: 900;
}

.login-link-row {
  margin-top: 46rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
}

.login-link-text,
.login-link-btn {
  font-size: 29rpx;
  line-height: 1.4;
}

.login-link-text {
  color: #9ca0aa;
  font-weight: 700;
}

.login-link-btn {
  color: #111111;
  font-weight: 900;
}

.step-error {
  margin-top: 28rpx;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  background: #fff0f0;
  border: 2rpx solid #ffd4d4;
}

.step-error-text {
  font-size: 27rpx;
  line-height: 1.45;
  color: #d92d20;
  font-weight: 800;
}
