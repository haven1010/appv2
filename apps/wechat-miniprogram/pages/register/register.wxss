.register-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f6ff 0%, #f0ecff 100%);
  position: relative;
  overflow: hidden;
}

/* ─── 背景装饰 ─── */
.bg-blob {
  position: absolute;
  border-radius: 50%;
  z-index: 0;
}

.bg-blob-top {
  width: 600rpx;
  height: 600rpx;
  right: -200rpx;
  top: -150rpx;
  background: radial-gradient(circle, rgba(90, 108, 214, 0.12) 0%, rgba(90, 108, 214, 0.06) 70%, transparent 100%);
}

.bg-blob-bottom {
  width: 500rpx;
  height: 500rpx;
  left: -200rpx;
  bottom: -100rpx;
  background: radial-gradient(circle, rgba(90, 108, 214, 0.1) 0%, rgba(90, 108, 214, 0.05) 70%, transparent 100%);
}

.register-shell {
  position: relative;
  z-index: 2;
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ─── 品牌头部 ─── */
.brand-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(90, 108, 214, 0.08);
  margin-bottom: 20rpx;
  backdrop-filter: blur(20rpx);
}

.brand-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #f5f5f7;
  color: #1a1a2e;
  font-size: 34rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.brand-info {
  flex: 1;
  min-width: 0;
}

.brand-name {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1a1d26;
  line-height: 1.3;
}

.brand-role {
  display: block;
  font-size: 24rpx;
  color: #8e96a8;
  margin-top: 4rpx;
}

/* ─── 身份标识 ─── */
.identity-badge {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(90, 108, 214, 0.08);
  margin-bottom: 20rpx;
}

.identity-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #f5f5f7;
  color: #1a1a2e;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.identity-info {
  flex: 1;
  min-width: 0;
}

.identity-label {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #1a1d26;
}

.identity-desc {
  display: block;
  font-size: 22rpx;
  color: #8e96a8;
  margin-top: 4rpx;
}

/* ─── 注册卡片 ─── */
.register-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(90, 108, 214, 0.1);
  backdrop-filter: blur(20rpx);
}

/* ─── 模式切换 ─── */
.mode-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 6rpx;
  background: #f5f2ff;
  border-radius: 999rpx;
}

.mode-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 72rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #8e96a8;
  transition: all 0.25s;
}

.mode-option.active {
  background: #ffffff;
  color: var(--brand-purple);
  box-shadow: 0 4rpx 12rpx rgba(90, 108, 214, 0.15);
}

.mode-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e8e4f0;
  transition: all 0.25s;
}

.mode-option.active .mode-dot {
  background: var(--brand-purple);
}

/* ─── 区块卡片 ─── */
.section-card {
  margin-bottom: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0ecff;
}

.section-card:last-of-type {
  border-bottom: none;
  margin-bottom: 0;
}

.section-head {
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #1a1d26;
  line-height: 1.4;
}

.section-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8e96a8;
}

/* ─── 表单 ─── */
.form-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.form-item {
  width: 100%;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-half {
  flex: 1;
  min-width: 0;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #4a4d5e;
}

.required {
  color: #ef4444;
}

.input-wrapper {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: #f5f2ff;
  border-radius: 20rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e8e4f0;
  transition: all 0.25s;
  box-sizing: border-box;
}

.input-wrapper.focus {
  border-color: var(--brand-purple);
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(90, 108, 214, 0.1);
}

.input-wrapper-area {
  height: auto;
  min-height: 88rpx;
  padding: 18rpx 20rpx;
  align-items: flex-start;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #1a1d26;
  background: transparent;
  min-height: 44rpx;
}

.input-area {
  min-height: 60rpx;
  line-height: 1.5;
  height: auto;
}

.picker-field {
  display: flex;
  align-items: center;
  height: 100%;
  font-size: 28rpx;
  color: #1a1d26;
}

.picker-field.placeholder {
  color: #8e96a8;
}

.placeholder {
  color: #8e96a8;
  font-size: 26rpx;
}

/* ─── 错误提示 ─── */
.error-msg {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #fef2f2;
  border: 1rpx solid rgba(239, 68, 68, 0.2);
  font-size: 24rpx;
  color: #dc2626;
  line-height: 1.5;
}

/* ─── 提交按钮 ─── */
.register-btn {
  margin-top: 24rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: var(--brand-purple);
  color: #1a1a2e;
  font-size: 34rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(90, 108, 214, 0.25);
}

.register-btn::after {
  border: none;
}

.register-btn-hover {
  transform: scale(0.97);
  opacity: 0.95;
}

.register-btn[disabled] {
  background: #b8b4c8;
  box-shadow: none;
  color: #1a1a2e;
}

/* ─── 底部 ─── */
.footer-links {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.footer-text {
  font-size: 26rpx;
  color: #8e96a8;
}

.footer-link {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand-purple);
}

/* ─── 动画 ─── */
.page-enter {
  animation: slideUp 0.35s ease both;
}

@keyframes slideUp {
  from { opacity: 0; transform: translate3d(0, 30rpx, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}
