  background:
}

.page-body {
  padding: 24rpx;
}

/* ── Filter Section ── */
.filter-section {
  background: var(--card-bg);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: var(--border-soft);
  box-shadow: var(--shadow-md);
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--ink-main);
  min-width: 120rpx;
}

/* ── Picker ── */
.picker-box {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  padding: 0 20rpx;
  background: var(--card-bg-soft);
  border: 1rpx solid rgba(102, 126, 234, 0.12);
  border-radius: 18rpx;
}

.picker-text {
  font-size: 26rpx;
  color: var(--ink-main);
}

.picker-arrow {
  font-size: 20rpx;
  color: var(--ink-muted);
}

/* ── Empty / Loading ── */
.loading-state,
.empty-state {
  text-align: center;
  padding: 140rpx 0;
}

.loading-text,
.empty-text {
  font-size: 26rpx;
  color: var(--ink-muted);
}

.empty-icon {
  display: block;
  font-size: 72rpx;
  margin-bottom: 18rpx;
}

/* ── Applicant List ── */
.applicant-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.applicant-card {
  background: var(--card-bg);
  border-radius: 28rpx;
  padding: 24rpx;
  border: var(--border-soft);
  box-shadow: var(--shadow-md);
  animation: slideIn 0.3s ease-out;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.applicant-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.applicant-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.applicant-name {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--ink-main);
}

.applicant-phone {
  font-size: 24rpx;
  color: var(--brand-purple);
}

/* ── Status Badge ── */
.status-badge {
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.status-badge.pending {
  background: rgba(102, 126, 234, 0.1);
  color: var(--brand-purple);
}

.status-badge.approved {
  background: rgba(49, 164, 124, 0.1);
  color: var(--accent-green);
}

.status-badge.rejected {
  background: rgba(228, 92, 109, 0.1);
  color: var(--accent-red);
}

.status-badge.cancelled {
  background: rgba(176, 170, 192, 0.1);
  color: var(--ink-muted);
}

/* ── Applicant Meta ── */
.applicant-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 14rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--ink-sub);
  line-height: 1.6;
}

/* ── Applicant Actions ── */
.applicant-actions {
  display: flex;
  gap: 12rpx;
  padding-top: 14rpx;
  border-top: var(--border-soft);
}

.action-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 800;
  border: none;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.approve-btn {
  background: var(--brand-purple);
  color: #1a1a2e;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.2);
}

.approve-btn:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.reject-btn {
  background: rgba(228, 92, 109, 0.08);
  color: var(--accent-red);
  border: 1rpx solid rgba(228, 92, 109, 0.14);
}

.reject-btn:active {
  transform: scale(0.97);
}

/* ── Page Bottom Gap ── */
.page-bottom-gap {
  height: 56rpx;
}

/* ── Boss Bottom Nav ── */
.boss-bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  gap: 0;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: var(--border-soft);
  box-shadow: 0 -6rpx 20rpx rgba(102, 126, 234, 0.06);
}

.boss-bottom-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 14rpx 8rpx 10rpx;
  color: var(--ink-sub);
  font-size: 24rpx;
  font-weight: 800;
  background: transparent;
}

.boss-bottom-item.active {
  color: var(--brand-purple);
  background: transparent;
}
