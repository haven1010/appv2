}

.paper-bg {
  display: none;
}

.container {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 26rpx calc(200rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ── Cards ── */
.hero-card,
.section-card {
  background: var(--card-bg);
  border: var(--border-soft);
  border-radius: 30rpx;
  box-shadow: var(--shadow-md);
}

.hero-card {
  padding: 24rpx 22rpx;
}

.hero-title {
  display: block;
  color: var(--ink-main);
  font-size: 36rpx;
  font-weight: 900;
}

.hero-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-sub);
  font-size: 26rpx;
  line-height: 1.6;
}

.section-card {
  padding: 22rpx;
}

.section-title {
  margin-bottom: 14rpx;
  color: var(--ink-main);
  font-size: 30rpx;
  font-weight: 800;
}

.section-title-row {
  margin-bottom: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title-row .section-title {
  margin-bottom: 0;
}

/* ── Readonly Tag ── */
.readonly-tag {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  background: rgba(102, 126, 234, 0.08);
  color: var(--brand-purple);
  font-size: 20rpx;
  font-weight: 700;
}

/* ── Info Row ── */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed rgba(102, 126, 234, 0.16);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 150rpx;
  flex-shrink: 0;
  color: #4a4d5e;
  font-size: 26rpx;
  font-weight: 700;
}

.info-value {
  flex: 1;
  color: var(--ink-main);
  font-size: 26rpx;
  text-align: right;
  word-break: break-all;
}

.info-value.multiline {
  text-align: left;
}

.info-input {
  flex: 1;
  min-width: 0;
  text-align: right;
  color: var(--ink-main);
  font-size: 26rpx;
  line-height: 1.4;
  padding: 0;
}

/* ── Section Actions ── */
.section-actions {
  margin-top: 16rpx;
}

.section-btn {
  width: 100%;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: var(--radius-pill);
  border: none;
  background: var(--brand-purple);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  transition: all 0.2s;
}

.section-btn:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.section-btn[disabled] {
  background: #b8b4c8;
  box-shadow: none;
  color: #ffffff;
}

.section-btn::after {
  border: none;
}

/* ── Loading ── */
.loading-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
}

.loading-text,
.empty-text {
  color: var(--ink-sub);
  font-size: 26rpx;
}

/* ── Actions ── */
.actions-row {
  display: flex;
  gap: 14rpx;
}

.action-btn {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: var(--radius-pill);
  border: none;
  font-size: 30rpx;
  font-weight: 800;
  transition: all 0.2s;
}

.action-btn::after {
  border: none;
}

.action-secondary {
  background: rgba(102, 126, 234, 0.08);
  color: var(--brand-purple);
}

.action-secondary:active {
  transform: scale(0.97);
}

.action-danger {
  background: rgba(228, 92, 109, 0.08);
  color: var(--accent-red);
}

.action-danger:active {
  transform: scale(0.97);
}

/* ── Boss Bottom Nav ── */
.boss-bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  gap: 0;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: var(--border-soft);
  box-shadow: 0 -6rpx 20rpx rgba(102, 126, 234, 0.06);
}

.boss-bottom-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 14rpx 8rpx 10rpx;
  color: var(--ink-sub);
  font-size: 24rpx;
  font-weight: 800;
  background: transparent;
}

.boss-bottom-item.active {
  color: var(--brand-purple);
  background: transparent;
}
