<view class="page page-enter">
  <view class="paper-bg"></view>

  <view class="container">
    <view class="hero-card">
      <text class="hero-title">我的</text>
      <text class="hero-subtitle">这里可以查看老板账号、入驻资料和审核状态。</text>
    </view>

    <view wx:if="{{loading}}" class="section-card loading-card">
      <text class="loading-text">加载中...</text>
    </view>

    <block wx:else>
      <view class="section-card">
        <view class="section-title">账户信息</view>

        <view class="info-row">
          <text class="info-label">姓名</text>
          <input class="info-input" maxlength="20" placeholder="请输入姓名" value="{{accountForm.name}}" data-field="name" bindinput="onAccountFieldInput" />
        </view>
        <view class="info-row">
          <text class="info-label">UID</text>
          <text class="info-value">{{profile.uid}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">手机号</text>
          <input class="info-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{accountForm.phone}}" data-field="phone" bindinput="onAccountFieldInput" />
        </view>
        <view class="info-row">
          <text class="info-label">身份证</text>
          <text class="info-value">{{profile.idCardMasked}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">角色</text>
          <text class="info-value">{{roleText}}</text>
        </view>

        <view class="section-actions">
          <button class="section-btn" loading="{{accountSaving}}" disabled="{{accountSaving}}" bindtap="saveAccountInfo">
            {{accountSaving ? '保存中...' : '保存账户信息'}}
          </button>
        </view>
      </view>

      <view class="section-card">
        <view class="section-title-row">
          <view class="section-title">入驻信息</view>
          <text class="readonly-tag">{{latestBase ? latestBase.auditStatusText : '未入驻'}}</text>
        </view>

        <block wx:if="{{latestBase}}">
          <view class="info-row">
            <text class="info-label">基地名称</text>
            <text class="info-value">{{latestBase.baseName}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">企业类别</text>
            <text class="info-value">{{latestBase.categoryText}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">区域编码</text>
            <text class="info-value">{{latestBase.regionCode}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">联系电话</text>
            <text class="info-value">{{latestBase.contactPhone}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">基地地址</text>
            <text class="info-value multiline">{{latestBase.address}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">提交时间</text>
            <text class="info-value">{{latestBase.submittedAtText}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">更新时间</text>
            <text class="info-value">{{latestBase.updatedAtText}}</text>
          </view>
        </block>

        <view wx:else class="empty-text">暂未提交基地入驻信息</view>
      </view>
    </block>

    <view class="actions-row">
      <button class="action-btn action-secondary" bindtap="loadProfile">刷新信息</button>
      <button class="action-btn action-danger" bindtap="logout">退出登录</button>
    </view>

    <view class="boss-bottom-nav">
      <view class="boss-bottom-item" bindtap="goToBossDashboard">工作台</view>
      <view class="boss-bottom-item" bindtap="goToBossBaseList">我的基地</view>
      <view class="boss-bottom-item" bindtap="goToBossJobList">岗位发布</view>
      <view class="boss-bottom-item active">我的</view>
    </view>
  </view>
</view>
