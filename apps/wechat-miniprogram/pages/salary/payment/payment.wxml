<view class="page">
  <view class="page-body page-enter">
    <view class="header-card ds-card card-in">
      <text class="header-icon">💳</text>
      <text class="header-title">支付进度</text>
      <view class="amount-display">¥{{amount}}</view>
      <view class="status-badge {{statusClass}}">{{statusText}}</view>
    </view>

    <view class="timeline-card ds-card card-in delay-1">
      <view class="timeline-item {{item.completed ? 'completed' : ''}} {{item.active ? 'active' : ''}}" wx:for="{{steps}}" wx:key="title">
        <view class="timeline-dot">
          <text class="timeline-icon" wx:if="{{item.completed}}">✓</text>
          <view class="timeline-pulse" wx:if="{{item.active}}"></view>
        </view>
        <view class="timeline-content">
          <text class="timeline-title">{{item.title}}</text>
          <text class="timeline-time">{{item.time}}</text>
        </view>
      </view>
    </view>

    <view class="info-card ds-card card-in delay-2">
      <text class="section-title">发放信息</text>
      <view class="info-row" wx:if="{{payoutType}}">
        <text class="info-label">发放方式</text>
        <text class="info-value">{{payoutTypeText}}</text>
      </view>
      <view class="info-row" wx:if="{{bankCard}}">
        <text class="info-label">收款账户</text>
        <text class="info-value">{{bankCard}}</text>
      </view>
      <view class="info-row" wx:if="{{confirmedTime}}">
        <text class="info-label">确认时间</text>
        <text class="info-value">{{confirmedTime}}</text>
      </view>
      <view class="info-row" wx:if="{{status < 2}}">
        <text class="info-label">预计到账</text>
        <text class="info-value">{{estimatedArrival}}</text>
      </view>
      <view class="info-row" wx:if="{{paidTime && status >= 2}}">
        <text class="info-label">到账时间</text>
        <text class="info-value">{{paidTime}}</text>
      </view>
    </view>

    <view class="tips-card ds-card card-in delay-3" wx:if="{{status < 2}}">
      <text class="tips-title">💡 温馨提示</text>
      <text class="tips-item">• 工资将在确认后1-3个工作日内到账</text>
      <text class="tips-item">• 如遇节假日可能顺延</text>
      <text class="tips-item">• 到账后会收到短信通知</text>
    </view>

    <view class="action-card card-in delay-4">
      <button class="btn-ghost" bindtap="goBack">返回</button>
    </view>

    <view class="page-bottom-gap"></view>
  </view>
</view>
