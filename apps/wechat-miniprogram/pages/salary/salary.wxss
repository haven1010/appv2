/* pages/salary/salary.wxss — Claude Purple Theme */
.page {
  background: var(--page-bg);
}

.page-body {
  padding: 24rpx 28rpx calc(186rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ── Section Header Accent ── */
.salary-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.salary-header-accent {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: var(--brand-gradient);
  flex-shrink: 0;
}

.salary-header-title {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--ink-main);
}

/* Shared card classes */
.ds-card {
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-in {
  animation: fadeUp 0.4s ease both;
}

.delay-1 { animation-delay: 90ms; }

.summary-card {
  text-align: center;
}

.summary-title {
  display: block;
  font-size: 36rpx;
  line-height: 1.35;
  color: var(--ink-main);
  font-weight: 800;
}

.summary-time {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--ink-sub);
}

.summary-amount {
  display: block;
  margin-top: 14rpx;
  font-size: 68rpx;
  line-height: 1.1;
  color: var(--brand-purple);
  font-weight: 900;
}

.summary-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.summary-item {
  flex: 1;
  min-width: 0;
  border-radius: var(--radius-md);
  background: var(--card-bg-soft);
  padding: 14rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.summary-icon {
  font-size: 30rpx;
  line-height: 1;
}

.summary-text {
  font-size: 28rpx;
  line-height: 1.35;
  color: var(--ink-main);
  font-weight: 700;
}

.refresh-btn {
  margin-top: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-purple);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  border: none;
}

.refresh-btn::after {
  border: none;
}

.section-head {
  margin-top: 32rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-copy {
  flex: 1;
  min-width: 0;
}

.section-title {
  font-size: 34rpx;
  line-height: 1.35;
  color: var(--ink-main);
  font-weight: 800;
}

.section-note {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--ink-sub);
}

.section-count {
  min-width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  color: #ffffff;
  background: var(--brand-purple);
  font-weight: 700;
}

.state-card,
.empty-card {
  text-align: center;
}

.empty-icon {
  display: block;
  font-size: 70rpx;
  line-height: 1;
}

.state-title {
  display: block;
  margin-top: 10rpx;
  font-size: 32rpx;
  line-height: 1.45;
  color: var(--ink-main);
  font-weight: 700;
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--ink-sub);
}

.go-job-btn {
  margin-top: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-pill);
  background: var(--card-bg-soft);
  color: var(--brand-purple);
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.go-job-btn::after {
  border: none;
}

.pending-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.pending-card {
  padding: 24rpx;
}

.pending-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.pending-main {
  flex: 1;
  min-width: 0;
}

.pending-base {
  display: block;
  font-size: 32rpx;
  line-height: 1.35;
  color: var(--ink-main);
  font-weight: 800;
}

.pending-date {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--ink-sub);
}

.pending-amount {
  font-size: 42rpx;
  line-height: 1.2;
  color: var(--brand-purple);
  font-weight: 900;
}

.pending-meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.meta-chip {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
  background: rgba(102, 126, 234, 0.1);
  color: var(--brand-purple);
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
}

.pending-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.status-chip {
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 700;
}

.status-chip.pending {
  color: var(--brand-purple);
  background: rgba(102, 126, 234, 0.1);
}

.status-chip.confirmed {
  color: var(--accent-gold);
  background: rgba(242, 184, 75, 0.15);
}

.status-chip.paid {
  color: var(--accent-green);
  background: rgba(49, 164, 124, 0.1);
}

.action-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.confirm-btn {
  min-width: 180rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: var(--brand-purple);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  transform: scale(1);
  transition: transform 120ms ease;
  border: none;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn-press {
  transform: scale(0.95);
}

.appeal-btn,
.appeal-cancel-btn,
.appeal-submit-btn {
  min-width: 180rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 800;
  border: none;
}

.appeal-btn {
  background: rgba(102, 126, 234, 0.1);
  color: var(--brand-purple);
}

.appeal-cancel-btn {
  background: var(--card-bg-soft);
  color: var(--ink-sub);
}

.appeal-submit-btn {
  background: var(--brand-purple);
  color: #ffffff;
}

.appeal-btn::after,
.appeal-cancel-btn::after,
.appeal-submit-btn::after {
  border: none;
}

.appeal-panel {
  margin-top: 16rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg-soft);
  border: var(--border-soft);
  padding: 16rpx 18rpx;
}

.appeal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
}

.appeal-chip {
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 700;
}

.appeal-chip.appeal-pending {
  color: var(--accent-gold);
  background: rgba(242, 184, 75, 0.15);
}

.appeal-chip.appeal-resolved {
  color: var(--accent-green);
  background: rgba(49, 164, 124, 0.1);
}

.appeal-chip.appeal-rejected {
  color: var(--accent-red);
  background: rgba(228, 92, 109, 0.1);
}

.appeal-line,
.appeal-time {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ink-sub);
}

.appeal-editor {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed rgba(102, 126, 234, 0.16);
}

.appeal-textarea,
.appeal-input {
  width: 100%;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: #f5f2ff;
  border: var(--border-soft);
  padding: 18rpx;
  font-size: 28rpx;
  color: var(--ink-main);
  transition: all 0.25s;
}

.appeal-textarea:focus,
.appeal-input:focus {
  border-color: var(--brand-purple);
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.appeal-textarea {
  min-height: 160rpx;
}

.appeal-input {
  margin-top: 14rpx;
}

.appeal-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
}

.page-bottom-gap {
  height: 24rpx;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
