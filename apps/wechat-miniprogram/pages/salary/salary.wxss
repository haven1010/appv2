/* pages/salary/salary.wxss — iOS-style income dashboard */
page {
  background: #f5f5f7 !important;
  color: #111111;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.page {
  min-height: 100vh;
  background: #f5f5f7;
}

.page-body {
  padding: 28rpx 28rpx calc(188rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.summary-card,
.state-card,
.empty-card,
.pending-card {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 18rpx 44rpx rgba(15, 23, 42, 0.06);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.summary-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 32rpx 30rpx;
  border-radius: 38rpx;
}

.summary-card::before {
  content: '';
  position: absolute;
  right: -120rpx;
  top: -150rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(52, 199, 89, 0.18) 0%, rgba(52, 199, 89, 0) 68%);
  pointer-events: none;
}

.summary-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.summary-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0;
}

.summary-time {
  display: block;
  margin-top: 10rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 700;
}

.refresh-btn {
  min-width: 104rpx;
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: none;
  background: rgba(17, 17, 17, 0.06);
  color: #111111;
  font-size: 25rpx;
  line-height: 58rpx;
  font-weight: 800;
}

.refresh-btn::after {
  border: none;
}

.refresh-btn:active {
  opacity: 0.72;
}

.summary-label {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 56rpx;
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 800;
}

.summary-amount {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  color: #111111;
  font-size: 78rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 0;
  overflow-wrap: anywhere;
}

.summary-row {
  position: relative;
  z-index: 1;
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.summary-item {
  min-width: 0;
  min-height: 150rpx;
  padding: 20rpx 16rpx;
  border-radius: 26rpx;
  background: #f7f7f8;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.summary-icon {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #111111;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 46rpx;
  text-align: center;
  font-weight: 900;
}

.summary-label-small {
  margin-top: 18rpx;
  color: #8e8e93;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 800;
}

.summary-text {
  margin-top: 8rpx;
  color: #111111;
  font-size: 27rpx;
  line-height: 1.18;
  font-weight: 900;
  overflow-wrap: anywhere;
}

.section-head {
  margin: 40rpx 4rpx 18rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.section-copy {
  flex: 1;
  min-width: 0;
}

.section-title {
  color: #111111;
  font-size: 38rpx;
  line-height: 1.15;
  font-weight: 900;
}

.section-note {
  display: block;
  max-width: 560rpx;
  margin-top: 10rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 700;
}

.section-count {
  min-width: 84rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ededee;
  color: #111111;
  font-size: 25rpx;
  line-height: 52rpx;
  text-align: center;
  font-weight: 900;
  flex-shrink: 0;
  box-sizing: border-box;
}

.state-card,
.empty-card {
  border-radius: 34rpx;
  padding: 54rpx 34rpx;
  text-align: center;
}

.loading-pulse {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #111111;
  box-shadow: 0 0 0 18rpx rgba(17, 17, 17, 0.06);
  animation: salaryPulse 1.2s ease-in-out infinite;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto;
  border-radius: 28rpx;
  background: #f2f2f4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon view {
  width: 42rpx;
  height: 48rpx;
  border-radius: 10rpx;
  border: 6rpx solid #111111;
  box-sizing: border-box;
  position: relative;
}

.empty-icon view::before {
  content: '';
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: -15rpx;
  height: 14rpx;
  border-radius: 999rpx 999rpx 0 0;
  border: 5rpx solid #111111;
  border-bottom: none;
}

.state-title {
  display: block;
  margin-top: 26rpx;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 900;
}

.state-desc {
  display: block;
  max-width: 520rpx;
  margin: 12rpx auto 0;
  color: #8e8e93;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 700;
}

.go-job-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 34rpx;
  padding: 0;
  border-radius: 999rpx;
  border: none;
  background: #111111;
  color: #ffffff;
  font-size: 31rpx;
  line-height: 1;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.go-job-btn::after {
  border: none;
}

.go-job-btn:active {
  opacity: 0.76;
}

.pending-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.pending-card {
  border-radius: 34rpx;
  padding: 30rpx;
}

.pending-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.pending-main {
  flex: 1;
  min-width: 0;
}

.pending-base {
  display: block;
  color: #111111;
  font-size: 33rpx;
  line-height: 1.25;
  font-weight: 900;
}

.pending-date {
  display: block;
  margin-top: 10rpx;
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 700;
}

.pending-amount {
  max-width: 250rpx;
  color: #111111;
  font-size: 42rpx;
  line-height: 1.05;
  font-weight: 900;
  text-align: right;
  overflow-wrap: anywhere;
  flex-shrink: 0;
}

.pending-meta {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-chip {
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: #f2f2f4;
  color: #5f6368;
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 800;
}

.appeal-panel {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f7f7f8;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.appeal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
}

.appeal-chip {
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 900;
}

.appeal-chip.appeal-pending {
  color: #9a6700;
  background: #fff4cc;
}

.appeal-chip.appeal-resolved {
  color: #16853f;
  background: #ddf8e7;
}

.appeal-chip.appeal-rejected {
  color: #c22a2a;
  background: #ffe4e4;
}

.appeal-line,
.appeal-time {
  display: block;
  margin-top: 10rpx;
  color: #6f7278;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 700;
}

.pending-foot {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.status-chip {
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 900;
  flex-shrink: 0;
}

.status-chip.pending {
  color: #111111;
  background: #ededee;
}

.status-chip.confirmed {
  color: #9a6700;
  background: #fff4cc;
}

.status-chip.paid {
  color: #16853f;
  background: #ddf8e7;
}

.action-group {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.confirm-btn,
.appeal-btn {
  min-width: 168rpx;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 76rpx;
  font-weight: 900;
}

.confirm-btn {
  background: #111111;
  color: #ffffff;
}

.appeal-btn {
  background: #f2f2f4;
  color: #111111;
}

.confirm-btn::after,
.appeal-btn::after {
  border: none;
}

.confirm-btn:active,
.appeal-btn:active {
  opacity: 0.74;
}

.appeal-editor {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed rgba(0, 0, 0, 0.12);
}

.appeal-textarea,
.appeal-input {
  width: 100%;
  box-sizing: border-box;
  border-radius: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  background: #f7f7f8;
  color: #111111;
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 700;
  padding: 22rpx;
}

.appeal-textarea {
  min-height: 176rpx;
}

.appeal-input {
  margin-top: 16rpx;
}

.appeal-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 14rpx;
  justify-content: flex-end;
}

.appeal-cancel-btn,
.appeal-submit-btn {
  min-width: 156rpx;
  height: 74rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 28rpx;
  line-height: 74rpx;
  font-weight: 900;
}

.appeal-cancel-btn {
  background: #f2f2f4;
  color: #111111;
}

.appeal-submit-btn {
  background: #111111;
  color: #ffffff;
}

.appeal-cancel-btn::after,
.appeal-submit-btn::after {
  border: none;
}

.page-bottom-gap {
  height: 24rpx;
}

@keyframes salaryPulse {
  0%, 100% { transform: scale(0.92); opacity: 0.72; }
  50% { transform: scale(1); opacity: 1; }
}
