/* pages/salary/appeal/appeal.wxss — Claude Purple Theme */
.page {
  min-height: 100vh;
  background: var(--page-bg);
}

.page-body {
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

/* Shared card classes */
.ds-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  border: var(--border-soft);
  box-shadow: var(--shadow-md);
}

.card-in {
  animation: fadeUp 0.4s ease both;
}

.delay-1 { animation-delay: 0.1s; }
.delay-2 { animation-delay: 0.2s; }
.delay-3 { animation-delay: 0.3s; }
.delay-4 { animation-delay: 0.4s; }
.delay-5 { animation-delay: 0.5s; }

.header-card {
  text-align: center;
}

.header-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 16rpx;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 900;
  color: var(--ink-main);
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--ink-sub);
  line-height: 1.6;
}

.info-card {
  margin-top: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 28rpx;
  color: var(--ink-sub);
}

.info-value {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--brand-purple);
}

.form-card {
  margin-top: 16rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-main);
  margin-bottom: 12rpx;
}

.form-label.required::after {
  content: ' *';
  color: var(--accent-red);
}

.form-textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 20rpx;
  background: #f5f2ff;
  border: var(--border-soft);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--ink-main);
  line-height: 1.6;
  box-sizing: border-box;
  transition: all 0.25s;
}

.form-textarea:focus {
  border-color: var(--brand-purple);
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  background: #f5f2ff;
  border: var(--border-soft);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  color: var(--ink-main);
  box-sizing: border-box;
  transition: all 0.25s;
}

.form-input:focus {
  border-color: var(--brand-purple);
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: var(--ink-sub);
  margin-top: 8rpx;
}

.form-hint {
  display: block;
  font-size: 24rpx;
  color: var(--ink-sub);
  margin-top: 8rpx;
  line-height: 1.5;
}

.tips-card {
  margin-top: 16rpx;
  background: rgba(102, 126, 234, 0.06);
  border: 1rpx solid rgba(102, 126, 234, 0.1);
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--brand-purple);
  margin-bottom: 12rpx;
}

.tips-item {
  display: block;
  font-size: 24rpx;
  color: var(--ink-sub);
  line-height: 1.8;
  margin-bottom: 4rpx;
}

.tips-item:last-child {
  margin-bottom: 0;
}

.action-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-primary,
.btn-ghost {
  width: 100%;
  height: 88rpx;
  border-radius: var(--radius-pill);
  font-size: 32rpx;
  font-weight: 800;
  border: none;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: var(--brand-purple);
  color: #1a1a2e;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.btn-primary[disabled] {
  background: #b8b4c8;
  box-shadow: none;
  color: #1a1a2e;
}

.btn-ghost {
  background: transparent;
  color: var(--brand-purple);
}

.btn-ghost:active {
  opacity: 0.6;
}

.page-bottom-gap {
  height: 48rpx;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.page-enter {
  animation: fadeIn 0.3s ease both;
}
