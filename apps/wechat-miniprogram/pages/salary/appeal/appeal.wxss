.page {
  min-height: 100vh;
  background: #F8FAFC;
}

.page-body {
  padding: 16px;
}

.header-card {
  padding: 32px 24px;
  margin-bottom: 16px;
  text-align: center;
}

.header-icon {
  font-size: 48px;
  display: block;
  margin-bottom: 12px;
}

.header-title {
  display: block;
  font-size: 24px;
  font-weight: 600;
  color: #0F172A;
  margin-bottom: 8px;
}

.header-subtitle {
  display: block;
  font-size: 14px;
  color: #64748B;
  line-height: 1.6;
}

.info-card {
  padding: 20px;
  margin-bottom: 16px;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 16px;
  color: #64748B;
}

.info-value {
  font-size: 24px;
  font-weight: 700;
  color: #F97316;
}

.form-card {
  padding: 20px;
  margin-bottom: 16px;
}

.form-label {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #0F172A;
  margin-bottom: 12px;
}

.form-label.required::after {
  content: ' *';
  color: #EF4444;
}

.form-textarea {
  width: 100%;
  min-height: 120px;
  padding: 12px;
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  font-size: 14px;
  color: #0F172A;
  line-height: 1.6;
  box-sizing: border-box;
}

.form-input {
  width: 100%;
  height: 48px;
  padding: 0 12px;
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  font-size: 16px;
  color: #0F172A;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 12px;
  color: #94A3B8;
  margin-top: 8px;
}

.form-hint {
  display: block;
  font-size: 12px;
  color: #64748B;
  margin-top: 8px;
  line-height: 1.5;
}

.tips-card {
  padding: 20px;
  margin-bottom: 16px;
  background: #FEF3C7;
}

.tips-title {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #92400E;
  margin-bottom: 12px;
}

.tips-item {
  display: block;
  font-size: 14px;
  color: #78350F;
  line-height: 1.8;
  margin-bottom: 4px;
}

.tips-item:last-child {
  margin-bottom: 0;
}

.action-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 16px;
}

.btn-primary, .btn-ghost {
  width: 100%;
  height: 48px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #F97316, #FB923C);
  color: #FFFFFF;
}

.btn-ghost {
  background: #FFFFFF;
  color: #64748B;
  border: 1px solid #E2E8F0;
}

.page-bottom-gap {
  height: 40px;
}

.ds-card {
  background: #FFFFFF;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.page-enter {
  animation: fadeIn 0.3s ease-in;
}

.card-in {
  animation: slideUp 0.4s ease-out;
}

.delay-1 { animation-delay: 0.1s; }
.delay-2 { animation-delay: 0.2s; }
.delay-3 { animation-delay: 0.3s; }
.delay-4 { animation-delay: 0.4s; }
.delay-5 { animation-delay: 0.5s; }

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
