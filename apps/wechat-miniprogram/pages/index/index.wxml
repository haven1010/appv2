<view class="page senior-home">
  <view wx:if="{{showSplash}}" class="home-splash" bindtap="hideSplash">
    <view class="home-splash-stage">
      <image class="home-splash-hero" src="/images/splash-hero.png" mode="aspectFit"></image>
    </view>

    <view class="home-splash-brand">
      <image class="home-splash-logo" src="/images/zhihui-logo.webp" mode="aspectFit"></image>
      <text class="home-splash-name">智绘就业</text>
    </view>
    <text class="home-splash-hint">乡村振兴就业服务平台</text>
  </view>

  <view class="page-body senior-home-body">

    <view class="home-hero">
      <view class="home-title-row">
        <text class="home-title-greeting">{{greetingLabel}}</text>
        <text class="home-title-name">{{greetingName}}</text>
      </view>
      <text class="home-date">{{dateText}}</text>
    </view>

    <view class="home-rule"></view>

    <!-- ── 实名认证提示横幅 ── -->
    <view class="verify-banner {{showVerifyBanner ? 'visible' : ''}}" wx:if="{{showVerifyBanner}}" bindtap="goToVerify">
      <view class="verify-dot"></view>
      <view class="verify-banner-text">
        <text class="verify-banner-title">完成实名认证</text>
        <text class="verify-banner-desc">填写信息即可找活报名</text>
      </view>
      <text class="verify-banner-arrow">›</text>
    </view>

    <!-- ── 主要行动 ── -->
    <view class="primary-action-card" bindtap="goToJobList" hover-class="action-card-press">
      <image class="primary-action-bg" src="{{actionCardBg}}" mode="aspectFill" binderror="onActionBgError"></image>
      <view class="primary-action-mask"></view>
      <view class="primary-action-copy">
        <text class="primary-action-title">开始找活</text>
        <text class="primary-action-desc">浏览附近基地岗位</text>
        <view class="primary-action-button">
          <text>找工作</text>
        </view>
      </view>
    </view>

    <view class="support-grid">
      <view class="support-card" bindtap="goToSalary" hover-class="action-card-press">
        <view class="support-card-icon">¥</view>
        <view class="support-card-copy">
          <text class="support-card-title">看工资</text>
          <text class="support-card-desc">{{salaryHint}}</text>
        </view>
      </view>
      <view class="support-card" bindtap="goToMySignups" hover-class="action-card-press">
        <view class="support-card-icon">+</view>
        <view class="support-card-copy">
          <text class="support-card-title">我的报名</text>
          <text class="support-card-desc">{{signupHint}}</text>
        </view>
      </view>
    </view>

    <!-- ── 底部安全区 ── -->
    <view class="page-bottom-gap"></view>

  </view>
</view>
