/* pages/index/index.wxss — worker home, monochrome daily-dashboard style */

page {
  background: #fbfbfa !important;
  color: #111111;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.senior-home {
  min-height: 100vh;
  background:
    radial-gradient(circle at 20% 12%, rgba(255, 255, 255, 0.96) 0, rgba(255, 255, 255, 0) 34%),
    linear-gradient(180deg, #fbfbfa 0%, #f4f4f2 100%);
}

.home-splash {
  position: fixed;
  inset: 0;
  z-index: 9999;
  box-sizing: border-box;
  padding: calc(96rpx + env(safe-area-inset-top)) 48rpx calc(70rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

.home-splash-stage {
  position: relative;
  width: 690rpx;
  height: 820rpx;
  margin-top: 130rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-splash-hero {
  width: 690rpx;
  height: 820rpx;
  display: block;
}

.home-splash-brand {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.home-splash-logo {
  width: 78rpx;
  height: 78rpx;
  display: block;
}

.home-splash-name {
  color: #1d1d25;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 0;
}

.home-splash-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(88rpx + env(safe-area-inset-bottom));
  color: #b8bdc8;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  text-align: center;
}

.senior-home-body {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 18rpx 28rpx calc(164rpx + env(safe-area-inset-bottom));
}

.home-hero {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.home-title-row {
  max-width: 660rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 24rpx;
  flex-wrap: wrap;
}

.home-title-greeting,
.home-title-name {
  color: #111111;
  font-size: 64rpx;
  line-height: 1.08;
  font-weight: 900;
  letter-spacing: 0;
}

.home-title-name {
  position: relative;
}

.home-title-name::after {
  content: '';
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: -10rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.08);
}

.home-date {
  margin-top: 28rpx;
  color: #9d9d9d;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 0;
}

.home-rule {
  height: 2rpx;
  margin: 28rpx 0 40rpx;
  background: rgba(17, 17, 17, 0.08);
}

.primary-action-card {
  position: relative;
  overflow: hidden;
  min-height: 720rpx;
  border-radius: 34rpx;
  background: #e8ebe6;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 92rpx 56rpx 128rpx;
  box-shadow: none;
}

.primary-action-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.primary-action-mask {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(180deg, rgba(0, 0, 0, 0.10) 0%, rgba(0, 0, 0, 0.36) 100%),
    linear-gradient(90deg, rgba(0, 0, 0, 0.34) 0%, rgba(0, 0, 0, 0.14) 58%, rgba(0, 0, 0, 0.26) 100%);
}

.primary-action-copy {
  position: relative;
  z-index: 2;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.primary-action-title {
  max-width: 520rpx;
  color: #ffffff;
  font-size: 54rpx;
  line-height: 1.18;
  font-weight: 900;
  letter-spacing: 0;
}

.primary-action-desc {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 34rpx;
  line-height: 1.32;
  font-weight: 600;
}

.primary-action-button {
  margin-top: 58rpx;
  min-width: 210rpx;
  height: 88rpx;
  padding: 0 52rpx;
  border-radius: 999rpx;
  background: #fbfbfa;
  color: #111111;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-action-button text {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 900;
}

.support-grid {
  display: flex;
  gap: 22rpx;
  margin-top: 24rpx;
}

.support-card {
  flex: 1;
  min-width: 0;
  min-height: 210rpx;
  padding: 28rpx 28rpx 26rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(17, 17, 17, 0.08);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.support-card-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #111111;
  color: #ffffff;
  font-size: 36rpx;
  line-height: 58rpx;
  text-align: center;
  font-weight: 900;
}

.support-card-copy {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
}

.support-card-title {
  color: #111111;
  font-size: 36rpx;
  line-height: 1.15;
  font-weight: 900;
}

.support-card-desc {
  margin-top: 12rpx;
  color: #a8a8a8;
  font-size: 26rpx;
  line-height: 1.36;
  font-weight: 700;
}

.verify-banner {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: -28rpx 0 46rpx;
  padding: 22rpx 26rpx;
  background: rgba(255, 255, 255, 0.78);
  border-radius: 28rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.10);
  box-sizing: border-box;
}

.verify-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #111111;
  flex-shrink: 0;
}

.verify-banner-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.verify-banner-title {
  color: #111111;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 900;
}

.verify-banner-desc {
  color: #a8a8a8;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 700;
}

.verify-banner-arrow {
  color: #b8b8b8;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 800;
}

.action-card-press {
  opacity: 0.86;
  transform: scale(0.985);
}

.page-bottom-gap {
  height: 24rpx;
}
