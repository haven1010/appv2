/* ═══════════════════════════════════════════
   Home Page — 大龄友好醒目大字版
   ═══════════════════════════════════════════ */

.worker-home-page {
  min-height: 100vh;
}

.worker-home-body {
  padding: 16rpx 20rpx calc(208rpx + env(safe-area-inset-bottom));
}

/* ── Top Bar ── */
.top-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.search-pill {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: var(--radius-pill);
  background: rgba(240, 242, 247, 0.8);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
  transition: all 0.2s;
}

.search-pill:active {
  background: rgba(228, 230, 235, 0.9);
}

.search-icon {
  font-size: 30rpx;
  line-height: 1;
}

.search-text {
  flex: 1;
  min-width: 0;
  color: #9aa4b2;
  font-size: 26rpx;
  font-weight: 600;
}

.notice-pill {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(242, 184, 75, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.notice-pill:active {
  transform: scale(0.9);
}

.notice-icon {
  font-size: 32rpx;
  line-height: 1;
}

/* ── Hero Banner ── */
.hero-banner {
  margin-top: 18rpx;
  padding: 44rpx 34rpx 40rpx;
  background: #f5f5f7;
  color: #1a1a2e;
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.hero-banner::before {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -60rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 40%, transparent 70%);
}

.hero-banner::after {
  content: '';
  position: absolute;
  left: -20rpx;
  bottom: -80rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.04) 0%, transparent 70%);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background: rgba(0, 0, 0, 0.06);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  color: rgba(0, 0, 0, 0.85);
  font-size: 22rpx;
  font-weight: 700;
}

.hero-badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.2);
}

.hero-title {
  display: block;
  margin-top: 28rpx;
  font-size: 64rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #1a1a2e;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  display: block;
  margin-top: 18rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: rgba(0, 0, 0, 0.8);
  font-weight: 600;
}

.hero-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}

.hero-action-btn {
  height: 76rpx;
  padding: 0 34rpx;
  border-radius: var(--radius-pill);
  background: #ffffff;
  color: #1a1a2e;
  font-size: 28rpx;
  font-weight: 800;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
  transition: all 0.2s;
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-action-btn:active {
  transform: scale(0.96);
  background: #f0f0f2;
}

.hero-action-btn::after {
  border: none;
}

/* ── Profile Tip ── */
.profile-tip {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, rgba(242, 184, 75, 0.1), rgba(242, 184, 75, 0.04));
  border: 2rpx solid rgba(242, 184, 75, 0.25);
  transition: all 0.2s;
}

.profile-tip:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.profile-tip-icon {
  font-size: 32rpx;
  line-height: 1;
  flex-shrink: 0;
}

.profile-tip-text {
  flex: 1;
  font-size: 28rpx;
  color: #8b6914;
  font-weight: 700;
}

.profile-tip-arrow {
  color: #c9a23c;
  font-size: 32rpx;
  font-weight: 800;
}

/* ── Service Panel ── */
.service-panel {
  margin-top: 20rpx;
  padding: 28rpx 20rpx 22rpx;
  background: #ffffff;
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.panel-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 8rpx;
}

.panel-head-icon {
  width: 8rpx;
  height: 34rpx;
  border-radius: 4rpx;
  background: var(--brand-gradient);
  flex-shrink: 0;
}

.panel-title-text {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--ink-main);
}

.panel-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-sub);
  font-size: 24rpx;
  font-weight: 600;
  padding: 0 8rpx;
}

.service-grid {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20rpx 12rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 12rpx 4rpx;
  border-radius: 20rpx;
  transition: all 0.2s;
}

.service-item:active {
  transform: scale(0.92);
  opacity: 0.8;
}

.service-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.service-icon::after {
  content: '';
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.06);
}

/* Service icon colors */
.service-icon-job      { background: #E8EAFA; }
.service-icon-signup   { background: #D4F0E5; }
.service-icon-attend   { background: #E0EEFF; }
.service-icon-salary   { background: #FDF0D5; }
.service-icon-train    { background: #EDE0F5; }
.service-icon-policy   { background: #D5F2EE; }
.service-icon-rights   { background: #FAE0DD; }
.service-icon-more     { background: #EDE8F5; }

.service-icon-text {
  color: #1a1a2e;
  font-size: 40rpx;
  line-height: 1;
  position: relative;
  z-index: 1;
}

.service-title {
  display: block;
  margin-top: 14rpx;
  color: var(--ink-main);
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 800;
}

.service-subtitle {
  display: block;
  margin-top: 6rpx;
  color: var(--ink-sub);
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

/* ── Hot Section ── */
.hot-section {
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.hot-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.hot-head-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.hot-head-icon {
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--brand-gradient);
  flex-shrink: 0;
}

.hot-title {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--ink-main);
}

.hot-more {
  color: var(--ink-sub);
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  background: var(--card-bg-soft);
  transition: all 0.2s;
}

.hot-more:active {
  background: #e4e6ea;
}

.hot-divider {
  margin-top: 20rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(90, 108, 214, 0.10), transparent);
}

.hot-job-card {
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, rgba(90, 108, 214, 0.05), rgba(90, 108, 214, 0.02));
  border: 2rpx solid rgba(90, 108, 214, 0.10);
  transition: all 0.2s;
}

.hot-job-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.hot-job-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.hot-job-title {
  flex: 1;
  min-width: 0;
  color: var(--ink-main);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.35;
}

.hot-job-tag {
  display: inline-flex;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  background: rgba(90, 108, 214, 0.12);
  color: var(--brand-purple);
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.hot-job-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hot-job-address {
  color: var(--ink-sub);
  font-size: 26rpx;
  font-weight: 600;
}

.hot-job-foot {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.hot-job-salary {
  color: var(--brand-purple);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.1;
}

.hot-job-salary-unit {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-sub);
}

.hot-job-btn {
  min-width: auto;
  height: auto;
  line-height: 1.4;
  border-radius: 0;
  border: none;
  background: transparent;
  color: var(--ink-main);
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
  box-shadow: none;
  transition: all 0.2s;
}

.hot-job-btn:active {
  opacity: 0.5;
}

.hot-job-btn::after {
  border: none;
}

/* ── Empty / Loading States ── */
.compact-empty {
  margin-top: 14rpx;
}
