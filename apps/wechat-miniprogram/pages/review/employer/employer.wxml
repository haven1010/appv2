<view class="page review-page">
  <view class="review-hero">
    <view class="review-visual"></view>
    <text class="hero-kicker">劳动反馈</text>
    <text class="hero-title">评价这次工作</text>
    <text class="hero-desc">{{baseName}} · {{jobTitle}}</text>
  </view>

  <view class="rating-card">
    <text class="section-title">总体感受</text>
    <view class="star-row">
      <text
        class="star {{rating >= item ? 'star-active' : ''}}"
        wx:for="{{[1,2,3,4,5]}}"
        wx:key="*this"
        data-rating="{{item}}"
        bindtap="onOverallRatingTap"
      >★</text>
    </view>
    <text class="rating-text">{{rating > 0 ? rating + ' 分' : '请选择评分'}}</text>
  </view>

  <view class="category-card">
    <text class="section-title">分项评价</text>
    <view class="category-item" wx:for="{{categories}}" wx:key="key" wx:for-index="idx">
      <view class="category-copy">
        <text class="category-label">{{item.label}}</text>
        <text class="category-desc">{{item.desc}}</text>
      </view>
      <view class="star-row-small">
        <text
          class="star-small {{item.rating >= star ? 'star-active' : ''}}"
          wx:for="{{[1,2,3,4,5]}}"
          wx:for-item="star"
          wx:key="*this"
          data-index="{{idx}}"
          data-rating="{{star}}"
          bindtap="onCategoryRatingTap"
        >★</text>
      </view>
    </view>
  </view>

  <view class="comment-card">
    <text class="section-title">补充说明</text>
    <textarea
      class="comment-textarea"
      placeholder="可以写写工作环境、工资结算、管理沟通等真实感受"
      placeholder-class="placeholder"
      value="{{comment}}"
      bindinput="onCommentInput"
      maxlength="300"
      show-confirm-bar="{{false}}"
    />
    <text class="char-count">{{comment.length}}/300</text>
  </view>

  <view class="tips-card">
    <text class="tips-title">评价会帮助其他工友判断岗位是否合适</text>
    <text class="tips-desc">请保持真实、客观，不发布与本次工作无关的内容。</text>
  </view>

  <view class="action-card">
    <button class="btn-primary" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">提交评价</button>
    <button class="btn-ghost" bindtap="goBack">取消</button>
  </view>
</view>
