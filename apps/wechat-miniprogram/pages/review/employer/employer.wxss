  background:
}

.page-body {
  padding: 28rpx 24rpx;
}

/* ── Hero Card ── */
.hero-card {
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.header-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: var(--ink-main);
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--ink-sub);
  line-height: 1.5;
}

/* ── Rating Card ── */
.rating-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
  margin-bottom: 20rpx;
}

.star-row {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.star {
  font-size: 64rpx;
  color: #999999;
  transition: all 0.2s;
}

.star.star-active {
  color: var(--accent-gold);
  text-shadow: 0 4rpx 12rpx rgba(242, 184, 75, 0.3);
}

.rating-text {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent-gold);
}

/* ── Category Card ── */
.category-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.category-item:last-child {
  margin-bottom: 0;
}

.category-label {
  font-size: 26rpx;
  color: var(--ink-main);
  font-weight: 700;
}

.star-row-small {
  display: flex;
  gap: 6rpx;
}

.star-small {
  font-size: 36rpx;
  color: #999999;
  transition: all 0.2s;
}

.star-small.star-active {
  color: var(--accent-gold);
  text-shadow: 0 2rpx 8rpx rgba(242, 184, 75, 0.3);
}

/* ── Comment Card ── */
.comment-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.comment-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  background: var(--card-bg-soft);
  border: 2rpx solid rgba(102, 126, 234, 0.12);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--ink-main);
  line-height: 1.6;
  box-sizing: border-box;
  transition: all 0.25s;
}

.comment-textarea:focus {
  border-color: var(--brand-purple);
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--ink-muted);
  margin-top: 8rpx;
}

/* ── Tips Card ── */
.tips-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: rgba(102, 126, 234, 0.06);
  border: 1rpx solid rgba(102, 126, 234, 0.12);
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--brand-purple);
  margin-bottom: 16rpx;
}

.tips-item {
  display: block;
  font-size: 24rpx;
  color: #4a4d5e;
  line-height: 1.8;
  margin-bottom: 6rpx;
}

.tips-item:last-child {
  margin-bottom: 0;
}

/* ── Action Card ── */
.action-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.page-bottom-gap {
  height: 40rpx;
}

/* ── Animations ── */
.card-in {
  animation: slideUp 0.4s ease-out;
}

.delay-1 { animation-delay: 0.1s; }
.delay-2 { animation-delay: 0.2s; }
.delay-3 { animation-delay: 0.3s; }
.delay-4 { animation-delay: 0.4s; }
.delay-5 { animation-delay: 0.5s; }

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
