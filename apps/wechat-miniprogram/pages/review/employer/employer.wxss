page {
  background: #f5f5f7;
}

.review-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #f5f5f7;
  color: #111111;
}

.review-hero,
.rating-card,
.category-card,
.comment-card,
.tips-card,
.action-card {
  border-radius: 34rpx;
  background: #ffffff;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.055);
}

.review-hero {
  padding: 36rpx 30rpx 34rpx;
  text-align: center;
}

.review-visual {
  width: 170rpx;
  height: 170rpx;
  margin: 0 auto 26rpx;
  border-radius: 48rpx;
  background:
    radial-gradient(circle at 70% 28%, rgba(22, 130, 82, 0.20), transparent 34%),
    radial-gradient(circle at 30% 74%, rgba(0, 0, 0, 0.08), transparent 30%),
    linear-gradient(145deg, #ffffff, #e9ece8);
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.08);
}

.hero-kicker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 46rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  background: #edf8f2;
  color: #168252;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 900;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  color: #111111;
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 900;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  color: #8d929c;
  font-size: 27rpx;
  line-height: 1.45;
  font-weight: 800;
}

.rating-card,
.category-card,
.comment-card,
.tips-card,
.action-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.section-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 900;
  margin-bottom: 22rpx;
}

.star-row {
  display: flex;
  justify-content: center;
  gap: 14rpx;
}

.star {
  font-size: 64rpx;
  color: #d4d6dc;
  line-height: 1;
}

.star-active {
  color: #f2b84b;
}

.rating-text {
  display: block;
  margin-top: 18rpx;
  color: #8d929c;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 900;
  text-align: center;
}

.category-item {
  padding: 24rpx 0;
}

.category-item + .category-item {
  border-top: 1rpx solid #eef0f2;
}

.category-copy {
  margin-bottom: 18rpx;
}

.category-label {
  display: block;
  color: #111111;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 900;
}

.category-desc {
  display: block;
  margin-top: 6rpx;
  color: #8d929c;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 700;
}

.star-row-small {
  display: flex;
  gap: 10rpx;
}

.star-small {
  font-size: 42rpx;
  color: #d4d6dc;
  line-height: 1;
}

.comment-textarea {
  width: 100%;
  min-height: 190rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: #f6f7f8;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  color: #111111;
  font-size: 29rpx;
  line-height: 1.6;
  font-weight: 800;
  padding: 22rpx 24rpx;
}

.placeholder {
  color: #a5a8b0;
}

.char-count {
  display: block;
  margin-top: 12rpx;
  text-align: right;
  color: #9ca0aa;
  font-size: 24rpx;
  font-weight: 800;
}

.tips-card {
  background: #f8fbf9;
}

.tips-title {
  display: block;
  color: #111111;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 900;
}

.tips-desc {
  display: block;
  margin-top: 8rpx;
  color: #707680;
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 700;
}

.btn-primary,
.btn-ghost {
  width: 100%;
  height: 102rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 900;
}

.btn-primary {
  color: #ffffff;
  background: #111111;
  box-shadow: 0 16rpx 34rpx rgba(0, 0, 0, 0.16);
}

.btn-ghost {
  margin-top: 18rpx;
  color: #111111;
  background: #f2f3f5;
}

.btn-primary::after,
.btn-ghost::after {
  border: none;
}
