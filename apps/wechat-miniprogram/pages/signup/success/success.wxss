page {
  background: #f5f5f7;
}

.signup-success-page {
  min-height: 100vh;
  background: #f5f5f7;
  color: #111111;
}

.page-body {
  box-sizing: border-box;
  padding: 34rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
}

.success-hero,
.detail-card,
.action-card,
.archive-card {
  border-radius: 34rpx;
  background: #ffffff;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, 0.055);
}

.success-hero {
  position: relative;
  overflow: hidden;
  text-align: center;
  padding: 36rpx 34rpx 42rpx;
}

.success-visual {
  width: 260rpx;
  height: 210rpx;
  margin: 0 auto 4rpx;
  opacity: 0.98;
}

.success-mark {
  width: 76rpx;
  height: 76rpx;
  margin: -28rpx auto 20rpx;
  border-radius: 50%;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.18);
}

.title {
  display: block;
  color: #111111;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.22;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  color: #8d929c;
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 800;
}

.cancelled-tip {
  display: flex;
  margin-top: 18rpx;
  height: 46rpx;
  padding: 0 18rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #fff0ee;
  color: #c23b32;
  font-size: 24rpx;
  font-weight: 900;
}

.detail-card,
.action-card,
.archive-card {
  margin-top: 24rpx;
  padding: 8rpx 30rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  padding: 24rpx 0;
}

.detail-row + .detail-row {
  border-top: 1rpx solid #eef0f2;
}

.label {
  flex: none;
  color: #8d929c;
  font-size: 27rpx;
  line-height: 1.4;
  font-weight: 800;
}

.value {
  flex: 1;
  text-align: right;
  color: #111111;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.45;
}

.action-card,
.archive-card {
  padding: 30rpx;
}

.btn-primary,
.btn-secondary,
.btn-danger,
.btn-ghost {
  width: 100%;
  height: 100rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  font-size: 31rpx;
  line-height: 1;
  font-weight: 900;
}

.btn-primary {
  color: #ffffff;
  background: #111111;
  box-shadow: 0 16rpx 34rpx rgba(0, 0, 0, 0.16);
}

.btn-secondary {
  margin-top: 26rpx;
  color: #ffffff;
  background: #168252;
  box-shadow: 0 14rpx 30rpx rgba(22, 130, 82, 0.18);
}

.btn-danger {
  margin-top: 18rpx;
  color: #c23b32;
  background: #fff0ee;
}

.btn-ghost {
  margin-top: 18rpx;
  color: #111111;
  background: #f2f3f5;
}

.btn-primary::after,
.btn-secondary::after,
.btn-danger::after,
.btn-ghost::after {
  border: none;
}

.archive-head {
  margin-bottom: 26rpx;
}

.archive-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 900;
}

.archive-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #8d929c;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 700;
}

.archive-field + .archive-field {
  margin-top: 24rpx;
}

.archive-label {
  display: block;
  margin-bottom: 14rpx;
  color: #111111;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 900;
}

.archive-input-wrap,
.archive-textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: #f6f7f8;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
}

.archive-input-wrap {
  min-height: 100rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.archive-prefix {
  color: #168252;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 900;
}

.archive-input {
  flex: 1;
  min-height: 100rpx;
  background: transparent;
  color: #111111;
  font-size: 31rpx;
  font-weight: 900;
}

.archive-textarea {
  min-height: 160rpx;
  padding: 22rpx 24rpx;
  color: #111111;
  font-size: 30rpx;
  line-height: 1.6;
  font-weight: 800;
}

.placeholder {
  color: #a5a8b0;
}
