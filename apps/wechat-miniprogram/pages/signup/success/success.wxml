<view class="page signup-success-page">
  <view class="page-body">
    <view class="success-hero">
      <image class="success-visual" src="/images/splash-hero.png" mode="aspectFit"></image>
      <view class="success-mark">
        <text>✓</text>
      </view>
      <text class="title">{{duplicate ? '今日已报名' : '报名成功'}}</text>
      <text class="subtitle">{{duplicate ? '无需重复提交，请查看报名记录' : '报名信息已提交，等待工作人员确认'}}</text>
      <text wx:if="{{cancelled}}" class="cancelled-tip">当前报名已取消</text>
    </view>

    <view class="detail-card">
      <view class="detail-row">
        <text class="label">报名人</text>
        <text class="value">{{workerName}}（{{workerUid}}）</text>
      </view>
      <view class="detail-row">
        <text class="label">报名基地</text>
        <text class="value">{{baseName}}</text>
      </view>
      <view class="detail-row">
        <text class="label">报名岗位</text>
        <text class="value">{{jobTitle}}</text>
      </view>
      <view class="detail-row" wx:if="{{workDate}}">
        <text class="label">工作日期</text>
        <text class="value">{{workDate}}</text>
      </view>
    </view>

    <view class="action-card">
      <button class="btn-primary" bindtap="goWorkHistory">查看报名记录</button>
      <button
        wx:if="{{canCancel}}"
        class="btn-danger"
        bindtap="onCancelSignup"
        loading="{{cancelling}}"
        disabled="{{cancelling || cancelled}}"
      >{{cancelling ? '取消中...' : '取消报名'}}</button>
      <button class="btn-ghost" bindtap="backToSquare">返回首页</button>
    </view>

    <view class="archive-card">
      <view class="archive-head">
        <text class="archive-title">后续务工归档</text>
        <text class="archive-subtitle">完成本次工作后再填写工资和备注</text>
      </view>

      <view class="archive-field">
        <text class="archive-label">本次工资</text>
        <view class="archive-input-wrap">
          <text class="archive-prefix">¥</text>
          <input
            class="archive-input"
            type="digit"
            placeholder="请输入金额"
            placeholder-class="placeholder"
            value="{{totalAmountInput}}"
            bindinput="onAmountInput"
          />
        </view>
      </view>

      <view class="archive-field">
        <text class="archive-label">补充备注</text>
        <textarea
          class="archive-textarea"
          placeholder="可填写发薪方式、离场情况等"
          placeholder-class="placeholder"
          value="{{remarkInput}}"
          bindinput="onRemarkInput"
          auto-height
        />
      </view>

      <button class="btn-secondary" bindtap="completeWorklog" loading="{{completing}}" disabled="{{completing}}">结束务工并归档</button>
    </view>
  </view>
</view>
