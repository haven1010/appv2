<view class="page signup-page">
  <view class="page-body">
    <view class="signup-hero">
      <image class="signup-hero-img" src="/images/home-action-bg-2.png" mode="aspectFill"></image>
      <view class="signup-hero-mask"></view>
      <view class="signup-hero-copy">
        <text class="hero-kicker">报名确认</text>
        <text class="hero-title">确认信息后提交</text>
        <text class="hero-desc">工作人员会根据报名记录安排上工</text>
      </view>
    </view>

    <view class="summary-card">
      <view class="summary-row">
        <text class="summary-label">报名基地</text>
        <text class="summary-value">{{baseName || '基地待确认'}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">报名岗位</text>
        <text class="summary-value">{{jobTitle || '岗位待确认'}}</text>
      </view>
    </view>

    <view class="form-card">
      <view class="section-head">
        <text class="section-title">实名信息</text>
        <text class="section-desc">用于报名核验，不会公开展示</text>
      </view>

      <view class="profile-line">
        <text class="profile-label">姓名</text>
        <text class="profile-value">{{name || '未完善'}}</text>
      </view>
      <view class="profile-line">
        <text class="profile-label">联系电话</text>
        <text class="profile-value">{{phone || '未完善'}}</text>
      </view>
      <view class="profile-line">
        <text class="profile-label">身份证</text>
        <text class="profile-value">{{maskedIdCard || '未完善'}}</text>
      </view>
    </view>

    <view class="form-card">
      <view class="section-head">
        <text class="section-title">上工安排</text>
      </view>

      <view class="form-field">
        <text class="field-label">工作日期</text>
        <picker mode="date" value="{{workDate}}" bindchange="onDateChange">
          <view class="picker-field">
            <text class="{{workDate ? 'picker-text' : 'picker-placeholder'}}">{{workDate || '请选择工作日期'}}</text>
          </view>
        </picker>
      </view>

      <view class="form-field">
        <text class="field-label">备注</text>
        <textarea class="textarea-field" value="{{note}}" bindinput="onInputNote" placeholder="可填写到岗时间、身体情况等" placeholder-class="placeholder" />
      </view>
    </view>

    <view class="confirm-card">
      <text class="confirm-title">提交后可在“我的报名”查看进度</text>
      <text class="confirm-desc">如需取消，可进入报名记录处理。</text>
      <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">{{submitting ? '提交中...' : '提交报名'}}</button>
    </view>
  </view>
</view>
