page {
  background: #f5f5f7;
}

.signup-page {
  min-height: 100vh;
  background: #f5f5f7;
  color: #111111;
}

.page-body {
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(54rpx + env(safe-area-inset-bottom));
}

.signup-hero {
  position: relative;
  height: 360rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #111111;
  box-shadow: 0 22rpx 52rpx rgba(0, 0, 0, 0.14);
}

.signup-hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.signup-hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08) 0%, rgba(0, 0, 0, 0.76) 100%);
}

.signup-hero-copy {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 30rpx;
}

.hero-kicker {
  display: flex;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  color: #168252;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 900;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 52rpx;
  line-height: 1.12;
  font-weight: 900;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 800;
}

.summary-card,
.form-card,
.confirm-card {
  margin-top: 24rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.055);
}

.summary-card {
  padding: 8rpx 28rpx;
}

.summary-row,
.profile-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  padding: 24rpx 0;
}

.summary-row + .summary-row,
.profile-line + .profile-line {
  border-top: 1rpx solid #eef0f2;
}

.summary-label,
.profile-label {
  flex: none;
  color: #8d929c;
  font-size: 27rpx;
  line-height: 1.4;
  font-weight: 800;
}

.summary-value,
.profile-value {
  flex: 1;
  color: #111111;
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 900;
  text-align: right;
}

.form-card,
.confirm-card {
  padding: 30rpx;
}

.section-head {
  margin-bottom: 26rpx;
}

.section-title {
  display: block;
  color: #111111;
  font-size: 35rpx;
  line-height: 1.3;
  font-weight: 900;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  color: #9ca0aa;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 700;
}

.form-field + .form-field {
  margin-top: 26rpx;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #111111;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 900;
}

.picker-field,
.textarea-field {
  width: 100%;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: #f6f7f8;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
}

.picker-field {
  height: 104rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}

.picker-text,
.picker-placeholder {
  font-size: 31rpx;
  line-height: 1.3;
  font-weight: 900;
}

.picker-text {
  color: #111111;
}

.picker-placeholder,
.placeholder {
  color: #a5a8b0;
}

.textarea-field {
  min-height: 176rpx;
  padding: 22rpx 24rpx;
  color: #111111;
  font-size: 30rpx;
  line-height: 1.6;
  font-weight: 800;
}

.confirm-title {
  display: block;
  color: #111111;
  font-size: 31rpx;
  line-height: 1.4;
  font-weight: 900;
}

.confirm-desc {
  display: block;
  margin-top: 10rpx;
  color: #8d929c;
  font-size: 27rpx;
  line-height: 1.45;
  font-weight: 700;
}

.submit-btn {
  width: 100%;
  height: 106rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  background: #111111;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #d9dbe0 !important;
  box-shadow: none;
  color: #9ca0aa;
}
