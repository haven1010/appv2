/* pages/login/login.wxss - iOS-style login */

page {
  background: #f5f5f7 !important;
  color: #111111;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.login-page {
  min-height: 100vh;
  background: #f5f5f7;
}

.login-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(54rpx + env(safe-area-inset-top)) 34rpx calc(50rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.welcome-section {
  flex: 1;
  min-height: 580rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.brand-logo-wrapper {
  width: 154rpx;
  height: 154rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.brand-logo {
  width: 118rpx;
  height: 118rpx;
  border-radius: 28rpx;
}

.brand-name {
  margin-top: 30rpx;
  color: #111111;
  font-size: 58rpx;
  line-height: 1.08;
  font-weight: 900;
  letter-spacing: 0;
}

.brand-desc {
  max-width: 560rpx;
  margin-top: 18rpx;
  color: #8e8e93;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 800;
}

.wx-section {
  width: 100%;
  margin-top: 46rpx;
}

.wx-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 31rpx;
  line-height: 1;
  font-weight: 900;
  box-shadow: 0 16rpx 34rpx rgba(15, 23, 42, 0.14);
}

.wx-section:active .wx-btn {
  opacity: 0.84;
  transform: scale(0.988);
}

.wx-btn-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 900;
}

.wx-hint {
  display: block;
  margin-top: 18rpx;
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
  text-align: center;
}

.pwd-entry {
  margin-top: 34rpx;
  padding: 18rpx 0 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.pwd-entry-line {
  width: 86rpx;
  height: 2rpx;
  background: #d1d1d6;
}

.pwd-entry-text {
  color: #111111;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 900;
}

.back-bar {
  min-height: 58rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.back-arrow,
.back-text {
  color: #111111;
  font-weight: 900;
}

.back-arrow {
  font-size: 35rpx;
  line-height: 1;
}

.back-text {
  font-size: 28rpx;
  line-height: 1;
}

.pwd-header {
  padding: 28rpx 0 24rpx;
}

.pwd-title {
  display: block;
  color: #111111;
  font-size: 50rpx;
  line-height: 1.12;
  font-weight: 900;
}

.pwd-desc {
  display: block;
  margin-top: 12rpx;
  color: #8e8e93;
  font-size: 27rpx;
  line-height: 1.4;
  font-weight: 800;
}

.login-card {
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 18rpx 44rpx rgba(15, 23, 42, 0.065);
}

.role-switch {
  height: 82rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #f2f2f4;
  display: flex;
  gap: 6rpx;
  box-sizing: border-box;
}

.role-pill {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #8e8e93;
}

.role-pill.active {
  background: #ffffff;
  color: #111111;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.08);
}

.role-icon {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #e5e5ea;
  color: #8e8e93;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  line-height: 1;
  font-weight: 900;
}

.role-icon.active {
  background: #111111;
  color: #ffffff;
}

.role-label {
  color: inherit;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 900;
}

.form-section {
  margin-top: 28rpx;
}

.form-item {
  margin-top: 22rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 900;
}

.input-shell {
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: #f2f2f4;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.input-shell.is-focus {
  background: #ffffff;
  border-color: rgba(17, 17, 17, 0.16);
  box-shadow: 0 0 0 6rpx rgba(17, 17, 17, 0.04);
}

.input-field {
  width: 100%;
  height: 88rpx;
  color: #111111;
  background: transparent;
  font-size: 30rpx;
  line-height: 88rpx;
  font-weight: 800;
}

.placeholder {
  color: #b8b8bd;
  font-size: 28rpx;
  font-weight: 700;
}

.error-msg {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #fff1f2;
  border: 1rpx solid rgba(225, 29, 72, 0.12);
  color: #be123c;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 800;
}

.login-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 26rpx;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
  box-shadow: 0 14rpx 30rpx rgba(15, 23, 42, 0.13);
}

.login-btn::after {
  border: none;
}

.login-btn:active,
.btn-pressed {
  opacity: 0.84;
  transform: scale(0.988);
}

.login-btn[disabled] {
  background: #d1d1d6;
  color: #ffffff;
  box-shadow: none;
}

.entry-row {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.entry-link {
  min-height: 104rpx;
  padding: 18rpx 16rpx;
  border-radius: 22rpx;
  background: #f7f7f8;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.entry-link:active {
  opacity: 0.82;
}

.entry-link-title {
  display: block;
  color: #111111;
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 900;
}

.entry-link-desc {
  display: block;
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 22rpx;
  line-height: 1.32;
  font-weight: 800;
}

.network-section {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf0f4;
}

.network-header {
  min-height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.network-title,
.network-arrow {
  color: #8e8e93;
  font-weight: 900;
}

.network-title {
  font-size: 25rpx;
  line-height: 1.2;
}

.network-arrow {
  font-size: 24rpx;
  line-height: 1;
}

.network-body {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #f7f7f8;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.network-tip,
.network-tip-desc {
  display: block;
  line-height: 1.45;
  font-weight: 800;
}

.network-tip {
  color: #111111;
  font-size: 24rpx;
  word-break: break-all;
}

.network-tip-desc {
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 23rpx;
}

.network-input {
  width: 100%;
  height: 78rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #111111;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
  font-size: 25rpx;
  line-height: 78rpx;
  font-weight: 800;
}

.preset-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.preset-chip {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #111111;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  font-size: 23rpx;
  line-height: 1;
  font-weight: 900;
}

.network-save-btn {
  width: 100%;
  height: 78rpx;
  margin-top: 16rpx;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 900;
}

.network-save-btn::after {
  border: none;
}

.page-enter {
  animation: fadeIn 0.32s ease both;
}

.page-leave {
  animation: fadeOut 0.24s ease forwards;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translate3d(0, 18rpx, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}

@keyframes fadeOut {
  from { opacity: 1; transform: translate3d(0, 0, 0); }
  to { opacity: 0; transform: translate3d(0, -10rpx, 0); }
}
