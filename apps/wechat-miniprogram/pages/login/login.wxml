<view class="login-page {{pageLeaving ? 'page-leave' : 'page-enter'}}">
  <!-- 背景装饰 -->
  <view class="bg-circle bg-circle-top"></view>
  <view class="bg-circle bg-circle-bottom"></view>

  <view class="login-shell">
    <!-- ====== 欢迎视图（默认展示） ====== -->
    <block wx:if="{{!showPasswordLogin}}">
      <!-- 品牌头部 -->
      <view class="welcome-section">
        <view class="brand-logo-wrapper">
          <image class="brand-logo" src="/images/zhihui-logo.jpg" mode="aspectFit" />
        </view>
        <text class="brand-name">智汇就业</text>
        <text class="brand-desc">苏陕协作就业服务与劳务对接平台</text>
      </view>

      <!-- 微信一键登录 -->
      <view class="wx-section" bindtap="handleWechatLogin">
        <view class="wx-btn">
          <text class="wx-btn-icon">微</text>
          <text wx:if="{{!wechatLoading}}">微信一键登录</text>
          <text wx:else>登录中...</text>
        </view>
        <text class="wx-hint">无需填写手机号，授权即登录</text>
      </view>

      <!-- 密码登录入口 -->
      <view class="pwd-entry" bindtap="togglePasswordLogin">
        <view class="pwd-entry-line"></view>
        <text class="pwd-entry-text">使用密码登录</text>
        <view class="pwd-entry-line"></view>
      </view>
    </block>

    <!-- ====== 密码登录视图 ====== -->
    <block wx:else>
      <!-- 返回 -->
      <view class="back-bar" bindtap="togglePasswordLogin">
        <text class="back-arrow">←</text>
        <text class="back-text">返回</text>
      </view>

      <!-- 密码登录头部 -->
      <view class="pwd-header">
        <text class="pwd-title">密码登录</text>
        <text class="pwd-desc">使用手机号和身份证后6位登录</text>
      </view>

      <!-- 登录卡片 -->
      <view class="login-card">
        <!-- 角色切换 -->
        <view class="role-switch">
          <view class="role-pill {{loginRole === 'worker' ? 'active' : ''}}" data-role="worker" bindtap="onSwitchRole">
            <view class="role-icon {{loginRole === 'worker' ? 'active' : ''}}">
              <text>工</text>
            </view>
            <text class="role-label">我是员工</text>
          </view>
          <view class="role-pill {{loginRole === 'boss' ? 'active' : ''}}" data-role="boss" bindtap="onSwitchRole">
            <view class="role-icon {{loginRole === 'boss' ? 'active' : ''}}">
              <text>企</text>
            </view>
            <text class="role-label">我是老板</text>
          </view>
        </view>

        <!-- 表单 -->
        <view class="form-section">
          <view class="form-item">
            <text class="field-label">手机号</text>
            <view class="input-shell {{focusField === 'phone' ? 'is-focus' : ''}}">
              <input
                class="input-field"
                type="number"
                maxlength="11"
                value="{{phone}}"
                placeholder="请输入 11 位手机号"
                placeholder-class="placeholder"
                bindfocus="onInputFocus"
                bindblur="onInputBlur"
                bindinput="onInputPhone"
                data-field="phone"
              />
            </view>
          </view>

          <view class="form-item">
            <text class="field-label">身份证后 6 位</text>
            <view class="input-shell {{focusField === 'idCard' ? 'is-focus' : ''}}">
              <input
                class="input-field"
                type="text"
                maxlength="6"
                value="{{idCardLast6}}"
                placeholder="请输入后 6 位"
                placeholder-class="placeholder"
                bindfocus="onInputFocus"
                bindblur="onInputBlur"
                bindinput="onInputIdCard"
                data-field="idCard"
              />
            </view>
          </view>

          <view class="error-msg" wx:if="{{error}}">
            <text>{{error}}</text>
          </view>

          <button
            class="login-btn {{btnPressed ? 'btn-pressed' : ''}}"
            bindtap="handleLogin"
            bindtouchstart="onLoginPressStart"
            bindtouchend="onLoginPressEnd"
            bindtouchcancel="onLoginPressEnd"
            loading="{{loading}}"
            disabled="{{loading || !canSubmit}}"
          >
            {{loading ? '登录中...' : '进入智汇就业'}}
          </button>

          <view class="entry-row">
            <view class="entry-link" bindtap="goToRegister">
              <text class="entry-link-title">{{loginRole === 'boss' ? '老板注册' : '工人注册'}}</text>
              <text class="entry-link-desc">首次使用先登记信息</text>
            </view>
            <view class="entry-link" bindtap="goToProxyRegister" wx:if="{{loginRole === 'worker'}}">
              <text class="entry-link-title">家人代注册</text>
              <text class="entry-link-desc">适合代办入职信息</text>
            </view>
          </view>
        </view>

        <!-- 网络设置 -->
        <view class="network-section">
          <view class="network-header" bindtap="toggleApiConfig">
            <text class="network-title">网络设置</text>
            <text class="network-arrow">{{showApiConfig ? '▴' : '▾'}}</text>
          </view>
          <view wx:if="{{showApiConfig}}" class="network-body">
            <text class="network-tip">当前接口：{{currentBaseUrlDisplay}}</text>
            <text class="network-tip-desc">手机真机调试时，请填写电脑可访问的内网地址。</text>
            <input
              class="network-input"
              type="text"
              value="{{apiBaseUrlInput}}"
              placeholder="http://你的电脑内网IP:3001/api"
              placeholder-class="placeholder"
              bindinput="onInputApiBaseUrl"
            />
            <view class="preset-row">
              <view class="preset-chip" data-url="{{devtoolsBaseUrl}}" bindtap="useApiPreset" wx:if="{{devtoolsBaseUrl}}">开发者工具</view>
              <view class="preset-chip" data-url="{{lanBaseUrl}}" bindtap="useApiPreset" wx:if="{{lanBaseUrl}}">局域网预设</view>
            </view>
            <button class="network-save-btn" bindtap="saveApiBaseUrl">保存接口地址</button>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
