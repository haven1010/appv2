.page-admin {
  min-height: 100vh;
  max-width: 1120rpx;
  margin: 0 auto;
  padding: 24rpx;
  padding-bottom: 186rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 8% 8%, rgba(196, 215, 180, 0.22) 0, rgba(196, 215, 180, 0) 34%),
    radial-gradient(circle at 92% -5%, rgba(245, 195, 132, 0.22) 0, rgba(245, 195, 132, 0) 28%),
    repeating-linear-gradient(
      -16deg,
      rgba(255, 255, 255, 0.08) 0rpx,
      rgba(255, 255, 255, 0.08) 12rpx,
      rgba(245, 239, 224, 0.1) 12rpx,
      rgba(245, 239, 224, 0.1) 24rpx
    ),
    linear-gradient(180deg, #fbf7ed 0%, #f5efe3 55%, #f3ebdc 100%);
}

.hero-card,
.section-card {
  background: var(--warm-card);
  border: 2rpx solid rgba(106, 153, 78, 0.14);
  border-radius: var(--radius-card);
  padding: 26rpx;
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.hero-card {
  margin-bottom: 18rpx;
}

.section-card {
  margin-top: 16rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink-main);
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-sub);
}

.info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.role-chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #355528;
  background: rgba(106, 153, 78, 0.12);
  border: 1rpx solid rgba(106, 153, 78, 0.24);
}

.role-chip.super {
  color: #7a4e1f;
  background: rgba(244, 162, 97, 0.18);
  border-color: rgba(244, 162, 97, 0.3);
}

.section-title {
  font-size: 30rpx;
  color: var(--ink-main);
  font-weight: 800;
}

.section-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-sub);
}

.grid-2 {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.stat-card {
  background: #fffdf8;
  border: 2rpx solid rgba(106, 153, 78, 0.14);
  border-radius: 22rpx;
  padding: 18rpx;
}

.stat-label {
  font-size: 20rpx;
  color: var(--ink-sub);
}

.stat-value {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--warm-green);
}

.input,
.picker,
.textarea,
.select {
  width: 100%;
  box-sizing: border-box;
  margin-top: 10rpx;
  background: #ffffff;
  border: 2rpx solid rgba(106, 153, 78, 0.16);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  font-size: 26rpx;
  color: var(--ink-main);
}

.textarea {
  min-height: 120rpx;
}

.form-label {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--ink-sub);
}

.actions-row {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.btn-primary,
.btn-secondary,
.btn-danger,
.btn-ghost {
  border-radius: 999rpx;
  padding: 0 24rpx;
  min-height: 76rpx;
  line-height: 76rpx;
  font-size: 24rpx;
  font-weight: 700;
  border: none;
}

.btn-primary {
  color: #ffffff;
  background: linear-gradient(90deg, var(--warm-green) 0%, var(--warm-blue) 100%);
}

.btn-secondary {
  color: #355528;
  background: linear-gradient(90deg, #e9c46a 0%, #f4d48f 100%);
}

.btn-danger {
  color: #ffffff;
  background: linear-gradient(90deg, var(--warm-orange) 0%, #dd7f42 100%);
}

.btn-ghost {
  color: var(--warm-green);
  background: #fffdf6;
  border: 2rpx solid rgba(106, 153, 78, 0.2);
}

.btn-primary::after,
.btn-secondary::after,
.btn-danger::after,
.btn-ghost::after {
  border: none;
}

.btn-delete-mini {
  min-height: 58rpx;
  line-height: 58rpx;
  min-width: 132rpx;
  width: auto !important;
  max-width: 180rpx;
  padding: 0 22rpx;
  font-size: 22rpx;
  font-weight: 700;
  margin: 0;
  border-radius: 999rpx;
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  color: #ffffff !important;
  background: linear-gradient(90deg, #e63946 0%, #c1121f 100%) !important;
  border: none !important;
}

.btn-delete-mini::after {
  border: none !important;
}

.list-item {
  margin-top: 12rpx;
  background: #fffdf8;
  border: 2rpx solid rgba(106, 153, 78, 0.14);
  border-radius: 22rpx;
  padding: 16rpx;
}

.item-title {
  font-size: 28rpx;
  color: var(--ink-main);
  font-weight: 700;
}

.item-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-sub);
}

.chip-row {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(106, 153, 78, 0.22);
}

.chip.pending {
  color: #7a4e1f;
  background: rgba(244, 162, 97, 0.14);
  border-color: rgba(244, 162, 97, 0.28);
}

.chip.success {
  color: #355528;
  background: rgba(106, 153, 78, 0.14);
  border-color: rgba(106, 153, 78, 0.26);
}

.chip.danger {
  color: #8c3f39;
  background: rgba(221, 127, 66, 0.12);
  border-color: rgba(221, 127, 66, 0.26);
}

.chip.info {
  color: #2f5f8b;
  background: rgba(79, 152, 216, 0.14);
  border-color: rgba(79, 152, 216, 0.24);
}

.empty-text {
  margin-top: 18rpx;
  color: var(--ink-sub);
  font-size: 24rpx;
  text-align: center;
}

.admin-bottom-nav {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 12rpx;
  z-index: 90;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 12rpx calc(env(safe-area-inset-bottom) + 8rpx);
  border-radius: 34rpx;
  border: 3rpx solid #d8be94;
  background: rgba(255, 249, 234, 0.98);
  box-shadow: 0 12rpx 28rpx rgba(100, 76, 43, 0.2);
  box-sizing: border-box;
}

.admin-bottom-item {
  flex: 1;
  padding: 14rpx 6rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: 20rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #7e6a4f;
  background: rgba(255, 255, 255, 0.88);
}

.admin-bottom-item.active {
  color: #3e5f2d;
  background: rgba(111, 157, 81, 0.14);
}
