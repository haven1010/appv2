/* ═══════════════════════════════════════════
   Admin Home — Claude Purple Theme
   ═══════════════════════════════════════════ */

@import "../common.wxss";

.admin-workbench-page {
  background: var(--page-bg);
}

.admin-workbench-body {
  padding: 28rpx 24rpx calc(80rpx + env(safe-area-inset-bottom));
}

/* ── Cards ── */
.workbench-hero,
.workbench-base-card,
.section-card,
.summary-card,
.entry-card {
  border-radius: var(--radius-lg);
  background: var(--card-bg);
  border: var(--border-soft);
  box-shadow: var(--shadow-md);
}

.workbench-hero,
.workbench-base-card,
.section-card {
  padding: 24rpx 22rpx;
}

/* ── Hero ── */
.workbench-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.3;
  color: var(--ink-main);
  font-weight: 900;
}

.workbench-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink-sub);
}

.workbench-base-card {
  margin-top: 18rpx;
}

/* ── Section Title ── */
.section-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.35;
  color: var(--ink-main);
  font-weight: 800;
}

.base-picker,
.form-value,
.form-input,
.form-textarea {
  margin-top: 12rpx;
  min-height: 84rpx;
  border-radius: 20rpx;
  background: var(--card-bg-soft);
  border: 1rpx solid rgba(102, 126, 234, 0.08);
  padding: 20rpx 18rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--ink-main);
  transition: all 0.25s;
}

.base-picker:focus,
.form-input:focus,
.form-textarea:focus {
  border-color: var(--brand-purple);
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.base-desc,
.section-subtitle,
.applicant-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-sub);
}

/* ── Summary Grid ── */
.summary-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.summary-card {
  padding: 18rpx 16rpx;
  text-align: center;
}

.summary-label {
  display: block;
  font-size: 24rpx;
  color: var(--ink-sub);
}

.summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 42rpx;
  line-height: 1.2;
  color: var(--brand-purple);
  font-weight: 900;
}

/* ── Entry Grid ── */
.entry-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.entry-card {
  padding: 20rpx 18rpx;
  transition: all 0.2s;
}

.entry-card:active {
  transform: scale(0.97);
  box-shadow: var(--shadow-sm);
}

.entry-title {
  display: block;
  font-size: 30rpx;
  color: var(--ink-main);
  font-weight: 800;
}

.entry-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--ink-sub);
}

/* ── Section Card ── */
.section-card {
  margin-top: 18rpx;
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* ── Filter Row / Chips ── */
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.filter-chip {
  padding: 10rpx 18rpx;
  border-radius: var(--radius-pill);
  background: rgba(102, 126, 234, 0.08);
  color: var(--brand-purple);
  font-size: 24rpx;
  font-weight: 700;
  transition: all 0.2s;
}

.filter-chip.active {
  background: var(--brand-gradient);
  color: #1a1a2e;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.25);
}

/* ── Applicant Card ── */
.applicant-card {
  margin-top: 16rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg-soft);
  border: var(--border-soft);
  padding: 20rpx 18rpx;
}

.applicant-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.applicant-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  color: var(--ink-main);
  font-weight: 800;
}

.applicant-job {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #4a4d5e;
  font-weight: 700;
}

/* ── Status Badge ── */
.status-badge {
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 700;
}

.pending {
  background: rgba(102, 126, 234, 0.1);
  color: var(--brand-purple);
}

.ok {
  background: rgba(49, 164, 124, 0.1);
  color: var(--accent-green);
}

.warn {
  background: rgba(228, 92, 109, 0.1);
  color: var(--accent-red);
}

.muted {
  background: rgba(176, 170, 192, 0.1);
  color: var(--ink-muted);
}

/* ── Applicant Actions ── */
.applicant-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.action-btn,
.submit-btn {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 800;
  border: none;
  transition: all 0.2s;
}

.action-btn {
  flex: 1;
}

.action-pass {
  background: var(--brand-gradient);
  color: #1a1a2e;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.2);
}

.action-pass:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.action-reject {
  background: var(--card-bg-soft);
  color: var(--brand-purple);
  border: 2rpx solid rgba(102, 126, 234, 0.16);
}

.action-reject:active {
  transform: scale(0.97);
}

.action-btn::after,
.submit-btn::after {
  border: none;
}

/* ── Form Grid ── */
.form-grid {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* ── Notice Summary Card ── */
.notice-summary-card {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.notice-summary-item {
  border-radius: 22rpx;
  background: var(--card-bg-soft);
  border: var(--border-soft);
  padding: 18rpx 16rpx;
}

.notice-summary-label {
  display: block;
  font-size: 24rpx;
  color: var(--ink-sub);
}

.notice-summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 40rpx;
  line-height: 1.2;
  color: var(--brand-purple);
  font-weight: 900;
}

.notice-summary-text {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--ink-main);
  font-weight: 700;
}

/* ── Form Field ── */
.form-field {
  width: 100%;
}

.form-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #4a4d5e;
  font-weight: 700;
}

.form-textarea {
  min-height: 120rpx;
  line-height: 1.55;
}

/* ── Submit Button ── */
.submit-btn {
  margin-top: 18rpx;
  background: var(--brand-gradient);
  color: #1a1a2e;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.submit-btn:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.submit-btn[disabled] {
  background: #b8b4c8;
  box-shadow: none;
  color: #1a1a2e;
}

/* ── Notice List ── */
.notice-list-title {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  color: var(--ink-main);
  font-weight: 800;
}

.notice-card {
  margin-top: 12rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg-soft);
  border: var(--border-soft);
  padding: 20rpx 18rpx;
}

/* ── Empty Text ── */
.empty-text {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--ink-sub);
  line-height: 1.6;
}
