<view class="page admin-workbench-page">
  <view class="page-body admin-workbench-body">
    <view class="workbench-hero">
      <text class="workbench-title">基地运营工作台</text>
      <text class="workbench-subtitle">{{roleText}} · 报名审核、集合通知、工资管理集中处理</text>
    </view>

    <view class="workbench-base-card" wx:if="{{baseOptions.length}}">
      <text class="section-title">当前基地</text>
      <picker mode="selector" value="{{baseIndex}}" range="{{baseOptions}}" range-key="baseName" bindchange="onBaseChange">
        <view class="base-picker">{{baseOptions[baseIndex].baseName}}</view>
      </picker>
      <text class="base-desc">{{currentBase.address || '请选择基地后查看信息'}}</text>
    </view>

    <view class="summary-grid">
      <view class="summary-card">
        <text class="summary-label">待审核</text>
        <text class="summary-value">{{summary.pending}}</text>
      </view>
      <view class="summary-card">
        <text class="summary-label">已通过</text>
        <text class="summary-value">{{summary.approved}}</text>
      </view>
      <view class="summary-card">
        <text class="summary-label">已通知</text>
        <text class="summary-value">{{summary.notified}}</text>
      </view>
      <view class="summary-card">
        <text class="summary-label">工资记录</text>
        <text class="summary-value">{{summary.payroll}}</text>
      </view>
    </view>

    <view class="entry-grid">
      <view class="entry-card" bindtap="goToAttendance">
        <text class="entry-title">签到与工资</text>
        <text class="entry-desc">进入签到、工资生成、导出表单的主页面</text>
      </view>
      <view class="entry-card" bindtap="goToPayroll">
        <text class="entry-title">工资表中心</text>
        <text class="entry-desc">查看工资记录和系统工资表同步结果</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <text class="section-title">报名审核</text>
        <view class="filter-row">
          <view wx:for="{{filters}}" wx:key="key" class="filter-chip {{activeFilter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onFilterTap">{{item.label}}</view>
        </view>
      </view>

      <view class="empty-text" wx:if="{{!filteredApplicants.length}}">当前没有需要处理的报名记录</view>

      <view class="applicant-card" wx:for="{{filteredApplicants}}" wx:key="id">
        <view class="applicant-top">
          <text class="applicant-name">{{item.name}}</text>
          <text class="status-badge {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <text class="applicant-job">{{item.jobTitle}}</text>
        <text class="applicant-meta">手机：{{item.phone}}</text>
        <text class="applicant-meta">报名时间：{{item.createdAtText}}</text>
        <text class="applicant-meta">{{item.trace}}</text>

        <view class="applicant-actions" wx:if="{{item.status === 0}}">
          <button class="action-btn action-pass" data-id="{{item.id}}" bindtap="approveApplicant">通过</button>
          <button class="action-btn action-reject" data-id="{{item.id}}" bindtap="rejectApplicant">驳回</button>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <text class="section-title">集合通知</text>
        <text class="section-subtitle">审核通过后填写集合时间、地点、联系人，保存后形成通知记录</text>
      </view>

      <view class="notice-summary-card">
        <view class="notice-summary-item">
          <text class="notice-summary-label">通知记录</text>
          <text class="notice-summary-value">{{notices.length}}</text>
        </view>
        <view class="notice-summary-item">
          <text class="notice-summary-label">最近一条</text>
          <text class="notice-summary-text">{{notices.length ? (notices[0].date + ' ' + notices[0].time) : '暂无记录'}}</text>
        </view>
      </view>

      <view class="form-grid">
        <view class="form-field">
          <text class="form-label">集合日期</text>
          <picker mode="date" value="{{noticeForm.date}}" bindchange="onNoticeDateChange">
            <view class="form-value">{{noticeForm.date || '请选择日期'}}</view>
          </picker>
        </view>

        <view class="form-field">
          <text class="form-label">出发时间</text>
          <picker mode="time" value="{{noticeForm.time}}" bindchange="onNoticeTimeChange">
            <view class="form-value">{{noticeForm.time || '请选择时间'}}</view>
          </picker>
        </view>

        <view class="form-field">
          <text class="form-label">集合地点</text>
          <input class="form-input" value="{{noticeForm.location}}" data-field="location" bindinput="onNoticeFieldInput" placeholder="如：县政府东门广场" />
        </view>

        <view class="form-field">
          <text class="form-label">联系人</text>
          <input class="form-input" value="{{noticeForm.contactName}}" data-field="contactName" bindinput="onNoticeFieldInput" placeholder="填写现场联系人姓名" />
        </view>

        <view class="form-field">
          <text class="form-label">联系电话</text>
          <input class="form-input" value="{{noticeForm.contactPhone}}" data-field="contactPhone" bindinput="onNoticeFieldInput" placeholder="填写联系电话" />
        </view>

        <view class="form-field">
          <text class="form-label">备注说明</text>
          <textarea class="form-textarea" value="{{noticeForm.remark}}" data-field="remark" bindinput="onNoticeFieldInput" placeholder="如：提前10分钟到场，携带身份证原件" auto-height />
        </view>
      </view>

      <button class="submit-btn" loading="{{noticeSubmitting}}" bindtap="submitNotice">保存集合通知</button>

      <view class="empty-text" wx:if="{{!notices.length}}">当前还没有保存过集合通知</view>
      <text wx:if="{{notices.length}}" class="notice-list-title">通知记录</text>
      <view class="notice-card" wx:for="{{notices}}" wx:key="id">
        <view class="applicant-top">
          <text class="applicant-name">{{item.date}} {{item.time}}</text>
          <text class="status-badge ok">已保存</text>
        </view>
        <text class="applicant-meta">地点：{{item.location}}</text>
        <text class="applicant-meta">联系人：{{item.contactName}} {{item.contactPhone}}</text>
        <text class="applicant-meta" wx:if="{{item.remark}}">备注：{{item.remark}}</text>
      </view>
    </view>
  </view>
</view>
