<view class="page-admin">
  <view class="back-bar" bindtap="goBack">
    <view class="back-arrow"></view>
    <text class="back-text">返回</text>
  </view>

  <view class="hero-card">
    <view class="hero-title">基地运营工作台</view>
    <view class="hero-sub">{{roleText}} · 报名审核、集合通知、工资管理集中处理</view>
  </view>

  <view class="section-card" wx:if="{{baseOptions.length}}">
    <view class="section-title">当前基地</view>
    <picker mode="selector" value="{{baseIndex}}" range="{{baseOptions}}" range-key="baseName" bindchange="onBaseChange">
      <view class="picker">{{baseOptions[baseIndex].baseName}}</view>
    </picker>
    <view class="section-sub">{{currentBase.address || '请选择基地后查看信息'}}</view>
  </view>

  <view class="grid-2">
    <view class="stat-card">
      <view class="stat-label">待审核</view>
      <view class="stat-value">{{summary.pending}}</view>
    </view>
    <view class="stat-card">
      <view class="stat-label">已通过</view>
      <view class="stat-value">{{summary.approved}}</view>
    </view>
    <view class="stat-card">
      <view class="stat-label">已通知</view>
      <view class="stat-value">{{summary.notified}}</view>
    </view>
    <view class="stat-card">
      <view class="stat-label">工资记录</view>
      <view class="stat-value">{{summary.payroll}}</view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <view class="section-title">报名审核</view>
      <view class="chip-row">
        <view wx:for="{{filters}}" wx:key="key" class="chip {{activeFilter === item.key ? 'pending' : ''}}" data-key="{{item.key}}" bindtap="onFilterTap">{{item.label}}</view>
      </view>
    </view>
    <view class="empty-text" wx:if="{{!filteredApplicants.length}}">当前没有需要处理的报名记录</view>

    <view class="list-item" wx:for="{{filteredApplicants}}" wx:key="id">
      <view class="applicant-top">
        <view class="item-title">{{item.name}}</view>
        <view class="status-badge {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="item-sub">{{item.jobTitle}}</view>
      <view class="item-sub">手机：{{item.phone}}</view>
      <view class="item-sub">报名时间：{{item.createdAtText}}</view>
      <view class="item-sub">{{item.trace}}</view>
      <view class="actions-row" wx:if="{{item.status === 0}}">
        <button class="btn-primary" data-id="{{item.id}}" bindtap="approveApplicant">通过</button>
        <button class="btn-ghost" data-id="{{item.id}}" bindtap="rejectApplicant">驳回</button>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head notice-section-head" bindtap="toggleNoticeForm">
      <view class="section-head-left">
        <view class="section-title">集合通知</view>
        <view class="notice-toggle-arrow {{showNoticeForm ? 'expanded' : ''}}"></view>
      </view>
      <view class="section-sub">{{showNoticeForm ? '点击收起' : '点击展开'}} · {{notices.length}}条记录</view>
    </view>

    <view class="notice-summary-row" wx:if="{{!showNoticeForm}}">
      <view class="stat-card">
        <view class="stat-label">最近通知</view>
        <view class="notice-summary-text">{{notices.length ? (notices[0].date + ' ' + notices[0].time + ' ' + notices[0].location) : '暂无记录'}}</view>
      </view>
    </view>

    <view wx:if="{{showNoticeForm}}">
      <view class="form-label">集合日期</view>
      <picker mode="date" value="{{noticeForm.date}}" bindchange="onNoticeDateChange">
        <view class="picker">{{noticeForm.date || '请选择日期'}}</view>
      </picker>

      <view class="form-label">出发时间</view>
      <picker mode="time" value="{{noticeForm.time}}" bindchange="onNoticeTimeChange">
        <view class="picker">{{noticeForm.time || '请选择时间'}}</view>
      </picker>

      <view class="form-label">集合地点</view>
      <input class="input" value="{{noticeForm.location}}" data-field="location" bindinput="onNoticeFieldInput" placeholder="如：县政府东门广场" />

      <view class="form-label">联系人</view>
      <input class="input" value="{{noticeForm.contactName}}" data-field="contactName" bindinput="onNoticeFieldInput" placeholder="填写现场联系人姓名" />

      <view class="form-label">联系电话</view>
      <input class="input" value="{{noticeForm.contactPhone}}" data-field="contactPhone" bindinput="onNoticeFieldInput" placeholder="填写联系电话" />

      <view class="form-label">备注说明</view>
      <textarea class="textarea" value="{{noticeForm.remark}}" data-field="remark" bindinput="onNoticeFieldInput" placeholder="如：提前10分钟到场，携带身份证原件" auto-height />

      <view class="actions-row">
        <button class="btn-primary" loading="{{noticeSubmitting}}" bindtap="submitNotice">保存集合通知</button>
      </view>

      <view class="empty-text" wx:if="{{!notices.length}}">当前还没有保存过集合通知</view>
      <view wx:if="{{notices.length}}">
        <view class="notice-list-title">通知记录</view>
        <view class="list-item" wx:for="{{notices}}" wx:key="id">
          <view class="applicant-top">
            <view class="item-title">{{item.date}} {{item.time}}</view>
            <view class="status-badge ok">已保存</view>
          </view>
          <view class="item-sub">地点：{{item.location}}</view>
          <view class="item-sub">联系人：{{item.contactName}} {{item.contactPhone}}</view>
          <view class="item-sub" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="grid-2">
    <view class="entry-card" bindtap="goToAttendance">
      <view class="entry-title">签到与工资</view>
      <view class="entry-desc">签到、工资生成、导出表单</view>
    </view>
    <view class="entry-card" bindtap="goToPayroll">
      <view class="entry-title">工资表中心</view>
      <view class="entry-desc">工资记录和系统同步结果</view>
    </view>
  </view>

  <view class="empty-text" wx:if="{{loading}}">加载中...</view>

  <view class="admin-bottom-nav">
    <view class="admin-bottom-item {{activeNav === 'home' ? 'active' : ''}}" data-target="home" bindtap="switchAdminNav">{{role === 'super_admin' || role === 'region_admin' ? '人员管理' : '首页'}}</view>
    <view class="admin-bottom-item {{activeNav === 'base' ? 'active' : ''}}" data-target="base" bindtap="switchAdminNav">{{role === 'super_admin' || role === 'region_admin' ? '基地管理' : '基地'}}</view>
    <view class="admin-bottom-item {{activeNav === 'scan' ? 'active' : ''}}" wx:if="{{role !== 'super_admin' && role !== 'region_admin'}}" data-target="scan" bindtap="switchAdminNav">扫码</view>
    <view class="admin-bottom-item {{activeNav === 'audit' ? 'active' : ''}}" wx:if="{{role === 'super_admin' || role === 'region_admin'}}" data-target="audit" bindtap="switchAdminNav">审核</view>
    <view class="admin-bottom-item {{activeNav === 'payroll' ? 'active' : ''}}" wx:if="{{role === 'super_admin' || role === 'region_admin'}}" data-target="payroll" bindtap="switchAdminNav">工资管理</view>
    <view class="admin-bottom-item {{activeNav === 'me' ? 'active' : ''}}" data-target="me" bindtap="switchAdminNav">我的信息</view>
  </view>
</view>
