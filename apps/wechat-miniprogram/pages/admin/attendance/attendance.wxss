/* ═══════════════════════════════════════════
   Admin Attendance — Claude Purple Theme
   ═══════════════════════════════════════════ */

@import "../common.wxss";

.appeal-block {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(242, 184, 75, 0.08);
  border: 2rpx solid rgba(242, 184, 75, 0.16);
}

.appeal-editor-card {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx dashed rgba(102, 126, 234, 0.16);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
