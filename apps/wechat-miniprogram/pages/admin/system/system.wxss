/* ═══════════════════════════════════════════
   Admin System — Claude Purple Theme
   ═══════════════════════════════════════════ */

@import "../common.wxss";

.filter-grid {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.no-top {
  margin-top: 0;
}

/* ── Report Card ── */
.base-report-card {
  margin-top: 14rpx;
  border-color: rgba(102, 126, 234, 0.18);
  background: rgba(102, 126, 234, 0.04);
}

.report-summary-row {
  margin-top: 12rpx;
}

.auto-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-sub);
}

/* ── Collapse ── */
.collapse-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6rpx 0 10rpx;
}

.collapse-main {
  flex: 1;
  min-width: 0;
}

.collapse-tag {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 700;
  color: var(--brand-purple);
  background: rgba(102, 126, 234, 0.1);
  border: 1rpx solid rgba(102, 126, 234, 0.2);
}

.collapse-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-muted);
}

/* ── Table ── */
.table-scroll {
  width: 100%;
  margin-top: 12rpx;
}

.table-wrap {
  min-width: 2000rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.15);
  border-radius: 14rpx;
  overflow: hidden;
  background: var(--card-bg);
}

.table-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid rgba(102, 126, 234, 0.08);
}

.table-row:last-child {
  border-bottom: none;
}

.table-head {
  background: rgba(102, 126, 234, 0.08);
}

.cell {
  padding: 12rpx 8rpx;
  font-size: 20rpx;
  color: var(--ink-main);
  border-right: 1rpx solid rgba(102, 126, 234, 0.08);
  box-sizing: border-box;
}

.table-head .cell {
  font-weight: 700;
}

.cell:last-child {
  border-right: none;
}

.cell.serial { width: 72rpx; text-align: center; }
.cell.name { width: 110rpx; }
.cell.gender { width: 80rpx; text-align: center; }
.cell.idcard { width: 220rpx; }
.cell.addr { width: 260rpx; }
.cell.poor { width: 120rpx; text-align: center; }
.cell.age { width: 92rpx; text-align: center; }
.cell.phone { width: 170rpx; }
.cell.location { width: 180rpx; }
.cell.worktype { width: 190rpx; }
.cell.start { width: 210rpx; }
.cell.end { width: 210rpx; }
.cell.remark { flex: 1; min-width: 150rpx; }

.cell.amount { width: 140rpx; text-align: right; }
.cell.sign { width: 110rpx; text-align: center; }

/* ── Report Actions ── */
.report-actions {
  margin-top: 18rpx;
}

/* ── History Active ── */
.history-active {
  border-color: var(--brand-purple) !important;
  box-shadow: 0 0 0 2rpx rgba(102, 126, 234, 0.2) inset;
  background: rgba(102, 126, 234, 0.04) !important;
}

@media (max-width: 720rpx) {
  .filter-grid {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
}
