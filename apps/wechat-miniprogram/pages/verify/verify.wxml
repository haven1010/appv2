<view class="verify-page">
  <!-- ====== 顶部栏 ====== -->
  <view class="top-bar">
    <view class="top-bar-row">
      <view wx:if="{{currentStep > 0}}" class="back-btn" bindtap="prevStep">
        <text class="back-arrow">‹</text>
        <text class="back-label">{{stepLabels[currentStep]}}</text>
      </view>
      <view wx:else class="top-title">
        <text class="top-brand">实名认证</text>
        <text class="top-sub">完善身份信息</text>
      </view>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{progressPercent}}%"></view>
    </view>
  </view>

  <!-- ====== 步骤容器 ====== -->
  <view class="steps-container">
    <block wx:for="{{stepClasses}}" wx:key="index">
      <view class="step {{item}}">

        <!-- ─── 0. 欢迎 ─── -->
        <block wx:if="{{stepKeys[index] === 'welcome'}}">
          <view class="step-body welcome-body">
            <image class="step-icon" src="/images/icons/sun.svg" mode="aspectFit" />
            <text class="step-title">完成实名认证</text>
            <text class="step-desc">几步操作，解锁全部功能</text>
            <view class="welcome-features">
              <view class="welcome-feat"><image class="feat-icon" src="/images/icons/edit.svg" mode="aspectFit" /> 填写真实姓名</view>
              <view class="welcome-feat"><image class="feat-icon" src="/images/icons/file-text.svg" mode="aspectFit" /> 核对身份证信息</view>
              <view class="welcome-feat"><image class="feat-icon" src="/images/icons/check-circle.svg" mode="aspectFit" /> 开通岗位报名</view>
            </view>
            <button class="btn-start" bindtap="nextStep"><image class="btn-start-icon" src="/images/icons/edit-white.svg" mode="aspectFit" /> 开始认证</button>
            <view class="welcome-login">
              <text class="welcome-login-link" bindtap="goToHome">跳过，稍后再说</text>
            </view>
          </view>
        </block>

        <!-- ─── 1. 姓名 ─── -->
        <block wx:elif="{{stepKeys[index] === 'name'}}">
          <view class="step-body">
            <image class="step-icon" src="/images/icons/edit.svg" mode="aspectFit" />
            <text class="step-title">你叫什么名字？</text>
            <view class="step-input-area">
              <view class="input-wrapper {{name ? 'has-value' : ''}}">
                <input class="input-field" type="text" placeholder="请输入真实姓名" placeholder-class="placeholder" value="{{name}}" bindinput="onInputName" focus="{{index === currentStep}}" />
              </view>
            </view>
            <text class="step-hint">请填写身份证上的真实姓名</text>
          </view>
        </block>

        <!-- ─── 2. 身份信息 ─── -->
        <block wx:elif="{{stepKeys[index] === 'identity'}}">
          <view class="step-body">
            <image class="step-icon" src="/images/icons/file-text.svg" mode="aspectFit" />
            <text class="step-title">请填写身份证信息</text>
            <button class="ocr-btn" bindtap="handleOcr">
              <image class="ocr-icon" src="/images/icons/camera.svg" mode="aspectFit" />
              <text class="ocr-text">拍摄身份证自动识别</text>
            </button>
            <view class="ocr-divider">
              <view class="ocr-line"></view>
              <text class="ocr-or">或手动输入</text>
              <view class="ocr-line"></view>
            </view>
            <view class="step-input-area">
              <view class="input-wrapper {{idCard ? 'has-value' : ''}}">
                <input class="input-field" type="idcard" placeholder="请输入18位身份证号" placeholder-class="placeholder" value="{{idCard}}" bindinput="onInputIdCard" maxlength="18" focus="{{index === currentStep}}" />
              </view>
              <view class="textarea-wrapper field-gap">
                <textarea class="textarea-field" placeholder="请填写身份证上的地址（至少5个字）" placeholder-class="placeholder" value="{{homeAddress}}" bindinput="onInputHomeAddress" maxlength="120" auto-height />
              </view>
            </view>
            <text class="step-hint">身份证号和地址用于报名、签到与工资确认留档</text>
          </view>
        </block>

        <!-- ─── 3. 性别 ─── -->
        <block wx:elif="{{stepKeys[index] === 'gender'}}">
          <view class="step-body">
            <image class="step-icon" src="/images/icons/user.svg" mode="aspectFit" />
            <text class="step-title">你的性别是？</text>
            <view class="choice-group">
              <view class="choice-pill {{gender === 'male' ? 'selected' : ''}}" bindtap="onSelectGender" data-value="male">
                
                <text class="choice-label">男</text>
              </view>
              <view class="choice-pill {{gender === 'female' ? 'selected' : ''}}" bindtap="onSelectGender" data-value="female">
                
                <text class="choice-label">女</text>
              </view>
            </view>
          </view>
        </block>

        <!-- ─── 4. 贫困户 ─── -->
        <block wx:elif="{{stepKeys[index] === 'poverty'}}">
          <view class="step-body">
            <image class="step-icon" src="/images/icons/clipboard.svg" mode="aspectFit" />
            <text class="step-title">是否建档立卡贫困户？</text>
            <view class="choice-group">
              <view class="choice-pill {{isPoorHousehold === 'yes' ? 'selected' : ''}}" bindtap="onSelectPoverty" data-value="yes">
                <text class="choice-label">是</text>
                <text class="choice-sub">已建档立卡</text>
              </view>
              <view class="choice-pill {{isPoorHousehold === 'no' ? 'selected' : ''}}" bindtap="onSelectPoverty" data-value="no">
                <text class="choice-label">否</text>
                <text class="choice-sub">非贫困户</text>
              </view>
            </view>
          </view>
        </block>

        <!-- ─── 6. 手机号 ─── -->
        <block wx:elif="{{stepKeys[index] === 'phone'}}">
          <view class="step-body">
            <image class="step-icon" src="/images/icons/phone.svg" mode="aspectFit" />
            <text class="step-title">你的手机号是？</text>
            <view class="step-input-area">
              <view class="input-wrapper {{phone ? 'has-value' : ''}}">
                <input class="input-field" type="number" placeholder="请输入11位手机号" placeholder-class="placeholder" value="{{phone}}" bindinput="onInputPhone" maxlength="11" focus="{{index === currentStep}}" />
              </view>
            </view>
          </view>
        </block>

        <!-- ─── 8. 确认 ─── -->
        <block wx:elif="{{stepKeys[index] === 'confirm'}}">
          <view class="step-body">
            <image class="step-icon" src="/images/icons/check-circle.svg" mode="aspectFit" />
            <text class="step-title">确认信息并提交</text>
            <text class="step-desc">请核对以下信息，确认无误后提交</text>
            <view class="confirm-card">
              <view class="confirm-section">
                <text class="confirm-section-title">实名信息</text>
                <view class="confirm-row"><text class="confirm-label">姓名</text><text class="confirm-value">{{name || '-'}}</text></view>
                <view class="confirm-row"><text class="confirm-label">身份证</text><text class="confirm-value">{{idCard || '-'}}</text></view>
                <view class="confirm-row" wx:if="{{gender}}"><text class="confirm-label">性别</text><text class="confirm-value">{{gender === 'male' ? '男' : '女'}}</text></view>
                <view class="confirm-row" wx:if="{{isPoorHousehold}}"><text class="confirm-label">贫困户</text><text class="confirm-value">{{isPoorHousehold === 'yes' ? '是' : '否'}}</text></view>
                <view class="confirm-row"><text class="confirm-label">地址</text><text class="confirm-value">{{homeAddress || '-'}}</text></view>
                <view class="confirm-row"><text class="confirm-label">手机号</text><text class="confirm-value">{{phone || '-'}}</text></view>
              </view>
            </view>
          </view>
        </block>

        <!-- 步骤错误提示 -->
        <view class="step-error" wx:if="{{stepError}}">
          <text class="step-error-text">{{stepError}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- ====== 底部操作区 ====== -->
  <view class="bottom-area" wx:if="{{currentStep > 0}}">
    <block wx:if="{{currentStep < totalSteps - 1}}">
      <button class="btn-next {{stepError ? 'btn-next-error' : ''}}" bindtap="nextStep">
        <text>下一步</text>
        <text class="btn-next-arrow">→</text>
      </button>
    </block>
    <block wx:elif="{{currentStep === totalSteps - 1}}">
      <button class="btn-submit" loading="{{loading}}" disabled="{{loading}}" bindtap="handleSubmit">
        <block wx:if="{{loading}}">提交中...</block>
        <block wx:else><image class="btn-submit-icon" src="/images/icons/check-white.svg" mode="aspectFit" /> 确认并提交</block>
      </button>
    </block>
  </view>
</view>
