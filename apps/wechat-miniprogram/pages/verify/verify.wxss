/* pages/verify/verify.wxss - iOS-style real-name flow */

page {
  background: #f5f5f7 !important;
  color: #111111;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.verify-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(158rpx + env(safe-area-inset-bottom));
  background: #f5f5f7;
  color: #111111;
  overflow: visible;
}

.top-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  box-sizing: border-box;
  padding: calc(28rpx + env(safe-area-inset-top)) 32rpx 22rpx;
  background: rgba(245, 245, 247, 0.92);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
}

.top-bar-row {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.back-btn {
  min-width: 0;
  max-width: 100%;
  height: 64rpx;
  padding: 0 22rpx 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 2rpx solid rgba(17, 17, 17, 0.06);
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.back-btn:active {
  opacity: 0.72;
  transform: scale(0.98);
}

.back-arrow {
  color: #111111;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 700;
}

.back-label {
  min-width: 0;
  color: #111111;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-title {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.top-brand {
  color: #111111;
  font-size: 44rpx;
  line-height: 1.08;
  font-weight: 900;
  letter-spacing: 0;
}

.top-sub {
  color: #8e8e93;
  font-size: 26rpx;
  line-height: 1.25;
  font-weight: 700;
}

.progress-track {
  width: 100%;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e5e5ea;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #111111;
  transition: width 0.28s ease;
}

.steps-container {
  position: relative;
  box-sizing: border-box;
  padding: 24rpx 32rpx 0;
  overflow: visible;
}

.step {
  box-sizing: border-box;
}

.step.past,
.step.future {
  display: none;
}

.step.current {
  display: block;
  animation: verifyFadeUp 0.24s ease both;
}

@keyframes verifyFadeUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.step-body {
  min-height: 620rpx;
  box-sizing: border-box;
  padding: 34rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.welcome-body {
  padding-top: 44rpx;
}

.step-icon {
  width: 76rpx;
  height: 76rpx;
  display: block;
  margin: 0 auto 24rpx;
  opacity: 0.88;
}

.welcome-body .step-icon {
  width: 92rpx;
  height: 92rpx;
}

.step-title {
  max-width: 640rpx;
  color: #111111;
  font-size: 48rpx;
  line-height: 1.16;
  font-weight: 900;
  text-align: center;
  letter-spacing: 0;
}

.step-desc {
  max-width: 620rpx;
  margin-top: 16rpx;
  color: #8e8e93;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 700;
  text-align: center;
}

.step-hint {
  margin-top: 18rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 700;
  text-align: center;
}

.welcome-features {
  width: 100%;
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.welcome-feat {
  min-height: 92rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(17, 17, 17, 0.06);
  box-shadow: 0 14rpx 30rpx rgba(15, 23, 42, 0.045);
  color: #111111;
  font-size: 30rpx;
  line-height: 92rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.feat-icon {
  width: 32rpx;
  height: 32rpx;
  display: inline-block;
  vertical-align: -5rpx;
  margin-right: 12rpx;
}

.btn-start {
  width: 100%;
  height: 96rpx;
  margin-top: 48rpx;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 96rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 28rpx rgba(17, 17, 17, 0.16);
}

.btn-start::after {
  border: none;
}

.btn-start:active {
  opacity: 0.86;
  transform: scale(0.985);
}

.btn-start-icon {
  width: 34rpx;
  height: 34rpx;
  display: inline-block;
  vertical-align: -6rpx;
  margin-right: 10rpx;
}

.welcome-login {
  margin-top: 26rpx;
  text-align: center;
}

.welcome-login-link {
  color: #8e8e93;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 800;
  padding: 12rpx 18rpx;
}

.step-input-area {
  width: 100%;
  margin-top: 44rpx;
}

.input-wrapper,
.textarea-wrapper {
  width: 100%;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(17, 17, 17, 0.06);
  box-shadow: 0 14rpx 30rpx rgba(15, 23, 42, 0.045);
}

.input-wrapper {
  min-height: 104rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
}

.input-wrapper.has-value {
  border-color: rgba(17, 17, 17, 0.18);
}

.input-field {
  width: 100%;
  height: 104rpx;
  color: #111111;
  font-size: 34rpx;
  line-height: 104rpx;
  font-weight: 800;
  background: transparent;
}

.picker-field {
  width: 100%;
  min-height: 104rpx;
  color: #111111;
  font-size: 32rpx;
  line-height: 104rpx;
  font-weight: 800;
}

.picker-field.placeholder,
.placeholder {
  color: #b8b8bd;
  font-weight: 700;
}

.textarea-wrapper {
  min-height: 184rpx;
  padding: 26rpx 30rpx;
}

.field-gap {
  margin-top: 22rpx;
}

.textarea-field {
  width: 100%;
  min-height: 132rpx;
  color: #111111;
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 800;
  background: transparent;
}

.choice-group {
  width: 100%;
  margin-top: 46rpx;
  display: flex;
  gap: 22rpx;
}

.choice-pill {
  flex: 1;
  min-width: 0;
  min-height: 128rpx;
  padding: 18rpx 16rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(17, 17, 17, 0.06);
  box-shadow: 0 14rpx 30rpx rgba(15, 23, 42, 0.045);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.choice-pill:active {
  transform: scale(0.985);
}

.choice-pill.selected {
  background: #111111;
  border-color: #111111;
  box-shadow: 0 14rpx 28rpx rgba(17, 17, 17, 0.16);
}

.choice-label {
  color: #111111;
  font-size: 36rpx;
  line-height: 1.15;
  font-weight: 900;
}

.choice-sub {
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 700;
}

.choice-pill.selected .choice-label,
.choice-pill.selected .choice-sub {
  color: #ffffff;
}

.ocr-btn {
  width: 100%;
  height: 90rpx;
  margin-top: 38rpx;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx dashed rgba(17, 17, 17, 0.18);
  color: #111111;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.ocr-btn::after {
  border: none;
}

.ocr-btn:active {
  opacity: 0.78;
}

.ocr-icon {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.ocr-text {
  color: #111111;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 800;
}

.ocr-divider {
  width: 100%;
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.ocr-line {
  flex: 1;
  height: 2rpx;
  background: #e5e5ea;
}

.ocr-or {
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  white-space: nowrap;
}

.confirm-card {
  width: 100%;
  margin-top: 34rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(17, 17, 17, 0.06);
  box-shadow: 0 14rpx 30rpx rgba(15, 23, 42, 0.045);
  box-sizing: border-box;
}

.confirm-section {
  padding: 26rpx 0;
  border-bottom: 2rpx solid #ededee;
}

.confirm-section:last-child {
  border-bottom: none;
}

.confirm-section-title {
  margin-bottom: 12rpx;
  color: #111111;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 900;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-title-icon {
  width: 28rpx;
  height: 28rpx;
  display: inline-block;
  flex-shrink: 0;
}

.confirm-row {
  min-height: 58rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  padding: 10rpx 0;
}

.confirm-label {
  flex-shrink: 0;
  color: #8e8e93;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
}

.confirm-value {
  min-width: 0;
  max-width: 460rpx;
  color: #111111;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 800;
  text-align: right;
  overflow-wrap: anywhere;
}

.step-error {
  width: 100%;
  margin: 8rpx 0 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #fff1f0;
  border: 2rpx solid rgba(255, 59, 48, 0.18);
  box-sizing: border-box;
  text-align: center;
}

.step-error-text {
  color: #d70015;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 800;
}

.bottom-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(245, 245, 247, 0.94);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
}

.btn-next,
.btn-submit {
  width: 100%;
  height: 96rpx;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 96rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 14rpx 28rpx rgba(17, 17, 17, 0.16);
}

.btn-next::after,
.btn-submit::after {
  border: none;
}

.btn-next:active,
.btn-submit:active {
  opacity: 0.86;
  transform: scale(0.985);
}

.btn-next-arrow {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 700;
}

.btn-next-error {
  animation: verifyShake 0.26s ease;
}

@keyframes verifyShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  75% { transform: translateX(8rpx); }
}

.btn-submit[disabled] {
  opacity: 0.7;
}

.btn-submit-icon {
  width: 34rpx;
  height: 34rpx;
  display: inline-block;
  vertical-align: -6rpx;
  margin-right: 10rpx;
}
