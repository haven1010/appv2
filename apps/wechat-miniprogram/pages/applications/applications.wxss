.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 84% 0%, rgba(59, 130, 246, 0.12) 0%, rgba(59, 130, 246, 0) 28%),
    radial-gradient(circle at 10% 8%, rgba(34, 197, 94, 0.1) 0%, rgba(34, 197, 94, 0) 26%),
    linear-gradient(180deg, #f8f1e6 0%, #eef6ec 100%);
}

.page-body {
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(186rpx + env(safe-area-inset-bottom));
}

.hero-card,
.group-card {
  background: rgba(255, 252, 246, 0.96);
  border: 2rpx solid rgba(101, 126, 87, 0.14);
  border-radius: 30rpx;
  box-shadow: 0 12rpx 28rpx rgba(76, 92, 63, 0.08);
}

.hero-card {
  padding: 28rpx;
}

.hero-badge {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #e8f3da;
  color: #56753d;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  line-height: 1.35;
  color: #2f342d;
  font-weight: 800;
}

.hero-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #6b7567;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.group-card {
  padding: 24rpx;
}

.group-head {
  margin-bottom: 18rpx;
}

.group-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.35;
  color: #2f342d;
  font-weight: 800;
}

.group-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #7a8475;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.step-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 18rpx;
  border-radius: 22rpx;
  background: #f8f6ef;
  border: 1rpx solid rgba(101, 126, 87, 0.12);
}

.step-index {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6a994e 0%, #4f7f84 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
  min-width: 0;
}

.step-label {
  display: block;
  font-size: 30rpx;
  line-height: 1.4;
  color: #333a30;
  font-weight: 700;
}

.step-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #7a8475;
}

.step-arrow {
  color: #90a185;
  font-size: 28rpx;
  font-weight: 700;
}

.back-btn {
  margin-top: 22rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #fffaf0;
  color: #5e7a47;
  border: 2rpx solid rgba(101, 126, 87, 0.18);
  font-size: 30rpx;
  font-weight: 700;
}

.back-btn::after {
  border: none;
}

.page-bottom-gap {
  height: 24rpx;
}
