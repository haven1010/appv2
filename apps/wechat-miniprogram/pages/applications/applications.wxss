/* ═══════════════════════════════════════════
   Applications (AI Chat) Page — Claude Purple Theme
   ═══════════════════════════════════════════ */

.ai-page {
  min-height: 100vh;
}

.ai-body {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(190rpx + env(safe-area-inset-bottom));
}

/* ── Top Header ── */
.ai-top {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 16rpx;
}

.ai-title {
  font-size: 46rpx;
  line-height: 1.25;
  color: var(--ink-main);
  font-weight: 900;
}

.ai-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--ink-sub);
}

/* ── Chat Stream ── */
.chat-stream {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.user-row {
  display: flex;
  justify-content: flex-end;
}

.user-bubble {
  max-width: 72%;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  background: var(--brand-gradient);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1.5;
  font-weight: 700;
  box-shadow: 0 12rpx 24rpx rgba(102, 126, 234, 0.18);
}

.assistant-card {
  border-radius: var(--radius-lg);
  background: var(--card-bg);
  padding: 24rpx 20rpx 16rpx;
  box-shadow: var(--shadow-md);
  border: var(--border-soft);
}

.assistant-text {
  display: block;
  font-size: 34rpx;
  line-height: 1.7;
  color: var(--ink-main);
  font-weight: 700;
}

.assistant-actions {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(102, 126, 234, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.assistant-action-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.assistant-action-btn:active {
  transform: scale(0.9);
  opacity: 0.7;
}

.assistant-action-icon {
  font-size: 30rpx;
  color: var(--brand-purple);
  font-weight: 800;
}

/* ── Quick Actions ── */
.quick-action-row {
  margin-top: 26rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 22rpx;
  border-radius: var(--radius-pill);
  background: var(--card-bg);
  border: var(--border-soft);
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.quick-chip:active {
  transform: scale(0.96);
  background: var(--card-bg-soft);
}

.quick-chip-icon {
  font-size: 26rpx;
}

.quick-chip-text {
  font-size: 28rpx;
  color: var(--ink-main);
  font-weight: 700;
}

/* ── Composer ── */
.composer-shell {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 18rpx;
  z-index: 20;
}

.composer-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 30rpx;
  background: var(--card-bg);
  box-shadow: var(--shadow-lg);
  border: var(--border-soft);
}

.composer-left-icon {
  font-size: 42rpx;
  line-height: 1;
}

.composer-input {
  flex: 1;
  min-height: 72rpx;
  font-size: 30rpx;
  color: var(--ink-main);
  background: transparent;
}

.composer-right-icons {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.composer-small-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--card-bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  transition: all 0.2s;
}

.composer-small-icon:active {
  transform: scale(0.9);
}

.composer-send {
  margin-top: 12rpx;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-purple);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.25);
  transition: all 0.2s;
}

.composer-send:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.composer-send::after {
  border: none;
}
