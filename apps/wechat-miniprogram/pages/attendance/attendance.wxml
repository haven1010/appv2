<view class="page attendance-page {{pageReady ? 'page-enter' : ''}}">
  <view class="attendance-hero">
    <image class="attendance-hero-img" src="/images/home-action-bg-4.png" mode="aspectFill"></image>
    <view class="attendance-hero-mask"></view>
    <view class="attendance-hero-copy">
      <text class="hero-kicker">今日考勤</text>
      <text class="hero-title">{{dateText}} {{weekText}}</text>
      <text class="hero-desc">{{periodText}}班次 · 上工记录可追溯</text>
    </view>
  </view>

  <view class="today-card">
    <view class="today-status">
      <text class="today-title">上工前先展示签到码</text>
      <text class="today-desc">现场负责人扫码后，会生成当天考勤记录。</text>
    </view>
    <button class="primary-action" bindtap="goToQrcode">打开签到码</button>
  </view>

  <view class="action-list">
    <view class="action-item" bindtap="goToWorkHistory">
      <view class="action-icon">历</view>
      <view class="action-copy">
        <text class="action-title">考勤记录</text>
        <text class="action-desc">查看签到时间、工作历程和累计记录</text>
      </view>
      <text class="action-arrow">›</text>
    </view>

    <view class="action-item" bindtap="goToSalary">
      <view class="action-icon green">薪</view>
      <view class="action-copy">
        <text class="action-title">薪资结算</text>
        <text class="action-desc">核对待确认工资，处理结算进度</text>
      </view>
      <text class="action-arrow">›</text>
    </view>
  </view>

  <view class="guide-card">
    <text class="section-title">今日操作建议</text>
    <view class="timeline-item">
      <text class="timeline-index">1</text>
      <text class="timeline-text">开工前展示签到码，确保当天工时被记录。</text>
    </view>
    <view class="timeline-item">
      <text class="timeline-index">2</text>
      <text class="timeline-text">收工后查看考勤记录，确认是否有漏记。</text>
    </view>
    <view class="timeline-item">
      <text class="timeline-index">3</text>
      <text class="timeline-text">工资待确认时，进入薪资结算页及时处理。</text>
    </view>
  </view>
</view>
