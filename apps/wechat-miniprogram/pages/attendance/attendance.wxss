/* ═══════════════════════════════════════════
   Attendance List — Claude Purple Theme
   ═══════════════════════════════════════════ */

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
}

/* ── Hero Card ── */
.hero-card {
  border-radius: var(--radius-lg);
  border: var(--border-soft);
  background: var(--card-bg);
  box-shadow: var(--shadow-md);
  padding: 28rpx;
  position: relative;
  overflow: hidden;
}

.hero-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--brand-gradient);
  border-radius: 0 0 2rpx 2rpx;
}

.hero-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-title {
  display: block;
  font-size: 38rpx;
  font-weight: 900;
  color: var(--ink-main);
}

.hero-subtitle {
  margin-top: 8rpx;
  display: block;
  font-size: 24rpx;
  color: var(--ink-sub);
}

.hero-badge {
  font-size: 20rpx;
  color: var(--brand-purple);
  background: rgba(102, 126, 234, 0.1);
  border: 1rpx solid rgba(102, 126, 234, 0.18);
  border-radius: var(--radius-pill);
  padding: 6rpx 14rpx;
  flex-shrink: 0;
}

/* ── Hero Stats ── */
.hero-stats {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}

.hero-stat {
  flex: 1;
  border-radius: var(--radius-sm);
  border: var(--border-soft);
  background: var(--card-bg-soft);
  padding: 14rpx 12rpx;
  text-align: center;
}

.hero-stat-value {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--brand-purple);
}

.hero-stat-label {
  margin-top: 6rpx;
  display: block;
  font-size: 20rpx;
  color: var(--ink-sub);
}

/* ── Module Card ── */
.module-card {
  margin-top: 16rpx;
  border-radius: var(--radius-md);
  border: var(--border-soft);
  background: var(--card-bg);
  box-shadow: var(--shadow-sm);
  padding: 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: all 0.2s;
}

.module-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.module-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.module-icon.mint {
  color: var(--brand-purple);
  background: rgba(102, 126, 234, 0.1);
}

.module-icon.blue {
  color: var(--accent-blue);
  background: rgba(77, 166, 255, 0.1);
}

.module-icon.sky {
  color: var(--accent-green);
  background: rgba(49, 164, 124, 0.1);
}

.module-main {
  flex: 1;
  min-width: 0;
}

.module-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
}

.module-desc {
  margin-top: 6rpx;
  display: block;
  font-size: 22rpx;
  color: var(--ink-sub);
  line-height: 1.55;
}

.cell-arrow {
  font-size: 36rpx;
  line-height: 1;
  color: var(--ink-muted);
}

/* ── Guide Card ── */
.guide-card {
  margin-top: 20rpx;
  border-radius: var(--radius-md);
  border: var(--border-soft);
  background: var(--card-bg);
  box-shadow: var(--shadow-sm);
  padding: 24rpx;
}

.section-head {
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink-main);
}

/* ── Steps ── */
.step-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 12rpx 0;
}

.step-index {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 800;
  color: #1a1a2e;
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
  box-shadow: 0 4rpx 8rpx rgba(102, 126, 234, 0.2);
}

.step-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-sub);
  line-height: 1.65;
}
