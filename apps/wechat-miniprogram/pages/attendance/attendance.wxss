page {
  background: #f5f5f7;
}

.attendance-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #f5f5f7;
  color: #111111;
}

.attendance-hero {
  position: relative;
  height: 360rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #111111;
  box-shadow: 0 22rpx 52rpx rgba(0, 0, 0, 0.14);
}

.attendance-hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.attendance-hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08) 0%, rgba(0, 0, 0, 0.76) 100%);
}

.attendance-hero-copy {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 30rpx;
}

.hero-kicker {
  display: flex;
  align-items: center;
  width: 150rpx;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #168252;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 900;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 52rpx;
  line-height: 1.12;
  font-weight: 900;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 800;
}

.today-card,
.action-list,
.guide-card {
  margin-top: 24rpx;
  border-radius: 34rpx;
  background: #ffffff;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.055);
}

.today-card {
  padding: 30rpx;
}

.today-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 900;
}

.today-desc {
  display: block;
  margin-top: 10rpx;
  color: #8d929c;
  font-size: 27rpx;
  line-height: 1.5;
  font-weight: 700;
}

.primary-action {
  width: 100%;
  height: 104rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #111111;
  font-size: 34rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.18);
}

.primary-action::after {
  border: none;
}

.action-list {
  overflow: hidden;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx;
}

.action-item + .action-item {
  border-top: 1rpx solid #eef0f2;
}

.action-item:active {
  opacity: 0.72;
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #f2f3f5;
  color: #111111;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}

.action-icon.green {
  color: #168252;
  background: #edf8f2;
}

.action-copy {
  flex: 1;
  min-width: 0;
}

.action-title {
  display: block;
  color: #111111;
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 900;
}

.action-desc {
  display: block;
  margin-top: 8rpx;
  color: #8d929c;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 700;
}

.action-arrow {
  color: #c5c8ce;
  font-size: 44rpx;
  line-height: 1;
}

.guide-card {
  padding: 30rpx;
}

.section-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
}

.timeline-index {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
}

.timeline-text {
  flex: 1;
  color: #5c626b;
  font-size: 27rpx;
  line-height: 1.58;
  font-weight: 800;
}
