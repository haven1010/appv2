.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 0% 0%, rgba(183, 206, 159, 0.32) 0%, rgba(183, 206, 159, 0) 45%),
    radial-gradient(circle at 100% 0%, rgba(233, 196, 106, 0.3) 0%, rgba(233, 196, 106, 0) 38%),
    linear-gradient(180deg, #f7f1e3 0%, #efe7d8 100%);
}

.hero-card,
.section-card,
.state-panel {
  border-radius: 28rpx;
  border: 2rpx solid rgba(112, 93, 69, 0.16);
  background: rgba(255, 251, 243, 0.96);
  box-shadow: 0 10rpx 22rpx rgba(112, 93, 69, 0.08);
}

.hero-card {
  padding: 24rpx;
}

.hero-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-title {
  flex: 1;
  font-size: 42rpx;
  line-height: 1.25;
  color: #2f3b2a;
  font-weight: 800;
}

.status-tag {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.status-tag.approved {
  color: #3f6d2f;
  background: #dcecc8;
}

.status-tag.pending {
  color: #8e6a2f;
  background: #f8e5b6;
}

.status-tag.rejected {
  color: #8f4b43;
  background: #f3d9d4;
}

.hero-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #6f5f4a;
}

.hero-stats {
  margin-top: 18rpx;
  display: flex;
  gap: 10rpx;
}

.hero-stat {
  flex: 1;
  border-radius: 18rpx;
  border: 2rpx solid rgba(112, 93, 69, 0.12);
  background: #f9f2e4;
  padding: 14rpx 12rpx;
  text-align: center;
}

.hero-stat-value {
  display: block;
  font-size: 28rpx;
  line-height: 1.35;
  color: #3c4b34;
  font-weight: 800;
}

.hero-stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: #7d6b56;
}

.section-card {
  margin-top: 18rpx;
  padding: 22rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.35;
  color: #2f3b2a;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.info-row {
  padding: 14rpx 0;
  border-bottom: 1rpx dashed rgba(112, 93, 69, 0.2);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  display: block;
  font-size: 24rpx;
  line-height: 1.35;
  color: #7d6b56;
}

.info-value {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  line-height: 1.45;
  color: #3b2f21;
  word-break: break-all;
}

.license-wrap {
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid rgba(112, 93, 69, 0.16);
  background: #f5ebd7;
}

.license-image {
  width: 100%;
  height: 360rpx;
  display: block;
}

.env-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.env-image {
  width: calc((100% - 24rpx) / 3);
  height: 180rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(112, 93, 69, 0.12);
  background: #f0e5cd;
}

.empty-box {
  border-radius: 18rpx;
  border: 2rpx dashed rgba(112, 93, 69, 0.22);
  background: #f9f2e4;
  padding: 34rpx 20rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  line-height: 1.45;
  color: #87735d;
}

.warn-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #9a5d3d;
}

.state-panel {
  margin-top: 10rpx;
  padding: 56rpx 26rpx;
  text-align: center;
}

.state-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.4;
  color: #3b2f21;
  font-weight: 700;
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #87735d;
}
