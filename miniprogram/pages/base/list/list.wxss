.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at right top, rgba(143, 219, 190, 0.28) 0%, rgba(143, 219, 190, 0) 46%),
    radial-gradient(circle at left top, rgba(145, 196, 235, 0.24) 0%, rgba(145, 196, 235, 0) 42%),
    linear-gradient(180deg, #f9fefe 0%, #f2fbf8 100%);
}

.hero-card {
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(95, 170, 193, 0.2);
  box-shadow: 0 12rpx 24rpx rgba(83, 157, 186, 0.12);
  padding: 24rpx;
}

.hero-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #143a50;
}

.hero-badge {
  font-size: 20rpx;
  color: #2f8f78;
  background: rgba(130, 219, 189, 0.2);
  border: 1rpx solid rgba(130, 219, 189, 0.34);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.hero-subtitle {
  margin-top: 10rpx;
  display: block;
  font-size: 24rpx;
  color: #6b8ea5;
}

.hero-stats {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.hero-stat {
  flex: 1;
  border-radius: 16rpx;
  background: rgba(246, 252, 252, 0.9);
  border: 1rpx solid rgba(95, 170, 193, 0.16);
  padding: 14rpx 12rpx;
}

.hero-stat-value {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #143a50;
}

.hero-stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b8ea5;
}

.segment-card {
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(95, 170, 193, 0.2);
  padding: 8rpx;
  display: flex;
  box-shadow: 0 8rpx 16rpx rgba(83, 157, 186, 0.1);
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #6a8ea4;
  border-radius: 999rpx;
  font-weight: 700;
}

.segment-item.active {
  color: #ffffff;
  background: linear-gradient(135deg, #58c2a6 0%, #4f98d8 100%);
  box-shadow: 0 8rpx 16rpx rgba(83, 157, 186, 0.22);
}

.state-panel {
  margin-top: 18rpx;
  border-radius: 24rpx;
  text-align: center;
  padding: 52rpx 28rpx;
  border: 1rpx solid rgba(95, 170, 193, 0.2);
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 12rpx 22rpx rgba(83, 157, 186, 0.1);
}

.state-title {
  display: block;
  font-size: 30rpx;
  color: #30526a;
  font-weight: 700;
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b8ea5;
}

.base-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.base-card {
  border-radius: 20rpx;
  border: 1rpx solid rgba(95, 170, 193, 0.2);
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 10rpx 20rpx rgba(83, 157, 186, 0.1);
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.base-main {
  flex: 1;
  min-width: 0;
}

.base-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.base-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 800;
  color: #143a50;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.status-tag {
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  font-weight: 700;
}

.status-tag.ok {
  color: #2f8f78;
  background: rgba(130, 219, 189, 0.22);
}

.status-tag.wait {
  color: #4f98d8;
  background: rgba(145, 196, 235, 0.22);
}

.base-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.category-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #2f8f78;
  background: rgba(130, 219, 189, 0.2);
  border: 1rpx solid rgba(130, 219, 189, 0.34);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.base-address {
  font-size: 22rpx;
  color: #5f8298;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cell-arrow {
  font-size: 34rpx;
  color: #89a8bc;
  line-height: 1;
}
