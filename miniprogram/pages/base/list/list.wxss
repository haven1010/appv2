/* pages/base/list/list.wxss */
.page {
  min-height: 100vh;
  padding: 0 24rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at right top, rgba(255, 226, 180, 0.9) 0%, rgba(255, 226, 180, 0) 46%),
    linear-gradient(180deg, #fffef8 0%, #fff2dc 100%);
}

.sticky-shell {
  position: sticky;
  top: 0;
  z-index: 8;
  padding: 24rpx 2rpx 16rpx;
  background: linear-gradient(180deg, rgba(255, 247, 230, 0.98) 0%, rgba(255, 247, 230, 0.72) 74%, rgba(255, 247, 230, 0) 100%);
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #2f2316;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b7a64;
}

.filter-bar {
  display: flex;
  border-radius: 999rpx;
  padding: 10rpx;
  margin: 12rpx 0 20rpx;
  background: rgba(255, 251, 244, 0.94);
  border: 1rpx solid rgba(201, 153, 85, 0.2);
  box-shadow: 0 10rpx 20rpx rgba(190, 139, 49, 0.08);
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #7e6c55;
  border-radius: 999rpx;
  margin: 0 4rpx;
  font-weight: 700;
}

.filter-item.active {
  background: linear-gradient(135deg, #8ce3c8 0%, #86d9f5 52%, #ffd786 100%);
  color: #2f2316;
  box-shadow: 0 8rpx 16rpx rgba(98, 176, 157, 0.22);
}

.base-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.base-item {
  border-radius: 24rpx;
  border: 1rpx solid rgba(201, 153, 85, 0.2);
  background: rgba(255, 251, 244, 0.95);
  box-shadow: 0 12rpx 22rpx rgba(186, 134, 41, 0.1);
  padding: 24rpx;
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.base-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 800;
  color: #2f2316;
}

.audit-tag {
  font-size: 21rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 700;
  color: #498f74;
  background: rgba(130, 219, 189, 0.24);
}

.audit-tag.pending {
  color: #af7e26;
  background: rgba(255, 219, 130, 0.28);
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.category-tag {
  font-size: 21rpx;
  color: #3f9b7c;
  background: rgba(111, 223, 191, 0.2);
  border: 1rpx solid rgba(111, 223, 191, 0.38);
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
}

.base-address {
  font-size: 24rpx;
  color: #6f604d;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-foot {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(201, 153, 85, 0.16);
}

.foot-hint {
  font-size: 24rpx;
  color: #8c7961;
}

.state-card {
  margin-top: 24rpx;
  border-radius: 24rpx;
  text-align: center;
  padding: 52rpx 28rpx;
  border: 1rpx solid rgba(201, 153, 85, 0.2);
  background: rgba(255, 252, 246, 0.92);
  box-shadow: 0 12rpx 22rpx rgba(190, 139, 49, 0.08);
}

.state-title {
  display: block;
  font-size: 30rpx;
  color: #5d4a31;
  font-weight: 700;
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b7a64;
}

@media (prefers-color-scheme: dark) {
  .page {
    background:
      radial-gradient(circle at right top, rgba(74, 96, 109, 0.54) 0%, rgba(74, 96, 109, 0) 46%),
      linear-gradient(180deg, #1a2028 0%, #121820 100%);
  }

  .sticky-shell {
    background: linear-gradient(180deg, rgba(25, 31, 41, 0.98) 0%, rgba(25, 31, 41, 0.74) 74%, rgba(25, 31, 41, 0) 100%);
  }

  .title,
  .base-name,
  .state-title {
    color: #ecf3ff;
  }

  .subtitle,
  .base-address,
  .foot-hint,
  .state-desc {
    color: #a8bace;
  }

  .filter-bar,
  .base-item,
  .state-card {
    background: rgba(30, 39, 50, 0.94);
    border-color: rgba(129, 152, 176, 0.24);
    box-shadow: 0 14rpx 28rpx rgba(0, 0, 0, 0.28);
  }

  .filter-item {
    color: #adc1d8;
  }

  .filter-item.active {
    color: #eff8ff;
    background: linear-gradient(135deg, #3f8c72 0%, #3b6e88 52%, #a17f3e 100%);
  }

  .audit-tag {
    color: #8de0c5;
    background: rgba(61, 141, 114, 0.35);
  }

  .audit-tag.pending {
    color: #ebc377;
    background: rgba(154, 116, 46, 0.34);
  }

  .category-tag {
    color: #9ce9ce;
    background: rgba(61, 141, 114, 0.34);
    border-color: rgba(98, 188, 159, 0.36);
  }
}
