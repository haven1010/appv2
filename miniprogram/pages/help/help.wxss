.help-container {
  padding: 32rpx;
}

.service-card {
  background: linear-gradient(135deg, #ecfeff, #d1fae5);
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 30rpx;
}

.service-title {
  display: block;
  font-size: 34rpx;
  color: #065f46;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.service-desc {
  display: block;
  font-size: 26rpx;
  color: #0f766e;
  line-height: 1.6;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.faq-item {
  margin-bottom: 24rpx;
}

.q {
  display: block;
  color: #334155;
  font-weight: 600;
}

.a {
  display: block;
  color: #475569;
  margin-top: 8rpx;
}

.kefu-btn {
  margin-top: 36rpx;
  background: #059669;
  color: #fff;
}

.fallback {
  margin-top: 28rpx;
  padding: 18rpx 20rpx;
  background: #fff7ed;
  border-radius: 16rpx;
}

.fallback-tip {
  color: #9a3412;
  font-size: 24rpx;
}

.phone-btn {
  margin-top: 24rpx;
  background: #0f172a;
  color: #fff;
}
