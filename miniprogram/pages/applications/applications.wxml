<view class="page">

  <view class="page-body {{pageReady ? 'page-enter' : ''}}">
    <view class="welcome-card ds-card card-in">
      <text class="welcome-icon">🤖</text>
      <text class="welcome-title">智能助手</text>
      <text class="welcome-subtitle">可以帮你找工作、解答问题</text>
      <text class="welcome-status">功能开发中</text>

      <view class="learning-box">
        <text class="learning-title">AI助手正在学习中 🌱</text>
        <text class="learning-item">· 智能岗位推荐</text>
        <text class="learning-item">· 收入分析</text>
        <text class="learning-item">· 问题解答</text>
      </view>
    </view>

    <view class="section card-in delay-1">
      <text class="section-title">能力预览</text>
      <view class="feature-list">
        <view class="feature-card ds-card" wx:for="{{featureCards}}" wx:key="id">
          <text class="feature-icon">{{item.icon}}</text>
          <view class="feature-content">
            <text class="feature-title">{{item.title}}</text>
            <text class="feature-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section card-in delay-2">
      <text class="section-title">快捷入口</text>
      <view class="quick-row">
        <button
          class="quick-btn btn-primary"
          hover-class="quick-btn-press"
          hover-stay-time="100"
          bindtap="handleQuickAction"
          data-action="recommend"
        >推荐岗位</button>
        <button
          class="quick-btn btn-secondary"
          hover-class="quick-btn-press"
          hover-stay-time="100"
          bindtap="handleQuickAction"
          data-action="ask"
        >问一问</button>
      </view>
    </view>

    <view class="section card-in delay-3">
      <text class="section-title">对话区（预留）</text>
      <view class="chat-placeholder ds-card">
        <view class="chat-empty">
          <text class="chat-empty-icon">💬</text>
          <text class="chat-empty-text">未来将在这里进行对话</text>
        </view>

        <view class="chat-input-shell">
          <input
            class="chat-input"
            value="{{draftInput}}"
            placeholder="输入问题（即将开放）"
            disabled="{{true}}"
          />
          <button class="send-btn" disabled="{{true}}">发送</button>
        </view>
      </view>
    </view>

    <button class="back-btn btn-ghost card-in delay-3" bindtap="goToHome">返回广场</button>

    <view class="page-bottom-gap"></view>
  </view>
</view>
