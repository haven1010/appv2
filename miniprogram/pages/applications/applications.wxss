.page {
  background-color: #f5efe3;
}

.page-body {
  padding: 24rpx;
  padding-bottom: calc(186rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.welcome-card {
  text-align: center;
  background: linear-gradient(155deg, #fff8e8 0%, #eef8e6 54%, #fcefd9 100%);
}

.welcome-icon {
  display: block;
  font-size: 78rpx;
  line-height: 1;
}

.welcome-title {
  display: block;
  margin-top: 12rpx;
  font-size: 44rpx;
  line-height: 1.3;
  color: #333333;
  font-weight: 800;
}

.welcome-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #666666;
}

.welcome-status {
  margin: 14rpx auto 0;
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1.3;
  color: #f4a261;
  background: #fff2df;
  font-weight: 700;
}

.learning-box {
  margin-top: 18rpx;
  text-align: left;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.75);
  padding: 16rpx 18rpx;
}

.learning-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.4;
  color: #466e34;
  font-weight: 700;
}

.learning-item {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #666666;
}

.section {
  margin-top: 32rpx;
}

.section-title {
  display: block;
  margin: 0 4rpx 12rpx;
  font-size: 34rpx;
  line-height: 1.35;
  color: #333333;
  font-weight: 800;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.feature-card {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.feature-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e3f0d0;
  color: #466e34;
  font-size: 30rpx;
  line-height: 56rpx;
  text-align: center;
  flex-shrink: 0;
}

.feature-content {
  flex: 1;
  min-width: 0;
}

.feature-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.4;
  color: #333333;
  font-weight: 700;
}

.feature-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #999999;
}

.quick-row {
  display: flex;
  gap: 12rpx;
}

.quick-btn {
  flex: 1;
  min-width: 0;
}

.quick-btn-press {
  transform: scale(0.95);
}

.chat-placeholder {
  background: #fff8e8;
}

.chat-empty {
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.75);
  padding: 22rpx 18rpx;
  text-align: center;
}

.chat-empty-icon {
  display: block;
  font-size: 60rpx;
  line-height: 1;
}

.chat-empty-text {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #666666;
}

.chat-input-shell {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.chat-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #999999;
  font-size: 28rpx;
  padding: 0 24rpx;
}

.send-btn {
  width: 150rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  background: #c3ceb9;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.send-btn::after {
  border: none;
}

.back-btn {
  margin-top: 18rpx;
  background: #fff8e8;
  color: #6a994e;
}

.delay-1 {
  animation-delay: 80ms;
}

.delay-2 {
  animation-delay: 140ms;
}

.delay-3 {
  animation-delay: 200ms;
}

.page-bottom-gap {
  height: 24rpx;
}
