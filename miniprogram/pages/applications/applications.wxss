/* pages/applications/applications.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 156rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 84% -8%, rgba(46, 143, 77, 0.16) 0%, rgba(46, 143, 77, 0) 34%),
    radial-gradient(circle at 8% 8%, rgba(231, 168, 58, 0.14) 0%, rgba(231, 168, 58, 0) 30%),
    linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
}

.card {
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(45, 115, 199, 0.16);
  border-radius: 28rpx;
  box-shadow: 0 14rpx 32rpx rgba(45, 115, 199, 0.12);
}

.brand-head {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid rgba(45, 115, 199, 0.2);
}

.brand-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #153457;
}

.brand-sub {
  display: block;
  font-size: 22rpx;
  color: #62829d;
  margin-top: 4rpx;
}

.hero-line {
  height: 1rpx;
  margin: 20rpx 0 16rpx;
  background: linear-gradient(90deg, rgba(45, 115, 199, 0), rgba(45, 115, 199, 0.22), rgba(45, 115, 199, 0));
}

.hero-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1b3f62;
}

.hero-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #67869f;
  line-height: 1.6;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-gap {
  margin-top: 34rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #153457;
}

.section-note {
  font-size: 22rpx;
  color: #7b95ab;
}

.state-card {
  text-align: center;
  color: #70889d;
  font-size: 25rpx;
  padding: 52rpx 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.14);
  background: rgba(255, 255, 255, 0.9);
}

.app-list,
.pending-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.app-card,
.pending-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 22rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.16);
  box-shadow: 0 10rpx 24rpx rgba(45, 115, 199, 0.1);
}

.app-top,
.pending-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
}

.app-title,
.pending-title {
  font-size: 30rpx;
  color: #153457;
  font-weight: 800;
}

.app-base,
.pending-date,
.app-date {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7290a8;
}

.status-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  white-space: nowrap;
}

.status-chip.ok {
  color: #2e8f4d;
  background: rgba(46, 143, 77, 0.14);
}

.status-chip.fail {
  color: #c44b38;
  background: rgba(230, 90, 71, 0.14);
}

.status-chip.pending {
  color: #9a6414;
  background: rgba(231, 168, 58, 0.18);
}

.pending-amount {
  margin: 20rpx 0;
  font-size: 40rpx;
  color: #2e8f4d;
  font-weight: 800;
}

.btn-confirm {
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 62%, #1f5ca9 100%);
  color: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 27rpx;
  font-weight: 700;
  border: none;
}

.btn-confirm::after {
  border: none;
}

.status-done {
  font-size: 24rpx;
  color: #6f8aa2;
}
