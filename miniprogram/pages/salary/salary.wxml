<view class="page">

  <view class="page-body page-enter">
    <view class="summary-card ds-card card-in">
      <text class="summary-title">我的收入</text>
      <text class="summary-time">更新于 {{lastUpdated || '--:--'}}</text>
      <text class="summary-amount">¥{{stats ? stats.totalEarned : '0.00'}}</text>

      <view class="summary-row">
        <view class="summary-item">
          <text class="summary-icon">🧺</text>
          <text class="summary-text">{{stats ? stats.totalDays : 0}}天</text>
        </view>
        <view class="summary-item">
          <text class="summary-icon">💰</text>
          <text class="summary-text">¥{{stats ? stats.totalEarned : '0.00'}}</text>
        </view>
        <view class="summary-item">
          <text class="summary-icon">⏳</text>
          <text class="summary-text">¥{{stats ? stats.pendingAmount : '0.00'}}</text>
        </view>
      </view>

      <button class="refresh-btn" bindtap="refreshData">刷新数据</button>
    </view>

    <view class="section-head card-in delay-1">
      <text class="section-title">待确认工资</text>
      <text class="section-count">{{pendingList.length}}</text>
    </view>

    <view wx:if="{{loading}}" class="state-card ds-card card-in delay-1">
      <text class="state-title">正在加载薪资数据...</text>
      <text class="state-desc">请稍候</text>
    </view>

    <view wx:elif="{{pendingList.length === 0}}" class="empty-card ds-card card-in delay-1">
      <text class="empty-icon">💼</text>
      <text class="state-title">暂无待确认工资</text>
      <text class="state-desc">完成工作后自动记录</text>
      <button class="go-job-btn" bindtap="goFindJobs">去找工作</button>
    </view>

    <view wx:else class="pending-list">
      <view wx:for="{{pendingList}}" wx:key="id" class="pending-card ds-card card-in" style="animation-delay: {{index * 70}}ms;">
        <view class="pending-top">
          <view class="pending-main">
            <text class="pending-base">{{item.baseName || '基地'}}</text>
            <text class="pending-date">{{item.workDate || '-'}}</text>
          </view>
          <text class="pending-amount">¥{{item.amountText}}</text>
        </view>

        <view class="pending-meta">
          <text wx:if="{{item.jobTitle}}" class="meta-chip">岗位 {{item.jobTitle}}</text>
          <text wx:if="{{item.workHours}}" class="meta-chip">工时 {{item.workHours}}h</text>
          <text wx:if="{{item.pieceCount}}" class="meta-chip">计件 {{item.pieceCount}}</text>
        </view>

        <view class="pending-foot">
          <text class="status-chip {{item.statusClass}}">{{item.statusText}}</text>
          <button
            wx:if="{{item.canConfirm}}"
            class="confirm-btn"
            hover-class="confirm-btn-press"
            hover-stay-time="100"
            bindtap="confirmSalary"
            data-id="{{item.id}}"
          >确认工资</button>
        </view>
      </view>
    </view>

    <view class="page-bottom-gap"></view>
  </view>
</view>
