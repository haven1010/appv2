.page {
  background-color: #f5efe3;
}

.page-body {
  padding-bottom: calc(186rpx + env(safe-area-inset-bottom));
}

.summary-card {
  background: linear-gradient(160deg, #fff8e8 0%, #eef8e6 52%, #edf6ff 100%);
  text-align: center;
}

.summary-title {
  display: block;
  font-size: 36rpx;
  line-height: 1.35;
  color: #333333;
  font-weight: 800;
}

.summary-time {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: #999999;
}

.summary-amount {
  display: block;
  margin-top: 14rpx;
  font-size: 68rpx;
  line-height: 1.1;
  color: #6a994e;
  font-weight: 900;
}

.summary-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.summary-item {
  flex: 1;
  min-width: 0;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.75);
  padding: 14rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.summary-icon {
  font-size: 30rpx;
  line-height: 1;
}

.summary-text {
  font-size: 28rpx;
  line-height: 1.35;
  color: #333333;
  font-weight: 700;
}

.refresh-btn {
  margin-top: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 40rpx;
  background: linear-gradient(90deg, #6a994e 0%, #4f98d8 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
}

.refresh-btn::after {
  border: none;
}

.section-head {
  margin-top: 32rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 34rpx;
  line-height: 1.35;
  color: #333333;
  font-weight: 800;
}

.section-count {
  min-width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #f4a261;
  font-weight: 700;
}

.state-card,
.empty-card {
  text-align: center;
}

.empty-icon {
  display: block;
  font-size: 70rpx;
  line-height: 1;
}

.state-title {
  display: block;
  margin-top: 10rpx;
  font-size: 32rpx;
  line-height: 1.45;
  color: #333333;
  font-weight: 700;
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #999999;
}

.go-job-btn {
  margin-top: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 40rpx;
  background: linear-gradient(90deg, #e9c46a 0%, #f4d48f 100%);
  color: #333333;
  font-size: 30rpx;
  font-weight: 700;
}

.go-job-btn::after {
  border: none;
}

.pending-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.pending-card {
  border-radius: 28rpx;
}

.pending-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.pending-main {
  flex: 1;
  min-width: 0;
}

.pending-base {
  display: block;
  font-size: 32rpx;
  line-height: 1.35;
  color: #333333;
  font-weight: 800;
}

.pending-date {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: #999999;
}

.pending-amount {
  font-size: 42rpx;
  line-height: 1.2;
  color: #f4a261;
  font-weight: 900;
}

.pending-meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.meta-chip {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e3f0d0;
  color: #466e34;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
}

.pending-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-chip {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 700;
}

.status-chip.pending {
  color: #4f98d8;
  background: #deedf9;
}

.status-chip.confirmed {
  color: #8c6239;
  background: #f8e5c7;
}

.status-chip.paid {
  color: #466e34;
  background: #dcecc8;
}

.confirm-btn {
  min-width: 180rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(90deg, #6a994e 0%, #4f98d8 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  transform: scale(1);
  transition: transform 120ms ease;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn-press {
  transform: scale(0.95);
}

.page-bottom-gap {
  height: 24rpx;
}

.delay-1 {
  animation-delay: 90ms;
}
