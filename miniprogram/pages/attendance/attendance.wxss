.page {
  min-height: 100vh;
  padding: 0 24rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at right top, rgba(255, 226, 180, 0.9) 0%, rgba(255, 226, 180, 0) 46%),
    linear-gradient(180deg, #fffef8 0%, #fff2dc 100%);
}

.sticky-shell {
  position: sticky;
  top: 0;
  z-index: 8;
  padding: 24rpx 2rpx 16rpx;
  background: linear-gradient(180deg, rgba(255, 247, 230, 0.98) 0%, rgba(255, 247, 230, 0.72) 74%, rgba(255, 247, 230, 0) 100%);
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #2f2316;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b7a64;
}

.entry-card {
  margin-top: 16rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(201, 153, 85, 0.2);
  background: rgba(255, 251, 244, 0.95);
  box-shadow: 0 12rpx 22rpx rgba(186, 134, 41, 0.1);
  padding: 24rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #2f2316;
}

.card-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7f6f5a;
}

.entry-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.entry-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 18rpx;
  border: 1rpx solid rgba(201, 153, 85, 0.14);
  background: rgba(255, 255, 255, 0.78);
  padding: 18rpx;
}

.entry-title {
  display: block;
  font-size: 28rpx;
  color: #2f2316;
  font-weight: 700;
}

.entry-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7d6d58;
}

.entry-arrow {
  font-size: 24rpx;
  font-weight: 700;
  color: #4a9f83;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(111, 223, 191, 0.16);
}

@media (prefers-color-scheme: dark) {
  .page {
    background:
      radial-gradient(circle at right top, rgba(74, 96, 109, 0.54) 0%, rgba(74, 96, 109, 0) 46%),
      linear-gradient(180deg, #1a2028 0%, #121820 100%);
  }

  .sticky-shell {
    background: linear-gradient(180deg, rgba(25, 31, 41, 0.98) 0%, rgba(25, 31, 41, 0.74) 74%, rgba(25, 31, 41, 0) 100%);
  }

  .title,
  .card-title,
  .entry-title {
    color: #ecf3ff;
  }

  .subtitle,
  .card-desc,
  .entry-sub {
    color: #a8bace;
  }

  .entry-card,
  .entry-item {
    background: rgba(30, 39, 50, 0.94);
    border-color: rgba(129, 152, 176, 0.24);
    box-shadow: 0 14rpx 28rpx rgba(0, 0, 0, 0.28);
  }

  .entry-arrow {
    color: #8ee7cb;
    background: rgba(61, 141, 114, 0.34);
  }
}
