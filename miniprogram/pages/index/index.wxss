.page {
  background-color: #f5efe3;
}

.page-body {
  padding-bottom: calc(186rpx + env(safe-area-inset-bottom));
}

.user-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eadfc7;
  border: 4rpx solid #6a994e;
  flex-shrink: 0;
}

.user-meta {
  margin-left: 18rpx;
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.name {
  font-size: 38rpx;
  line-height: 1.3;
  color: #333333;
  font-weight: 800;
}

.verified {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #dcecc8;
  color: #466e34;
  font-size: 28rpx;
  font-weight: 700;
}

.uid {
  margin-top: 8rpx;
  display: block;
  font-size: 28rpx;
  color: #999999;
}

.qrcode-mini-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 132rpx;
  min-height: 96rpx;
  border-radius: 24rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f8e5b0 0%, #e9c46a 100%);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.qrcode-mini-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  color: #333333;
  font-size: 28rpx;
  line-height: 48rpx;
  font-weight: 800;
  text-align: center;
}

.qrcode-mini-text {
  font-size: 22rpx;
  line-height: 1.25;
  color: #3a3328;
  font-weight: 700;
}

.section-title {
  display: block;
  margin: 32rpx 4rpx 16rpx;
  font-size: 34rpx;
  line-height: 1.35;
  color: #333333;
  font-weight: 800;
}

.base-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.base-card {
  opacity: 0;
  transform: translate3d(0, 20rpx, 0);
  animation: card-enter 260ms ease-out forwards;
}

.base-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.base-name {
  flex: 1;
  font-size: 34rpx;
  line-height: 1.35;
  color: #333333;
  font-weight: 800;
}

.base-category {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #e7f1d6;
  color: #4d7338;
  font-size: 24rpx;
  font-weight: 700;
}

.base-row {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: #666666;
}

.base-footer {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.base-apply-btn {
  margin: 0;
  padding: 0 22rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  border: none;
  background: linear-gradient(90deg, #6a994e 0%, #4f98d8 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.base-apply-btn::after {
  border: none;
}

.base-apply-btn-disabled {
  opacity: 0.62;
}

.base-link {
  color: #4f98d8;
  font-size: 28rpx;
  font-weight: 700;
}

.state-card {
  text-align: center;
}

.state-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.5;
  color: #333333;
  font-weight: 700;
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #999999;
}

.retry-btn {
  margin-top: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 40rpx;
  background: linear-gradient(90deg, #e9c46a 0%, #f4d48f 100%);
  color: #333333;
  font-size: 30rpx;
  font-weight: 700;
}

.retry-btn::after {
  border: none;
}

.detail-card {
  margin-top: 4rpx;
}

.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.detail-title {
  flex: 1;
  font-size: 34rpx;
  line-height: 1.35;
  color: #333333;
  font-weight: 800;
}

.detail-audit {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #e7f1d6;
  color: #4d7338;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-row {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: #666666;
}

.detail-footer {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.detail-link {
  color: #4f98d8;
  font-size: 28rpx;
  font-weight: 700;
}

.page-bottom-gap {
  height: 24rpx;
}

.delay-1 {
  animation-delay: 80ms;
}

.delay-2 {
  animation-delay: 140ms;
}

@keyframes card-enter {
  from {
    opacity: 0;
    transform: translate3d(0, 20rpx, 0);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}
