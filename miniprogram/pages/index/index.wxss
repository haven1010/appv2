/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(46, 143, 77, 0.16) 0%, rgba(46, 143, 77, 0) 33%),
    radial-gradient(circle at 6% 14%, rgba(231, 168, 58, 0.18) 0%, rgba(231, 168, 58, 0) 36%),
    linear-gradient(180deg, #f8fcff 0%, #f1f8ff 100%);
  padding: 24rpx;
  padding-bottom: 156rpx;
  box-sizing: border-box;
}

.header {
  position: sticky;
  top: 0;
  z-index: 8;
  margin-bottom: 24rpx;
  padding: 10rpx 0 6rpx;
}

.header-glow {
  position: absolute;
  left: -24rpx;
  right: -24rpx;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(246, 251, 255, 0.98) 0%, rgba(246, 251, 255, 0.72) 74%, rgba(246, 251, 255, 0) 100%);
  pointer-events: none;
  transition: opacity 240ms ease;
}

.logo-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.logo-image {
  width: 62rpx;
  height: 62rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid rgba(45, 115, 199, 0.2);
  box-shadow: 0 8rpx 18rpx rgba(45, 115, 199, 0.18);
}

.brand-copy {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  color: #163456;
  line-height: 1.2;
}

.title-sub {
  font-size: 20rpx;
  color: #5f7c95;
  margin-top: 2rpx;
}

.welcome-card {
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 30rpx;
  padding: 56rpx 40rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.2);
  box-shadow: 0 16rpx 34rpx rgba(45, 115, 199, 0.12);
}

.welcome-watermark {
  position: absolute;
  right: -20rpx;
  top: -16rpx;
  width: 188rpx;
  height: 188rpx;
  opacity: 0.1;
}

.welcome-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #163456;
  text-align: center;
  margin-bottom: 16rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: #5f7c95;
  text-align: center;
  margin-bottom: 28rpx;
  line-height: 1.65;
}

.welcome-tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 26rpx;
}

.tag {
  font-size: 20rpx;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
}

.tag.green {
  color: #1f7e42;
  background: rgba(46, 143, 77, 0.12);
  border-color: rgba(46, 143, 77, 0.24);
}

.tag.blue {
  color: #1d5cae;
  background: rgba(45, 115, 199, 0.12);
  border-color: rgba(45, 115, 199, 0.22);
}

.tag.gold {
  color: #986316;
  background: rgba(231, 168, 58, 0.15);
  border-color: rgba(231, 168, 58, 0.24);
}

.btn-primary,
.btn-register,
.btn-view,
.btn-apply {
  border: none;
}

.btn-primary::after,
.btn-register::after,
.btn-view::after,
.btn-apply::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 62%, #1f5ca9 100%);
  color: #ffffff;
  border-radius: 16rpx;
  padding: 26rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 24rpx rgba(45, 115, 199, 0.24);
}

.btn-register {
  background: rgba(255, 246, 228, 0.96);
  color: #976515;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  margin-top: 18rpx;
  border: 1rpx solid rgba(231, 168, 58, 0.32);
}

.stats-card {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(237, 246, 255, 0.92));
  border-radius: 30rpx;
  padding: 34rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.2);
  margin-bottom: 30rpx;
  box-shadow: 0 14rpx 32rpx rgba(45, 115, 199, 0.12);
  transition: transform 260ms ease, box-shadow 260ms ease;
}

.stats-card.lifted {
  transform: translateY(-6rpx);
  box-shadow: 0 20rpx 36rpx rgba(45, 115, 199, 0.2);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 26rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(45, 115, 199, 0.16);
}

.user-block {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: #edf7f1;
  border: 4rpx solid rgba(46, 143, 77, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 800;
  color: #2e8f4d;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #17354f;
}

.user-uid {
  font-size: 23rpx;
  color: #67829a;
  margin-top: 6rpx;
}

.qr-btn {
  width: 76rpx;
  height: 76rpx;
  background: rgba(46, 143, 77, 0.1);
  border-radius: 20rpx;
  border: 1rpx solid rgba(46, 143, 77, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #206f3e;
  font-weight: 700;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.stat-item {
  flex: 1;
}

.stat-item.border-mid {
  border-left: 1rpx solid rgba(45, 115, 199, 0.18);
  border-right: 1rpx solid rgba(45, 115, 199, 0.18);
}

.stat-value {
  display: block;
  font-size: 35rpx;
  font-weight: 800;
  color: #17354f;
}

.stat-value.green {
  color: #2e8f4d;
}

.stat-label {
  font-size: 20rpx;
  color: #728aa1;
  margin-top: 8rpx;
}

.section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 35rpx;
  font-weight: 800;
  color: #17354f;
}

.section-sub {
  font-size: 22rpx;
  color: #6f879d;
}

.loading-box,
.empty-box {
  text-align: center;
  color: #68829a;
  padding: 58rpx 0;
  font-size: 26rpx;
}

.base-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.base-card {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.18);
  box-shadow: 0 10rpx 24rpx rgba(45, 115, 199, 0.1);
  opacity: 0;
  animation: cardRise 460ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
}

.base-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.base-name {
  font-size: 31rpx;
  font-weight: 800;
  color: #17354f;
}

.base-meta {
  display: flex;
  gap: 14rpx;
  margin-top: 10rpx;
}

.base-cat {
  font-size: 22rpx;
  color: #91600f;
  background: rgba(231, 168, 58, 0.2);
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.base-jobs {
  font-size: 20rpx;
  color: #70879e;
}

.base-score {
  font-size: 20rpx;
  color: #567a96;
  background: rgba(45, 115, 199, 0.1);
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.18);
}

.base-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(45, 115, 199, 0.16);
}

.base-name-small {
  font-size: 22rpx;
  color: #6f879d;
}

.btn-view {
  background: linear-gradient(135deg, #e7a83a 0%, #f0be64 60%, #d98d25 100%);
  color: #4f330a;
  padding: 14rpx 34rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(21, 59, 92, 0.34);
  z-index: 90;
  animation: fadeIn 220ms ease both;
}

.drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 82vh;
  background: #f8fcff;
  border-radius: 30rpx 30rpx 0 0;
  z-index: 100;
  border-top: 1rpx solid rgba(45, 115, 199, 0.2);
  box-shadow: 0 -12rpx 34rpx rgba(45, 115, 199, 0.16);
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  animation: drawerUp 300ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

.drawer.pulse {
  box-shadow: 0 -16rpx 40rpx rgba(46, 143, 77, 0.3);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid rgba(45, 115, 199, 0.18);
  flex-shrink: 0;
}

.drawer-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #17354f;
}

.drawer-close {
  font-size: 38rpx;
  color: #6e879d;
  padding: 8rpx;
}

.drawer-body {
  height: 60vh;
  padding: 20rpx;
  padding-bottom: 44rpx;
}

.job-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.job-card {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 18rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.18);
}

.job-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
  gap: 18rpx;
}

.job-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #17354f;
}

.job-salary {
  font-size: 24rpx;
  color: #2e8f4d;
  font-weight: 700;
}

.job-desc {
  font-size: 24rpx;
  color: #6b849b;
  margin-bottom: 18rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal;
  line-height: 1.55;
}

.job-tags {
  display: flex;
  gap: 10rpx;
  margin-bottom: 18rpx;
  flex-wrap: wrap;
}

.job-tag {
  font-size: 21rpx;
  color: #5f7d95;
  background: rgba(45, 115, 199, 0.1);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.btn-apply {
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 62%, #1f5ca9 100%);
  color: #ffffff;
  border-radius: 14rpx;
  padding: 22rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.btn-apply.btn-applied {
  background: #dce8f2;
  color: #6f869a;
}

@keyframes cardRise {
  from {
    opacity: 0;
    transform: translateY(14rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes drawerUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
