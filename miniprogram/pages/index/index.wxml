<view class="page">
  <view class="page-body page-enter">
    <view class="user-card ds-card card-in">
      <image class="avatar" src="{{user.avatar}}" mode="aspectFill" binderror="onAvatarError"></image>
      <view class="user-meta">
        <view class="name-row">
          <text class="name">{{user.name}}</text>
          <text class="verified" wx:if="{{user.verified}}">已认证</text>
        </view>
        <text class="uid">UID: {{user.uid}}</text>
      </view>
      <view
        class="qrcode-mini-btn pressable"
        hover-class="pressing"
        hover-stay-time="100"
        bindtap="goToQrcode"
      >
        <text class="qrcode-mini-icon">码</text>
        <text class="qrcode-mini-text">二维码</text>
      </view>
    </view>

    <text class="section-title card-in delay-2">最新入驻基地</text>

    <view wx:if="{{loadingBases}}" class="state-card ds-card card-in delay-2">
      <text class="state-title">基地信息加载中...</text>
      <text class="state-desc">请稍候</text>
    </view>

    <view wx:elif="{{bases.length}}" class="base-list">
      <view
        class="base-card ds-card card-in"
        wx:for="{{bases}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goToBaseDetail"
        style="animation-delay: {{item.animDelay}};"
      >
        <view class="base-head">
          <text class="base-name">{{item.name}}</text>
          <text class="base-category">{{item.categoryText}}</text>
        </view>
        <text class="base-row">地址：{{item.address}}</text>
        <text class="base-row">入驻时间：{{item.createdAtText}}</text>
        <view class="base-footer">
          <button
            class="base-apply-btn {{applyingBaseId === item.id ? 'base-apply-btn-disabled' : ''}}"
            data-id="{{item.id}}"
            catchtap="applyForBase"
            loading="{{applyingBaseId === item.id}}"
            disabled="{{applyingBaseId === item.id}}"
          >{{applyingBaseId === item.id ? '报名中...' : '我要报名'}}</button>
          <text class="base-link">查看基地详情</text>
        </view>
      </view>
    </view>

    <view wx:else class="state-card ds-card card-in delay-2">
      <text class="state-title">{{loadError || '暂无基地信息'}}</text>
      <button class="retry-btn" bindtap="retryLoadBases">重新加载</button>
    </view>

    <text class="section-title card-in delay-2">基地详细信息</text>

    <view
      wx:if="{{featuredBase}}"
      class="detail-card ds-card card-in delay-2 pressable"
      hover-class="pressing"
      hover-stay-time="100"
      bindtap="goToFeaturedBaseDetail"
    >
      <view class="detail-head">
        <text class="detail-title">{{featuredBase.name}}</text>
        <text class="detail-audit">{{featuredBase.auditText}}</text>
      </view>
      <text class="detail-row">基地类型：{{featuredBase.categoryText}}</text>
      <text class="detail-row">基地状态：{{featuredBase.statusText}}</text>
      <text class="detail-row">详细地址：{{featuredBase.address}}</text>
      <text class="detail-row">现场管理员联系方式：{{featuredBase.fieldManagerContact}}</text>
      <text class="detail-row">入驻时间：{{featuredBase.createdAtText}}</text>
      <view class="detail-footer">
        <text class="detail-link">进入详情页查看完整信息</text>
      </view>
    </view>

    <view wx:else class="state-card ds-card card-in delay-2">
      <text class="state-title">暂无可展示的基地详情</text>
      <text class="state-desc">入驻基地后将展示详细信息</text>
    </view>

    <view class="page-bottom-gap"></view>
  </view>
</view>
