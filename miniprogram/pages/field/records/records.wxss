/* pages/field/records/records.wxss */
.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 84% -8%, rgba(46, 143, 77, 0.14) 0%, rgba(46, 143, 77, 0) 34%),
    radial-gradient(circle at 8% 8%, rgba(45, 115, 199, 0.12) 0%, rgba(45, 115, 199, 0) 30%),
    linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.records-header {
  margin-bottom: 22rpx;
}

.records-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #17354f;
  display: block;
}

.records-base {
  font-size: 24rpx;
  color: #67859d;
  margin-top: 8rpx;
}

.date-switcher {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 20rpx 32rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.16);
  margin-bottom: 22rpx;
}

.date-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #1d5fae;
  background: rgba(45, 115, 199, 0.12);
  border-radius: 16rpx;
}

.date-display {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.date-label {
  font-size: 30rpx;
  font-weight: 800;
  color: #17354f;
}

.date-value {
  font-size: 22rpx;
  color: #67859d;
  margin-top: 4rpx;
}

.count-bar {
  margin-bottom: 18rpx;
}

.count-text {
  font-size: 24rpx;
  color: #67859d;
}

.count-num {
  color: #1d5fae;
  font-weight: 700;
}

.loading-box {
  text-align: center;
  color: #67859d;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.14);
  box-shadow: 0 10rpx 24rpx rgba(45, 115, 199, 0.08);
}

.record-left {
  position: relative;
  flex-shrink: 0;
}

.record-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(45, 115, 199, 0.12);
  border: 2rpx solid rgba(45, 115, 199, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1d5fae;
}

.record-idx {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  background: #2d73c7;
  color: #fff;
  border-radius: 50%;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.record-center {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #17354f;
}

.record-detail {
  font-size: 22rpx;
  color: #67859d;
  margin-top: 4rpx;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.record-time {
  font-size: 32rpx;
  font-weight: 700;
  color: #17354f;
  margin-bottom: 8rpx;
}

.record-status {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.record-status.checked {
  background: rgba(46, 143, 77, 0.16);
  color: #1f7e42;
}

.empty-box {
  text-align: center;
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #6a88a1;
}