/* pages/field/home/home.wxss */
.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 84% -8%, rgba(46, 143, 77, 0.14) 0%, rgba(46, 143, 77, 0) 34%),
    radial-gradient(circle at 8% 8%, rgba(45, 115, 199, 0.12) 0%, rgba(45, 115, 199, 0) 30%),
    linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
  padding: 24rpx;
  padding-bottom: 156rpx;
}

.header {
  margin-bottom: 26rpx;
}

.logo-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.logo {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 62%, #1f5ca9 100%);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  box-shadow: 0 10rpx 20rpx rgba(45, 115, 199, 0.24);
}

.title {
  font-size: 38rpx;
  font-weight: 800;
  color: #17354f;
}

.welcome {
  margin-top: 12rpx;
}

.welcome-text {
  font-size: 26rpx;
  color: #67859d;
}

.loading-box {
  text-align: center;
  color: #67859d;
  padding: 110rpx 0;
  font-size: 26rpx;
}

.error-card {
  background: rgba(255, 245, 243, 0.96);
  border: 1rpx solid rgba(217, 94, 73, 0.24);
  border-radius: 22rpx;
  padding: 42rpx 30rpx;
  text-align: center;
}

.error-icon {
  font-size: 54rpx;
  display: block;
  margin-bottom: 14rpx;
}

.error-msg {
  font-size: 26rpx;
  color: #d95e49;
  display: block;
  margin-bottom: 20rpx;
}

.btn-retry {
  display: inline-block;
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 70%, #1f5ca9 100%);
  color: #fff;
  padding: 14rpx 36rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.base-card,
.stats-card,
.record-item {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.16);
  box-shadow: 0 12rpx 30rpx rgba(45, 115, 199, 0.1);
}

.base-card {
  padding: 30rpx;
  margin-bottom: 22rpx;
}

.base-card-header {
  margin-bottom: 14rpx;
}

.base-switch {
  display: inline-block;
  background: rgba(46, 143, 77, 0.1);
  color: #1f7e42;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 14rpx;
}

.base-badge {
  display: inline-block;
  background: rgba(45, 115, 199, 0.12);
  color: #1d5fae;
  font-size: 21rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 700;
}

.base-name {
  font-size: 35rpx;
  font-weight: 800;
  color: #17354f;
  margin-bottom: 18rpx;
}

.base-detail-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.base-detail-label {
  font-size: 23rpx;
  color: #6a88a1;
  width: 88rpx;
  flex-shrink: 0;
}

.base-detail-val {
  font-size: 23rpx;
  color: #24435d;
  line-height: 1.5;
}

.stats-card {
  padding: 30rpx;
  margin-bottom: 22rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 31rpx;
  font-weight: 800;
  color: #17354f;
}

.section-link {
  font-size: 22rpx;
  color: #1d5fae;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.stat-item {
  flex: 1;
}

.stat-item.border-mid {
  border-left: 1rpx solid rgba(45, 115, 199, 0.14);
  border-right: 1rpx solid rgba(45, 115, 199, 0.14);
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #17354f;
}

.stat-value.green {
  color: #1f7e42;
}

.stat-value.orange {
  color: #8f5d11;
}

.stat-value.red {
  color: #b33f2a;
}

.stat-label {
  font-size: 20rpx;
  color: #6a88a1;
  margin-top: 6rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.action-btn {
  flex: 1;
  border-radius: 22rpx;
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border: 1rpx solid rgba(45, 115, 199, 0.16);
}

.scan-btn {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(225, 244, 255, 0.92));
}

.records-btn {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(232, 248, 239, 0.9));
}

.action-icon {
  font-size: 42rpx;
  margin-bottom: 10rpx;
}

.action-text {
  font-size: 29rpx;
  font-weight: 700;
  color: #17354f;
  margin-bottom: 8rpx;
}

.action-desc {
  font-size: 21rpx;
  color: #67859d;
  line-height: 1.5;
}

.recent-section {
  margin-bottom: 30rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
}

.record-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(45, 115, 199, 0.1);
  border: 2rpx solid rgba(45, 115, 199, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #1d5fae;
  flex-shrink: 0;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #17354f;
}

.record-time {
  font-size: 21rpx;
  color: #67859d;
  margin-top: 4rpx;
}

.record-status {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.record-status.success {
  background: rgba(46, 143, 77, 0.16);
  color: #1f7e42;
}

.empty-box {
  text-align: center;
  color: #6d89a2;
  padding: 70rpx 0;
  font-size: 26rpx;
}
