/* pages/field/scan/scan.wxss */
.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 84% -8%, rgba(46, 143, 77, 0.14) 0%, rgba(46, 143, 77, 0) 34%),
    radial-gradient(circle at 8% 8%, rgba(45, 115, 199, 0.12) 0%, rgba(45, 115, 199, 0) 30%),
    linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.scan-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.scan-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #17354f;
  display: block;
  margin-bottom: 10rpx;
}

.scan-base {
  font-size: 26rpx;
  color: #66859d;
}

.scan-base.warn {
  color: #b33f2a;
}

.scan-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.scan-visual {
  width: 480rpx;
  height: 480rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.scan-frame {
  width: 400rpx;
  height: 400rpx;
  position: relative;
  margin-bottom: 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(45, 115, 199, 0.18);
  box-shadow: 0 12rpx 30rpx rgba(45, 115, 199, 0.1);
}

.corner {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-color: #2d73c7;
  border-style: solid;
  border-width: 0;
}

.corner.tl {
  top: 0;
  left: 0;
  border-top-width: 6rpx;
  border-left-width: 6rpx;
  border-radius: 10rpx 0 0 0;
}

.corner.tr {
  top: 0;
  right: 0;
  border-top-width: 6rpx;
  border-right-width: 6rpx;
  border-radius: 0 10rpx 0 0;
}

.corner.bl {
  bottom: 0;
  left: 0;
  border-bottom-width: 6rpx;
  border-left-width: 6rpx;
  border-radius: 0 0 0 10rpx;
}

.corner.br {
  bottom: 0;
  right: 0;
  border-bottom-width: 6rpx;
  border-right-width: 6rpx;
  border-radius: 0 0 10rpx 0;
}

.scan-line {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #2d73c7, transparent);
  animation: scanAnim 2s ease-in-out infinite;
}

@keyframes scanAnim {
  0% {
    top: 24rpx;
  }
  50% {
    top: 376rpx;
  }
  100% {
    top: 24rpx;
  }
}

.scan-hint {
  font-size: 24rpx;
  color: #67859d;
}

.btn-scan {
  width: 80%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 62%, #1f5ca9 100%);
  color: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 34rpx;
  border: none;
}

.btn-scan[disabled] {
  opacity: 0.62;
}

.btn-scan-icon {
  font-size: 36rpx;
}

.btn-scan-text {
  font-size: 32rpx;
  color: #fff;
}

.manual-section {
  width: 100%;
  margin-top: 10rpx;
}

.manual-title {
  font-size: 24rpx;
  color: #67859d;
  text-align: center;
  margin-bottom: 14rpx;
}

.manual-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.manual-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(45, 115, 199, 0.16);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #17354f;
}

.btn-manual {
  background: rgba(45, 115, 199, 0.12);
  color: #1d5fae;
  border: 1rpx solid rgba(45, 115, 199, 0.24);
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.result-card {
  border-radius: 28rpx;
  padding: 52rpx 34rpx;
  text-align: center;
  margin-bottom: 34rpx;
}

.result-card.success {
  background: rgba(46, 143, 77, 0.12);
  border: 2rpx solid rgba(46, 143, 77, 0.28);
}

.result-card.fail {
  background: rgba(217, 94, 73, 0.12);
  border: 2rpx solid rgba(217, 94, 73, 0.24);
}

.result-icon {
  font-size: 88rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.result-card.success .result-icon {
  color: #1f7e42;
}

.result-card.fail .result-icon {
  color: #b33f2a;
}

.result-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #17354f;
  margin-bottom: 12rpx;
}

.result-msg {
  font-size: 28rpx;
  color: #66859d;
  margin-bottom: 16rpx;
}

.result-time {
  font-size: 24rpx;
  color: #6d89a2;
  margin-bottom: 30rpx;
}

.btn-clear {
  display: inline-block;
  background: rgba(45, 115, 199, 0.12);
  color: #1d5fae;
  border: 1rpx solid rgba(45, 115, 199, 0.24);
  padding: 16rpx 64rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.history-section {
  margin-top: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #17354f;
  margin-bottom: 16rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.14);
}

.history-status {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.history-item.success .history-status {
  background: rgba(46, 143, 77, 0.16);
  color: #1f7e42;
}

.history-item.fail .history-status {
  background: rgba(217, 94, 73, 0.16);
  color: #b33f2a;
}

.history-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.history-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #17354f;
}

.history-msg {
  font-size: 22rpx;
  color: #67859d;
}

.history-time {
  font-size: 22rpx;
  color: #6a88a1;
  flex-shrink: 0;
}