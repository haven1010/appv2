/* pages/profile/userInfo/userInfo.wxss */
.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 84% -8%, rgba(46, 143, 77, 0.16) 0%, rgba(46, 143, 77, 0) 34%),
    radial-gradient(circle at 8% 8%, rgba(231, 168, 58, 0.14) 0%, rgba(231, 168, 58, 0) 30%),
    linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
}

.scroll-wrap {
  height: 100vh;
  padding: 0 24rpx 48rpx;
  box-sizing: border-box;
}

.sticky-shell {
  position: sticky;
  top: 0;
  z-index: 8;
  padding: 22rpx 0 18rpx;
}

.sticky-glow {
  position: absolute;
  left: -24rpx;
  right: -24rpx;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(246, 251, 255, 0.98) 0%, rgba(246, 251, 255, 0.72) 74%, rgba(246, 251, 255, 0) 100%);
  pointer-events: none;
}

.brand-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-logo {
  width: 58rpx;
  height: 58rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.22);
  background: #fff;
}

.sticky-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #153457;
}

.sticky-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #6d89a1;
}

.module-card {
  margin-top: 10rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.18);
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 32rpx rgba(45, 115, 199, 0.12);
  overflow: hidden;
}

.module-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
}

.avatar-wrap {
  width: 98rpx;
  height: 98rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(46, 143, 77, 0.32);
  background: linear-gradient(145deg, #eef8f2 0%, #e5f4ec 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-text {
  font-size: 40rpx;
  font-weight: 800;
  color: #2e8f4d;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.head-name {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #153457;
}

.head-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #6d89a1;
}

.head-toggle {
  font-size: 22rpx;
  color: #2d73c7;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(45, 115, 199, 0.1);
  font-weight: 700;
}

.module-body {
  border-top: 1rpx solid rgba(45, 115, 199, 0.14);
  padding: 0 24rpx 24rpx;
  max-height: 1900rpx;
  overflow: hidden;
  opacity: 1;
  transition: max-height 360ms ease, opacity 300ms ease, transform 300ms ease;
}

.module-card.closed .module-body {
  max-height: 0;
  opacity: 0;
  padding-bottom: 0;
  transform: translateY(-10rpx);
}

.info-grid {
  padding-top: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.info-label {
  font-size: 24rpx;
  color: #7893aa;
}

.info-value {
  max-width: 62%;
  text-align: right;
  font-size: 27rpx;
  font-weight: 700;
  color: #2e8f4d;
}

.divider {
  height: 1rpx;
  margin: 8rpx 0 12rpx;
  background: linear-gradient(90deg, rgba(45, 115, 199, 0), rgba(45, 115, 199, 0.24), rgba(45, 115, 199, 0));
}

.field-group {
  padding: 12rpx 0;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #6f8aa2;
  margin-bottom: 8rpx;
}

.field-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2d73c7;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(45, 115, 199, 0.08);
  border: 1rpx solid rgba(45, 115, 199, 0.2);
}

.field-input {
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #153457;
  font-weight: 700;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(45, 115, 199, 0.22);
}

.save-btn {
  margin-top: 24rpx;
  border-radius: 999rpx;
  border: none;
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 62%, #1f5ca9 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 28rpx rgba(45, 115, 199, 0.24);
}

.save-btn::after {
  border: none;
}

.empty-card {
  margin-top: 24rpx;
  border-radius: 24rpx;
  padding: 40rpx 28rpx;
  text-align: center;
  border: 1rpx solid rgba(45, 115, 199, 0.18);
  background: rgba(255, 255, 255, 0.92);
}

.empty-title {
  display: block;
  color: #355775;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  color: #6f8aa2;
  font-size: 24rpx;
}
