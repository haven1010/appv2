/* pages/profile/userInfo/userInfo.wxss */
.page {
  min-height: 100vh;
  background-color: #f5efe3;
}

.scroll-wrap {
  height: 100vh;
  padding: 24rpx 24rpx calc(42rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.module-card {
  margin-top: 0;
  border-radius: 28rpx;
  background: #fff8e8;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.module-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
}

.avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(106, 153, 78, 0.35);
  background: linear-gradient(145deg, #eef8f2 0%, #e5f4ec 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-text {
  font-size: 40rpx;
  font-weight: 800;
  color: #2e8f4d;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.head-name {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #333333;
}

.head-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #999999;
}

.head-toggle {
  font-size: 24rpx;
  color: #6a994e;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(106, 153, 78, 0.12);
  font-weight: 700;
}

.module-body {
  padding: 0 24rpx 24rpx;
  max-height: 1900rpx;
  overflow: hidden;
  opacity: 1;
  transition: max-height 300ms ease, opacity 240ms ease, transform 240ms ease;
}

.module-card.closed .module-body {
  max-height: 0;
  opacity: 0;
  padding-bottom: 0;
  transform: translateY(-10rpx);
}

.info-grid {
  padding-top: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.info-label {
  font-size: 24rpx;
  color: #999999;
}

.info-value {
  max-width: 62%;
  text-align: right;
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
}

.divider {
  height: 1rpx;
  margin: 10rpx 0 14rpx;
  background: rgba(106, 153, 78, 0.2);
}

.field-group {
  padding: 4rpx 0;
}

.field-group + .field-group {
  margin-top: 30rpx;
}

.field-label {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.field-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.field-input {
  width: 100%;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #333333;
  font-weight: 700;
  padding: 20rpx;
  min-height: 84rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 2rpx solid rgba(106, 153, 78, 0.14);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.field-input.focus {
  border-color: #6a994e;
  box-shadow: 0 0 10rpx rgba(106, 153, 78, 0.3);
}

.field-input.invalid {
  border-color: #e63946;
  box-shadow: 0 0 8rpx rgba(230, 57, 70, 0.16);
}

.field-textarea {
  min-height: 96rpx;
  height: auto;
  line-height: 1.5;
  padding-top: 16rpx;
}

.error {
  display: block;
  margin-top: 10rpx;
  color: #e63946;
  font-size: 24rpx;
  line-height: 1.4;
  text-align: left;
}

.save-btn {
  margin-top: 24rpx;
  border-radius: 40rpx;
  border: none;
  background: linear-gradient(90deg, #6a994e 0%, #4f98d8 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
  height: 88rpx;
  line-height: 88rpx;
  box-shadow: 0 8rpx 20rpx rgba(79, 139, 95, 0.2);
}

.save-btn::after {
  border: none;
}

.empty-card {
  margin-top: 12rpx;
  border-radius: 28rpx;
  padding: 40rpx 28rpx;
  text-align: center;
  background: #fff8e8;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.empty-title {
  display: block;
  color: #333333;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  color: #999999;
  font-size: 28rpx;
  line-height: 1.5;
}
