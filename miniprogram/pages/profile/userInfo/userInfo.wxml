<view class="page {{pageReady ? 'page-enter' : ''}}" bindtap="handleBlankTap">
  <scroll-view class="scroll-wrap" scroll-y enhanced bounces>
    <view class="module-card {{infoExpanded ? 'open' : 'closed'}}" wx:if="{{profile}}" catchtap="noop">
      <view class="module-head pressable" hover-class="pressing" hover-stay-time="110" bindtap="toggleInfoCard">
        <view class="avatar-wrap pressable" hover-class="pressing" hover-stay-time="90" catchtap="previewAvatar">
          <image class="avatar-image" wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
          <text class="avatar-text" wx:else>{{profile.name ? profile.name[0] : '工'}}</text>
        </view>

        <view class="head-main">
          <text class="head-name" bindlongpress="copyByLongPress" data-copy="{{profile.name}}" data-label="姓名">{{profile.name || '未填写姓名'}}</text>
          <text class="head-sub">{{profile.roleText || '务工人员'}} · {{auditStatusText}}</text>
        </view>

        <text class="head-toggle">{{infoExpanded ? '收起' : '展开'}}</text>
      </view>

      <view class="module-body">
        <view class="info-grid">
          <view class="info-row">
            <text class="info-label">岗位</text>
            <text class="info-value" bindlongpress="copyByLongPress" data-copy="{{profile.roleText}}" data-label="岗位">{{profile.roleText || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">部门</text>
            <text class="info-value" bindlongpress="copyByLongPress" data-copy="{{profile.departmentText}}" data-label="部门">{{profile.departmentText || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">入职时间</text>
            <text class="info-value">{{profile.joinDateText || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">工号</text>
            <text class="info-value" bindlongpress="copyByLongPress" data-copy="{{profile.uid}}" data-label="工号">{{profile.uid || '-'}}</text>
          </view>
        </view>

        <view class="divider"></view>

        <view class="proxy-takeover-card" wx:if="{{profile.needProxyTakeover}}">
          <view class="proxy-takeover-title">代注册账号接管</view>
          <view class="proxy-takeover-sub">请本人完成接管，后续将使用新手机号登录。</view>
          <view class="proxy-takeover-status">当前状态：{{profile.loginLockReason || '待本人接管'}}</view>

          <view class="field-group">
            <text class="field-label">审核单ID</text>
            <input
              class="field-input {{proxyTakeoverErrors.caseId ? 'invalid' : ''}}"
              type="number"
              value="{{proxyTakeoverForm.caseId}}"
              placeholder="请输入代注册审核单ID"
              data-field="caseId"
              bindinput="onProxyTakeoverInput"
            />
            <text wx:if="{{proxyTakeoverErrors.caseId}}" class="error">{{proxyTakeoverErrors.caseId}}</text>
          </view>

          <view class="field-group">
            <text class="field-label">接管后手机号</text>
            <input
              class="field-input {{proxyTakeoverErrors.phone ? 'invalid' : ''}}"
              type="text"
              maxlength="13"
              value="{{proxyTakeoverForm.phone}}"
              placeholder="请输入11位手机号"
              data-field="phone"
              bindinput="onProxyTakeoverInput"
            />
            <text wx:if="{{proxyTakeoverErrors.phone}}" class="error">{{proxyTakeoverErrors.phone}}</text>
          </view>

          <view class="field-group">
            <text class="field-label">身份证后6位</text>
            <input
              class="field-input {{proxyTakeoverErrors.idCardLast6 ? 'invalid' : ''}}"
              type="text"
              maxlength="6"
              value="{{proxyTakeoverForm.idCardLast6}}"
              placeholder="请输入身份证后6位"
              data-field="idCardLast6"
              bindinput="onProxyTakeoverInput"
            />
            <text wx:if="{{proxyTakeoverErrors.idCardLast6}}" class="error">{{proxyTakeoverErrors.idCardLast6}}</text>
          </view>

          <button
            class="takeover-btn"
            loading="{{proxyTakeoverSubmitting}}"
            disabled="{{proxyTakeoverSubmitting}}"
            bindtap="handleProxyTakeover"
          >{{proxyTakeoverSubmitting ? '接管中...' : '立即接管账号'}}</button>
        </view>

        <view class="field-group">
          <text class="field-label">姓名</text>
          <input
            class="field-input {{focusField === 'name' ? 'focus' : ''}} {{errors.name ? 'invalid' : ''}}"
            value="{{form.name}}"
            placeholder="请输入真实姓名（2-20个字）"
            data-field="name"
            bindfocus="handleFocus"
            bindblur="handleBlur"
            bindinput="onInput"
          />
          <text wx:if="{{errors.name}}" class="error">{{errors.name}}</text>
        </view>

        <view class="field-group">
          <text class="field-label">手机号</text>
          <input
            class="field-input {{focusField === 'phone' ? 'focus' : ''}} {{errors.phone ? 'invalid' : ''}}"
            type="text"
            maxlength="13"
            value="{{form.phone}}"
            placeholder="请输入手机号"
            data-field="phone"
            bindfocus="handleFocus"
            bindblur="handleBlur"
            bindinput="onInput"
          />
          <text wx:if="{{errors.phone}}" class="error">{{errors.phone}}</text>
        </view>

        <view class="field-group">
          <text class="field-label">家庭地址</text>
          <textarea
            class="field-input field-textarea {{focusField === 'homeAddress' ? 'focus' : ''}} {{errors.homeAddress ? 'invalid' : ''}}"
            value="{{form.homeAddress}}"
            placeholder="请填写家庭详细地址"
            data-field="homeAddress"
            bindfocus="handleFocus"
            bindblur="handleBlur"
            bindinput="onInput"
            maxlength="120"
            auto-height
          />
          <text wx:if="{{errors.homeAddress}}" class="error">{{errors.homeAddress}}</text>
        </view>

        <view class="field-group">
          <text class="field-label">身份证号</text>
          <text class="field-value">{{profile.idCardMasked || '-'}}</text>
        </view>

        <view class="field-group">
          <text class="field-label">紧急联系人</text>
          <input
            class="field-input {{focusField === 'emergencyContact' ? 'focus' : ''}} {{errors.emergencyContact ? 'invalid' : ''}}"
            value="{{form.emergencyContact}}"
            placeholder="请输入联系人姓名及关系"
            data-field="emergencyContact"
            bindfocus="handleFocus"
            bindblur="handleBlur"
            bindinput="onInput"
          />
          <text wx:if="{{errors.emergencyContact}}" class="error">{{errors.emergencyContact}}</text>
        </view>

        <view class="field-group">
          <text class="field-label">联系人电话</text>
          <input
            class="field-input {{focusField === 'emergencyPhone' ? 'focus' : ''}} {{errors.emergencyPhone ? 'invalid' : ''}}"
            type="text"
            maxlength="13"
            value="{{form.emergencyPhone}}"
            placeholder="请输入紧急联系人电话"
            data-field="emergencyPhone"
            bindfocus="handleFocus"
            bindblur="handleBlur"
            bindinput="onInput"
          />
          <text wx:if="{{errors.emergencyPhone}}" class="error">{{errors.emergencyPhone}}</text>
        </view>
      </view>
    </view>

    <view class="empty-card" wx:if="{{!profile}}">
      <text class="empty-title">暂无基本信息</text>
      <text class="empty-desc">请稍后刷新或重新登录后再试</text>
    </view>

    <button
      class="save-btn pressable"
      hover-class="pressing"
      hover-stay-time="110"
      wx:if="{{profile}}"
      loading="{{saving}}"
      bindtap="handleSave"
    >保存修改</button>
  </scroll-view>
</view>
