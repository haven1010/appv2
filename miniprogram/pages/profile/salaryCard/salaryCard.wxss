/* pages/profile/salaryCard/salaryCard.wxss */
.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 84% -8%, rgba(46, 143, 77, 0.16) 0%, rgba(46, 143, 77, 0) 34%),
    radial-gradient(circle at 8% 8%, rgba(231, 168, 58, 0.14) 0%, rgba(231, 168, 58, 0) 30%),
    linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
}

.scroll-wrap {
  height: 100vh;
  padding: 0 24rpx 48rpx;
  box-sizing: border-box;
}

.sticky-shell {
  position: sticky;
  top: 0;
  z-index: 8;
  padding: 22rpx 0 18rpx;
}

.sticky-glow {
  position: absolute;
  left: -24rpx;
  right: -24rpx;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(246, 251, 255, 0.98) 0%, rgba(246, 251, 255, 0.72) 74%, rgba(246, 251, 255, 0) 100%);
  pointer-events: none;
}

.brand-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-logo {
  width: 58rpx;
  height: 58rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.22);
  background: #fff;
}

.sticky-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #153457;
}

.sticky-sub {
  display: block;
  margin-top: 6rpx;
  color: #6d89a1;
  font-size: 23rpx;
}

.state-card {
  margin-top: 20rpx;
  border-radius: 24rpx;
  text-align: center;
  padding: 52rpx 26rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.18);
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 22rpx rgba(45, 115, 199, 0.1);
}

.state-title {
  display: block;
  font-size: 30rpx;
  color: #335674;
  font-weight: 700;
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6f8aa2;
}

.bank-card {
  margin-top: 10rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.24);
  background: linear-gradient(138deg, rgba(242, 249, 255, 0.96) 0%, rgba(232, 244, 255, 0.95) 56%, rgba(250, 253, 255, 0.98) 100%);
  box-shadow: 0 18rpx 32rpx rgba(45, 115, 199, 0.16);
  padding: 26rpx;
  transition: transform 280ms ease, box-shadow 280ms ease;
}

.bank-card.lifted {
  transform: translateY(-6rpx);
  box-shadow: 0 22rpx 38rpx rgba(45, 115, 199, 0.2);
}

.bank-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.bank-meta {
  flex: 1;
  min-width: 0;
}

.meta-label {
  display: block;
  font-size: 22rpx;
  color: #6f8ba3;
}

.meta-value {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #153457;
}

.privacy-tag {
  margin-left: 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #2d73c7;
  background: rgba(45, 115, 199, 0.12);
  border: 1rpx solid rgba(45, 115, 199, 0.24);
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
}

.number-panel {
  margin-top: 22rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.22);
  background: rgba(255, 255, 255, 0.86);
  padding: 16rpx 18rpx;
  transition: opacity 260ms ease, transform 260ms ease;
}

.number-panel.showing {
  opacity: 1;
  transform: translateY(-2rpx);
}

.number-panel.hiding {
  opacity: 0.86;
  transform: translateY(0);
}

.number-label {
  display: block;
  font-size: 22rpx;
  color: #6f8ba3;
}

.number-value {
  display: block;
  margin-top: 10rpx;
  font-size: 36rpx;
  letter-spacing: 3rpx;
  font-weight: 800;
  color: #153457;
}

.number-panel.hiding .number-value {
  color: #5f7a93;
}

.bank-bottom {
  display: flex;
  gap: 20rpx;
  margin-top: 22rpx;
}

.bottom-col {
  flex: 1;
}

.bottom-label {
  display: block;
  font-size: 22rpx;
  color: #6f8ba3;
}

.bottom-value {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #244a6c;
  font-weight: 700;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.action-btn {
  flex: 1;
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  padding: 20rpx 10rpx;
}

.view-btn {
  color: #2d73c7;
  background: rgba(45, 115, 199, 0.12);
  border: 1rpx solid rgba(45, 115, 199, 0.22);
}

.copy-btn {
  color: #fff;
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 62%, #1f5ca9 100%);
  border: 1rpx solid rgba(45, 115, 199, 0.24);
}

.copy-btn.copy-success {
  animation: copyShake 900ms ease;
}

.action-btn.disabled {
  opacity: 0.48;
}

.empty-card {
  margin-top: 22rpx;
}

@keyframes copyShake {
  0%,
  100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-5rpx);
  }
  50% {
    transform: translateX(5rpx);
  }
  75% {
    transform: translateX(-3rpx);
  }
}
