/* pages/profile/profile.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 156rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 84% -8%, rgba(46, 143, 77, 0.16) 0%, rgba(46, 143, 77, 0) 34%),
    radial-gradient(circle at 8% 8%, rgba(231, 168, 58, 0.14) 0%, rgba(231, 168, 58, 0) 30%),
    linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
}

.card {
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(45, 115, 199, 0.16);
  border-radius: 28rpx;
  box-shadow: 0 14rpx 30rpx rgba(45, 115, 199, 0.12);
}

.header-card {
  padding: 26rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.2);
}

.brand-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #153457;
}

.brand-sub {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #6a87a0;
}

.profile-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #eef8f2;
  border: 4rpx solid rgba(46, 143, 77, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 800;
  color: #2e8f4d;
}

.user-name {
  font-size: 38rpx;
  color: #153457;
  font-weight: 800;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6d89a1;
}

.user-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
}

.tag {
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #1f7e42;
  background: rgba(46, 143, 77, 0.12);
  border: 1rpx solid rgba(46, 143, 77, 0.24);
}

.tag.uid {
  color: #1d5fae;
  background: rgba(45, 115, 199, 0.12);
  border-color: rgba(45, 115, 199, 0.2);
}

.menu-list {
  margin-top: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 26rpx;
  border-bottom: 1rpx solid rgba(45, 115, 199, 0.14);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}

.menu-icon {
  min-width: 72rpx;
  height: 40rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #2e8f4d, #2d73c7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.menu-label {
  font-size: 30rpx;
  color: #153457;
  font-weight: 700;
}

.menu-value {
  font-size: 22rpx;
  color: #6f8aa2;
  margin-right: 10rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: #8da5ba;
}

.btn-logout {
  margin-top: 34rpx;
  background: rgba(231, 168, 58, 0.16);
  color: #9a6212;
  border: 1rpx solid rgba(231, 168, 58, 0.3);
  border-radius: 18rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-logout::after {
  border: none;
}
