<view class="page">
  <view class="page-body {{pageReady ? 'page-enter' : ''}}">
    <view class="hero-card ds-card card-in">
      <text class="hero-title">我的报名</text>
      <text class="hero-subtitle">查看你已报名的基地与岗位状态</text>

      <view class="hero-stats">
        <view class="hero-stat">
          <text class="hero-value">{{stats.total}}</text>
          <text class="hero-label">总报名</text>
        </view>
        <view class="hero-stat">
          <text class="hero-value">{{stats.signedUp}}</text>
          <text class="hero-label">待签到</text>
        </view>
        <view class="hero-stat">
          <text class="hero-value">{{stats.checkedIn}}</text>
          <text class="hero-label">已签到</text>
        </view>
      </view>
    </view>

    <view class="filter-card ds-card card-in delay-1">
      <input
        class="search-input"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        placeholder="搜索基地名或岗位名"
        confirm-type="search"
      />

      <view class="filter-row">
        <view
          wx:for="{{filters}}"
          wx:key="key"
          class="filter-chip {{activeFilter === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onFilterTap"
        >{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="state-card ds-card">
      <text class="state-title">正在加载报名记录...</text>
      <text class="state-desc">请稍候</text>
    </view>

    <view wx:elif="{{viewRecords.length === 0}}" class="ds-empty card-in delay-2">
      <text class="ds-empty-icon">🧺</text>
      <text class="ds-empty-title">暂无匹配的报名记录</text>
      <text class="ds-empty-desc">你可以在广场先报名岗位，再回来查看进度</text>
    </view>

    <view wx:else class="record-list">
      <view wx:for="{{viewRecords}}" wx:key="id" class="record-card ds-card card-in delay-2">
        <view class="record-head">
          <text class="record-base">{{item.baseName}}</text>
          <text class="status-badge {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <text class="record-job">{{item.jobTitle}}</text>

        <view class="record-meta">
          <text>工作日期：{{item.workDateText}}</text>
        </view>
        <view class="record-meta">
          <text>报名时间：{{item.createdTimeText}}</text>
        </view>
        <view class="record-meta" wx:if="{{item.checkinTimeText !== '-'}}">
          <text>签到时间：{{item.checkinTimeText}}</text>
        </view>
      </view>
    </view>

    <view class="action-row">
      <button class="btn-ghost mini-btn" bindtap="backToSquare">去广场报名</button>
      <button class="btn-primary mini-btn" bindtap="goWorkHistory">看工作历程</button>
    </view>

    <view class="safe-bottom-space"></view>
  </view>
</view>