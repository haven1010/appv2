<view class="page">
  <view class="page-body {{pageReady ? 'page-enter' : ''}}">
    <view class="profile-card ds-card card-in">
      <view class="profile-top">
        <view class="profile-left">
          <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
          <view wx:else class="avatar avatar-fallback">{{displayInitial}}</view>

          <view class="identity">
            <text class="name">{{displayName}}</text>
            <text class="uid">UID：{{displayUid}}</text>
            <text class="role">{{roleText}}</text>
          </view>
        </view>

        <text class="verify-badge">已实名认证</text>
      </view>
      <text class="profile-tip">今日进度已同步，继续保持好状态</text>
    </view>

    <view class="stats-card ds-card card-in delay-1">
      <view class="stat-item">
        <text class="stat-icon">🧑‍🌾</text>
        <text class="stat-label">工作天数</text>
        <text class="stat-value">{{workDaysText}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-icon">💵</text>
        <text class="stat-label">累计收入</text>
        <text class="stat-value income">¥{{totalIncomeText}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-icon">📝</text>
        <text class="stat-label">我的报名</text>
        <text class="stat-value">{{signupCountText}}</text>
      </view>
    </view>

    <view class="growth-card ds-card card-in delay-2">
      <view class="growth-head">
        <text class="growth-title">成长体系</text>
        <text class="growth-hint">{{growthHint}}</text>
      </view>

      <view class="badge-list">
        <view class="badge-item {{badgeNewbieActive ? 'active' : ''}}">
          <text class="badge-icon">🌱</text>
          <text class="badge-name">新手上岗</text>
        </view>
        <view class="badge-item {{badgeAttendanceActive ? 'active' : ''}}">
          <text class="badge-icon">🎯</text>
          <text class="badge-name">出勤达人</text>
        </view>
        <view class="badge-item {{badgeSalaryActive ? 'active' : ''}}">
          <text class="badge-icon">⭐</text>
          <text class="badge-name">结算先锋</text>
        </view>
      </view>
    </view>

    <view class="menu-card ds-card card-in delay-3">
      <view class="menu-item" hover-class="menu-item-press" hover-stay-time="100" bindtap="goBasicInfo">
        <view class="menu-left">
          <text class="menu-icon">👤</text>
          <view class="menu-content">
            <text class="menu-title">基本信息</text>
            <text class="menu-sub">个人资料与审核状态</text>
          </view>
        </view>
        <text class="menu-arrow">></text>
      </view>

      <view class="menu-item" hover-class="menu-item-press" hover-stay-time="100" bindtap="goMySignups">
        <view class="menu-left">
          <text class="menu-icon">📋</text>
          <view class="menu-content">
            <text class="menu-title">我的报名</text>
            <text class="menu-sub">查看报名基地、岗位和状态</text>
          </view>
        </view>
        <text class="menu-arrow">></text>
      </view>

      <view class="menu-item" hover-class="menu-item-press" hover-stay-time="100" bindtap="goSalaryCard">
        <view class="menu-left">
          <text class="menu-icon">💳</text>
          <view class="menu-content">
            <text class="menu-title">银行卡</text>
            <text class="menu-sub">工资收款账户</text>
          </view>
        </view>
        <text class="menu-arrow">></text>
      </view>

      <view class="menu-item" hover-class="menu-item-press" hover-stay-time="100" bindtap="showWorkHistory">
        <view class="menu-left">
          <text class="menu-icon">🕰️</text>
          <view class="menu-content">
            <text class="menu-title">工作历程</text>
            <text class="menu-sub">签到记录与时间线</text>
          </view>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <button class="logout-btn" hover-class="logout-btn-press" hover-stay-time="100" bindtap="logout">退出登录</button>

    <view class="page-bottom-gap"></view>
  </view>
</view>
