<!--pages/profile/profile.wxml-->
<view class="page">
  <view class="profile-header">
    <view class="avatar">{{userInfo.name ? userInfo.name[0] : '?'}}</view>
    <view class="user-name">{{userInfo.name}}</view>
    <view class="user-tags">
      <text class="tag">实名采摘工</text>
      <text class="tag uid">{{userInfo.uid}}</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goBasicInfo">
      <view class="menu-left">
        <text class="menu-icon">👤</text>
        <text class="menu-label">基本信息</text>
      </view>
      <text class="menu-value">{{profileData ? (profileData.infoAuditStatus === 1 ? '已认证' : profileData.infoAuditStatus === 0 ? '待审核' : '未认证') : '-'}}</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goSalaryCard">
      <view class="menu-left">
        <text class="menu-icon">💳</text>
        <text class="menu-label">薪资卡号</text>
      </view>
      <text class="menu-value">未绑定</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="showWorkHistory">
      <view class="menu-left">
        <text class="menu-icon">📋</text>
        <text class="menu-label">工作历程</text>
      </view>
      <text class="menu-value">{{workerStats ? workerStats.workDays + ' 天签到' : '0 天签到'}}</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goHelp">
      <view class="menu-left">
        <text class="menu-icon">🤖</text>
        <text class="menu-label">帮助与AI客服</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <view class="menu-left">
        <text class="menu-icon">⚙</text>
        <text class="menu-label">设置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <button class="btn-logout" bindtap="logout">退出当前账号</button>
</view>
