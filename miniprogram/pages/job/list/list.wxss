.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: transparent;
}

.hero-card {
  border-radius: 30rpx;
  background: var(--warm-card);
  border: 3rpx solid rgba(140, 112, 72, 0.22);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
}

.hero-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: #473421;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #4a6b34;
  background: rgba(240, 246, 226, 0.9);
  border: 2rpx solid rgba(78, 115, 58, 0.25);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.hero-subtitle {
  margin-top: 10rpx;
  display: block;
  font-size: 24rpx;
  color: var(--ink-sub);
}

.hero-actions {
  margin-top: 10rpx;
}

.hero-back {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #4a6b34;
  background: rgba(240, 246, 226, 0.9);
  border: 2rpx solid rgba(78, 115, 58, 0.25);
}

.hero-stats {
  margin-top: 16rpx;
  display: flex;
  gap: 10rpx;
}

.hero-stat {
  flex: 1;
  background: rgba(255, 255, 255, 0.66);
  border: 2rpx solid rgba(140, 112, 72, 0.2);
  border-radius: 18rpx;
  padding: 14rpx 10rpx;
  text-align: center;
}

.hero-stat-value {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #3f3222;
}

.hero-stat-label {
  margin-top: 6rpx;
  display: block;
  font-size: 21rpx;
  color: #7a664e;
}

.filter-card {
  margin-top: 14rpx;
  border-radius: 26rpx;
  background: var(--warm-card);
  border: 3rpx solid rgba(140, 112, 72, 0.2);
  box-shadow: var(--shadow-card);
  padding: 16rpx;
}

.search-input {
  width: 100%;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 2rpx solid rgba(140, 112, 72, 0.2);
  background: rgba(255, 255, 255, 0.7);
  padding: 16rpx 18rpx;
  font-size: 24rpx;
  color: #3f3222;
}

.segment-row {
  margin-top: 12rpx;
  display: flex;
  gap: 8rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #7a664e;
  background: rgba(255, 255, 255, 0.66);
  border: 2rpx solid rgba(140, 112, 72, 0.18);
}

.segment-item.active {
  color: #ffffff;
  background: linear-gradient(90deg, var(--warm-green) 0%, var(--warm-blue) 100%);
  box-shadow: 0 8rpx 16rpx rgba(86, 126, 67, 0.24);
}

.state-panel {
  margin-top: 16rpx;
  border-radius: 30rpx;
  text-align: center;
  padding: 52rpx 28rpx;
  border: 3rpx solid rgba(140, 112, 72, 0.2);
  background: var(--warm-card);
  box-shadow: var(--shadow-card);
}

.state-title {
  display: block;
  font-size: 30rpx;
  color: #4a3823;
  font-weight: 700;
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a664e;
}

.base-progress-list,
.job-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.base-progress-card,
.job-card {
  border-radius: 26rpx;
  border: 3rpx solid rgba(140, 112, 72, 0.2);
  background: var(--warm-card);
  box-shadow: var(--shadow-card);
  padding: 18rpx;
}

.base-progress-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.base-progress-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 800;
  color: #473421;
}

.base-progress-audit {
  font-size: 20rpx;
  color: #4a6b34;
  background: rgba(240, 246, 226, 0.9);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  font-weight: 700;
}

.base-progress-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.base-progress-stats {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
}

.base-progress-stat {
  flex: 1;
  border-radius: 16rpx;
  border: 2rpx solid rgba(140, 112, 72, 0.2);
  background: rgba(255, 255, 255, 0.66);
  text-align: center;
  padding: 10rpx 8rpx;
}

.base-progress-stat-value {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: #3f3222;
}

.base-progress-stat-label {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #7a664e;
}

.base-progress-foot {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed rgba(140, 112, 72, 0.24);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.base-progress-hint {
  font-size: 22rpx;
  color: #7a664e;
}

.cell-arrow {
  font-size: 30rpx;
  line-height: 1;
  color: #9a876e;
}

.job-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.job-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 800;
  color: #473421;
}

.job-salary {
  font-size: 24rpx;
  font-weight: 800;
  color: #4a6b34;
  text-align: right;
}

.job-progress {
  font-size: 24rpx;
  font-weight: 800;
  color: #4a6b34;
  text-align: right;
}

.job-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.meta-tag {
  font-size: 20rpx;
  color: #4a6b34;
  background: rgba(240, 246, 226, 0.9);
  border: 2rpx solid rgba(78, 115, 58, 0.25);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.meta-item {
  font-size: 21rpx;
  color: #6f5e49;
}

.signup-progress {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.signup-progress-track {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(122, 102, 78, 0.14);
  overflow: hidden;
}

.signup-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--warm-green) 0%, var(--warm-blue) 100%);
}

.signup-progress-text {
  min-width: 72rpx;
  text-align: right;
  font-size: 20rpx;
  font-weight: 700;
  color: #4a6b34;
}

.applicant-section {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  border: 2rpx solid rgba(140, 112, 72, 0.18);
  background: rgba(255, 255, 255, 0.6);
}

.applicant-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #4a3823;
}

.applicant-list {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.applicant-name {
  max-width: 100%;
  font-size: 21rpx;
  color: #5e4b36;
  background: rgba(238, 226, 204, 0.86);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.applicant-empty {
  margin-top: 8rpx;
  display: block;
  font-size: 21rpx;
  color: #7a664e;
}

.job-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6f5e49;
  line-height: 1.6;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  border: 2rpx solid rgba(140, 112, 72, 0.18);
  background: rgba(255, 255, 255, 0.6);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.job-bottom {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(140, 112, 72, 0.24);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status {
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.status-open {
  color: #4a6b34;
  background: rgba(240, 246, 226, 0.9);
}

.status-closed {
  color: #8e4a2e;
  background: rgba(248, 225, 214, 0.88);
}

.apply-btn {
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(90deg, var(--warm-green) 0%, var(--warm-blue) 100%);
}
