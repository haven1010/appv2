.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at right top, rgba(143, 219, 190, 0.28) 0%, rgba(143, 219, 190, 0) 46%),
    radial-gradient(circle at left top, rgba(145, 196, 235, 0.24) 0%, rgba(145, 196, 235, 0) 42%),
    linear-gradient(180deg, #f9fefe 0%, #f2fbf8 100%);
}

.hero-card {
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(95, 170, 193, 0.2);
  box-shadow: 0 12rpx 24rpx rgba(83, 157, 186, 0.12);
  padding: 24rpx;
}

.hero-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: #143a50;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #2f8f78;
  background: rgba(130, 219, 189, 0.2);
  border: 1rpx solid rgba(130, 219, 189, 0.34);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.hero-subtitle {
  margin-top: 10rpx;
  display: block;
  font-size: 24rpx;
  color: #6b8ea5;
}

.hero-stats {
  margin-top: 16rpx;
  display: flex;
  gap: 10rpx;
}

.hero-stat {
  flex: 1;
  background: rgba(246, 252, 252, 0.9);
  border: 1rpx solid rgba(95, 170, 193, 0.16);
  border-radius: 16rpx;
  padding: 14rpx 10rpx;
  text-align: center;
}

.hero-stat-value {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #143a50;
}

.hero-stat-label {
  margin-top: 6rpx;
  display: block;
  font-size: 21rpx;
  color: #6b8ea5;
}

.filter-card {
  margin-top: 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(95, 170, 193, 0.2);
  box-shadow: 0 8rpx 16rpx rgba(83, 157, 186, 0.1);
  padding: 16rpx;
}

.search-input {
  width: 100%;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(95, 170, 193, 0.24);
  background: rgba(246, 252, 252, 0.9);
  padding: 16rpx 18rpx;
  font-size: 24rpx;
  color: #143a50;
}

.segment-row {
  margin-top: 12rpx;
  display: flex;
  gap: 8rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #6a8ea4;
  background: rgba(246, 252, 252, 0.9);
  border: 1rpx solid rgba(95, 170, 193, 0.14);
}

.segment-item.active {
  color: #ffffff;
  background: linear-gradient(135deg, #58c2a6 0%, #4f98d8 100%);
  box-shadow: 0 8rpx 16rpx rgba(83, 157, 186, 0.22);
}

.state-panel {
  margin-top: 16rpx;
  border-radius: 24rpx;
  text-align: center;
  padding: 52rpx 28rpx;
  border: 1rpx solid rgba(95, 170, 193, 0.2);
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 12rpx 22rpx rgba(83, 157, 186, 0.1);
}

.state-title {
  display: block;
  font-size: 30rpx;
  color: #30526a;
  font-weight: 700;
}

.state-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b8ea5;
}

.job-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.job-card {
  border-radius: 20rpx;
  border: 1rpx solid rgba(95, 170, 193, 0.2);
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 10rpx 20rpx rgba(83, 157, 186, 0.1);
  padding: 18rpx;
}

.job-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.job-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 800;
  color: #143a50;
}

.job-salary {
  font-size: 24rpx;
  font-weight: 800;
  color: #2f8f78;
  text-align: right;
}

.job-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.meta-tag {
  font-size: 20rpx;
  color: #2f8f78;
  background: rgba(130, 219, 189, 0.2);
  border: 1rpx solid rgba(130, 219, 189, 0.34);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.meta-item {
  font-size: 21rpx;
  color: #5f8298;
}

.signup-progress {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.signup-progress-track {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(95, 170, 193, 0.14);
  overflow: hidden;
}

.signup-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #58c2a6 0%, #4f98d8 100%);
}

.signup-progress-text {
  min-width: 72rpx;
  text-align: right;
  font-size: 20rpx;
  font-weight: 700;
  color: #2f8f78;
}

.job-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #5f8298;
  line-height: 1.6;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(95, 170, 193, 0.14);
  background: rgba(246, 252, 252, 0.9);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.job-bottom {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(95, 170, 193, 0.14);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status {
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.status-open {
  color: #2f8f78;
  background: rgba(130, 219, 189, 0.22);
}

.status-closed {
  color: #5f88a2;
  background: rgba(145, 196, 235, 0.2);
}

.apply-btn {
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #58c2a6 0%, #4f98d8 100%);
}
