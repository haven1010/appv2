<view class="page page-enter">
  <view class="hero-card">
    <view class="hero-head">
      <text class="hero-title">
        {{isBossView ? (baseId ? (baseName ? (baseName + '报名进度') : '报名进度详情') : '报名进度') : (baseName ? (baseName + '招聘情况') : '招聘管理')}}
      </text>
      <text class="hero-badge">{{isBossView ? 'Boss View' : 'TDesign Layout'}}</text>
    </view>

    <text class="hero-subtitle">
      {{isBossView
        ? (baseId
          ? '仅展示该基地报名人员姓名与岗位进度'
          : (canViewSignupProgress
            ? ('按基地查看报名进度，已入驻基地 ' + approvedBaseCount + ' 个')
            : '管理员审核通过入驻成功后可查看报名进度'))
        : ('共 ' + jobs.length + ' 个岗位，支持筛选与快速报名')}}
    </text>

    <view wx:if="{{isBossView && baseId}}" class="hero-actions">
      <view
        class="hero-back pressable"
        hover-class="pressing"
        hover-stay-time="80"
        bindtap="backToBossBaseCards"
      >返回基地列表</view>
    </view>

    <view class="hero-stats">
      <block wx:if="{{isBossView && !baseId}}">
        <view class="hero-stat">
          <text class="hero-stat-value">{{approvedBaseCount}}</text>
          <text class="hero-stat-label">已入驻基地</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-value">{{totalBaseJobCount}}</text>
          <text class="hero-stat-label">岗位总数</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-value">{{totalBaseSignupCount}}</text>
          <text class="hero-stat-label">总报名人数</text>
        </view>
      </block>

      <block wx:elif="{{isBossView}}">
        <view class="hero-stat">
          <text class="hero-stat-value">{{jobs.length}}</text>
          <text class="hero-stat-label">岗位总数</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-value">{{totalSignupCount}}</text>
          <text class="hero-stat-label">总报名人数</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-value">{{openCount}}</text>
          <text class="hero-stat-label">招聘中</text>
        </view>
      </block>

      <block wx:else>
        <view class="hero-stat">
          <text class="hero-stat-value">{{jobs.length}}</text>
          <text class="hero-stat-label">岗位总数</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-value">{{openCount}}</text>
          <text class="hero-stat-label">招聘中</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-value">{{closedCount}}</text>
          <text class="hero-stat-label">已关闭</text>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{!isBossView || canViewSignupProgress}}" class="filter-card">
    <input
      class="search-input"
      placeholder="{{isBossView ? (baseId ? '搜索岗位名或报名人姓名' : '搜索基地名、地址或报名人姓名') : '搜索岗位名或基地名'}}"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      confirm-type="search"
    />

    <view wx:if="{{!(isBossView && !baseId)}}" class="segment-row">
      <view
        class="segment-item pressable {{statusFilter === 'all' ? 'active' : ''}}"
        hover-class="pressing"
        hover-stay-time="90"
        data-status="all"
        bindtap="onStatusChange"
      >全部</view>
      <view
        class="segment-item pressable {{statusFilter === 'open' ? 'active' : ''}}"
        hover-class="pressing"
        hover-stay-time="90"
        data-status="open"
        bindtap="onStatusChange"
      >招聘中</view>
      <view
        class="segment-item pressable {{statusFilter === 'closed' ? 'active' : ''}}"
        hover-class="pressing"
        hover-stay-time="90"
        data-status="closed"
        bindtap="onStatusChange"
      >已关闭</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-panel">
    <text class="state-title">{{isBossView ? '正在加载报名进度...' : '正在加载招聘岗位...'}}</text>
    <text class="state-desc">请稍候</text>
  </view>

  <view wx:elif="{{isBossView && !baseId && !canViewSignupProgress}}" class="state-panel">
    <text class="state-title">管理员审核通过入驻成功后可查看报名进度</text>
    <text class="state-desc">审核通过后，将以基地卡片展示报名情况</text>
  </view>

  <view wx:elif="{{isBossView && baseId && !canViewSignupProgress}}" class="state-panel">
    <text class="state-title">该基地暂未通过审核，暂不可查看报名进度</text>
    <text class="state-desc">管理员审核通过后可查看报名人员姓名与岗位进度</text>
  </view>

  <view wx:elif="{{isBossView && !baseId && viewBossBaseCards.length === 0}}" class="state-panel">
    <text class="state-title">暂无基地报名记录</text>
    <text class="state-desc">当前基地还没有报名人员</text>
  </view>

  <view wx:elif="{{(!isBossView || baseId) && viewJobs.length === 0}}" class="state-panel">
    <text class="state-title">{{isBossView ? '暂无报名记录' : '暂无符合条件的岗位'}}</text>
    <text class="state-desc">{{isBossView ? '当前岗位还没有报名人员' : '尝试清空筛选条件后重试'}}</text>
  </view>

  <view wx:else>
    <view wx:if="{{isBossView && !baseId}}" class="base-progress-list">
      <view
        wx:for="{{viewBossBaseCards}}"
        wx:key="baseId"
        class="base-progress-card pressable"
        hover-class="pressing"
        hover-stay-time="100"
        bindtap="goToBaseProgress"
        data-id="{{item.baseId}}"
        data-name="{{item.baseName}}"
      >
        <view class="base-progress-head">
          <text class="base-progress-title">{{item.baseName}}</text>
          <text class="base-progress-audit">{{item.auditText}}</text>
        </view>

        <view class="base-progress-meta">
          <text class="meta-tag">{{item.address}}</text>
          <text class="meta-item">报名 {{item.totalSignupCount}} 人</text>
        </view>

        <view class="base-progress-stats">
          <view class="base-progress-stat">
            <text class="base-progress-stat-value">{{item.totalJobs}}</text>
            <text class="base-progress-stat-label">岗位</text>
          </view>
          <view class="base-progress-stat">
            <text class="base-progress-stat-value">{{item.openJobs}}</text>
            <text class="base-progress-stat-label">招聘中</text>
          </view>
          <view class="base-progress-stat">
            <text class="base-progress-stat-value">{{item.closedJobs}}</text>
            <text class="base-progress-stat-label">已关闭</text>
          </view>
        </view>

        <view class="applicant-section">
          <text class="applicant-title">报名人员（仅姓名）</text>
          <view wx:if="{{item.applicantNamesPreview && item.applicantNamesPreview.length}}" class="applicant-list">
            <text
              wx:for="{{item.applicantNamesPreview}}"
              wx:key="index"
              wx:for-item="applicantName"
              class="applicant-name"
            >{{applicantName}}</text>
          </view>
          <text wx:else class="applicant-empty">暂无报名人员</text>
        </view>

        <view class="base-progress-foot">
          <text class="base-progress-hint">点击查看该基地报名详情</text>
          <text class="cell-arrow">></text>
        </view>
      </view>
    </view>

    <view wx:else class="job-list">
      <view
        wx:for="{{viewJobs}}"
        wx:key="id"
        class="job-card pressable"
        bindtap="goToDetail"
        hover-class="pressing"
        hover-stay-time="100"
        data-id="{{item.id}}"
      >
        <block wx:if="{{isBossView}}">
          <view class="job-top">
            <text class="job-title">{{item.jobTitle || item.title || '未命名岗位'}}</text>
            <text class="job-progress">报名 {{item.signupProgressText || '0/-'}}</text>
          </view>

          <view class="job-meta">
            <text class="meta-tag" wx:if="{{item.baseName}}">{{item.baseName}}</text>
            <text class="meta-item">招聘 {{item.recruitCount || item.headcount || item.count || '-'}} 人</text>
            <text class="meta-item">进度 {{item.signupProgressPercent || 0}}%</text>
          </view>

          <view class="signup-progress">
            <view class="signup-progress-track">
              <view class="signup-progress-fill" style="width: {{item.signupProgressPercent || 0}}%;"></view>
            </view>
            <text class="signup-progress-text">{{item.signupProgressPercent || 0}}%</text>
          </view>

          <view class="applicant-section">
            <text class="applicant-title">报名人员（仅姓名）</text>
            <view wx:if="{{item.applicantNames && item.applicantNames.length}}" class="applicant-list">
              <text
                wx:for="{{item.applicantNames}}"
                wx:key="index"
                wx:for-item="applicantName"
                class="applicant-name"
              >{{applicantName}}</text>
            </view>
            <text wx:else class="applicant-empty">暂无报名人员</text>
          </view>

          <view class="job-bottom">
            <text class="status {{item.status === 'recruiting' || item.status === 'open' || item.status === 1 ? 'status-open' : 'status-closed'}}">
              {{item.status === 'recruiting' || item.status === 'open' || item.status === 1 ? '招聘中' : '已关闭'}}
            </text>
          </view>
        </block>

        <block wx:else>
          <view class="job-top">
            <text class="job-title">{{item.jobTitle || item.title || '未命名岗位'}}</text>
            <text class="job-salary">
              {{item.salaryAmount || item.hourlyRate || item.unitPrice || '-'}} 元/{{item.payType == 1 ? '天' : item.payType == 2 ? '小时' : '件'}}
            </text>
          </view>

          <view class="job-meta">
            <text class="meta-tag" wx:if="{{item.baseName}}">{{item.baseName}}</text>
            <text class="meta-item">招聘 {{item.recruitCount || item.headcount || item.count || '-'}} 人</text>
            <text class="meta-item">{{item.workDateRange || '时间待定'}}</text>
          </view>

          <view wx:if="{{item.requirements || item.description}}" class="job-desc">
            <text>{{item.requirements || item.description}}</text>
          </view>

          <view class="job-bottom">
            <text class="status {{item.status === 'recruiting' || item.status === 'open' || item.status === 1 ? 'status-open' : 'status-closed'}}">
              {{item.status === 'recruiting' || item.status === 'open' || item.status === 1 ? '招聘中' : '已关闭'}}
            </text>
            <view
              class="apply-btn pressable"
              catchtap="applyJob"
              hover-class="pressing"
              hover-stay-time="100"
              data-id="{{item.id}}"
              data-baseid="{{item.baseId}}"
            >立即报名</view>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
