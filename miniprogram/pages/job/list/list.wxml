<view class="page page-enter">
  <view class="sticky-shell">
    <text class="title">{{baseName ? baseName + ' · 招聘岗位' : '招聘管理'}}</text>
    <text class="subtitle">共 {{jobs.length}} 个岗位，支持快速报名</text>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <text class="state-title">正在加载招聘岗位...</text>
    <text class="state-desc">请稍候</text>
  </view>

  <view wx:elif="{{jobs.length === 0}}" class="state-card">
    <text class="state-title">暂无招聘岗位</text>
    <text class="state-desc">稍后刷新或更换基地后再试</text>
  </view>

  <view wx:else class="job-list">
    <view
      wx:for="{{jobs}}"
      wx:key="id"
      class="job-card pressable"
      bindtap="goToDetail"
      hover-class="pressing"
      hover-stay-time="100"
      data-id="{{item.id}}"
    >
      <view class="job-top">
        <text class="job-title">{{item.jobTitle || item.title || '未命名岗位'}}</text>
        <text class="job-salary">{{item.salaryAmount || '-'}} 元/{{item.payType == 1 ? '天' : item.payType == 2 ? '小时' : '件'}}</text>
      </view>

      <view class="job-meta">
        <text class="meta-tag" wx:if="{{item.baseName}}">{{item.baseName}}</text>
        <text class="meta-item">招聘 {{item.headcount || item.count || '-'}} 人</text>
        <text class="meta-item">{{item.workDateRange || '时间待定'}}</text>
      </view>

      <view wx:if="{{item.requirements || item.description}}" class="job-desc">
        <text>{{item.requirements || item.description}}</text>
      </view>

      <view class="job-bottom">
        <text class="status {{item.status === 'recruiting' || item.status === 1 ? 'status-open' : 'status-closed'}}">
          {{item.status === 'recruiting' || item.status === 1 ? '招聘中' : '已关闭'}}
        </text>
        <view
          class="apply-btn pressable"
          catchtap="applyJob"
          hover-class="pressing"
          hover-stay-time="100"
          data-id="{{item.id}}"
          data-baseid="{{item.baseId}}"
        >立即报名</view>
      </view>
    </view>
  </view>
</view>
