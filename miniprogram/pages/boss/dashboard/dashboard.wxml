<view class="page page-enter">
  <view class="paper-bg"></view>

  <view class="container">
    <view class="hero-card">
      <view class="hero-head">
        <text class="hero-title">🏢 企业入驻审核</text>
        <button class="hero-logout-btn" bindtap="logout">退出登录</button>
      </view>
      <text class="hero-subtitle">老板账号可提交企业资料，并查看、结算名下基地的已确认工资；工资结算完成后，系统会自动生成工资表同步给超级管理员。</text>
    </view>

    <view class="form-card">
      <view class="section-title">老板个人信息</view>

      <view class="field">
        <text class="label">老板姓名</text>
        <input class="input" placeholder="请输入老板姓名" value="{{ownerName}}" data-field="ownerName" bindinput="onFieldInput" />
      </view>

      <view class="field">
        <text class="label">老板手机号</text>
        <input class="input" type="number" maxlength="11" placeholder="用于身份核验" value="{{ownerPhone}}" data-field="ownerPhone" bindinput="onFieldInput" />
      </view>

      <view class="field">
        <text class="label">身份证（脱敏）</text>
        <view class="readonly-box">{{ownerIdCardMasked || '登录后自动拉取'}}</view>
      </view>

      <view class="section-title">公司管理员联系方式</view>

      <view class="field">
        <text class="label">公司管理员姓名</text>
        <input class="input" placeholder="请填写公司管理员姓名" value="{{companyAdminName}}" data-field="companyAdminName" bindinput="onFieldInput" />
      </view>

      <view class="field">
        <text class="label">公司管理员手机号</text>
        <input class="input" type="number" maxlength="11" placeholder="用于审核沟通" value="{{companyAdminPhone}}" data-field="companyAdminPhone" bindinput="onFieldInput" />
      </view>

      <view class="section-title">企业信息</view>

      <view class="field">
        <text class="label">企业名称</text>
        <input class="input" placeholder="请输入企业名称" value="{{companyName}}" data-field="companyName" bindinput="onFieldInput" />
      </view>

      <view class="field">
        <text class="label">企业类别</text>
        <picker mode="selector" range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="picker-box">{{categoryOptions[categoryIndex].label}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="label">区域编码</text>
        <input class="input" type="number" placeholder="如 610100" value="{{regionCode}}" data-field="regionCode" bindinput="onFieldInput" />
      </view>

      <view class="field">
        <text class="label">营业执照</text>
        <view class="upload-box" bindtap="chooseLicenseImage">
          <text wx:if="{{uploadingLicense}}" class="upload-text">上传中...</text>
          <image wx:elif="{{licenseImage}}" class="upload-preview" src="{{licenseImage}}" mode="aspectFill" binderror="onLicensePreviewError"></image>
          <text wx:else class="upload-text">📷 点击上传营业执照</text>
        </view>
      </view>

      <view class="field">
        <text class="label">工作环境图片（最多 3 张）</text>
        <view wx:if="{{!envImages.length}}" class="upload-box {{uploadingEnv ? 'upload-box-disabled' : ''}}" bindtap="chooseEnvImages">
          <text class="upload-text">{{uploadingEnv ? '上传中...' : '📷 点击上传工作环境照片'}}</text>
        </view>
        <view wx:else class="env-list">
          <block wx:for="{{envImages}}" wx:key="*this" wx:for-item="img" wx:for-index="idx">
            <view class="env-item">
              <image class="env-preview" src="{{img}}" mode="aspectFill" binderror="onEnvPreviewError" data-index="{{idx}}"></image>
              <text class="remove-env" data-index="{{idx}}" bindtap="removeEnvImage">✕</text>
            </view>
          </block>
          <view
            wx:if="{{envImages.length < 3}}"
            class="env-add-mini {{uploadingEnv ? 'env-add-disabled' : ''}}"
            bindtap="chooseEnvImages"
          >
            <text class="env-add-mini-text">{{uploadingEnv ? '上传中' : '+ 添加'}}</text>
          </view>
        </view>
      </view>

      <view class="field">
        <text class="label">工作地址</text>
        <textarea class="textarea" placeholder="请输入详细工作地址" value="{{address}}" data-field="address" bindinput="onFieldInput" maxlength="120"></textarea>
      </view>

      <view class="field">
        <text class="label">工资标准</text>
        <input class="input" placeholder="如：日结 180 元 / 计件 0.8 元/斤" value="{{salary}}" data-field="salary" bindinput="onFieldInput" />
      </view>

      <view class="field">
        <text class="label">岗位描述</text>
        <textarea class="textarea" placeholder="请输入岗位职责、上班时间、食宿情况等" value="{{jobDescription}}" data-field="jobDescription" bindinput="onFieldInput" maxlength="240"></textarea>
      </view>

      <view wx:if="{{error}}" class="error-msg">{{error}}</view>

      <button class="submit-btn" loading="{{submitting}}" disabled="{{submitting || uploadingLicense || uploadingEnv}}" bindtap="submitForAudit">
        {{submitting ? '提交中...' : (uploadingLicense || uploadingEnv ? '图片上传中...' : '提交审核')}}
      </button>
    </view>

    <view wx:if="{{auditSubmitted}}" class="status-card">
      <text class="status-title">审核状态：{{auditStatusText}}</text>
      <text class="status-desc">资料已进入超级管理员审核队列，审核通过后会分配管理角色进入运营流程。</text>
    </view>

    <view class="form-card">
      <view class="section-title">工资结算</view>
      <view class="salary-readonly-tip">老板端只读查看每位采摘工的工资单明细，不修改工资金额；工人确认后，老板负责结算，系统会在结算完成后自动生成工资表给超级管理员。</view>

      <view class="field">
        <text class="label">查看基地</text>
        <picker mode="selector" range="{{payrollBases}}" range-key="baseName" value="{{payrollBaseIndex}}" bindchange="onPayrollBaseChange">
          <view class="picker-box">{{payrollBases.length ? payrollBases[payrollBaseIndex].baseName : '暂无可查看基地'}}</view>
        </picker>
      </view>

      <view class="date-grid">
        <view class="field field-half">
          <text class="label">开始日期</text>
          <picker mode="date" value="{{payrollDateFrom}}" bindchange="onPayrollDateFromChange">
            <view class="picker-box">{{payrollDateFrom}}</view>
          </picker>
        </view>

        <view class="field field-half">
          <text class="label">结束日期</text>
          <picker mode="date" value="{{payrollDateTo}}" bindchange="onPayrollDateToChange">
            <view class="picker-box">{{payrollDateTo}}</view>
          </picker>
        </view>
      </view>

      <view class="summary-chip-row">
        <text class="summary-chip">工资单 {{payrollSummary.totalRecords}}</text>
        <text class="summary-chip pending">待工人确认 {{payrollSummary.pendingCount}}</text>
        <text class="summary-chip info">待老板结算 {{payrollSummary.confirmedCount}}</text>
        <text class="summary-chip success">已结算 {{payrollSummary.paidCount}}</text>
        <text class="summary-chip success">总金额 ¥{{payrollSummary.totalAmount}}</text>
      </view>

      <view class="payroll-action-row">
        <button class="payroll-primary-btn" bindtap="settleConfirmedPayrolls" loading="{{payrollSettling}}" disabled="{{payrollSettling || payrollLoading || payrollSummary.confirmedCount === 0}}">批量结算已确认工资</button>
      </view>

      <button class="secondary-action-btn" bindtap="refreshPayrollBoard" loading="{{payrollLoading}}" disabled="{{payrollLoading}}">刷新工资情况</button>
      <view wx:if="{{payrollReportGeneratedAtText}}" class="payroll-generated-tip">最近一次自动生成时间：{{payrollReportGeneratedAtText}}{{payrollReportFileName ? (' · ' + payrollReportFileName) : ''}}</view>

      <view wx:if="{{!payrollBases.length}}" class="readonly-hint">当前名下暂无可查看基地。</view>
      <view wx:elif="{{payrollLoading}}" class="readonly-hint">工资情况加载中...</view>
      <view wx:elif="{{!payrollRows.length}}" class="readonly-hint">当前筛选暂无工资单。</view>

      <view wx:else class="payroll-list">
        <view class="payroll-item" wx:for="{{payrollRows}}" wx:key="id">
          <view class="payroll-top">
            <view class="payroll-main">
              <text class="payroll-name">{{item.workerName}}（{{item.workerUid}}）</text>
              <text class="payroll-meta">{{item.baseName}} · {{item.jobTitle}} · {{item.workDate}}</text>
            </view>
            <text class="payroll-amount">¥{{item.amountText}}</text>
          </view>

          <view class="payroll-chip-row">
            <text class="payroll-chip {{item.statusClass}}">{{item.statusText}}</text>
            <text class="payroll-chip info">{{item.volumeText}}</text>
          </view>

          <text class="payroll-detail">工资单 #{{item.id}} · 生成时间 {{item.createdAtText}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
