<view class="container register-container page-enter">
  <view class="brand-hero">
    <view class="brand-row">
      <image class="brand-logo" src="/images/zhihui-logo.jpg" mode="aspectFit" />
      <view>
        <view class="brand-title">智汇就业</view>
        <view class="brand-subtitle">实名注册 · 信息完善</view>
      </view>
    </view>
  </view>

  <view class="card register-card">
    <view class="card-title">{{registerRole === 'boss' ? '创建老板账号' : '创建采摘工账号'}}</view>
    <view class="card-subtitle">{{registerRole === 'boss' ? '请填写真实信息，用于企业入驻与资料审核' : '请填写真实信息，用于报名、工资结算与发放'}}</view>

    <view class="steps">
      <view class="step active">
        <view class="step-dot">1</view>
        <text class="step-label">基本信息</text>
      </view>
      <view class="step-line"></view>
      <view class="step {{emergencyContact || emergencyPhone ? 'active' : ''}}">
        <view class="step-dot">2</view>
        <text class="step-label">紧急联系人</text>
      </view>
    </view>

    <view class="form-section">
      <view class="section-label">
        <text>基本信息</text>
      </view>

      <view class="form-item">
        <view class="input-wrapper {{nameFocus ? 'focus' : ''}}">
          <text class="input-icon">姓名</text>
          <input
            class="input-field"
            type="text"
            placeholder="真实姓名"
            placeholder-class="placeholder"
            value="{{name}}"
            bindinput="onInputName"
            bindfocus="onNameFocus"
            bindblur="onNameBlur"
          />
          <text class="required-star">*</text>
        </view>
      </view>

      <view class="form-item">
        <view class="input-wrapper {{idCardFocus ? 'focus' : ''}}">
          <text class="input-icon">证件</text>
          <input
            class="input-field"
            type="idcard"
            placeholder="18位身份证号码"
            placeholder-class="placeholder"
            value="{{idCard}}"
            bindinput="onInputIdCard"
            bindfocus="onIdCardFocus"
            bindblur="onIdCardBlur"
            maxlength="18"
          />
          <text class="required-star">*</text>
        </view>
      </view>

      <view class="form-item">
        <view class="input-wrapper {{phoneFocus ? 'focus' : ''}}">
          <text class="input-icon">手机</text>
          <input
            class="input-field"
            type="number"
            placeholder="11位手机号"
            placeholder-class="placeholder"
            value="{{phone}}"
            bindinput="onInputPhone"
            bindfocus="onPhoneFocus"
            bindblur="onPhoneBlur"
            maxlength="11"
          />
          <text class="required-star">*</text>
        </view>
      </view>

      <block wx:if="{{registerRole === 'worker'}}">
        <view class="form-item">
          <view class="input-wrapper input-wrapper-multiline">
            <text class="input-icon">住址</text>
            <textarea
              class="input-field input-area"
              placeholder="家庭详细地址（用于工资表）"
              placeholder-class="placeholder"
              value="{{homeAddress}}"
              bindinput="onInputHomeAddress"
              maxlength="120"
              auto-height
            />
            <text class="required-star">*</text>
          </view>
        </view>

        <view class="form-item">
          <view class="input-wrapper">
            <text class="input-icon">银行</text>
            <input
              class="input-field"
              type="text"
              placeholder="如：中国农业银行"
              placeholder-class="placeholder"
              value="{{bankName}}"
              bindinput="onInputBankName"
            />
            <text class="required-star">*</text>
          </view>
        </view>

        <view class="form-item">
          <view class="input-wrapper">
            <text class="input-icon">卡号</text>
            <input
              class="input-field"
              type="number"
              placeholder="银行卡号"
              placeholder-class="placeholder"
              value="{{bankCardNo}}"
              bindinput="onInputBankCardNo"
              maxlength="30"
            />
            <text class="required-star">*</text>
          </view>
        </view>
      </block>
    </view>

    <view class="form-section">
      <view class="section-label">
        <text>紧急联系人</text>
        <text class="section-optional">选填</text>
      </view>

      <view class="form-item">
        <view class="input-wrapper">
          <text class="input-icon">联系人</text>
          <input
            class="input-field"
            type="text"
            placeholder="姓名及关系，如：李四-配偶"
            placeholder-class="placeholder"
            value="{{emergencyContact}}"
            bindinput="onInputEmergencyContact"
          />
        </view>
      </view>

      <view class="form-item">
        <view class="input-wrapper">
          <text class="input-icon">电话</text>
          <input
            class="input-field"
            type="number"
            placeholder="紧急联系人电话"
            placeholder-class="placeholder"
            value="{{emergencyPhone}}"
            bindinput="onInputEmergencyPhone"
            maxlength="11"
          />
        </view>
      </view>
    </view>

    <view class="error-msg" wx:if="{{error}}">
      <text>{{error}}</text>
    </view>

    <view class="api-toggle" bindtap="toggleApiConfig">
      <text class="api-toggle-label">网络设置</text>
      <text class="api-toggle-value">{{currentBaseUrlDisplay}}</text>
    </view>

    <view class="api-panel" wx:if="{{showApiConfig}}">
      <view class="api-title">后端接口地址</view>
      <input
        class="api-input"
        type="text"
        placeholder="http://192.168.1.100:3001/api"
        placeholder-class="placeholder"
        value="{{apiBaseUrlInput}}"
        bindinput="onInputApiBaseUrl"
      />

      <view class="api-presets">
        <view class="api-preset" data-url="{{devtoolsBaseUrl}}" bindtap="useApiPreset">开发者工具地址</view>
        <view class="api-preset" data-url="{{lanBaseUrl}}" bindtap="useApiPreset">局域网默认地址</view>
      </view>

      <button class="api-save-btn" bindtap="saveApiBaseUrl">保存接口地址</button>
    </view>

    <button
      class="register-btn"
      hover-class="register-btn-hover"
      bindtap="handleRegister"
      loading="{{loading}}"
      disabled="{{loading}}"
    >{{loading ? '注册中...' : '立即注册'}}</button>

    <view class="footer-links">
      <text class="login-text">已有账号？</text>
      <text class="login-link" bindtap="goToLogin">返回登录</text>
    </view>
  </view>
</view>
