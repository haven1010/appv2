/* pages/register/register.wxss */
.register-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 90rpx;
}

.register-card {
  width: 100%;
  border-radius: 32rpx;
  padding: 42rpx 30rpx;
  box-sizing: border-box;
}

.card-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #163456;
  margin-bottom: 8rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: #5d7d96;
  margin-bottom: 30rpx;
}

.mode-switch {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  border: 2rpx solid #d5e5f2;
  background: #f7fbff;
  margin-bottom: 14rpx;
}

.mode-pill {
  flex: 1;
  height: 66rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #6f8aa3;
  font-weight: 700;
  background: #eef5fb;
}

.mode-pill.active {
  color: #ffffff;
  background: linear-gradient(135deg, #2e8f4d, #2d73c7);
  box-shadow: 0 6rpx 14rpx rgba(45, 115, 199, 0.22);
}

.mode-tip {
  margin-bottom: 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid #d7e7f5;
  background: #f2f8ff;
  padding: 14rpx 16rpx;
  color: #54738f;
  font-size: 23rpx;
  line-height: 1.5;
}

.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  padding: 20rpx 0;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #dde8f4;
  color: #8ca3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.step.active .step-dot {
  background: linear-gradient(135deg, #2e8f4d, #2d73c7);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(45, 115, 199, 0.34);
}

.step-label {
  font-size: 21rpx;
  color: #8ea4b8;
}

.step.active .step-label {
  color: #2e8f4d;
  font-weight: 700;
}

.step-line {
  width: 80rpx;
  height: 3rpx;
  background: #dce7f3;
  margin: 0 22rpx 24rpx;
}

.form-section {
  margin-bottom: 26rpx;
}

.section-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #2f5373;
  margin-bottom: 16rpx;
}

.section-optional {
  font-size: 20rpx;
  color: #86a1b6;
  font-weight: 400;
  background: #eef5fb;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: auto;
}

.form-item {
  margin-bottom: 16rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f8fbff;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 2rpx solid #dae7f3;
  transition: all 0.25s ease;
}

.input-wrapper-multiline {
  align-items: flex-start;
}

.input-wrapper.focus {
  background: #fff;
  border-color: #2d73c7;
  box-shadow: 0 0 0 6rpx rgba(45, 115, 199, 0.12);
}

.input-icon {
  font-size: 22rpx;
  color: #2e8f4d;
  background: rgba(46, 143, 77, 0.12);
  border-radius: 999rpx;
  min-width: 76rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #163456;
  height: 44rpx;
}

.picker-field {
  display: flex;
  align-items: center;
  height: 44rpx;
}

.picker-placeholder {
  color: #98aec1;
}

.input-area {
  min-height: 92rpx;
  height: auto;
  line-height: 1.5;
  padding-top: 4rpx;
}

.placeholder {
  color: #98aec1;
  font-size: 26rpx;
}

.required-star {
  color: #e04f39;
  font-size: 30rpx;
  font-weight: 700;
  margin-left: 8rpx;
}

.input-hint {
  margin-top: 8rpx;
  padding-left: 12rpx;
}

.hint-text {
  font-size: 22rpx;
  color: #8ea3b8;
}

.input-hint.success .hint-text {
  color: #2e8f4d;
}

.error-msg {
  background: rgba(240, 91, 70, 0.1);
  border: 1rpx solid rgba(240, 91, 70, 0.2);
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  margin: 6rpx 0 20rpx;
  color: #ca3e2b;
  font-size: 24rpx;
}

.api-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d7e5f2;
  background: #f5faff;
}

.api-toggle-label {
  font-size: 24rpx;
  color: #2f5373;
  font-weight: 600;
}

.api-toggle-value {
  max-width: 420rpx;
  font-size: 22rpx;
  color: #54748f;
  text-align: right;
}

.api-panel {
  border: 1rpx solid #d7e5f2;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-bottom: 20rpx;
  background: #fafdff;
}

.api-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #2f5373;
  margin-bottom: 12rpx;
}

.api-input {
  width: 100%;
  height: 72rpx;
  border: 2rpx solid #dae7f3;
  border-radius: 12rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  background: #fff;
  font-size: 24rpx;
  color: #163456;
}

.api-presets {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.api-preset {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: #2d73c7;
  background: #eaf3ff;
}

.api-save-btn {
  margin-top: 14rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 12rpx;
  background: #2d73c7;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.api-save-btn::after {
  border: none;
}

.register-btn {
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 64%, #1f5ca9 100%);
  color: #fff;
  border-radius: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  padding: 24rpx 0;
  margin-top: 14rpx;
  box-shadow: 0 10rpx 24rpx rgba(45, 115, 199, 0.26);
  border: none;
}

.register-btn::after {
  border: none;
}

.register-btn-hover {
  transform: translateY(2rpx);
  opacity: 0.92;
}

.register-btn[disabled] {
  background: linear-gradient(135deg, #94a3b8 0%, #6d8298 100%);
  box-shadow: none;
}

.footer-links {
  margin-top: 30rpx;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
}

.login-text {
  font-size: 25rpx;
  color: #5d7c96;
}

.login-link {
  color: #2d73c7;
  font-size: 28rpx;
  font-weight: 700;
  margin-left: 10rpx;
}
