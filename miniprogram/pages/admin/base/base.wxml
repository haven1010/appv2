<view class="page-admin">
  <view class="hero-card">
    <view class="hero-title">基地管理</view>
    <view class="hero-sub">{{roleText}} · 今年申请 / 已入驻基地与人员流程追溯</view>
  </view>

  <view class="section-card">
    <view class="section-title">今年基地概览（{{currentYear}}）</view>
    <view class="chip-row">
      <text class="chip pending">申请中：{{yearAppliedBases.length}}</text>
      <text class="chip success">已入驻：{{yearSettledBases.length}}</text>
      <text class="chip info">总基地：{{baseList.length}}</text>
    </view>

    <view class="form-label">切换基地</view>
    <picker mode="selector" value="{{baseIndex}}" range="{{baseList}}" range-key="baseName" bindchange="onBaseChange">
      <view class="picker">{{selectedBase.baseName || selectedBase.name || '暂无基地'}}</view>
    </picker>
  </view>

  <view class="section-card">
    <view class="section-title">今年申请基地</view>
    <view class="empty-text" wx:if="{{!yearAppliedBases.length}}">暂无今年申请中的基地</view>
    <view class="list-item" wx:for="{{yearAppliedBases}}" wx:key="id">
      <view class="item-title">{{item.baseName}}</view>
      <view class="item-sub">创建时间：{{item.createdAt ? item.createdAt.slice(0, 10) : '-'}}</view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">今年已入驻基地</view>
    <view class="empty-text" wx:if="{{!yearSettledBases.length}}">暂无今年已入驻基地</view>
    <view class="list-item" wx:for="{{yearSettledBases}}" wx:key="id">
      <view class="item-title">{{item.baseName}}</view>
      <view class="item-sub">创建时间：{{item.createdAt ? item.createdAt.slice(0, 10) : '-'}}</view>
      <view class="actions-row" wx:if="{{canSuperAdmin}}">
        <button class="btn-danger" data-id="{{item.id}}" bindtap="deleteBase">删除入驻基地</button>
      </view>
    </view>
  </view>

  <view class="section-card" wx:if="{{selectedBase}}">
    <view class="section-title">当前基地信息</view>
    <view class="list-item">
      <view class="item-title">{{selectedBase.baseName || selectedBase.name}}</view>
      <view class="item-sub">基地ID：{{selectedBase.id}}</view>
      <view class="item-sub">审核状态：{{selectedBase.auditStatus === 1 ? '已通过' : selectedBase.auditStatus === 2 ? '已拒绝' : '待审核'}}</view>
      <view class="item-sub">联系方式：{{selectedBase.contactPhone || '-'}}</view>
      <view class="item-sub">地址：{{selectedBase.address || '-'}}</view>
      <view class="item-sub">描述：{{selectedBase.description || '-'}}</view>
      <view class="actions-row" wx:if="{{canSuperAdmin}}">
        <button class="btn-danger" data-id="{{selectedBase.id}}" bindtap="deleteBase">删除当前基地</button>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">人员信息全流程追溯</view>
    <view class="empty-text" wx:if="{{!workerFlows.length}}">暂无人员流程数据</view>
    <view class="list-item" wx:for="{{workerFlows}}" wx:key="key">
      <view class="item-title">{{item.name}}（{{item.uid}}）</view>
      <view class="chip-row">
        <text class="chip {{item.statusChipType}}">{{item.statusText}}</text>
        <text class="chip info">岗位：{{item.jobTitle}}</text>
      </view>
      <view class="item-sub">{{item.trace}}</view>
      <view class="item-sub">更新时间：{{item.updatedAtText}}</view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">基地合作流程</view>
    <view class="empty-text" wx:if="{{!cooperationFlows.length}}">暂无合作流程数据</view>
    <view class="list-item" wx:for="{{cooperationFlows}}" wx:key="key">
      <view class="item-title">申请人：{{item.applicantName}}</view>
      <view class="chip-row">
        <text class="chip {{item.statusChipType}}">{{item.statusText}}</text>
      </view>
      <view class="item-sub">需求：{{item.requirement}}</view>
      <view class="item-sub" wx:if="{{item.rejectReason}}">驳回原因：{{item.rejectReason}}</view>
      <view class="item-sub">更新时间：{{item.updatedAtText}}</view>
    </view>
  </view>

  <view class="empty-text" wx:if="{{loading}}">加载中...</view>

  <view class="admin-bottom-nav">
    <view class="admin-bottom-item {{activeNav === 'home' ? 'active' : ''}}" data-target="home" bindtap="switchAdminNav">首页</view>
    <view class="admin-bottom-item {{activeNav === 'base' ? 'active' : ''}}" wx:if="{{role !== 'field_manager'}}" data-target="base" bindtap="switchAdminNav">基地</view>
    <view class="admin-bottom-item {{activeNav === 'scan' ? 'active' : ''}}" data-target="scan" bindtap="switchAdminNav">扫码</view>
    <view class="admin-bottom-item {{activeNav === 'audit' ? 'active' : ''}}" wx:if="{{role === 'super_admin' || role === 'region_admin'}}" data-target="audit" bindtap="switchAdminNav">审核</view>
    <view class="admin-bottom-item {{activeNav === 'payroll' ? 'active' : ''}}" wx:if="{{role === 'super_admin' || role === 'region_admin'}}" data-target="payroll" bindtap="switchAdminNav">工资</view>
    <view class="admin-bottom-item {{activeNav === 'me' ? 'active' : ''}}" data-target="me" bindtap="switchAdminNav">我的</view>
  </view>
</view>