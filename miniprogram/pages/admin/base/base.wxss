@import "../common.wxss";

.filter-grid {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.no-top {
  margin-top: 0;
}

.summary-grid {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.summary-item {
  background: rgba(248, 252, 255, 0.96);
  border: 1rpx solid rgba(45, 115, 199, 0.12);
  border-radius: 14rpx;
  padding: 12rpx;
}

.summary-label {
  font-size: 20rpx;
  color: #6d89a2;
}

.summary-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #17354f;
}

.worker-card {
  margin-top: 14rpx;
}

.worker-input-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.worker-input-label {
  width: 150rpx;
  color: #5f7d95;
  font-size: 22rpx;
  flex-shrink: 0;
}

.worker-input {
  flex: 1;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(45, 115, 199, 0.16);
  border-radius: 12rpx;
  padding: 10rpx 14rpx;
  font-size: 24rpx;
  color: #17354f;
}

.worker-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #4d6e88;
}

.worker-tip.warn {
  color: #b33f2a;
}