<view class="page-admin">
  <view class="hero-card">
    <view class="hero-title">管理员工作台</view>
    <view class="hero-sub">{{roleText}} · {{userInfo.name}} · UID: {{userInfo.uid}}</view>
    <view class="info-row">
      <text class="role-chip">角色：{{roleText}}</text>
    </view>
  </view>

  <block wx:if="{{role === 'field_manager'}}">
    <view class="section-card">
      <view class="section-title">基地信息</view>
      <view class="section-sub">以基地卡片展示，点击卡片可查看基地详情和报名人员信息</view>
      <view class="chip-row">
        <text class="chip info">基地数：{{fieldBaseCards.length}}</text>
      </view>
      <view class="empty-text" wx:if="{{!fieldBaseCards.length && !fieldError}}">暂无可查看基地</view>
      <view class="chip-row" wx:if="{{fieldError}}">
        <text class="chip danger">{{fieldError}}</text>
      </view>

      <view
        class="list-item base-name-card {{fieldSelectedBaseId === item.id ? 'active' : ''}}"
        wx:for="{{fieldBaseCards}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onFieldBaseCardTap"
      >
        <view class="base-name-top">
          <view class="item-title">{{item.baseName}}</view>
          <view class="chip {{item.auditChipType}}">{{item.auditText}}</view>
        </view>
        <view class="item-sub">联系方式：{{item.contactPhone}}</view>
        <view class="item-sub">区域编码：{{item.regionCode}}</view>
        <view class="item-sub">地址：{{item.address}}</view>
      </view>
    </view>

    <view class="section-card" wx:if="{{fieldSelectedBase}}">
      <view class="section-title">基地详情</view>
      <view class="item-sub">基地名称：{{fieldSelectedBase.baseName}}</view>
      <view class="item-sub">审核状态：{{fieldSelectedBase.auditText}}</view>
      <view class="item-sub">联系方式：{{fieldSelectedBase.contactPhone}}</view>
      <view class="item-sub">区域编码：{{fieldSelectedBase.regionCode}}</view>
      <view class="item-sub">基地地址：{{fieldSelectedBase.address}}</view>
      <view class="item-sub">基地描述：{{fieldSelectedBase.description}}</view>
      <view class="item-sub">创建时间：{{fieldSelectedBase.createdAtText}}</view>
      <view class="item-sub">更新时间：{{fieldSelectedBase.updatedAtText}}</view>
    </view>

    <view class="section-card">
      <view class="section-title">报名人员（{{fieldApplicantSummary.total}}）</view>
      <view class="chip-row">
        <text class="chip pending">待处理：{{fieldApplicantSummary.pending}}</text>
        <text class="chip success">已录用：{{fieldApplicantSummary.approved}}</text>
        <text class="chip danger">已拒绝：{{fieldApplicantSummary.rejected}}</text>
        <text class="chip info">已取消：{{fieldApplicantSummary.cancelled}}</text>
      </view>
      <view class="empty-text" wx:if="{{!fieldApplicantRows.length}}">当前基地暂无报名人员</view>

      <view class="list-item" wx:for="{{fieldApplicantRows}}" wx:key="key">
        <view class="base-name-top">
          <view class="item-title">{{item.name}}（{{item.uid}}）</view>
          <view class="chip {{item.statusChipType}}">{{item.statusText}}</view>
        </view>
        <view class="item-sub">电话：{{item.phone}}</view>
        <view class="item-sub">性别：{{item.genderText}} ｜ 年龄：{{item.ageText}}</view>
        <view class="item-sub">报名岗位：{{item.jobTitle}}</view>
        <view class="item-sub">报名时间：{{item.applyTimeText}}</view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">签到相关信息</view>
      <view class="section-sub">保留首页签到概览，点击按钮进入签到页面</view>

      <view class="form-label">签到日期</view>
      <picker mode="date" value="{{fieldDate}}" bindchange="onFieldDateChange">
        <view class="picker">{{fieldDate}}</view>
      </picker>

      <view class="chip-row">
        <text class="chip success">已签到：{{fieldCheckedRows.length}}</text>
        <text class="chip pending">未签到：{{fieldPendingRows.length}}</text>
        <text class="chip info">首次到访/补签：{{fieldFirstVisitRows.length}}</text>
      </view>

      <view class="actions-row">
        <button class="btn-secondary" bindtap="goScanCenter">进入签到页面</button>
        <button class="btn-ghost" bindtap="refreshFieldAttendance" wx:if="{{fieldSelectedBaseId}}">刷新签到信息</button>
      </view>

      <view class="list-item" wx:if="{{fieldCheckedRows.length}}">
        <view class="item-title">今日已签到</view>
        <view class="item-sub" wx:for="{{fieldCheckedRows}}" wx:key="key">{{item.name}} ({{item.uid || '-'}}) - {{item.checkinTime}}</view>
      </view>

      <view class="list-item" wx:if="{{fieldPendingRows.length}}">
        <view class="item-title">待签到人员</view>
        <view class="item-sub" wx:for="{{fieldPendingRows}}" wx:key="key">{{item.name}} ({{item.uid || '-'}})</view>
      </view>

      <view class="list-item" wx:if="{{fieldFirstVisitRows.length}}">
        <view class="item-title">首次到访/补签</view>
        <view class="item-sub" wx:for="{{fieldFirstVisitRows}}" wx:key="key">{{item.name}} ({{item.uid || '-'}}) - {{item.checkinTime}}</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{role === 'base_manager'}}">
    <view class="section-card">
      <view class="section-title">基地人员总览（首页）</view>
      <view class="section-sub">按基地查看人员、签到状态和工资状态</view>

      <view class="form-label">选择基地</view>
      <picker mode="selector" value="{{managedBaseIndex}}" range="{{managedBases}}" range-key="baseName" bindchange="onManagedBaseChange">
        <view class="picker">{{managedBaseName || '暂无基地'}}</view>
      </picker>

      <view class="chip-row">
        <text class="chip info">人员总数：{{managedSummary.totalWorkers}}</text>
        <text class="chip success">已签到：{{managedSummary.checkedIn}}</text>
        <text class="chip pending">已出工资：{{managedSummary.withSalary}}</text>
        <text class="chip info">同步时间：{{managedSyncedAt || '-'}}</text>
      </view>

      <view class="actions-row">
        <button class="btn-ghost" bindtap="refreshManagedRows">实时同步</button>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">人员折叠列表</view>
      <view class="empty-text" wx:if="{{!managedBaseRows.length}}">当前基地暂无已录用人员</view>

      <view class="list-item" wx:for="{{managedBaseRows}}" wx:key="key" data-key="{{item.key}}" bindtap="toggleManagedWorker">
        <view class="item-title">{{item.name}}（{{item.uid || '-'}}）</view>
        <view class="chip-row">
          <text class="chip {{item.attendanceChipType}}">签到：{{item.attendanceStatusText}}</text>
          <text class="chip {{item.salaryChipType}}">工资：{{item.salaryStatusText}}</text>
        </view>
        <view class="item-sub" wx:if="{{item.expanded}}">签到时间：{{item.checkinTime}}</view>
        <view class="item-sub" wx:if="{{item.expanded}}">当日收入：{{item.salaryAmount}}</view>
        <view class="item-sub" wx:if="{{item.expanded}}">{{item.trace}}</view>
        <view class="item-sub">{{item.expanded ? '收起详情' : '展开详情'}}</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="section-card">
      <view class="section-title">全平台人员总览（首页）</view>
      <view class="section-sub">现场管理员、基地管理员、报名采摘工统一检索</view>

      <view class="chip-row">
        <text class="chip info">总用户：{{superStats.totalUsers || 0}}</text>
        <text class="chip info">管理员：{{superStats.totalAdmins || 0}}</text>
        <text class="chip info">采摘工：{{superStats.totalWorkers || 0}}</text>
        <text class="chip pending">待审核：{{superStats.pendingAudit || 0}}</text>
      </view>

      <view class="form-label">角色筛选</view>
      <picker mode="selector" value="{{superRoleIndex}}" range="{{superRoleOptions}}" range-key="label" bindchange="onSuperRoleChange">
        <view class="picker">{{superRoleOptions[superRoleIndex].label}}</view>
      </picker>

      <view class="form-label">关键字</view>
      <input class="input" value="{{superKeyword}}" bindinput="onSuperKeywordInput" placeholder="姓名 / UID" />

      <view class="actions-row">
        <button class="btn-primary" bindtap="searchSuperUsers">搜索</button>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">人员列表（{{superTotal}}）</view>
      <view class="empty-text" wx:if="{{!superList.length}}">暂无符合条件的人员</view>
      <view class="list-item" wx:for="{{superList}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleSuperUserDetail">
        <view class="person-head-row">
          <view class="person-head-main">
            <view class="item-title">{{item.name}}</view>
            <view class="item-sub">{{item.expanded ? '点击收起信息' : '点击查看信息'}}</view>
          </view>
          <button
            wx:if="{{item.canDelete}}"
            class="btn-danger btn-delete-mini"
            data-id="{{item.id}}"
            catchtap="deleteSuperUser"
          >删除</button>
        </view>

        <block wx:if="{{item.expanded}}">
          <view class="chip-row">
            <text class="chip info">{{item.roleText}}</text>
            <text class="chip pending">{{item.auditText}}</text>
          </view>
          <view class="item-sub">UID：{{item.uid}}</view>
          <view class="item-sub">手机号：{{item.phone}}</view>
          <view class="item-sub">身份证：{{item.idCard}}</view>
          <view class="item-sub">指派基地：{{item.assignedBaseId}}</view>
          <view class="item-sub">创建时间：{{item.createdAtText}}</view>
          <view class="item-sub">更新时间：{{item.updatedAtText}}</view>
          <view class="item-sub" wx:if="{{!item.canDelete}}">当前登录账号不可删除</view>
        </block>
      </view>
    </view>
  </block>

  <view class="empty-text" wx:if="{{loading}}">加载中...</view>

  <view class="admin-bottom-nav">
    <view class="admin-bottom-item {{activeNav === 'home' ? 'active' : ''}}" data-target="home" bindtap="switchAdminNav">{{role === 'super_admin' || role === 'region_admin' ? '人员管理' : '首页'}}</view>
    <view class="admin-bottom-item {{activeNav === 'base' ? 'active' : ''}}" wx:if="{{role !== 'field_manager'}}" data-target="base" bindtap="switchAdminNav">{{role === 'super_admin' || role === 'region_admin' ? '基地管理' : '基地'}}</view>
    <view class="admin-bottom-item {{activeNav === 'scan' ? 'active' : ''}}" wx:if="{{role !== 'super_admin' && role !== 'region_admin'}}" data-target="scan" bindtap="switchAdminNav">扫码</view>
    <view class="admin-bottom-item {{activeNav === 'audit' ? 'active' : ''}}" wx:if="{{role === 'super_admin' || role === 'region_admin'}}" data-target="audit" bindtap="switchAdminNav">审核</view>
    <view class="admin-bottom-item {{activeNav === 'payroll' ? 'active' : ''}}" wx:if="{{role === 'super_admin' || role === 'region_admin'}}" data-target="payroll" bindtap="switchAdminNav">工资管理</view>
    <view class="admin-bottom-item {{activeNav === 'me' ? 'active' : ''}}" data-target="me" bindtap="switchAdminNav">我的信息</view>
  </view>
</view>
