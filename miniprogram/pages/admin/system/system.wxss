@import "../common.wxss";

.filter-grid {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.no-top {
  margin-top: 0;
}

.table-wrap {
  margin-top: 14rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.2);
  border-radius: 14rpx;
  overflow: hidden;
}

.table-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid rgba(45, 115, 199, 0.12);
}

.table-row:last-child {
  border-bottom: none;
}

.table-head {
  background: rgba(45, 115, 199, 0.12);
}

.cell {
  padding: 12rpx 8rpx;
  font-size: 20rpx;
  color: #17354f;
  border-right: 1rpx solid rgba(45, 115, 199, 0.1);
  box-sizing: border-box;
}

.table-head .cell {
  font-weight: 700;
}

.cell:last-child {
  border-right: none;
}

.cell.serial {
  width: 72rpx;
  text-align: center;
}

.cell.name {
  width: 110rpx;
}

.cell.gender {
  width: 80rpx;
  text-align: center;
}

.cell.idcard {
  width: 220rpx;
}

.cell.addr {
  width: 220rpx;
}

.cell.poor {
  width: 120rpx;
  text-align: center;
}

.cell.amount {
  width: 140rpx;
  text-align: right;
}

.cell.sign {
  flex: 1;
}

.history-active {
  border-color: rgba(46, 143, 77, 0.35);
  box-shadow: 0 0 0 1rpx rgba(46, 143, 77, 0.25) inset;
}

@media (max-width: 720rpx) {
  .filter-grid {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
}
