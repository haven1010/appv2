@import "../common.wxss";

.filter-grid {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.no-top {
  margin-top: 0;
}

.base-report-card {
  margin-top: 14rpx;
  border-color: rgba(106, 153, 78, 0.18);
  background: rgba(255, 248, 232, 0.96);
}

.report-summary-row {
  margin-top: 12rpx;
}

.auto-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-sub);
}

.collapse-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6rpx 0 10rpx;
}

.collapse-main {
  flex: 1;
  min-width: 0;
}

.collapse-tag {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #355528;
  background: linear-gradient(90deg, #e9c46a 0%, #f4d48f 100%);
  border: 1rpx solid rgba(106, 153, 78, 0.2);
}

.table-scroll {
  width: 100%;
  margin-top: 12rpx;
}

.table-wrap {
  min-width: 2000rpx;
  border: 1rpx solid rgba(106, 153, 78, 0.2);
  border-radius: 14rpx;
  overflow: hidden;
  background: #fffdf8;
}

.table-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid rgba(106, 153, 78, 0.12);
}

.table-row:last-child {
  border-bottom: none;
}

.table-head {
  background: rgba(106, 153, 78, 0.12);
}

.cell {
  padding: 12rpx 8rpx;
  font-size: 20rpx;
  color: #333333;
  border-right: 1rpx solid rgba(106, 153, 78, 0.12);
  box-sizing: border-box;
}

.table-head .cell {
  font-weight: 700;
}

.cell:last-child {
  border-right: none;
}

.cell.serial {
  width: 72rpx;
  text-align: center;
}

.cell.name {
  width: 110rpx;
}

.cell.gender {
  width: 80rpx;
  text-align: center;
}

.cell.idcard {
  width: 220rpx;
}

.cell.addr {
  width: 260rpx;
}

.cell.poor {
  width: 120rpx;
  text-align: center;
}

.cell.age {
  width: 92rpx;
  text-align: center;
}

.cell.phone {
  width: 170rpx;
}

.cell.location {
  width: 180rpx;
}

.cell.worktype {
  width: 190rpx;
}

.cell.start {
  width: 210rpx;
}

.cell.end {
  width: 210rpx;
}

.cell.remark {
  flex: 1;
  min-width: 150rpx;
}

.report-actions {
  margin-top: 18rpx;
}

.history-active {
  border-color: rgba(106, 153, 78, 0.35);
  box-shadow: 0 0 0 1rpx rgba(106, 153, 78, 0.22) inset;
}

@media (max-width: 720rpx) {
  .filter-grid {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
}
