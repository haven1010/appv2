@import "../common.wxss";

.filter-grid {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.no-top {
  margin-top: 0;
}

.collapse-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 0 10rpx;
}

.collapse-main {
  flex: 1;
  min-width: 0;
}

.collapse-tag {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #5f7f74;
  background: linear-gradient(135deg, #dff0e8 0%, #e8f1f9 56%, #fef8dc 100%);
  border: 1rpx solid rgba(166, 194, 183, 0.44);
}

.collapse-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7f9189;
}

.table-scroll {
  width: 100%;
  margin-top: 14rpx;
}

.table-wrap {
  min-width: 1150rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.2);
  border-radius: 14rpx;
  overflow: hidden;
}

.table-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid rgba(45, 115, 199, 0.12);
}

.table-row:last-child {
  border-bottom: none;
}

.table-head {
  background: rgba(45, 115, 199, 0.12);
}

.cell {
  padding: 12rpx 8rpx;
  font-size: 20rpx;
  color: #17354f;
  border-right: 1rpx solid rgba(45, 115, 199, 0.1);
  box-sizing: border-box;
}

.table-head .cell {
  font-weight: 700;
}

.cell:last-child {
  border-right: none;
}

.cell.serial {
  width: 72rpx;
  text-align: center;
}

.cell.name {
  width: 110rpx;
}

.cell.gender {
  width: 80rpx;
  text-align: center;
}

.cell.idcard {
  width: 220rpx;
}

.cell.addr {
  width: 260rpx;
}

.cell.poor {
  width: 120rpx;
  text-align: center;
}

.cell.amount {
  width: 160rpx;
  text-align: right;
}

.cell.sign {
  flex: 1;
}

.report-actions {
  margin-top: 18rpx;
}

.history-active {
  border-color: rgba(46, 143, 77, 0.35);
  box-shadow: 0 0 0 1rpx rgba(46, 143, 77, 0.25) inset;
}

@media (max-width: 720rpx) {
  .filter-grid {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
}
