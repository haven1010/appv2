<view class="page-admin">
  <view class="hero-card">
    <view class="hero-title">工资表归档中心（超管）</view>
    <view class="hero-sub">工期结束后自动补齐工资草稿，并按基地卡片存档查看</view>
  </view>

  <view class="section-card">
    <view class="section-title">筛选条件</view>
    <view class="filter-grid">
      <view>
        <view class="form-label no-top">基地</view>
        <picker mode="selector" value="{{baseIndex}}" range="{{baseOptions}}" range-key="label" bindchange="onBaseChange">
          <view class="picker">{{baseOptions[baseIndex].label}}</view>
        </picker>
      </view>

      <view>
        <view class="form-label no-top">开始日期</view>
        <picker mode="date" value="{{dateFrom}}" bindchange="onDateFromChange">
          <view class="picker">{{dateFrom}}</view>
        </picker>
      </view>

      <view>
        <view class="form-label">结束日期</view>
        <picker mode="date" value="{{dateTo}}" bindchange="onDateToChange">
          <view class="picker">{{dateTo}}</view>
        </picker>
      </view>

      <view>
        <view class="form-label">人员关键字</view>
        <input class="input" value="{{keyword}}" bindinput="onKeywordInput" placeholder="姓名 / UID" />
      </view>
    </view>

    <view class="actions-row">
      <button class="btn-primary" bindtap="searchReport" loading="{{reportLoading}}">生成工资表</button>
      <button class="btn-ghost" bindtap="resetReport">重置筛选</button>
    </view>
  </view>

  <view class="section-card" wx:if="{{hasReport}}">
    <view class="section-title">工资表结果（按基地）</view>
    <view class="section-sub">{{reportFilterText}}</view>
    <view class="section-sub" wx:if="{{reportGeneratedAtText}}">生成时间：{{reportGeneratedAtText}}</view>

    <view class="chip-row report-summary-row">
      <text class="chip info">基地：{{totalBases}}</text>
      <text class="chip info">人数：{{totalWorkers}}</text>
      <text class="chip success">总收入：{{totalIncome}}</text>
      <text class="chip success" wx:if="{{autoDraftSummary.enabled}}">自动补齐：{{autoDraftSummary.created}}</text>
      <text class="chip pending" wx:if="{{autoDraftSummary.enabled}}">跳过：{{autoDraftSummary.skipped}}</text>
      <text class="chip danger" wx:if="{{autoDraftSummary.enabled && autoDraftSummary.failed}}">失败：{{autoDraftSummary.failed}}</text>
    </view>
    <view class="auto-note" wx:if="{{autoDraftSummary.note}}">{{autoDraftSummary.note}}</view>

    <view class="empty-text" wx:if="{{!baseReportList.length && !reportLoading}}">当前筛选暂无工资数据</view>

    <view class="list-item base-report-card" wx:for="{{baseReportList}}" wx:key="key">
      <view class="collapse-head" data-base-id="{{item.baseId}}" bindtap="toggleBaseReport">
        <view class="collapse-main">
          <view class="item-title">{{item.baseName}}</view>
          <view class="item-sub">人数：{{item.totalWorkers}} · 总收入：{{item.totalIncome}}</view>
        </view>
        <view class="collapse-tag">{{item.expanded ? '收起' : '展开'}}</view>
      </view>

      <scroll-view class="table-scroll" scroll-x wx:if="{{item.expanded && item.rows.length}}">
        <view class="table-wrap">
          <view class="table-row table-head">
            <text class="cell serial">序号</text>
            <text class="cell name">姓名</text>
            <text class="cell gender">性别</text>
            <text class="cell idcard">身份证号</text>
            <text class="cell addr">家庭住址</text>
            <text class="cell poor">是否贫困户</text>
            <text class="cell amount">务工总收入</text>
            <text class="cell sign">领款签字</text>
          </view>

          <view class="table-row" wx:for="{{item.rows}}" wx:key="serial" wx:for-item="row">
            <text class="cell serial">{{row.serial}}</text>
            <text class="cell name">{{row.name}}</text>
            <text class="cell gender">{{row.gender}}</text>
            <text class="cell idcard">{{row.idCard}}</text>
            <text class="cell addr">{{row.address}}</text>
            <text class="cell poor">{{row.poorHousehold}}</text>
            <text class="cell amount">{{row.totalIncome}}</text>
            <text class="cell sign">{{row.signature || ' '}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="empty-text" wx:if="{{item.expanded && !item.rows.length}}">该基地暂无工资记录</view>
    </view>

    <view class="actions-row report-actions">
      <button class="btn-secondary" bindtap="exportReport" disabled="{{!baseReportList.length}}">导出 XLSX</button>
      <button class="btn-ghost" bindtap="archiveReport" disabled="{{!baseReportList.length}}">存档当前报表</button>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">历史存档</view>
    <view class="actions-row">
      <button class="btn-danger" bindtap="clearHistory" wx:if="{{historyList.length}}">清空历史</button>
    </view>

    <view class="empty-text" wx:if="{{!historyList.length}}">暂无历史存档</view>

    <view
      class="list-item {{selectedHistoryId === item.id ? 'history-active' : ''}}"
      wx:for="{{historyList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="applyHistory"
    >
      <view class="item-title">{{item.label}}</view>
      <view class="item-sub">存档时间：{{item.createdAtText}}</view>
      <view class="item-sub">基地：{{item.totalBases}} · 人数：{{item.totalWorkers}} · 总收入：{{item.totalIncome}}</view>
    </view>
  </view>

  <view class="empty-text" wx:if="{{loading}}">加载中...</view>
  <view class="empty-text" wx:if="{{reportLoading}}">工资表生成中...</view>

  <view class="admin-bottom-nav">
    <view class="admin-bottom-item {{activeNav === 'home' ? 'active' : ''}}" data-target="home" bindtap="switchAdminNav">{{role === 'super_admin' || role === 'region_admin' ? '人员管理' : '首页'}}</view>
    <view class="admin-bottom-item {{activeNav === 'base' ? 'active' : ''}}" wx:if="{{role !== 'field_manager'}}" data-target="base" bindtap="switchAdminNav">{{role === 'super_admin' || role === 'region_admin' ? '基地管理' : '基地'}}</view>
    <view class="admin-bottom-item {{activeNav === 'scan' ? 'active' : ''}}" wx:if="{{role !== 'super_admin' && role !== 'region_admin'}}" data-target="scan" bindtap="switchAdminNav">扫码</view>
    <view class="admin-bottom-item {{activeNav === 'audit' ? 'active' : ''}}" wx:if="{{role === 'super_admin' || role === 'region_admin'}}" data-target="audit" bindtap="switchAdminNav">审核</view>
    <view class="admin-bottom-item {{activeNav === 'payroll' ? 'active' : ''}}" wx:if="{{role === 'super_admin' || role === 'region_admin'}}" data-target="payroll" bindtap="switchAdminNav">工资管理</view>
    <view class="admin-bottom-item {{activeNav === 'me' ? 'active' : ''}}" data-target="me" bindtap="switchAdminNav">我的信息</view>
  </view>
</view>

