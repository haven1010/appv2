.page-admin {
  min-height: 100vh;
  max-width: 1120rpx;
  margin: 0 auto;
  padding: 24rpx;
  padding-bottom: 186rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 88% -8%, rgba(171, 212, 197, 0.36) 0, rgba(171, 212, 197, 0) 32%),
    radial-gradient(circle at 6% 14%, rgba(182, 210, 232, 0.34) 0, rgba(182, 210, 232, 0) 34%),
    repeating-linear-gradient(
      -14deg,
      rgba(255, 255, 255, 0.14) 0rpx,
      rgba(255, 255, 255, 0.14) 10rpx,
      rgba(250, 244, 228, 0.16) 10rpx,
      rgba(250, 244, 228, 0.16) 20rpx
    ),
    linear-gradient(180deg, #fffdf7 0%, #fffaf0 58%, #f7fbff 100%);
}

.hero-card,
.section-card {
  background: rgba(255, 253, 248, 0.95);
  border: 2rpx solid rgba(162, 191, 179, 0.44);
  border-radius: 30rpx 24rpx 28rpx 26rpx;
  padding: 26rpx;
  box-shadow: 0 12rpx 26rpx rgba(126, 161, 147, 0.14);
  box-sizing: border-box;
}

.hero-card {
  margin-bottom: 18rpx;
}

.section-card {
  margin-top: 16rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #4e5d55;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8a83;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.role-chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #6f8f83;
  background: rgba(233, 244, 239, 0.9);
  border: 1rpx solid rgba(160, 188, 179, 0.48);
}

.role-chip.super {
  color: #8f7f66;
  background: rgba(251, 243, 212, 0.92);
  border-color: rgba(207, 191, 143, 0.45);
}

.section-title {
  font-size: 30rpx;
  color: #4e5d55;
  font-weight: 800;
}

.section-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7a8a83;
}

.grid-2 {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.stat-card {
  background: rgba(255, 253, 248, 0.94);
  border: 2rpx solid rgba(176, 197, 187, 0.38);
  border-radius: 22rpx 18rpx 20rpx 16rpx;
  padding: 18rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #83948c;
}

.stat-value {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #6c9488;
}

.input,
.picker,
.textarea,
.select {
  width: 100%;
  box-sizing: border-box;
  margin-top: 10rpx;
  background: rgba(255, 253, 248, 0.94);
  border: 2rpx solid rgba(174, 194, 184, 0.44);
  border-radius: 20rpx 16rpx 18rpx 14rpx;
  padding: 16rpx 18rpx;
  font-size: 26rpx;
  color: #495750;
}

.textarea {
  min-height: 120rpx;
}

.form-label {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #7b8d85;
}

.actions-row {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.btn-primary,
.btn-secondary,
.btn-danger,
.btn-ghost {
  border-radius: 999rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  border: 2rpx solid rgba(165, 194, 183, 0.46);
  box-shadow: 0 8rpx 16rpx rgba(137, 171, 157, 0.16);
}

.btn-primary {
  color: #4a5c53;
  background: linear-gradient(135deg, #dff0e8 0%, #e8f1f9 56%, #fef8dc 100%);
}

.btn-secondary {
  color: #8f7f66;
  background: linear-gradient(135deg, #fbf1ca 0%, #fff5d7 100%);
  border-color: rgba(207, 191, 143, 0.45);
}

.btn-danger {
  color: #a17671;
  background: linear-gradient(135deg, #f8e3df 0%, #f9efed 100%);
  border-color: rgba(216, 174, 166, 0.52);
}

.btn-ghost {
  color: #708982;
  background: rgba(255, 252, 244, 0.96);
  border-color: rgba(185, 196, 178, 0.48);
}

.btn-primary::after,
.btn-secondary::after,
.btn-danger::after,
.btn-ghost::after {
  border: none;
}

.list-item {
  margin-top: 12rpx;
  background: rgba(255, 253, 248, 0.95);
  border: 2rpx solid rgba(176, 197, 187, 0.38);
  border-radius: 22rpx 18rpx 20rpx 16rpx;
  padding: 16rpx;
}

.item-title {
  font-size: 28rpx;
  color: #4e5d55;
  font-weight: 700;
}

.item-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7a8a83;
}

.chip-row {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(160, 188, 179, 0.48);
}

.chip.pending {
  color: #8f7f66;
  background: rgba(251, 243, 212, 0.92);
  border-color: rgba(207, 191, 143, 0.45);
}

.chip.success {
  color: #6f9a83;
  background: rgba(231, 244, 235, 0.94);
  border-color: rgba(165, 196, 176, 0.54);
}

.chip.danger {
  color: #b58984;
  background: rgba(252, 236, 233, 0.94);
  border-color: rgba(220, 170, 163, 0.52);
}

.chip.info {
  color: #6f8ea3;
  background: rgba(232, 241, 249, 0.94);
  border-color: rgba(170, 197, 217, 0.5);
}

.empty-text {
  margin-top: 18rpx;
  color: #85948d;
  font-size: 24rpx;
  text-align: center;
}

.admin-bottom-nav {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(env(safe-area-inset-bottom) + 12rpx);
  z-index: 90;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx;
  border-radius: 24rpx 20rpx 22rpx 18rpx;
  border: 2rpx solid rgba(166, 194, 183, 0.45);
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 10rpx 24rpx rgba(137, 171, 157, 0.16);
  box-sizing: border-box;
}

.admin-bottom-item {
  flex: 1;
  padding: 12rpx 6rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #7c8c84;
  background: rgba(246, 249, 241, 0.9);
}

.admin-bottom-item.active {
  color: #5f7f74;
  background: linear-gradient(135deg, #dff0e8 0%, #e8f1f9 56%, #fef8dc 100%);
  border: 1rpx solid rgba(166, 194, 183, 0.44);
}
