/* pages/admin/common.wxss */
.page-admin {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 84% -8%, rgba(46, 143, 77, 0.15) 0%, rgba(46, 143, 77, 0) 34%),
    radial-gradient(circle at 8% 8%, rgba(231, 168, 58, 0.14) 0%, rgba(231, 168, 58, 0) 30%),
    linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
}

.hero-card {
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(45, 115, 199, 0.18);
  border-radius: 30rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(45, 115, 199, 0.12);
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #17354f;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #63839d;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.role-chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #1f7e42;
  background: rgba(46, 143, 77, 0.12);
  border: 1rpx solid rgba(46, 143, 77, 0.24);
}

.role-chip.super {
  color: #8b5a10;
  background: rgba(231, 168, 58, 0.16);
  border-color: rgba(231, 168, 58, 0.3);
}

.section-card {
  margin-top: 18rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(45, 115, 199, 0.16);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(45, 115, 199, 0.1);
}

.section-title {
  font-size: 30rpx;
  color: #17354f;
  font-weight: 800;
}

.section-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6a88a1;
}

.grid-2 {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.stat-card {
  background: rgba(248, 252, 255, 0.95);
  border: 1rpx solid rgba(45, 115, 199, 0.12);
  border-radius: 18rpx;
  padding: 18rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #6f8aa2;
}

.stat-value {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #17354f;
}

.input,
.picker,
.textarea,
.select {
  width: 100%;
  box-sizing: border-box;
  margin-top: 10rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(45, 115, 199, 0.16);
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  font-size: 26rpx;
  color: #17354f;
}

.textarea {
  min-height: 120rpx;
}

.form-label {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #5f7d95;
}

.actions-row {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.btn-primary,
.btn-secondary,
.btn-danger,
.btn-ghost {
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  border: none;
}

.btn-primary {
  color: #fff;
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 62%, #1f5ca9 100%);
}

.btn-secondary {
  color: #4f330a;
  background: linear-gradient(135deg, #e7a83a 0%, #f1c36d 100%);
}

.btn-danger {
  color: #fff;
  background: linear-gradient(135deg, #d95e49 0%, #bf3b3b 100%);
}

.btn-ghost {
  color: #3d5f7c;
  background: rgba(45, 115, 199, 0.1);
  border: 1rpx solid rgba(45, 115, 199, 0.2);
}

.btn-primary::after,
.btn-secondary::after,
.btn-danger::after,
.btn-ghost::after {
  border: none;
}

.list-item {
  margin-top: 12rpx;
  background: rgba(248, 252, 255, 0.95);
  border: 1rpx solid rgba(45, 115, 199, 0.12);
  border-radius: 16rpx;
  padding: 16rpx;
}

.item-title {
  font-size: 28rpx;
  color: #17354f;
  font-weight: 700;
}

.item-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #66859d;
}

.chip-row {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid transparent;
}

.chip.pending {
  color: #8f5d11;
  background: rgba(231, 168, 58, 0.18);
  border-color: rgba(231, 168, 58, 0.3);
}

.chip.success {
  color: #1f7e42;
  background: rgba(46, 143, 77, 0.16);
  border-color: rgba(46, 143, 77, 0.28);
}

.chip.danger {
  color: #b33f2a;
  background: rgba(217, 94, 73, 0.16);
  border-color: rgba(217, 94, 73, 0.28);
}

.chip.info {
  color: #1d5fae;
  background: rgba(45, 115, 199, 0.14);
  border-color: rgba(45, 115, 199, 0.24);
}

.empty-text {
  margin-top: 18rpx;
  color: #6d89a2;
  font-size: 24rpx;
  text-align: center;
}

.admin-bottom-nav {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(env(safe-area-inset-bottom) + 12rpx);
  z-index: 90;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.18);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 24rpx rgba(45, 115, 199, 0.16);
  box-sizing: border-box;
}

.admin-bottom-item {
  flex: 1;
  padding: 12rpx 6rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #4e6b84;
  background: rgba(45, 115, 199, 0.08);
}

.admin-bottom-item.active {
  color: #ffffff;
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 62%, #1f5ca9 100%);
}
