/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: 48rpx;
  padding-bottom: 64rpx;
}

.login-card {
  width: 100%;
  border-radius: 32rpx;
  padding: 46rpx 34rpx;
  box-sizing: border-box;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  color: #163456;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 25rpx;
  color: #537590;
  margin-bottom: 42rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #f8fbff;
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid #d7e8f8;
  transition: all 0.25s ease;
}

.input-wrapper:focus-within {
  border-color: #2d73c7;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(45, 115, 199, 0.12);
}

.input-badge {
  height: 46rpx;
  min-width: 84rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.badge-blue {
  background: linear-gradient(135deg, #2d73c7, #1f5ca9);
}

.badge-gold {
  background: linear-gradient(135deg, #e7a83a, #cc8520);
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  color: #163456;
  height: 48rpx;
}

.placeholder {
  color: #96adc2;
}

.error-msg {
  color: #c0392b;
  font-size: 25rpx;
  margin: 8rpx 0 14rpx;
  padding: 14rpx 16rpx;
  background: rgba(236, 89, 69, 0.1);
  border-radius: 12rpx;
  border: 1rpx solid rgba(236, 89, 69, 0.22);
}

.login-btn {
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 64%, #1f5ca9 100%);
  color: white;
  border-radius: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  padding: 24rpx 0;
  margin-top: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(41, 98, 164, 0.26);
  border: none;
}

.login-btn::after {
  border: none;
}

.login-btn-hover {
  transform: translateY(2rpx);
  opacity: 0.92;
}

.footer-links {
  margin-top: 36rpx;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
}

.register-text {
  font-size: 25rpx;
  color: #5d7c96;
}

.register-link {
  color: #2e8f4d;
  font-size: 28rpx;
  font-weight: 700;
  margin-left: 10rpx;
}
