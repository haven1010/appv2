/* pages/qrcode/qrcode.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 156rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 86% -6%, rgba(46, 143, 77, 0.15) 0%, rgba(46, 143, 77, 0) 34%),
    radial-gradient(circle at 8% 8%, rgba(231, 168, 58, 0.14) 0%, rgba(231, 168, 58, 0) 30%),
    linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
}

.card {
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(45, 115, 199, 0.16);
  border-radius: 30rpx;
  box-shadow: 0 14rpx 32rpx rgba(45, 115, 199, 0.12);
}

.brand-head {
  text-align: center;
  padding: 34rpx 28rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.brand-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 15rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.2);
}

.brand-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #153457;
}

.brand-sub {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #67869f;
}

.title {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #153457;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b88a0;
  margin-bottom: 30rpx;
}

.qr-box {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.18);
  padding: 24rpx;
  margin-bottom: 20rpx;
  min-height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-image {
  width: 340rpx;
  height: 340rpx;
}

.qr-loading,
.qr-error {
  color: #7390a8;
  font-size: 26rpx;
}

.uid-box {
  background: rgba(45, 115, 199, 0.08);
  border-radius: 18rpx;
  border: 1rpx solid rgba(45, 115, 199, 0.2);
  padding: 22rpx;
  margin-bottom: 22rpx;
}

.uid-label {
  display: block;
  font-size: 21rpx;
  color: #6e89a2;
}

.uid-text {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #153457;
  margin-top: 8rpx;
  font-family: monospace;
  letter-spacing: 2rpx;
}

.valid-text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f8aa2;
}

.btn-refresh {
  background: linear-gradient(135deg, #2e8f4d 0%, #2d73c7 62%, #1f5ca9 100%);
  color: #fff;
  border-radius: 14rpx;
  padding: 22rpx;
  font-size: 29rpx;
  font-weight: 700;
  border: none;
}

.btn-refresh::after {
  border: none;
}
