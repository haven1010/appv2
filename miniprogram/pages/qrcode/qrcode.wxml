<!--pages/qrcode/qrcode.wxml-->
<view class="page page-enter">
  <view class="brand-head card">
    <view class="brand-row">
      <image class="brand-logo" src="/images/zhihui-logo.jpg" mode="aspectFit" />
      <view>
        <view class="brand-title">智汇就业</view>
        <view class="brand-sub">签到码凭证</view>
      </view>
    </view>

    <view class="title">个人签到二维码</view>
    <view class="subtitle">向现场管理员出示二维码完成签到</view>

    <view class="qr-box" wx:if="{{!loading && qrImageUrl}}">
      <image class="qr-image" src="{{qrImageUrl}}" mode="aspectFit" />
    </view>

    <view class="qr-box qr-loading" wx:if="{{loading}}">
      <text>生成中...</text>
    </view>

    <view class="qr-box qr-error" wx:if="{{!loading && !qrImageUrl}}">
      <text>加载失败，请刷新后重试</text>
    </view>

    <view class="uid-box">
      <text class="uid-label">工号</text>
      <text class="uid-text">{{userInfo.uid}}</text>
      <text class="valid-text">有效期：{{validDuration}}</text>
    </view>

    <button class="btn-refresh" bindtap="refreshQrCode">刷新二维码</button>
  </view>
</view>
