/** app.wxss */

:root {
  --ink-main: #333333;
  --ink-sub: #6f6758;
  --warm-cream: #f7f1e4;
  --warm-card: #fff8e8;
  --warm-green: #6a994e;
  --warm-blue: #4f98d8;
  --warm-orange: #f4a261;
  --radius-card: 28rpx;
  --shadow-card: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

page {
  color: var(--ink-main);
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  background-color: var(--warm-cream) !important;
}

page,
.page {
  min-height: 100vh;
  background-color: var(--warm-cream) !important;
  background-image:
    radial-gradient(circle at 8% 8%, rgba(196, 215, 180, 0.22) 0, rgba(196, 215, 180, 0) 34%),
    radial-gradient(circle at 92% -5%, rgba(245, 195, 132, 0.22) 0, rgba(245, 195, 132, 0) 28%),
    repeating-linear-gradient(
      -16deg,
      rgba(255, 255, 255, 0.08) 0rpx,
      rgba(255, 255, 255, 0.08) 12rpx,
      rgba(245, 239, 224, 0.1) 12rpx,
      rgba(245, 239, 224, 0.1) 24rpx
    ),
    linear-gradient(180deg, #fbf7ed 0%, #f5efe3 55%, #f3ebdc 100%) !important;
}

.page-body {
  box-sizing: border-box;
  padding: 24rpx;
}

.container {
  box-sizing: border-box;
  padding: 24rpx;
}

.safe-bottom-space {
  height: calc(16rpx + env(safe-area-inset-bottom));
}

.section + .section {
  margin-top: 32rpx;
}

.ds-card {
  background: var(--warm-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

.ds-empty {
  text-align: center;
  background: var(--warm-card);
  border-radius: var(--radius-card);
  padding: 48rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.ds-empty-icon {
  display: block;
  font-size: 68rpx;
  line-height: 1;
}

.ds-empty-title {
  display: block;
  margin-top: 12rpx;
  font-size: 32rpx;
  line-height: 1.45;
  color: #333333;
  font-weight: 700;
}

.ds-empty-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #999999;
}

.ds-title {
  font-size: 40rpx;
  line-height: 1.3;
  color: #333333;
  font-weight: 800;
}

.ds-subtitle {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #999999;
}

.money-number {
  font-size: 56rpx;
  line-height: 1.1;
  color: var(--warm-green);
  font-weight: 900;
}

.money-number.accent {
  color: var(--warm-orange);
}

.btn-primary,
.btn-secondary,
.btn-ghost,
.btn-danger {
  border: none;
  border-radius: 40rpx;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.btn-primary {
  color: #ffffff;
  background: linear-gradient(90deg, var(--warm-green) 0%, var(--warm-blue) 100%);
}

.btn-secondary {
  color: #355528;
  background: linear-gradient(90deg, #e9c46a 0%, #f4d48f 100%);
}

.btn-ghost {
  color: var(--warm-green);
  background: var(--warm-card);
}

.btn-danger {
  color: #ffffff;
  background: linear-gradient(90deg, var(--warm-orange) 0%, #dd7f42 100%);
}

.btn-primary::after,
.btn-secondary::after,
.btn-ghost::after,
.btn-danger::after {
  border: none;
}

.btn-primary[disabled],
.btn-secondary[disabled],
.btn-ghost[disabled],
.btn-danger[disabled] {
  opacity: 0.56;
}

.ds-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 84rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 2rpx solid rgba(106, 153, 78, 0.12);
  color: #333333;
  font-size: 30rpx;
  line-height: 1.35;
  transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
}

.ds-input.focus {
  border-color: #6a994e;
  box-shadow: 0 0 12rpx rgba(106, 153, 78, 0.3);
}

.ds-input.invalid {
  border-color: #e63946;
  box-shadow: 0 0 10rpx rgba(230, 57, 70, 0.2);
}

/* Backward-compatible aliases for existing pages */
.card {
  background: #fff8e8;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.input {
  width: 100%;
  box-sizing: border-box;
  min-height: 84rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 2rpx solid rgba(106, 153, 78, 0.12);
  color: #333333;
  font-size: 30rpx;
  line-height: 1.35;
  transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
}

.input:focus {
  border-color: #6a994e;
  box-shadow: 0 0 12rpx rgba(106, 153, 78, 0.3);
}

.error-text {
  color: #e63946;
  font-size: 24rpx;
  line-height: 1.4;
}

.pressable {
  transition: transform 220ms ease, opacity 220ms ease;
}

.pressing {
  transform: scale(0.95);
  opacity: 0.92;
}

.page-enter {
  animation: pageFadeIn 260ms ease both;
}

.card-in {
  opacity: 0;
  transform: translate3d(0, 20rpx, 0);
  animation: cardFadeIn 280ms ease-out forwards;
}

@keyframes pageFadeIn {
  from {
    opacity: 0;
    transform: translate3d(0, 12rpx, 0);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@keyframes cardFadeIn {
  from {
    opacity: 0;
    transform: translate3d(0, 20rpx, 0);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}
