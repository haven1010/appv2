/* custom-tab-bar/index.wxss */
.tab-bar {
  display: flex;
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 14rpx;
  height: 112rpx;
  padding: 8rpx 12rpx calc(env(safe-area-inset-bottom) + 8rpx);
  background: rgba(250, 253, 255, 0.96);
  border: 1rpx solid rgba(45, 115, 199, 0.2);
  border-radius: 34rpx;
  box-shadow: 0 16rpx 36rpx rgba(41, 97, 161, 0.2);
  z-index: 999;
  backdrop-filter: blur(18rpx);
}

.brand-anchor {
  position: absolute;
  top: -26rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 1rpx solid rgba(45, 115, 199, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 18rpx rgba(45, 115, 199, 0.2);
}

.brand-anchor-logo {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tab-icon-wrap {
  width: 58rpx;
  height: 42rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  transition: all 0.2s ease;
}

.tab-icon-text {
  font-size: 34rpx;
  line-height: 1;
  opacity: 0.58;
}

.tab-text {
  font-size: 19rpx;
  color: #6f8aa1;
  line-height: 1.2;
}

.tab-bar-item.active .tab-icon-wrap {
  background: linear-gradient(135deg, rgba(46, 143, 77, 0.16), rgba(45, 115, 199, 0.16));
  box-shadow: inset 0 0 0 1rpx rgba(45, 115, 199, 0.2);
}

.tab-bar-item.active .tab-icon-text {
  opacity: 1;
}

.tab-bar-item.active .tab-text {
  color: #2d73c7;
  font-weight: 700;
}
