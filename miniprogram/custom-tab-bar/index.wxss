.tab-shell {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 12rpx;
  z-index: 999;
}

.compact-shell {
  left: 12rpx;
  right: 12rpx;
  bottom: 8rpx;
}

.tab-bar {
  height: 126rpx;
  padding: 8rpx 14rpx calc(env(safe-area-inset-bottom) + 10rpx);
  border-radius: 34rpx;
  border: 3rpx solid #d8be94;
  background: rgba(255, 249, 234, 0.98);
  box-shadow: 0 12rpx 28rpx rgba(100, 76, 43, 0.2);
  display: flex;
  align-items: flex-end;
  backdrop-filter: blur(12rpx);
}

.compact-bar {
  height: 96rpx;
  padding: 4rpx 10rpx calc(env(safe-area-inset-bottom) + 6rpx);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 18rpx rgba(100, 76, 43, 0.16);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 8rpx;
}

.icon-wrap {
  width: 62rpx;
  height: 46rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  position: relative;
}

.icon-text {
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  color: #8b7658;
}

.tab-text {
  font-size: 20rpx;
  line-height: 1.2;
  color: #7e6a4f;
}

.compact-bar .tab-item {
  padding-bottom: 4rpx;
}

.compact-bar .icon-wrap {
  width: 50rpx;
  height: 36rpx;
  margin-bottom: 2rpx;
}

.compact-bar .icon-text {
  font-size: 24rpx;
}

.compact-bar .tab-text {
  font-size: 18rpx;
  line-height: 1.1;
}

.tab-item.active .icon-wrap {
  background: rgba(111, 157, 81, 0.14);
}

.tab-item.active .icon-text,
.tab-item.active .tab-text {
  color: #3e5f2d;
  font-weight: 800;
}

.tab-item.is-center {
  padding-bottom: 0;
}

.tab-item.is-center .tab-text {
  margin-top: -28rpx;
  color: #3a2e1f;
  font-weight: 800;
}

.center-wrap {
  width: 122rpx;
  height: 122rpx;
  border-radius: 999rpx;
  border: 8rpx solid #fff9ec;
  background: linear-gradient(160deg, #ffd868 0%, #f7c649 100%);
  transform: translateY(-38rpx);
  box-shadow: 0 12rpx 24rpx rgba(209, 158, 51, 0.45);
  margin-bottom: 6rpx;
}

.center-glow {
  position: absolute;
  inset: -10rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 227, 138, 0.55) 0%, rgba(255, 227, 138, 0) 68%);
}

.tab-item.is-center .icon-text {
  font-size: 38rpx;
  color: #37210f;
  letter-spacing: 2rpx;
}

.tab-item.is-center.active .center-wrap {
  box-shadow: 0 14rpx 30rpx rgba(209, 158, 51, 0.62);
}
